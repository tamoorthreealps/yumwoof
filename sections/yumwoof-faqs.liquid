{{ 'css--yumwoof-faqs.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign categories = shop.metaobjects.faq_category.values | sort: 'sort_order'
  assign faqs = shop.metaobjects.faq.values

  assign question_count = faqs.size

  comment
    Only keep categories that have at least one FAQ pointing at them.
  endcomment
  assign used_ids = ''
  for faq in faqs
    assign fid = faq.category.value.system.id
    if fid != blank
      assign used_ids = used_ids | append: '|' | append: fid
    endif
  endfor
  assign used_ids = used_ids | append: '|'

  assign active_categories = ''
  for category in categories
    assign needle = '|' | append: category.system.id | append: '|'
    if used_ids contains needle
      assign active_categories = active_categories | append: category.system.handle | append: ','
    endif
  endfor
  assign active_handles = active_categories | split: ','

  assign category_count = active_handles.size

  assign show_filters = false
  if section.settings.show_filters and category_count > 0
    assign show_filters = true
  endif

  assign all_label = section.settings.all_label
  if all_label == blank
    assign all_label = 'All'
  endif
-%}

<style>
  #shopify-section-{{ section.id }} {
    --yw-bg: {{ section.settings.color_bg }};
    --yw-ink: {{ section.settings.color_text }};
    --yw-link: {{ section.settings.color_link }};
    --yw-rule: {{ section.settings.color_rule }};
    --yw-font-body: {{ section.settings.font_body }};
    --yw-font-label: {{ section.settings.font_label }};
    --yw-pt: {{ section.settings.padding_top }}px;
    --yw-pb: {{ section.settings.padding_bottom }}px;
    --yw-pt-m: {{ section.settings.padding_top_mobile }}px;
    --yw-pb-m: {{ section.settings.padding_bottom_mobile }}px;
  }
</style>

<div
  class="yw-faqs"
  data-yw-faqs
  data-single-open="{{ section.settings.single_open }}"
  data-open-first="{{ section.settings.open_first }}"
>
  <div class="yw-faqs__wrap">
    <aside class="yw-faqs__rail">
      <div class="yw-faqs__masthead">
        {%- if section.settings.title != blank -%}
          <h1 class="yw-faqs__title">{{ section.settings.title | escape }}</h1>
        {%- endif -%}
        {%- if section.settings.lede != blank -%}
          <div class="yw-faqs__lede">{{ section.settings.lede }}</div>
        {%- endif -%}
      </div>

      {%- if show_filters -%}
        <div class="yw-faqs__pills" role="group" aria-label="{{ section.settings.filter_label | escape }}">
          {%- assign pill_index = 0 -%}
          {%- for category in categories -%}
            {%- liquid
              assign handle = category.system.handle
              unless active_handles contains handle
                continue
              endunless
              assign pill_index = pill_index | plus: 1
              assign pill_text = category.pill_label
              if pill_text == blank
                assign pill_text = category.title
              endif
            -%}
            <button
              type="button"
              class="yw-pill{% if pill_index == 1 %} is-active{% endif %}"
              data-yw-filter="{{ handle }}"
              aria-pressed="false"
            >
              {{ pill_text | escape }}
            </button>
          {%- endfor -%}
        </div>

        <div class="yw-faqs__select" data-yw-select>
          <button
            type="button"
            class="yw-pill yw-pill--select"
            aria-expanded="false"
            aria-haspopup="listbox"
            aria-controls="yw-select-menu-{{ section.id }}"
            data-yw-select-trigger
          >
            <span data-yw-select-label>
              {%- if section.settings.show_all_option -%}
                {{ all_label | escape }}
              {%- else -%}
                {%- for category in categories -%}
                  {%- unless active_handles contains category.system.handle -%}
                    {%- continue -%}
                  {%- endunless -%}
                  {{ category.pill_label | default: category.title | escape }}
                  {%- break -%}
                {%- endfor -%}
              {%- endif -%}
            </span>
            <span class="yw-pill__chevron" aria-hidden="true">
              <svg width="12" height="12" viewBox="0 0 12 12" fill="none" xmlns="http://www.w3.org/2000/svg">
                <path d="M6.79268 9.22723C6.68117 9.22723 6.56965 9.18454 6.48471 9.09959L2.12869 4.74357C2.00411 4.61899 1.96665 4.43168 2.03416 4.26877C2.10125 4.10585 2.26068 4 2.43666 4H11.1487C11.3247 4 11.4841 4.10585 11.5512 4.26877C11.6187 4.43168 11.5813 4.61899 11.4567 4.74357L7.10065 9.09959C7.01571 9.18454 6.9042 9.22723 6.79268 9.22723Z" fill="black"/>
              </svg>
            </span>
          </button>

          <ul class="yw-faqs__select-menu" id="yw-select-menu-{{ section.id }}" role="listbox" hidden>
            {%- if section.settings.show_all_option -%}
              <li role="presentation">
                <button
                  type="button"
                  class="yw-faqs__select-option is-active"
                  role="option"
                  aria-selected="true"
                  data-yw-filter="all"
                >
                  {{ all_label | escape }}
                </button>
              </li>
            {%- endif -%}
            {%- assign opt_index = 0 -%}
            {%- for category in categories -%}
              {%- unless active_handles contains category.system.handle -%}
                {%- continue -%}
              {%- endunless -%}
              {%- assign opt_index = opt_index | plus: 1 -%}
              <li role="presentation">
                <button
                  type="button"
                  class="yw-faqs__select-option{% unless section.settings.show_all_option %}{% if opt_index == 1 %} is-active{% endif %}{% endunless %}"
                  role="option"
                  aria-selected="false"
                  data-yw-filter="{{ category.system.handle }}"
                >
                  {{ category.pill_label | default: category.title | escape }}
                </button>
              </li>
            {%- endfor -%}
          </ul>
        </div>
      {%- endif -%}
    </aside>

    <div class="yw-faqs__main" data-yw-main>
      {%- for category in categories -%}
        {%- liquid
          assign cat_id = category.system.id
          assign cat_handle = category.system.handle
        -%}

        {%- if active_handles contains cat_handle -%}
          <section class="yw-faqs__group" data-yw-group data-yw-category="{{ cat_handle }}">
            {%- if category.title != blank -%}
              <h2 class="yw-faqs__group-title">{{ category.title | escape }}</h2>
            {%- endif -%}

            <div class="yw-faqs__items">
              {%- for faq in faqs -%}
                {%- if faq.category.value.system.id != cat_id -%}
                  {%- continue -%}
                {%- endif -%}

                {%- assign uid = faq.system.handle | append: '-' | append: forloop.index -%}

                <div class="yw-faq" data-yw-item>
                  <h3 class="yw-faq__h">
                    <button
                      type="button"
                      class="yw-faq__trigger"
                      id="yw-q-{{ section.id }}-{{ uid }}"
                      aria-controls="yw-a-{{ section.id }}-{{ uid }}"
                      aria-expanded="false"
                      data-yw-trigger
                    >
                      <span class="yw-faq__question">{{ faq.question | escape }}</span>
                      <span class="yw-faq__icon" aria-hidden="true">
                        <span class="yw-faq__icon-bar yw-faq__icon-bar--h"></span>
                        <span class="yw-faq__icon-bar yw-faq__icon-bar--v"></span>
                      </span>
                    </button>
                  </h3>

                  <div
                    class="yw-faq__panel"
                    id="yw-a-{{ section.id }}-{{ uid }}"
                    role="region"
                    aria-labelledby="yw-q-{{ section.id }}-{{ uid }}"
                    data-yw-panel
                  >
                    <div class="yw-faq__answer">{{ faq.answer | metafield_tag }}</div>
                  </div>
                </div>
              {%- endfor -%}
            </div>
          </section>
        {%- endif -%}
      {%- endfor -%}

      {%- comment -%} Any FAQ without a category still renders {%- endcomment -%}
      {%- assign orphan_count = 0 -%}
      {%- for faq in faqs -%}
        {%- if faq.category.value == blank -%}
          {%- assign orphan_count = orphan_count | plus: 1 -%}
        {%- endif -%}
      {%- endfor -%}

      {%- if orphan_count > 0 -%}
        <section class="yw-faqs__group" data-yw-group data-yw-category="uncategorised">
          <div class="yw-faqs__items">
            {%- for faq in faqs -%}
              {%- if faq.category.value != blank -%}
                {%- continue -%}
              {%- endif -%}
              {%- assign uid = faq.system.handle | append: '-u' | append: forloop.index -%}
              <div class="yw-faq" data-yw-item>
                <h3 class="yw-faq__h">
                  <button
                    type="button"
                    class="yw-faq__trigger"
                    id="yw-q-{{ section.id }}-{{ uid }}"
                    aria-controls="yw-a-{{ section.id }}-{{ uid }}"
                    aria-expanded="false"
                    data-yw-trigger
                  >
                    <span class="yw-faq__question">{{ faq.question | escape }}</span>
                    <span class="yw-faq__icon" aria-hidden="true">
                      <span class="yw-faq__icon-bar yw-faq__icon-bar--h"></span>
                      <span class="yw-faq__icon-bar yw-faq__icon-bar--v"></span>
                    </span>
                  </button>
                </h3>
                <div
                  class="yw-faq__panel"
                  id="yw-a-{{ section.id }}-{{ uid }}"
                  role="region"
                  aria-labelledby="yw-q-{{ section.id }}-{{ uid }}"
                  data-yw-panel
                >
                  <div class="yw-faq__answer">{{ faq.answer | metafield_tag }}</div>
                </div>
              </div>
            {%- endfor -%}
          </div>
        </section>
      {%- endif -%}

      {%- if question_count == 0 -%}
        <p class="yw-faqs__empty">
          Add entries to the “FAQs” and “Faqs Category” metaobjects in Content → Metaobjects to build this page.
        </p>
      {%- endif -%}
    </div>
  </div>
</div>

<script>
  document.querySelectorAll('[data-yw-faqs]').forEach((faq) => {
    const header =
      document.querySelector('.yw-header') ||
      document.querySelector('.shopify-section-header') ||
      document.querySelector('header');

    const headerOffset = header ? header.offsetHeight + 20 : 20;

    const groups = faq.querySelectorAll('[data-yw-group]');
    const filters = faq.querySelectorAll('[data-yw-filter]');

    const select = faq.querySelector('[data-yw-select]');
    const selectTrigger = faq.querySelector('[data-yw-select-trigger]');
    const selectLabel = faq.querySelector('[data-yw-select-label]');
    const selectMenu = faq.querySelector('.yw-faqs__select-menu');

    /* ---------------- Accordion ---------------- */

    function openItem(item, animate = true) {
      const panel = item.querySelector('[data-yw-panel]');
      const trigger = item.querySelector('[data-yw-trigger]');

      item.classList.add('is-open');
      trigger.setAttribute('aria-expanded', 'true');
      panel.classList.add('is-open');

      if (!animate) {
        panel.style.height = 'auto';
        return;
      }

      panel.style.height = '0px';

      requestAnimationFrame(() => {
        panel.style.height = panel.scrollHeight + 'px';
      });

      panel.addEventListener(
        'transitionend',
        function end() {
          panel.style.height = 'auto';
          panel.removeEventListener('transitionend', end);
        },
        { once: true }
      );
    }

    function closeItem(item) {
      const panel = item.querySelector('[data-yw-panel]');
      const trigger = item.querySelector('[data-yw-trigger]');

      panel.style.height = panel.scrollHeight + 'px';

      requestAnimationFrame(() => {
        panel.style.height = '0px';
      });

      item.classList.remove('is-open');
      trigger.setAttribute('aria-expanded', 'false');
      panel.classList.remove('is-open');
    }

    // First accordion of every topic open
    groups.forEach((group) => {
      const items = group.querySelectorAll('[data-yw-item]');

      items.forEach((item) => {
        item.classList.remove('is-open');

        const trigger = item.querySelector('[data-yw-trigger]');
        const panel = item.querySelector('[data-yw-panel]');

        trigger.setAttribute('aria-expanded', 'false');
        panel.classList.remove('is-open');
        panel.style.height = '0px';
      });

      if (items.length) {
        openItem(items[0], false);
      }
    });

    faq.addEventListener('click', (e) => {
      const trigger = e.target.closest('[data-yw-trigger]');
      if (!trigger) return;

      const item = trigger.closest('[data-yw-item]');
      const group = item.closest('[data-yw-group]');

      if (item.classList.contains('is-open')) {
        closeItem(item);
        return;
      }

      group.querySelectorAll('[data-yw-item].is-open').forEach((openItemEl) => {
        if (openItemEl !== item) {
          closeItem(openItemEl);
        }
      });

      openItem(item);
    });

    /* ---------------- Filters ---------------- */

    filters.forEach((btn) => {
      btn.addEventListener('click', () => {
        const value = btn.dataset.ywFilter;
        const label = btn.textContent.trim();

        filters.forEach((b) => {
          let active = b.dataset.ywFilter === value;

          if (window.innerWidth >= 750 && b.dataset.ywFilter === 'all') {
            active = false;
          }

          b.classList.toggle('is-active', active);

          if (b.hasAttribute('aria-pressed')) {
            b.setAttribute('aria-pressed', active);
          }

          if (b.hasAttribute('aria-selected')) {
            b.setAttribute('aria-selected', active);
          }
        });

        if (selectLabel) {
          selectLabel.textContent = label;
        }

        if (window.innerWidth < 750) {
          groups.forEach((group) => {
            group.classList.toggle('is-filtered-out', value !== 'all' && group.dataset.ywCategory !== value);
          });

          closeDropdown();
          return;
        }

        groups.forEach((group) => {
          group.classList.remove('is-filtered-out');
        });

        const target = faq.querySelector(`[data-yw-category="${value}"]`);

        if (target) {
          window.scrollTo({
            top: target.getBoundingClientRect().top + window.pageYOffset - headerOffset,
            behavior: 'smooth',
          });
        }
      });
    });

    /* ---------------- Mobile Dropdown ---------------- */

    if (select && selectTrigger && selectMenu) {
      selectTrigger.addEventListener('click', (e) => {
        e.stopPropagation();

        const open = selectTrigger.getAttribute('aria-expanded') === 'true';

        selectTrigger.setAttribute('aria-expanded', !open);
        selectMenu.hidden = open;
      });

      document.addEventListener('click', (e) => {
        if (!select.contains(e.target)) closeDropdown();
      });

      document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape') closeDropdown();
      });
    }

    function closeDropdown() {
      if (!selectMenu || !selectTrigger) return;

      selectMenu.hidden = true;
      selectTrigger.setAttribute('aria-expanded', 'false');
    }

    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (!entry.isIntersecting) return;

          const category = entry.target.dataset.ywCategory;

          filters.forEach((btn) => {
            const active = btn.dataset.ywFilter === category;

            btn.classList.toggle('is-active', active);

            if (btn.hasAttribute('aria-pressed')) {
              btn.setAttribute('aria-pressed', active);
            }

            if (btn.hasAttribute('aria-selected')) {
              btn.setAttribute('aria-selected', active);
            }
          });
        });
      },
      {
        rootMargin: `-${headerOffset}px 0px -60% 0px`,
        threshold: 0,
      }
    );

    groups.forEach((group) => {
      observer.observe(group);
    });
  });
</script>

{% schema %}
{
  "name": "FAQs",
  "tag": "section",
  "class": "yw-faqs-section",
  "settings": [
    {
      "type": "paragraph",
      "content": "Questions and topics are managed in Content → Metaobjects (“FAQs” and “Faqs Category”). Topic order follows the Sort Order field."
    },
    { "type": "header", "content": "Heading" },
    {
      "type": "text",
      "id": "title",
      "label": "Page title",
      "default": "FAQs"
    },
    {
      "type": "richtext",
      "id": "lede",
      "label": "Intro text",
      "default": "<p>Don't see the answer you're looking for? Reach out to woof@yumwoof.com and we'll get back to you in a flash.</p>",
      "info": "Add the email as a link so it inherits the maroon underline."
    },
    { "type": "header", "content": "Topic filter" },
    {
      "type": "checkbox",
      "id": "show_filters",
      "label": "Show topic filter",
      "info": "Stacked pills on desktop, a dropdown on mobile. Needs at least one Faqs Category entry.",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_all_option",
      "label": "Show \"All\" option on mobile",
      "default": true
    },
    {
      "type": "text",
      "id": "all_label",
      "label": "\"All\" label",
      "default": "All"
    },
    {
      "type": "text",
      "id": "filter_label",
      "label": "Filter label for screen readers",
      "default": "Filter questions by topic"
    },
    { "type": "header", "content": "Colours" },
    { "type": "color", "id": "color_bg", "label": "Background", "default": "#FFF9EF" },
    { "type": "color", "id": "color_text", "label": "Text", "default": "#000000" },
    { "type": "color", "id": "color_link", "label": "Links", "default": "#661D1D" },
    { "type": "color", "id": "color_rule", "label": "Divider lines", "default": "#000000" },
    { "type": "header", "content": "Spacing — desktop" },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top padding",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "default": 76
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom padding",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "default": 160
    },
    { "type": "header", "content": "Spacing — mobile" },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "label": "Top padding",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "label": "Bottom padding",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "default": 80
    }
  ],
  "presets": [{ "name": "FAQs" }]
}
{% endschema %}
