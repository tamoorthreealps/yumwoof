{%- comment -%}
  Good Life Quote — founders image with overlaid quote + signature.
  Figma: Yumwoof (Final) — desktop 8638:1439 (1512w), mobile 8640:1762 (392w).
  Namespace: .good-life-quote  |  JS: window.__goodLifeQuote
  Motion:
    - Zoom: the photo scales up slowly as the section scrolls through the screen (1 → 1.08,
      1 → 1.05 on mobile), around the card's visible centre. The card never moves.
    - Reveal: the quote types out character by character, then the signature and the
      founders line rise from a soft blur. Plays once. Reduced motion: all static.
{%- endcomment -%}

{%- liquid
  assign s = section.settings
  assign img_d = s.image_desktop
  assign img_m = s.image_mobile
  assign mobile_fallback = false
  if img_m == blank and img_d != blank
    assign img_m = img_d
    assign mobile_fallback = true
  endif

  assign crop_d = s.desktop_crop
  assign crop_m = s.mobile_crop
  if mobile_fallback
    assign crop_m = 'cover'
  endif
-%}

<style>
  .good-life-quote {
    --glq-s: clamp(0.6px, calc(100vw / 1512), 1px);
    --glq-m: clamp(0.816px, calc(100vw / 392), 1.3px);
    --glq-text: {{ s.text_color }};
    --glq-overlay-d: {{ s.overlay_desktop | divided_by: 100.0 }};
    --glq-overlay-m: {{ s.overlay_mobile | divided_by: 100.0 }};
    --glq-font-display: 'TAYRosemary', 'TAY Rosemary', 'TAYRosemary-Regular', serif;
    --glq-font-body: 'Matter', 'Matter Medium', 'Matter-Medium', sans-serif;
    display: block;
    margin-top: {{ s.margin_top_desktop }}px;
    margin-bottom: {{ s.margin_bottom_desktop }}px;
  }

  .good-life-quote__card {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    width: 100%;
    height: calc(852 * var(--glq-s));
    border-radius: calc(64 * var(--glq-s)) 0 calc(64 * var(--glq-s)) 0;
    background-color: #000;
    z-index: 1;
  }

  /* ---------- media ---------- */
  .good-life-quote__media {
    position: absolute;
    inset: 0;
    overflow: hidden;
    z-index: 0;
  }
  .good-life-quote__media img,
  .good-life-quote__media svg {
    position: absolute;
    display: block;
    max-width: none;
    object-fit: cover;
  }
  .good-life-quote__media--cover img,
  .good-life-quote__media svg {
    inset: 0;
    width: 100%;
    height: 100%;
  }
  /* Exact Figma crop (desktop frame 8640:1734) */
  .good-life-quote__media--desktop.good-life-quote__media--figma img {
    left: 0;
    top: -36.78%;
    width: 138.94%;
    height: 165.24%;
  }
  /* Exact Figma crop (mobile frame 8650:3166) */
  .good-life-quote__media--mobile.good-life-quote__media--figma img {
    left: -27.01%;
    top: -4.69%;
    width: 187.99%;
    height: 164.41%;
  }
  .good-life-quote__media--mobile { display: none; }
  .good-life-quote__media svg { background: #3d3d3d; fill: rgba(255, 255, 255, 0.25); }

  .good-life-quote__overlay {
    position: absolute;
    inset: 0;
    z-index: 1;
    pointer-events: none;
    background: rgba(0, 0, 0, var(--glq-overlay-d));
  }

  /* ---------- content ---------- */
  .good-life-quote__content {
    position: absolute;
    z-index: 2;
    left: calc(60 * var(--glq-s));
    top: calc(120 * var(--glq-s));
    width: calc(720 * var(--glq-s));
    margin: 0;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: calc(24 * var(--glq-s));
    color: var(--glq-text);
  }

  .good-life-quote__quote {
    margin: 0;
    padding: 0;
    border: 0;
    quotes: none;
  }
  .good-life-quote__quote-text {
    margin: 0;
    font-family: var(--glq-font-display);
    font-weight: 400;
    font-style: normal;
    font-size: max(40px, calc(80 * var(--glq-s)));
    line-height: 1;
    letter-spacing: -0.02em;
    text-transform: uppercase;
    color: var(--glq-text);
    word-break: break-word;
    transform: translateY(-4px);
  }

  .good-life-quote__founders {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: calc(8 * var(--glq-s));
    width: calc(341 * var(--glq-s));
    margin: 0;
  }
  .good-life-quote__signature {
    display: block;
    width: calc(344 * var(--glq-s));
    max-width: none;
    height: calc(96 * var(--glq-s));
    object-fit: contain;
    object-position: left center;
  }
  .good-life-quote__name {
    margin: 0;
    font-family: var(--glq-font-body);
    font-weight: 500;
    font-style: normal;
    font-size: max(14px, calc(20 * var(--glq-s)));
    line-height: 1.4;
    color: var(--glq-text);
    white-space: nowrap;
    letter-spacing: 0;
  }

  /* ---------- Motion (classes added by JS only; reduced motion never gets them) ---------- */
  .good-life-quote { --glq-ease: cubic-bezier(0.22, 1, 0.36, 1); }

  /* Scroll zoom: only the image scales; the card, overlay and content never move */
  .good-life-quote.glq-zoom .good-life-quote__media img { will-change: transform; backface-visibility: hidden; }

  /* Quote: hidden until it has been split into its rendered lines */
  .good-life-quote.glq-anim:not(.glq-done) .good-life-quote__quote-text:not(.glq-split) { opacity: 0; }
  .good-life-quote .glq-line {
    display: block;
    white-space: nowrap;
    /* soft-edged mask sweeps left → right, like smooth typing */
    -webkit-mask-image: linear-gradient(90deg, #000 0%, #000 46%, transparent 54%, transparent 100%);
            mask-image: linear-gradient(90deg, #000 0%, #000 46%, transparent 54%, transparent 100%);
    -webkit-mask-size: 230% 100%;
            mask-size: 230% 100%;
    -webkit-mask-repeat: no-repeat;
            mask-repeat: no-repeat;
    -webkit-mask-position: 100% 0;
            mask-position: 100% 0;
    transition:
      -webkit-mask-position var(--glq-line-dur, 0.9s) cubic-bezier(0.4, 0, 0.2, 1) var(--glq-line-delay, 0s),
      mask-position var(--glq-line-dur, 0.9s) cubic-bezier(0.4, 0, 0.2, 1) var(--glq-line-delay, 0s);
  }
  .good-life-quote.glq-in .glq-line {
    -webkit-mask-position: 0 0;
            mask-position: 0 0;
  }

  /* Signature, then founders line: rise from a soft blur */
  .good-life-quote.glq-anim .good-life-quote__signature,
  .good-life-quote.glq-anim .good-life-quote__name {
    opacity: 0;
    filter: blur(6px);
    transform: translate3d(0, 18px, 0);
    transition:
      opacity 0.9s var(--glq-ease) var(--glq-sig-delay, 0s),
      filter 0.9s var(--glq-ease) var(--glq-sig-delay, 0s),
      transform 0.9s var(--glq-ease) var(--glq-sig-delay, 0s);
  }
  .good-life-quote.glq-anim .good-life-quote__name {
    filter: blur(4px);
    transform: translate3d(0, 14px, 0);
    transition-duration: 0.8s;
    transition-delay: var(--glq-name-delay, 0s);
  }
  .good-life-quote.glq-in .good-life-quote__signature,
  .good-life-quote.glq-in .good-life-quote__name {
    opacity: 1;
    filter: none;
    transform: none;
  }

  /* ---------- mobile (separate Figma layout) ---------- */
  @media screen and (max-width: 749px) {
    .good-life-quote {
      margin-top: {{ s.margin_top_mobile }}px;
      margin-bottom: {{ s.margin_bottom_mobile }}px;
    }
    .good-life-quote__card {
      height: calc(672 * var(--glq-m));
      border-radius: calc(32 * var(--glq-m)) 0 calc(32 * var(--glq-m)) 0;
    }
    .good-life-quote__media--desktop { display: none; }
    .good-life-quote__media--mobile { display: block; }

    .good-life-quote__overlay {
      background: linear-gradient(180deg, rgba(0, 0, 0, var(--glq-overlay-m)) 0%, rgba(0, 0, 0, 0) 100%);
    }

    .good-life-quote__content {
      top: calc(56 * var(--glq-m));
      left: calc(24 * var(--glq-m));
      right: calc(24 * var(--glq-m));
      bottom: calc(60 * var(--glq-m));
      width: auto;
      gap: 0;
      justify-content: space-between;
    }
    .good-life-quote__quote { width: calc(320 * var(--glq-m)); max-width: 100%; }
    .good-life-quote__quote-text {
      font-size: calc(48 * var(--glq-m));
      line-height: 1;
      letter-spacing: -0.01em;
    }
    .good-life-quote__br { display: none; }

    .good-life-quote__founders {
      width: calc(201 * var(--glq-m));
      gap: calc(8 * var(--glq-m));
    }
    .good-life-quote__signature {
      width: calc(201 * var(--glq-m));
      height: calc(56 * var(--glq-m));
    }
    .good-life-quote__name {
      font-size: calc(14 * var(--glq-m));
      line-height: calc(20 * var(--glq-m));
    }

    /* shorter travel on mobile */
    .good-life-quote.glq-anim .good-life-quote__signature { transform: translate3d(0, 12px, 0); }
    .good-life-quote.glq-anim .good-life-quote__name { transform: translate3d(0, 10px, 0); }
    .good-life-quote.glq-in .good-life-quote__signature,
    .good-life-quote.glq-in .good-life-quote__name { transform: none; }
  }
</style>

<section
  class="good-life-quote"
  id="good-life-quote-{{ section.id }}"
  aria-label="{{ s.founders_text | default: 'Founders quote' | escape }}"
  {% if s.enable_parallax %}data-glq-zoom{% endif %}
  {% if s.enable_reveal %}data-glq-reveal{% endif %}
>
  <figure class="good-life-quote__card" style="margin:0;">
    {%- comment -%} Desktop image {%- endcomment -%}
    <div class="good-life-quote__media good-life-quote__media--desktop good-life-quote__media--{{ crop_d }}">
      {%- if img_d != blank -%}
        {%- capture pos_d -%}{%- if crop_d == 'cover' -%}object-position: {{ img_d.presentation.focal_point }};{%- endif -%}{%- endcapture -%}
        {{
          img_d
          | image_url: width: 3200
          | image_tag:
            loading: 'lazy',
            widths: '750, 1100, 1500, 1800, 2200, 2600, 3200',
            sizes: '(min-width: 750px) 140vw, 100vw',
            alt: img_d.alt,
            style: pos_d
        }}
      {%- else -%}
        {{ 'lifestyle-2' | placeholder_svg_tag }}
      {%- endif -%}
    </div>

    {%- comment -%} Mobile image (falls back to desktop, cover-cropped) {%- endcomment -%}
    <div class="good-life-quote__media good-life-quote__media--mobile good-life-quote__media--{{ crop_m }}">
      {%- if img_m != blank -%}
        {%- capture pos_m -%}{%- if crop_m == 'cover' -%}object-position: {{ img_m.presentation.focal_point }};{%- endif -%}{%- endcapture -%}
        {{
          img_m
          | image_url: width: 1600
          | image_tag:
            loading: 'lazy',
            widths: '400, 600, 800, 1000, 1200, 1600',
            sizes: '(max-width: 749px) 190vw, 1px',
            alt: img_m.alt,
            style: pos_m
        }}
      {%- else -%}
        {{ 'lifestyle-2' | placeholder_svg_tag }}
      {%- endif -%}
    </div>

    <div class="good-life-quote__overlay" aria-hidden="true"></div>

    <div class="good-life-quote__content">
      {%- if s.quote != blank -%}
        <blockquote class="good-life-quote__quote">
          <p class="good-life-quote__quote-text">
            {{- s.quote | escape | newline_to_br | replace: '<br />', '<br class="good-life-quote__br">' -}}
          </p>
        </blockquote>
      {%- endif -%}

      {%- if s.signature_image != blank or s.founders_text != blank -%}
        <figcaption class="good-life-quote__founders">
          {%- if s.signature_image != blank -%}
            {{
              s.signature_image
              | image_url: width: 1032
              | image_tag:
                loading: 'lazy',
                class: 'good-life-quote__signature',
                alt: s.signature_image.alt | default: 'Founders signature'
            }}
          {%- endif -%}
          {%- if s.founders_text != blank -%}
            <p class="good-life-quote__name">{{ s.founders_text | escape }}</p>
          {%- endif -%}
        </figcaption>
      {%- endif -%}
    </div>
  </figure>
</section>

<script>
  /* Good Life Quote: scroll zoom on the image + quote → signature → name reveal */
  (() => {
    if (window.__goodLifeQuote) return;
    window.__goodLifeQuote = true;
    if (matchMedia('(prefers-reduced-motion: reduce)').matches || !('IntersectionObserver' in window)) return;

    const ZOOM = { desktop: 0.15, mobile: 0.09 }; // extra scale reached as the section passes through
    const mobileMq = matchMedia('(max-width: 749px)');

    // ---------- Quote: typed character by character ----------
    // Every character stays in the layout (only visibility changes), so line breaks,
    // wrapping and typography are exactly the final ones from the first frame.
    const TYPE_TOTAL = 3.6; // seconds for the whole quote, whatever its length

    const splitChars = (p) => {
      const chars = [];
      [...p.childNodes].forEach((node) => {
        if (node.nodeType !== 3) return; // keep <br> exactly where it is
        const frag = document.createDocumentFragment();
        [...node.textContent].forEach((ch) => {
          const s = document.createElement('span');
          s.textContent = ch;
          s.style.visibility = 'hidden';
          chars.push(s);
          frag.append(s);
        });
        node.replaceWith(frag);
      });
      p.classList.add('glq-split');
      return chars;
    };

    // Natural cadence: slight variation per key, a touch longer on spaces,
    // short pauses after commas and longer ones after full stops.
    const schedule = (chars) => {
      let t = 0;
      const times = chars.map((s, i) => {
        const prev = i ? chars[i - 1].textContent : '';
        let w = 0.85 + Math.random() * 0.3;
        if (s.textContent === ' ') w *= 1.35;
        if (/[,;:]/.test(prev)) w += 2.2;
        if (/[.!?]/.test(prev)) w += 3.5;
        t += w;
        return t;
      });
      return times.map((x) => (x / t) * TYPE_TOTAL); // normalise to TYPE_TOTAL
    };

    const reveal = (section) => {
      const p = section.querySelector('.good-life-quote__quote-text');
      const original = p && p.innerHTML;
      const chars = p ? splitChars(p) : [];
      const times = schedule(chars);

      const sig = Math.max(0, (chars.length ? TYPE_TOTAL : 0) - 0.35);
      section.style.setProperty('--glq-sig-delay', `${sig.toFixed(2)}s`);
      section.style.setProperty('--glq-name-delay', `${(sig + 0.25).toFixed(2)}s`);
      section.classList.add('glq-in'); // starts the signature / founders timers

      let shown = 0, t0 = null;
      const type = (now) => {
        if (!section.isConnected) return;
        if (t0 === null) t0 = now;
        const elapsed = (now - t0) / 1000;
        while (shown < chars.length && times[shown] <= elapsed) chars[shown++].style.visibility = '';
        if (shown < chars.length) return requestAnimationFrame(type);
        // done: put the original markup back so it reflows naturally on resize
        p.innerHTML = original;
        p.classList.remove('glq-split');
        section.classList.add('glq-done');
      };
      if (chars.length) requestAnimationFrame(type);
      else section.classList.add('glq-done');
    };

    // ---------- Scroll zoom: the image scales up as the section scrolls through ----------
    const zoom = (section) => {
      const card = section.querySelector('.good-life-quote__card');
      let ticking = false, lastImg = null;

      const frame = () => {
        ticking = false;
        if (!card.isConnected) return;
        const media = [...section.querySelectorAll('.good-life-quote__media')].find((m) => m.offsetParent);
        const img = media && media.querySelector('img');
        if (!img) return;
        if (img !== lastImg) { if (lastImg) lastImg.style.transform = ''; lastImg = img; }

        const { top, height } = card.getBoundingClientRect(); // the card never moves
        const vh = window.innerHeight;
        if (top > vh || top + height < 0) return;
        // 0 as the section enters at the bottom → 1 as it leaves at the top
        const p = Math.min(1, Math.max(0, (vh - top) / (vh + height)));
        const scale = 1 + p * (mobileMq.matches ? ZOOM.mobile : ZOOM.desktop);
        // zoom around the card's visible centre (the image is larger than the card)
        img.style.transformOrigin = `${media.offsetWidth / 2 - img.offsetLeft}px ${media.offsetHeight / 2 - img.offsetTop}px`;
        img.style.transform = `scale(${scale.toFixed(4)})`;
      };
      const request = () => { if (!ticking) { ticking = true; requestAnimationFrame(frame); } };

      section.classList.add('glq-zoom');
      addEventListener('scroll', request, { passive: true });
      addEventListener('resize', request, { passive: true });
      frame();
    };

    const init = (root = document) => {
      root.querySelectorAll('.good-life-quote:not(.glq-ready)').forEach((section) => {
        section.classList.add('glq-ready');
        if (section.hasAttribute('data-glq-zoom')) zoom(section);
        if (!section.hasAttribute('data-glq-reveal')) return;
        if (window.Shopify && Shopify.designMode) return; // no waiting on animations while editing

        section.classList.add('glq-anim');
        new IntersectionObserver(([entry], io) => {
          if (!entry.isIntersecting) return;
          io.disconnect(); // plays once
          reveal(section);
        }, { threshold: 0.2, rootMargin: '0px 0px -8% 0px' }).observe(section.querySelector('.good-life-quote__card'));
      });
    };

    init();
    document.addEventListener('shopify:section:load', (e) => init(e.target)); // Theme Editor re-render
  })();
</script>

{% schema %}
{
  "name": "Good Life Quote",
  "tag": "div",
  "class": "section-good-life-quote",
  "settings": [
    { "type": "header", "content": "Images" },
    {
      "type": "image_picker",
      "id": "image_desktop",
      "label": "Desktop image",
      "info": "Figma source is a 3:2 landscape photo (e.g. 3000 × 2000px)."
    },
    {
      "type": "select",
      "id": "desktop_crop",
      "label": "Desktop crop",
      "default": "figma",
      "options": [
        { "value": "figma", "label": "Match Figma crop (zoomed, left-aligned)" },
        { "value": "cover", "label": "Fill with focal point" }
      ]
    },
    {
      "type": "image_picker",
      "id": "image_mobile",
      "label": "Mobile image",
      "info": "Figma source is a 2:3 portrait photo (e.g. 2000 × 3000px). Falls back to the desktop image when empty."
    },
    {
      "type": "select",
      "id": "mobile_crop",
      "label": "Mobile crop",
      "default": "figma",
      "options": [
        { "value": "figma", "label": "Match Figma crop" },
        { "value": "cover", "label": "Fill with focal point" }
      ]
    },
    {
      "type": "range",
      "id": "overlay_desktop",
      "label": "Desktop image dimming",
      "min": 0,
      "max": 60,
      "step": 5,
      "unit": "%",
      "default": 10
    },
    {
      "type": "range",
      "id": "overlay_mobile",
      "label": "Mobile top gradient strength",
      "min": 0,
      "max": 60,
      "step": 5,
      "unit": "%",
      "default": 15
    },
    { "type": "header", "content": "Quote" },
    {
      "type": "textarea",
      "id": "quote",
      "label": "Quote",
      "info": "Line breaks apply on desktop only; mobile text flows naturally.",
      "default": "“A HOUSE FULL OF DOGS IS OUR IDEA OF THE GOOD LIFE.\nYUM CLUB IS FOR PEOPLE WHO FEEL THE SAME WAY.”"
    },
    {
      "type": "image_picker",
      "id": "signature_image",
      "label": "Founders signature",
      "info": "Export Figma layer 8640:1738 as SVG or PNG @3x (344 × 96)."
    },
    {
      "type": "text",
      "id": "founders_text",
      "label": "Founders text",
      "default": "Jaron & Ana, Founders"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "default": "#FFF9EF"
    },
    { "type": "header", "content": "Motion" },
    {
      "type": "checkbox",
      "id": "enable_parallax",
      "label": "Background image zoom on scroll",
      "info": "The photo zooms in slowly as the section scrolls through the screen (subtler on mobile).",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "enable_reveal",
      "label": "Quote and signature reveal",
      "info": "The quote types out, then the signature and founders line rise in. Plays once.",
      "default": true
    },
    { "type": "header", "content": "Spacing" },
    { "type": "range", "id": "margin_top_desktop", "label": "Desktop top margin", "min": 0, "max": 200, "step": 4, "unit": "px", "default": 0 },
    { "type": "range", "id": "margin_bottom_desktop", "label": "Desktop bottom margin", "min": 0, "max": 200, "step": 4, "unit": "px", "default": 0 },
    { "type": "range", "id": "margin_top_mobile", "label": "Mobile top margin", "min": 0, "max": 200, "step": 4, "unit": "px", "default": 0 },
    { "type": "range", "id": "margin_bottom_mobile", "label": "Mobile bottom margin", "min": 0, "max": 200, "step": 4, "unit": "px", "default": 0 }
  ],
  "presets": [
    { "name": "Good Life Quote" }
  ]
}
{% endschema %}
