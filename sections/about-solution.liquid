{{ 'css--about-solution.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign s = section.settings
  assign uid = section.id
  assign scrim = s.scrim_opacity | divided_by: 100.0
-%}

{%- style -%}
  {%- if s.bg_image != blank -%}
    #about-solution-{{ uid }} .about-solution__bg {
      background-image: url("{{ s.bg_image | image_url: width: 1600 }}");
      display:inherit !important;
    }
  {%- endif -%}
{%- endstyle -%}

<section
  class="about-solution"
  id="about-solution-{{ uid }}"
  style="
    --as-bg: {{ s.color_bg }};
    --as-text: {{ s.color_text }};
    --as-scrim: {{ scrim }};
    --as-min-height: {{ s.min_height }}px;
    --as-min-height-mobile: {{ s.min_height_mobile }}px;
    --as-pad-top: {{ s.padding_top }}px;
    --as-pad-bottom: {{ s.padding_bottom }}px;
    --as-pad-top-mobile: {{ s.padding_top_mobile }}px;
    --as-pad-bottom-mobile: {{ s.padding_bottom_mobile }}px;
  "
>
  <div class="about-solution__inner">
    {%- if s.bg_image != blank -%}
      <div class="about-solution__bg" aria-hidden="true"></div>
      <div class="about-solution__scrim" aria-hidden="true"></div>
    {%- endif -%}

    <div class="about-solution__content">
      {%- if s.heading != blank -%}
        <h2 class="about-solution__heading">{{ s.heading }}</h2>
      {%- endif -%}
      {%- if s.body != blank -%}
        <div class="about-solution__body">{{ s.body }}</div>
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "About Solution",
  "tag": "section",
  "class": "about-solution-section",
  "settings": [
    { "type": "header", "content": "Content" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "We designed the food we couldn't find." },
    { "type": "richtext", "id": "body", "label": "Body", "default": "<p>Like many pet parents, we wanted food we could trust. What began as a personal search for better nutrition eventually led us to develop some of the first air-dried recipes of their kind, publish a book on canine nutrition, build relationships with trusted farmers, ranchers, and fishermen, and serve millions of meals to dogs through better food.</p>" },

    { "type": "header", "content": "Background" },
    { "type": "color", "id": "color_bg", "label": "Background color", "default": "#0d0d0d" },
    { "type": "color", "id": "color_text", "label": "Text color", "default": "#fff9ef" },
    { "type": "image_picker", "id": "bg_image", "label": "Background image (optional)" },
    { "type": "range", "id": "scrim_opacity", "label": "Scrim strength", "min": 0, "max": 100, "step": 5, "unit": "%", "default": 55, "info": "Darkens the image so the light text stays legible." },

    { "type": "header", "content": "Layout" },
    { "type": "range", "id": "min_height", "label": "Min height (desktop)", "min": 320, "max": 1000, "step": 8, "unit": "px", "default": 744 },
    { "type": "range", "id": "min_height_mobile", "label": "Min height (mobile)", "min": 320, "max": 1000, "step": 8, "unit": "px", "default": 560 },
    { "type": "range", "id": "padding_top", "label": "Padding top (desktop)", "min": 0, "max": 240, "step": 4, "unit": "px", "default": 124 },
    { "type": "range", "id": "padding_bottom", "label": "Padding bottom (desktop)", "min": 0, "max": 240, "step": 4, "unit": "px", "default": 124 },
    { "type": "range", "id": "padding_top_mobile", "label": "Padding top (mobile)", "min": 0, "max": 200, "step": 4, "unit": "px", "default": 72 },
    { "type": "range", "id": "padding_bottom_mobile", "label": "Padding bottom (mobile)", "min": 0, "max": 200, "step": 4, "unit": "px", "default": 72 }
  ],
  "presets": [{ "name": "About Solution" }]
}
{% endschema %}



<script>
  /* About — Solution : masked heading reveal + lerped background parallax */
(() => {
  if (window.__aboutSolution) return;
  window.__aboutSolution = true;

  if (matchMedia('(prefers-reduced-motion: reduce)').matches || !('IntersectionObserver' in window)) return;

  const OVERSCAN = 0.12; // matches `inset: -18% 0` in the CSS
  const LERP = 0.085;    // lower = heavier, more cinematic lag
  const STAGGER = 0.15, LINE_DUR = 1.9, BODY_DUR = 1.7; // mirror the CSS variables

  const el = (cls, children) => {
    const s = document.createElement('span');
    s.className = cls;
    s.append(...children);
    return s;
  };

  // Wrap each rendered line of the heading in a mask; returns the line count
  const splitLines = (heading) => {
    const words = heading.textContent.trim().split(/\s+/).map((w) => {
      const s = el('', [w]);
      s.style.display = 'inline-block';
      return s;
    });
    heading.replaceChildren(...words.flatMap((w) => [w, ' ']));

    const lines = [];
    let top = null;
    for (const w of words) {
      if (top === null || Math.abs(w.offsetTop - top) > 2) { lines.push([]); top = w.offsetTop; }
      lines[lines.length - 1].push(w.textContent);
    }

    heading.replaceChildren(...lines.flatMap((line, i) => {
      const inner = el('as-line__inner', [line.join(' ')]);
      inner.style.setProperty('--as-i', i);
      return [el('as-line', [inner]), ' '];
    }));
    heading.classList.add('as-split');
    return lines.length;
  };

  const reveal = async (section) => {
    const heading = section.querySelector('.about-solution__heading');
    const text = heading && heading.textContent;

    // line breaks depend on the display font being loaded (wait max 1.2s)
    await Promise.race([document.fonts ? document.fonts.ready : 0, new Promise((r) => setTimeout(r, 1200))]);
    if (!section.isConnected) return;

    const lines = heading ? splitLines(heading) : 0;
    const bodyDelay = lines ? (lines - 1) * STAGGER + 0.45 : 0.1;
    section.style.setProperty('--as-body-delay', `${bodyDelay.toFixed(2)}s`);

    requestAnimationFrame(() => requestAnimationFrame(() => section.classList.add('as-in')));

    // when finished, restore the plain heading so it reflows naturally on resize
    const total = Math.max(lines ? (lines - 1) * STAGGER + LINE_DUR : 0, bodyDelay + BODY_DUR);
    setTimeout(() => {
      section.classList.add('as-done');
      if (heading) { heading.classList.remove('as-split'); heading.textContent = text; }
    }, total * 1000 + 200);
  };

  const parallax = (section, inner, bg) => {
    const listeners = new AbortController();
    let current = null, raf = 0, near = false;

    const tick = () => {
      raf = 0;
      const { top, height } = inner.getBoundingClientRect();
      const vh = window.innerHeight;
      // +1 just below the viewport, 0 centred, -1 just above
      const progress = Math.max(-1, Math.min(1, (top + height / 2 - vh / 2) / ((vh + height) / 2)));
      const target = -progress * (height * OVERSCAN - 2);

      current = current === null ? target : current + (target - current) * LERP;
      const settled = Math.abs(target - current) < 0.05;
      if (settled) current = target;

      bg.style.transform = `translate3d(0,${current.toFixed(2)}px,0)`;
      if (!settled) raf = requestAnimationFrame(tick);
    };

    const request = () => {
      if (!section.isConnected) return listeners.abort(); // section removed by the Theme Editor
      if (near && !raf) raf = requestAnimationFrame(tick);
    };

    section.classList.add('as-parallax');
    new IntersectionObserver(([entry]) => { near = entry.isIntersecting; request(); }, { rootMargin: '25% 0px' }).observe(inner);
    addEventListener('scroll', request, { passive: true, signal: listeners.signal });
    addEventListener('resize', request, { passive: true, signal: listeners.signal });
  };

  const init = (root = document) => {
    root.querySelectorAll('.about-solution:not(.as-anim)').forEach((section) => {
      const inner = section.querySelector('.about-solution__inner');
      const bg = section.querySelector('.about-solution__bg');
      section.classList.add('as-anim');

      new IntersectionObserver(([entry], io) => {
        if (!entry.isIntersecting) return;
        io.disconnect(); // plays once
        reveal(section);
      }, { threshold: 0.2, rootMargin: '0px 0px -8% 0px' }).observe(inner);

      if (bg) parallax(section, inner, bg);
    });
  };

  init();
  document.addEventListener('shopify:section:load', (e) => init(e.target)); // Theme Editor re-render
})();
</script>