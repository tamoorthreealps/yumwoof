{{ 'css--about-solution.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign s = section.settings
  assign uid = section.id
  assign scrim = s.scrim_opacity | divided_by: 100.0
-%}

{%- style -%}
  {%- if s.bg_image != blank -%}
    #about-solution-{{ uid }} .about-solution__bg {
      background-image: url("{{ s.bg_image | image_url: width: 1600 }}");
      display:inherit !important;
    }
  {%- endif -%}
{%- endstyle -%}

<section
  class="about-solution"
  id="about-solution-{{ uid }}"
  style="
    --as-bg: {{ s.color_bg }};
    --as-text: {{ s.color_text }};
    --as-scrim: {{ scrim }};
    --as-min-height: {{ s.min_height }}px;
    --as-min-height-mobile: {{ s.min_height_mobile }}px;
    --as-pad-top: {{ s.padding_top }}px;
    --as-pad-bottom: {{ s.padding_bottom }}px;
    --as-pad-top-mobile: {{ s.padding_top_mobile }}px;
    --as-pad-bottom-mobile: {{ s.padding_bottom_mobile }}px;
  "
>
  <div class="about-solution__inner">
    {%- if s.bg_image != blank -%}
      <div class="about-solution__bg" aria-hidden="true"></div>
      <div class="about-solution__scrim" aria-hidden="true"></div>
    {%- endif -%}

    <div class="about-solution__content">
      {%- if s.heading != blank -%}
        <h2 class="about-solution__heading">{{ s.heading }}</h2>
      {%- endif -%}
      {%- if s.body != blank -%}
        <div class="about-solution__body">{{ s.body }}</div>
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "About Solution",
  "tag": "section",
  "class": "about-solution-section",
  "settings": [
    { "type": "header", "content": "Content" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "We designed the food we couldn't find." },
    { "type": "richtext", "id": "body", "label": "Body", "default": "<p>Like many pet parents, we wanted food we could trust. What began as a personal search for better nutrition eventually led us to develop some of the first air-dried recipes of their kind, publish a book on canine nutrition, build relationships with trusted farmers, ranchers, and fishermen, and serve millions of meals to dogs through better food.</p>" },

    { "type": "header", "content": "Background" },
    { "type": "color", "id": "color_bg", "label": "Background color", "default": "#0d0d0d" },
    { "type": "color", "id": "color_text", "label": "Text color", "default": "#fff9ef" },
    { "type": "image_picker", "id": "bg_image", "label": "Background image (optional)" },
    { "type": "range", "id": "scrim_opacity", "label": "Scrim strength", "min": 0, "max": 100, "step": 5, "unit": "%", "default": 55, "info": "Darkens the image so the light text stays legible." },

    { "type": "header", "content": "Layout" },
    { "type": "range", "id": "min_height", "label": "Min height (desktop)", "min": 320, "max": 1000, "step": 8, "unit": "px", "default": 744 },
    { "type": "range", "id": "min_height_mobile", "label": "Min height (mobile)", "min": 320, "max": 1000, "step": 8, "unit": "px", "default": 560 },
    { "type": "range", "id": "padding_top", "label": "Padding top (desktop)", "min": 0, "max": 240, "step": 4, "unit": "px", "default": 124 },
    { "type": "range", "id": "padding_bottom", "label": "Padding bottom (desktop)", "min": 0, "max": 240, "step": 4, "unit": "px", "default": 124 },
    { "type": "range", "id": "padding_top_mobile", "label": "Padding top (mobile)", "min": 0, "max": 200, "step": 4, "unit": "px", "default": 72 },
    { "type": "range", "id": "padding_bottom_mobile", "label": "Padding bottom (mobile)", "min": 0, "max": 200, "step": 4, "unit": "px", "default": 72 }
  ],
  "presets": [{ "name": "About Solution" }]
}
{% endschema %}



<script>
  /* ==========================================================================
   About — Solution : motion
   - Masked line-by-line heading reveal + delayed body (IntersectionObserver,
     plays once per section)
   - Lerped translate3d parallax on .about-solution__bg (rAF, runs only while
     the section is near the viewport)
   - prefers-reduced-motion: does nothing, section stays static
   - Theme Editor safe: re-inits on shopify:section:load, tears down on unload
   ========================================================================== */
(function () {
  'use strict';

  if (window.__aboutSolutionMotion) return;
  window.__aboutSolutionMotion = true;

  var SELECTOR = '.about-solution';
  var OVERSCAN = 0.18;      // must match `inset: -18% 0` in the CSS
  var LERP = 0.085;         // lower = heavier, more cinematic lag
  var LINE_STAGGER = 0.15;  // seconds, mirrors --as-line-stagger
  var LINE_DUR = 1.9;       // seconds, mirrors --as-line-dur
  var BODY_DUR = 1.7;       // seconds, mirrors --as-body-dur

  var reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
  var instances = new WeakMap();

  function AboutSolution(section) {
    this.section = section;
    this.inner = section.querySelector('.about-solution__inner');
    this.bg = section.querySelector('.about-solution__bg');
    this.heading = section.querySelector('.about-solution__heading');
    this.body = section.querySelector('.about-solution__body');

    this.destroyed = false;
    this.revealed = false;
    this.originalHeading = this.heading ? this.heading.textContent : '';
    this.timers = [];

    // parallax state
    this.current = 0;
    this.target = 0;
    this.primed = false;
    this.rafId = 0;
    this.near = false;
    this.tick = this.tick.bind(this);

    section.classList.add('as-anim');
    this.observeReveal();
    if (this.bg && this.inner) this.setupParallax();
  }

  /* ---------------------------------------------------------------- reveal */

  AboutSolution.prototype.observeReveal = function () {
    var self = this;
    this.revealIO = new IntersectionObserver(function (entries) {
      for (var i = 0; i < entries.length; i++) {
        if (entries[i].isIntersecting) {
          self.revealIO.disconnect();
          self.reveal();
          break;
        }
      }
    }, { threshold: 0.2, rootMargin: '0px 0px -8% 0px' });
    this.revealIO.observe(this.inner || this.section);
  };

  AboutSolution.prototype.reveal = function () {
    if (this.revealed || this.destroyed) return;
    this.revealed = true;
    var self = this;

    // Line breaks depend on TAYRosemary being loaded — wait for it (max 1.2s)
    var fontsReady = (document.fonts && document.fonts.ready) ? document.fonts.ready : Promise.resolve();
    var timeout = new Promise(function (resolve) { self.timers.push(setTimeout(resolve, 1200)); });

    Promise.race([fontsReady, timeout]).then(function () {
      if (self.destroyed) return;

      var lines = self.heading ? self.splitHeading() : 0;
      var bodyDelay = lines ? (lines - 1) * LINE_STAGGER + 0.45 : 0.1;
      self.section.style.setProperty('--as-body-delay', bodyDelay.toFixed(2) + 's');

      // Commit the hidden start state, then flip on the next frame
      void self.section.offsetWidth;
      requestAnimationFrame(function () {
        requestAnimationFrame(function () {
          if (self.destroyed) return;
          self.section.classList.add('as-in');
        });
      });

      var headingEnd = lines ? ((lines - 1) * LINE_STAGGER + LINE_DUR) : 0;
      var total = Math.max(headingEnd, bodyDelay + BODY_DUR) * 1000 + 200;
      self.timers.push(setTimeout(function () { self.finish(); }, total));
    });
  };

  // Wrap each rendered line in a mask so lines can rise independently.
  // Returns the number of lines.
  AboutSolution.prototype.splitHeading = function () {
    var h = this.heading;
    var words = this.originalHeading.trim().split(/\s+/).filter(Boolean);
    if (!words.length) return 0;

    // 1) measure: one inline-block span per word
    var frag = document.createDocumentFragment();
    var spans = words.map(function (w, i) {
      var s = document.createElement('span');
      s.style.display = 'inline-block';
      s.textContent = w;
      frag.appendChild(s);
      if (i < words.length - 1) frag.appendChild(document.createTextNode(' '));
      return s;
    });
    h.textContent = '';
    h.appendChild(frag);

    var lines = [];
    var lastTop = null;
    spans.forEach(function (s) {
      var top = s.offsetTop;
      if (lastTop === null || Math.abs(top - lastTop) > 2) { lines.push([]); lastTop = top; }
      lines[lines.length - 1].push(s.textContent);
    });

    // 2) rebuild as masked lines
    var out = document.createDocumentFragment();
    lines.forEach(function (lineWords, i) {
      var outer = document.createElement('span');
      outer.className = 'as-line';
      var innerEl = document.createElement('span');
      innerEl.className = 'as-line__inner';
      innerEl.style.setProperty('--as-i', i);
      innerEl.textContent = lineWords.join(' ');
      outer.appendChild(innerEl);
      out.appendChild(outer);
      out.appendChild(document.createTextNode(' '));
    });
    h.textContent = '';
    h.appendChild(out);
    h.classList.add('as-split');
    return lines.length;
  };

  // Restore the untouched heading so it reflows naturally on resize
  AboutSolution.prototype.finish = function () {
    if (this.destroyed) return;
    this.section.classList.add('as-done');
    if (this.heading && this.heading.classList.contains('as-split')) {
      this.heading.classList.remove('as-split');
      this.heading.textContent = this.originalHeading;
    }
  };

  /* -------------------------------------------------------------- parallax */

  AboutSolution.prototype.setupParallax = function () {
    var self = this;
    this.section.classList.add('as-parallax');

    this.nearIO = new IntersectionObserver(function (entries) {
      self.near = entries[entries.length - 1].isIntersecting;
      if (self.near) self.start();
    }, { rootMargin: '25% 0px 25% 0px' });
    this.nearIO.observe(this.inner);

    this.onScroll = function () { if (self.near) self.start(); };
    window.addEventListener('scroll', this.onScroll, { passive: true });
    window.addEventListener('resize', this.onScroll, { passive: true });
  };

  AboutSolution.prototype.start = function () {
    if (!this.rafId && !this.destroyed) this.rafId = requestAnimationFrame(this.tick);
  };

  AboutSolution.prototype.tick = function () {
    this.rafId = 0;
    if (this.destroyed) return;

    // single layout read per frame, no writes before it
    var rect = this.inner.getBoundingClientRect();
    var vh = window.innerHeight || document.documentElement.clientHeight;

    // progress: +1 section just below viewport, 0 centred, -1 just above
    var progress = ((rect.top + rect.height / 2) - vh / 2) / ((vh + rect.height) / 2);
    if (progress > 1) progress = 1; else if (progress < -1) progress = -1;

    var maxShift = Math.max(0, rect.height * OVERSCAN - 2);
    // image drifts against the section's travel => reads as being further away
    this.target = -progress * maxShift;

    if (!this.primed) { this.current = this.target; this.primed = true; }
    else { this.current += (this.target - this.current) * LERP; }

    var settled = Math.abs(this.target - this.current) < 0.05;
    if (settled) this.current = this.target;

    this.bg.style.transform = 'translate3d(0,' + this.current.toFixed(2) + 'px,0)';

    if (!settled) this.rafId = requestAnimationFrame(this.tick);
  };

  /* --------------------------------------------------------------- teardown */

  AboutSolution.prototype.destroy = function () {
    this.destroyed = true;
    if (this.revealIO) this.revealIO.disconnect();
    if (this.nearIO) this.nearIO.disconnect();
    if (this.rafId) cancelAnimationFrame(this.rafId);
    this.timers.forEach(clearTimeout);
    if (this.onScroll) {
      window.removeEventListener('scroll', this.onScroll);
      window.removeEventListener('resize', this.onScroll);
    }
    if (this.heading && this.heading.classList.contains('as-split')) {
      this.heading.classList.remove('as-split');
      this.heading.textContent = this.originalHeading;
    }
    if (this.bg) this.bg.style.transform = '';
    this.section.classList.remove('as-anim', 'as-parallax', 'as-in', 'as-done');
  };

  /* ------------------------------------------------------------------ boot */

  function init(root) {
    if (reduceMotion.matches || !('IntersectionObserver' in window)) return;
    var nodes = (root || document).querySelectorAll(SELECTOR);
    for (var i = 0; i < nodes.length; i++) {
      if (!instances.has(nodes[i])) instances.set(nodes[i], new AboutSolution(nodes[i]));
    }
  }

  function destroy(root) {
    var nodes = (root || document).querySelectorAll(SELECTOR);
    for (var i = 0; i < nodes.length; i++) {
      var inst = instances.get(nodes[i]);
      if (inst) { inst.destroy(); instances.delete(nodes[i]); }
    }
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', function () { init(); });
  } else {
    init();
  }

  // Shopify Theme Editor
  document.addEventListener('shopify:section:load', function (e) { init(e.target); });
  document.addEventListener('shopify:section:unload', function (e) { destroy(e.target); });

  // Respect a live change of the OS motion setting
  var onMotionChange = function () { if (reduceMotion.matches) destroy(); else init(); };
  if (reduceMotion.addEventListener) reduceMotion.addEventListener('change', onMotionChange);
  else if (reduceMotion.addListener) reduceMotion.addListener(onMotionChange);
})();
</script>