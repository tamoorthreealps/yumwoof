{% comment %}theme-check-disable UndefinedObject{% endcomment %}
{{ 'css--footer.css' | asset_url | stylesheet_tag }}
{{ 'component-list-social.css' | asset_url | stylesheet_tag }}

{%- style -%}
  #shopify-section-{{ section.id }} .yf {
    --yf-bg: {{ section.settings.footer_bg | default: '#661D1D' }};
    --yf-text: {{ section.settings.footer_text | default: '#FFF9EF' }};

    {% if section.settings.footer_bg_image_desktop != blank %}
      background-image: url({{ section.settings.footer_bg_image_desktop | image_url: width: 2400 }});
      background-repeat: no-repeat;
      background-size: 100% 100%;
      background-position: center;
    {% endif %}
  }

  @media screen and (max-width: 989px) {
    #shopify-section-{{ section.id }} .yf {
      {% if section.settings.footer_bg_image_mobile != blank %}
        background-image: url({{ section.settings.footer_bg_image_mobile | image_url: width: 1200 }});
        background-repeat: no-repeat;
        background-size: 100% 100%;
        background-position: center;
      {% elsif section.settings.footer_bg_image_desktop != blank %}
        background-image: url({{ section.settings.footer_bg_image_desktop | image_url: width: 1200 }});
      {% endif %}
    }
  }
{%- endstyle -%}

{%- liquid
  assign marquee_text = section.settings.marquee_text | default: 'Gorgeous dogs eat Yumwoof.'
  assign klaviyo_form_class = section.settings.klaviyo_form_class | default: 'klaviyo-form-Ry6Yff' | strip
  assign show_currency = false
  if section.settings.enable_country_selector and localization.available_countries.size > 1
    assign show_currency = true
  endif
-%}

<footer class="yf" data-yf>
  {%- comment -%} ===== MARQUEE (full-bleed running text) ===== {%- endcomment -%}
  {%- if marquee_text != blank -%}
    <div class="yf__marquee desktop--yf__marquee" data-yf-marquee aria-hidden="true">
      <div class="yf__marquee-row" data-speed="{{ section.settings.marquee_speed | default: 60 }}">
        <div class="yf__marquee-track">
          {%- for i in (1..4) -%}
            <span class="yf__marquee-item">{{ marquee_text }}</span>
          {%- endfor -%}
        </div>
      </div>
    </div>
  {%- endif -%}

  <div class="yf__main yf__page">
    {%- comment -%} ===== SIGNUP (Klaviyo renders the eyebrow + heading + quiz + email) ===== {%- endcomment -%}
    <div class="yf__main__left">
      <div class="yf__signup">
        {%- if klaviyo_form_class != blank -%}
          <div class="yf__signup-form">
            <div class="{{ klaviyo_form_class }}"></div>
          </div>
        {%- endif -%}
        <div class="yf__signup__footer">
          <p class="yf__signup__footer_content">
            By signing up to receive emails from Yumwoof, you agree to our
            <a href="/pages/privacy-policy" target="_blank">Privacy Policy</a>. We treat your info responsibly.
          </p>
        </div>
      </div>

      {%- comment -%} ===== MARQUEE (full-bleed running text) ===== {%- endcomment -%}
      {%- if marquee_text != blank -%}
        <div class="yf__marquee mobile--yf__marquee" data-yf-marquee aria-hidden="true">
          <div class="yf__marquee-row" data-speed="{{ section.settings.marquee_speed | default: 60 }}">
            <div class="yf__marquee-track">
              {%- for i in (1..4) -%}
                <span class="yf__marquee-item">{{ marquee_text }}</span>
              {%- endfor -%}
            </div>
          </div>
        </div>
      {%- endif -%}
      {%- comment -%} ===== BADGE ===== {%- endcomment -%}
      {%- if section.settings.badge_image != blank -%}
        <div class="yf__badge" style="--yf-badge-w: {{ section.settings.badge_width | default: 220 }}px;" data-yf-badge>
          <div class="yf__badge-inner">
            {%- assign badge_alt = section.settings.badge_image.alt | default: shop.name | escape -%}
            {{
              section.settings.badge_image
              | image_url: width: 640
              | image_tag: widths: '220, 320, 440, 640', alt: badge_alt, loading: 'lazy'
            }}
          </div>
        </div>
      {%- endif -%}
    </div>

    <div class="yf__main__right">
      {%- comment -%} ===== SHOP (accordion on mobile, column on desktop) ===== {%- endcomment -%}
      <div class="yf-disc yf__col--shop" open>
        <div class="yf-disc__div">
          <span class="yf__heading">{{ section.settings.shop_heading | default: 'Shop' }}</span>
          <span class="yf-disc__icon" aria-hidden="true"></span>
        </div>
        <div class="yf-disc__panel">
          {%- if section.settings.shop_menu != blank -%}
            <ul class="yf__list" role="list">
              {%- for link in section.settings.shop_menu.links -%}
                <li>
                  <a href="{{ link.url }}">{{ link.title | escape }}</a>
                </li>
              {%- endfor -%}
            </ul>
          {%- endif -%}
        </div>
      </div>

      {%- comment -%} ===== EXPLORE ===== {%- endcomment -%}
      <div class="yf-disc yf__col--explore" open data-collapse-mobile>
        <div class="yf-disc__div">
          <span class="yf__heading">{{ section.settings.explore_heading | default: 'Explore' }}</span>
          <span class="yf-disc__icon" aria-hidden="true"></span>
        </div>
        <div class="yf-disc__panel">
          {%- if section.settings.explore_menu != blank -%}
            <ul class="yf__list" role="list">
              {%- for link in section.settings.explore_menu.links -%}
                <li>
                  <a href="{{ link.url }}">{{ link.title | escape }}</a>
                </li>
              {%- endfor -%}
            </ul>
          {%- endif -%}
        </div>
      </div>

      {%- comment -%} ===== LEGAL (mobile-only accordion; desktop shows policies in the bottom bar) ===== {%- endcomment -%}
      <div class="yf-disc yf__col--legal" open data-collapse-mobile>
        <div class="yf-disc__div">
          <span class="yf__heading">{{ section.settings.legal_heading | default: 'Legal' }}</span>
          <span class="yf-disc__icon" aria-hidden="true"></span>
        </div>
        <div class="yf-disc__panel">
          <ul class="yf__list" role="list">
            {%- if section.settings.legal_menu != blank -%}
              {%- for link in section.settings.legal_menu.links -%}
                <li>
                  <a href="{{ link.url }}">{{ link.title | escape }}</a>
                </li>
              {%- endfor -%}
            {%- else -%}
              {%- for policy in shop.policies -%}
                {%- if policy != blank -%}
                  <li>
                    <a href="{{ policy.url }}">{{ policy.title | escape }}</a>
                  </li>
                {%- endif -%}
              {%- endfor -%}
            {%- endif -%}
          </ul>
        </div>
      </div>
      {%- comment -%} ===== QUESTIONS ===== {%- endcomment -%}
      <div class="yf__questions">
        <h2 class="yf__heading">{{ section.settings.questions_heading | default: 'Questions?' }}</h2>
        <ul class="yf__questions-list" role="list">
          {%- if section.settings.live_chat_label != blank -%}
            <li>
              <a
                class="yf__questions-link live-chat"
                href="{{ section.settings.live_chat_url | default: 'javascript:void(0);' }}"
                onclick="GorgiasChat.open()"
              >
                {{- section.settings.live_chat_label }} &rarr;
              </a>
            </li>
          {%- endif -%}
          {%- if section.settings.contact_email != blank -%}
            <li>
              <a class="yf__questions-link" href="mailto:{{ section.settings.contact_email }}">
                {{- section.settings.contact_email -}}
              </a>
            </li>
          {%- endif -%}
          {%- if section.settings.phone_label != blank -%}
            {%- assign tel = section.settings.phone_url | default: section.settings.phone_label -%}
            <li>
              <a
                class="yf__questions-link"
                href="tel:{{ tel | remove: ' ' | remove: '(' | remove: ')' | remove: '-' }}"
              >
                {{- section.settings.phone_label -}}
              </a>
            </li>
          {%- endif -%}
          {%- if section.settings.hours != blank -%}
            <li class="yf__muted">{{ section.settings.hours }}</li>
          {%- endif -%}
        </ul>
      </div>
      {%- comment -%} ===== DOGQUARTERS (addresses) ===== {%- endcomment -%}
      <div class="yf__dogquarters">
        <h2 class="yf__heading">{{ section.settings.dogquarters_heading | default: 'Dogquarters' }}</h2>
        <div class="yf__addresses">
          {%- if section.settings.address_1 != blank -%}
            <div>
              {%- if section.settings.address_1_label != blank -%}
                <p class="yf__address-label">{{ section.settings.address_1_label }}</p>
              {%- endif -%}
              <div class="yf__address rte">{{ section.settings.address_1 }}</div>
            </div>
          {%- endif -%}
          {%- if section.settings.address_2 != blank -%}
            <div>
              {%- if section.settings.address_2_label != blank -%}
                <p class="yf__address-label">{{ section.settings.address_2_label }}</p>
              {%- endif -%}
              <div class="yf__address rte">{{ section.settings.address_2 }}</div>
            </div>
          {%- endif -%}
        </div>
      </div>

      {%- comment -%} ===== SOCIAL ===== {%- endcomment -%}
      {%- if section.settings.show_social -%}
        <div class="yf__social">
          {%- if section.settings.social_heading != blank -%}
            <h2 class="yf__heading">{{ section.settings.social_heading }}</h2>
          {%- endif -%}
          {%- render 'social-icons' -%}
        </div>
      {%- endif -%}

      {%- comment -%} ===== CURRENCY ===== {%- endcomment -%}
      {%- if show_currency -%}
        <div class="yf__currency">
          <localization-form>
            {%- form 'localization', id: 'FooterCountryForm', class: 'localization-form' -%}
              {%- render 'country-localization', localPosition: 'FooterCountry' -%}
            {%- endform -%}
          </localization-form>
        </div>
      {%- endif -%}
    </div>
  </div>
  {%- comment -%} ===== BOTTOM BAR ===== {%- endcomment -%}
  <div class="yf__bottom">
    <div class="yf__page yf__bottom-inner">
      <small class="yf__copyright">
        &copy; {{ 'now' | date: '%Y' }}
        {{ section.settings.copyright_name | default: shop.name | escape }}
      </small>
      {%- if section.settings.show_policy -%}
        <ul class="yf__bottom-policies" role="list">
          {%- if section.settings.legal_menu != blank -%}
            {%- for link in section.settings.legal_menu.links -%}
              <li>
                <a href="{{ link.url }}">{{ link.title | escape }}</a>
              </li>
            {%- endfor -%}
          {%- else -%}
            {%- for policy in shop.policies -%}
              {%- if policy != blank -%}
                <li>
                  <a href="{{ policy.url }}">{{ policy.title | escape }}</a>
                </li>
              {%- endif -%}
            {%- endfor -%}
          {%- endif -%}
        </ul>
      {%- endif -%}
      {%- if section.settings.site_credit_label != blank -%}
        <span class="yf__site-credit-wrap">
          <a class="yf__site-credit" href="{{ section.settings.site_credit_url | default: '#' }}" target="_blank">
            {{- section.settings.site_credit_label -}}
          </a>

          <span
            class="yf__site-credit-tooltip"
            style="
              --tooltip-bg: {{ section.settings.site_credit_tooltip_bg }};
              --tooltip-text: {{ section.settings.site_credit_tooltip_text }};
              --tooltip-icon: {{ section.settings.site_credit_tooltip_icon }};
            "
          >
            <span class="yf__site-credit-tooltip-icon">
              <svg width="25" height="24" viewBox="0 0 25 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                <path d="M24.3001 16.3579H17.8254L12.1469 8.71583L6.47328 16.3579H0L12.1469 0L24.3001 16.3579Z" fill="currentColor"/>
                <path d="M17.8254 16.3579L12.1519 24L6.47328 16.3579H17.8254Z" fill="currentColor"/>
              </svg>
            </span>

            Built by <span>ThreeAlps</span>
          </span>
        </span>
      {%- endif -%}
    </div>
  </div>
</footer>

<script>
  (function () {
    var reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    function initMarquee(row) {
      var track = row.querySelector('.yf__marquee-track');
      if (!track || row.dataset.marqueeReady) return;
      var speed = parseFloat(row.dataset.speed) || 60; // px per second
      var width = track.getBoundingClientRect().width;
      if (width === 0) return;
      // Duplicate the track so the translateX(-50%) loop is seamless.
      var clone = track.cloneNode(true);
      clone.setAttribute('aria-hidden', 'true');
      row.appendChild(clone);
      row.style.setProperty('--yf-marquee-duration', width / speed + 's');
      row.dataset.marqueeReady = 'true';
    }

    function initMarqueeRoot(root) {
      if (reduceMotion) return;
      root.querySelectorAll('.yf__marquee-row').forEach(initMarquee);
    }

    // Accordions: expanded columns on desktop, collapsed (except Shop) on mobile.
    // Open state is the .is-open class; CSS animates grid-template-rows 0fr -> 1fr.
    var mqMobile = window.matchMedia('(max-width: 989px)');

    function syncDisc() {
      var mobile = mqMobile.matches;
      document.querySelectorAll('.yf-disc').forEach(function (d) {
        if (!mobile) {
          d.classList.add('is-open'); // desktop: always expanded
        } else if (d.hasAttribute('data-collapse-mobile')) {
          d.classList.remove('is-open'); // Explore / Legal start closed
        } else {
          d.classList.add('is-open'); // Shop starts open
        }
      });
    }

    // One open at a time; tapping an open header collapses it.
    document.addEventListener('click', function (e) {
      if (!mqMobile.matches) return;
      var head = e.target.closest('.yf-disc__div');
      if (!head) return;
      var disc = head.parentElement;
      var wasOpen = disc.classList.contains('is-open');
      document.querySelectorAll('.yf-disc.is-open').forEach(function (d) {
        d.classList.remove('is-open');
      });
      if (!wasOpen) disc.classList.add('is-open');
    });

    function init(root) {
      initMarqueeRoot(root);
      syncDisc();
    }

    if (document.readyState !== 'loading') {
      init(document);
    } else {
      document.addEventListener('DOMContentLoaded', function () {
        init(document);
      });
    }
    if (mqMobile.addEventListener) {
      mqMobile.addEventListener('change', syncDisc);
    } else if (mqMobile.addListener) {
      mqMobile.addListener(syncDisc);
    }
    document.addEventListener('shopify:section:load', function (event) {
      init(event.target);
    });
  })();

  (function () {
    const badge = document.querySelector('[data-yf-badge]');
    if (!badge) return;
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;

    const img = badge.querySelector('img');
    const SHIFT = 80; // px of travel, top→bottom of viewport
    const TILT = 15; // degrees of rotation across that same range
    let ticking = false;

    // --- Reveal in from the bottom ---
    const io = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (!entry.isIntersecting) return;
          badge.style.setProperty('--yf-badge-in', '1');
          io.unobserve(entry.target);
        });
      },
      { threshold: 0.2, rootMargin: '0px 0px -10% 0px' }
    );
    io.observe(badge);

    // --- Parallax + rotation ---
    function update() {
      ticking = false;
      const rect = badge.getBoundingClientRect();
      const vh = window.innerHeight || document.documentElement.clientHeight;

      // Skip work when off-screen.
      if (rect.bottom < -200 || rect.top > vh + 200) return;

      // progress: 1 when the badge centre is at the bottom of the viewport,
      // -1 when it's at the top. 0 = dead centre.
      const centre = rect.top + rect.height / 2;
      const progress = Math.max(-1, Math.min(1, (centre - vh / 2) / (vh / 2)));

      img.style.setProperty('--yf-badge-y', (progress * SHIFT).toFixed(2) + 'px');
      img.style.setProperty('--yf-badge-rot', (progress * TILT).toFixed(2) + 'deg');
    }

    function onScroll() {
      if (ticking) return;
      ticking = true;
      requestAnimationFrame(update);
    }

    window.addEventListener('scroll', onScroll, { passive: true });
    window.addEventListener('resize', onScroll, { passive: true });
    update();
  })();
</script>

