{{ 'css--about-cta.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign s = section.settings
  assign uid = section.id
  assign scrim = s.scrim_opacity | divided_by: 100.0
-%}

{%- style -%}
  {%- if s.bg_image != blank -%}
    #about-cta-{{ uid }} .about-cta__bg {
      background-image: url("{{ s.bg_image | image_url: width: 1600 }}");
      display:inherit !important;
    }
  {%- endif -%}
{%- endstyle -%}

<section
  class="about-cta"
  id="about-cta-{{ uid }}"
  style="
    --ac-bg: {{ s.color_bg }};
    --ac-text: {{ s.color_text }};
    --ac-scrim: {{ scrim }};
    --ac-min-height: {{ s.min_height }}px;
    --ac-min-height-mobile: {{ s.min_height_mobile }}px;
    --ac-button-bg: {{ s.color_button_bg }};
    --ac-button-text: {{ s.color_button_text }};
    --ac-button-border: {{ s.color_button_border }};
    --ac-button-hover-bg: {{ s.color_button_hover_bg }};
    --ac-button-hover-text: {{ s.color_button_hover_text }};
    --ac-pad-top: {{ s.padding_top }}px;
    --ac-pad-bottom: {{ s.padding_bottom }}px;
    --ac-pad-top-mobile: {{ s.padding_top_mobile }}px;
    --ac-pad-bottom-mobile: {{ s.padding_bottom_mobile }}px;
    --ac-wash-top: {{ s.color_wash_top }};
    --ac-wash-bottom: {{ s.color_wash_bottom }};
    --ac-wash-pt: {{ s.wash_pad_top }}px;
    --ac-wash-pb: {{ s.wash_pad_bottom }}px;
    --ac-wash-pt-m: {{ s.wash_pad_top_mobile }}px;
    --ac-wash-pb-m: {{ s.wash_pad_bottom_mobile }}px;
  "
>
  <div class="about-cta__inner">
    {%- if s.bg_image != blank -%}
      <div class="about-cta__bg" aria-hidden="true"></div>
      <div class="about-cta__scrim" aria-hidden="true"></div>
    {%- endif -%}

    {%- if s.heading != blank -%}
      <h2 class="about-cta__heading">{{ s.heading }}</h2>
    {%- endif -%}

    {%- if s.body != blank -%}
      <div class="about-cta__body">{{ s.body }}</div>
    {%- endif -%}

    {%- if s.button_text != blank -%}
      <a class="about-cta__button" href="{{ s.button_url | default: '#' }}">{{ s.button_text | escape }}</a>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "About CTA",
  "tag": "section",
  "class": "about-cta-section",
  "settings": [
    { "type": "header", "content": "Content" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Feed them well." },
    { "type": "richtext", "id": "body", "label": "Body", "default": "<p>Millions of meals later, our mission remains the same: create food we would proudly feed our own dog every day.</p>" },

    { "type": "header", "content": "Button" },
    { "type": "text", "id": "button_text", "label": "Button text", "default": "Shop Air-Dried Food" },
    { "type": "url", "id": "button_url", "label": "Button link" },

    { "type": "header", "content": "Background" },
    { "type": "color", "id": "color_bg", "label": "Background color", "default": "#0d0d0d" },
    { "type": "color", "id": "color_text", "label": "Text color", "default": "#fff9ef" },
    { "type": "image_picker", "id": "bg_image", "label": "Background image (optional)" },
    { "type": "range", "id": "scrim_opacity", "label": "Scrim strength", "min": 0, "max": 100, "step": 5, "unit": "%", "default": 45 },

    { "type": "header", "content": "Background wash", "info": "Full-width gradient behind the card. Set the top color to match the section above and the bottom color to match the footer so it blends across both." },
    { "type": "color", "id": "color_wash_top", "label": "Wash top color", "default": "#fff9ef" },
    { "type": "color", "id": "color_wash_bottom", "label": "Wash bottom color", "default": "#cfe0f4" },
    { "type": "range", "id": "wash_pad_top", "label": "Wash space above card (desktop)", "min": 0, "max": 320, "step": 4, "unit": "px", "default": 160 },
    { "type": "range", "id": "wash_pad_bottom", "label": "Wash space below card (desktop)", "min": 0, "max": 320, "step": 4, "unit": "px", "default": 120 },
    { "type": "range", "id": "wash_pad_top_mobile", "label": "Wash space above card (mobile)", "min": 0, "max": 240, "step": 4, "unit": "px", "default": 80 },
    { "type": "range", "id": "wash_pad_bottom_mobile", "label": "Wash space below card (mobile)", "min": 0, "max": 240, "step": 4, "unit": "px", "default": 72 },

    { "type": "header", "content": "Button colors" },
    { "type": "color", "id": "color_button_bg", "label": "Button background", "default": "#fff9ef" },
    { "type": "color", "id": "color_button_text", "label": "Button text", "default": "#0d0d0d" },
    { "type": "color", "id": "color_button_border", "label": "Button border", "default": "#fff9ef" },
    { "type": "color", "id": "color_button_hover_bg", "label": "Button background (hover)", "default": "#ffc069" },
    { "type": "color", "id": "color_button_hover_text", "label": "Button text (hover)", "default": "#0d0d0d" },

    { "type": "header", "content": "Layout" },
    { "type": "range", "id": "min_height", "label": "Min height (desktop)", "min": 320, "max": 1000, "step": 8, "unit": "px", "default": 688 },
    { "type": "range", "id": "min_height_mobile", "label": "Min height (mobile)", "min": 240, "max": 600, "step": 4, "unit": "px", "default": 532 },
    { "type": "range", "id": "padding_top", "label": "Padding top (desktop)", "min": 0, "max": 240, "step": 4, "unit": "px", "default": 96 },
    { "type": "range", "id": "padding_bottom", "label": "Padding bottom (desktop)", "min": 0, "max": 240, "step": 4, "unit": "px", "default": 96 },
    { "type": "range", "id": "padding_top_mobile", "label": "Padding top (mobile)", "min": 0, "max": 200, "step": 4, "unit": "px", "default": 56 },
    { "type": "range", "id": "padding_bottom_mobile", "label": "Padding bottom (mobile)", "min": 0, "max": 200, "step": 4, "unit": "px", "default": 56 }
  ],
  "presets": [{ "name": "About CTA" }]
}
{% endschema %}


<script>
  /* About page motion (shared by About Solution + About CTA):
     masked heading reveal + smooth background zoom */
  (() => {
    if (window.__aboutMotion) return;
    window.__aboutMotion = true;

    if (matchMedia('(prefers-reduced-motion: reduce)').matches || !('IntersectionObserver' in window)) return;

    const BLOCKS = ['about-solution', 'about-cta'];
    const STAGGER = 0.15, LINE_DUR = 1.9, BODY_DUR = 1.7;

    const el = (cls, children) => {
      const s = document.createElement('span');
      s.className = cls;
      s.append(...children);
      return s;
    };

    const splitLines = (heading) => {
      const words = heading.textContent.trim().split(/\s+/).map((w) => {
        const s = el('', [w]);
        s.style.display = 'inline-block';
        return s;
      });

      heading.replaceChildren(...words.flatMap((w) => [w, ' ']));

      const lines = [];
      let top = null;

      for (const w of words) {
        if (top === null || Math.abs(w.offsetTop - top) > 2) {
          lines.push([]);
          top = w.offsetTop;
        }
        lines[lines.length - 1].push(w.textContent);
      }

      heading.replaceChildren(...lines.flatMap((line, i) => {
        const inner = el('as-line__inner', [line.join(' ')]);
        inner.style.setProperty('--as-i', i);
        return [el('as-line', [inner]), ' '];
      }));

      heading.classList.add('as-split');
      return lines.length;
    };

    const reveal = async (section, block) => {
      const heading = section.querySelector(`.${block}__heading`);
      const text = heading && heading.textContent;

      await Promise.race([
        document.fonts ? document.fonts.ready : 0,
        new Promise((r) => setTimeout(r, 1200))
      ]);

      if (!section.isConnected) return;

      const lines = heading ? splitLines(heading) : 0;
      const bodyDelay = lines ? (lines - 1) * STAGGER + 0.45 : 0.1;

      section.style.setProperty(
        '--as-body-delay',
        `${bodyDelay.toFixed(2)}s`
      );

      section.style.setProperty(
        '--as-button-delay',
        `${(bodyDelay + 0.2).toFixed(2)}s`
      );

      requestAnimationFrame(() =>
        requestAnimationFrame(() =>
          section.classList.add('as-in')
        )
      );

      const total = Math.max(
        lines ? (lines - 1) * STAGGER + LINE_DUR : 0,
        bodyDelay + 0.2 + BODY_DUR
      );

      setTimeout(() => {
        section.classList.add('as-done');

        if (heading) {
          heading.classList.remove('as-split');
          heading.textContent = text;
        }
      }, total * 1000 + 200);
    };

    const zoom = (section, bg) => {
      section.classList.add('as-zoom');
    };

    const init = (root = document) => BLOCKS.forEach((block) => {
      root.querySelectorAll(`.${block}:not(.as-anim)`).forEach((section) => {
        const inner = section.querySelector(`.${block}__inner`);
        const bg = section.querySelector(`.${block}__bg`);

        section.classList.add('as-anim');

        new IntersectionObserver(([entry], io) => {
          if (!entry.isIntersecting) return;

          io.disconnect();
          reveal(section, block);
        }, {
          threshold: 0.2,
          rootMargin: '0px 0px -8% 0px'
        }).observe(inner);

        if (bg) zoom(section, bg);
      });
    });

    init();

    document.addEventListener(
      'shopify:section:load',
      (e) => init(e.target)
    );
  })();
</script>