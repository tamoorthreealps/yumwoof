{{ 'css--yw-membership-cta.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign s = section.settings
  assign uid = section.id

  comment
    Background images are emitted as CSS background-image only — never markup.
    The desktop rule is written ONLY when a desktop image exists, so the
    mobile image can never surface at desktop widths.
  endcomment

  assign has_desktop_bg = false
  if s.bg_image != blank
    assign has_desktop_bg = true
  endif

  assign mobile_bg = s.bg_image_mobile | default: s.bg_image
-%}

{%- style -%}
  {%- if has_desktop_bg -%}
    @media (min-width: 750px) {
      #ywcta-{{ uid }} .ywcta__bg {
        background-image: image-set(
          url("{{ s.bg_image | image_url: width: 1600 }}") 1x,
          url("{{ s.bg_image | image_url: width: 2400 }}") 1.5x
        );
        background-image: -webkit-image-set(
          url("{{ s.bg_image | image_url: width: 1600 }}") 1x,
          url("{{ s.bg_image | image_url: width: 2400 }}") 1.5x
        );
      }
    }
    @supports not (background-image: image-set(url("x") 1x)) {
      @media (min-width: 750px) {
        #ywcta-{{ uid }} .ywcta__bg {
          background-image: url("{{ s.bg_image | image_url: width: 2000 }}");
        }
      }
    }
  {%- endif -%}

  {%- if mobile_bg != blank -%}
    @media (max-width: 749px) {
      #ywcta-{{ uid }} .ywcta__bg {
        background-image: image-set(
          url("{{ mobile_bg | image_url: width: 800 }}") 1x,
          url("{{ mobile_bg | image_url: width: 1200 }}") 1.5x,
          url("{{ mobile_bg | image_url: width: 1600 }}") 2x
        );
        background-image: -webkit-image-set(
          url("{{ mobile_bg | image_url: width: 800 }}") 1x,
          url("{{ mobile_bg | image_url: width: 1200 }}") 1.5x,
          url("{{ mobile_bg | image_url: width: 1600 }}") 2x
        );
      }
    }
    @supports not (background-image: image-set(url("x") 1x)) {
      @media (max-width: 749px) {
        #ywcta-{{ uid }} .ywcta__bg {
          background-image: url("{{ mobile_bg | image_url: width: 1200 }}");
        }
      }
    }
  {%- endif -%}
{%- endstyle -%}

<section
  class="ywcta"
  id="ywcta-{{ uid }}"
  {% if s.heading != blank %}aria-labelledby="ywcta-heading-{{ uid }}"{% endif %}
  style="
    --ywcta-bg: {{ s.color_bg }};
    --ywcta-heading: {{ s.color_heading }};
    --ywcta-text: {{ s.color_text }};
    --ywcta-button-bg: {{ s.color_button_bg }};
    --ywcta-button-text: {{ s.color_button_text }};
    --ywcta-button-hover-bg: {{ s.color_button_hover_bg }};
    --ywcta-button-hover-text: {{ s.color_button_hover_text }};
    --ywcta-button-border: {{ s.color_button_border }};
    --ywcta-overlay: {{ s.color_overlay }};
    --ywcta-overlay-opacity: {{ s.overlay_opacity | divided_by: 100.0 }};
    --ywcta-button-radius: {{ s.button_radius }};
    --ywcta-height: {{ s.height_desktop }};
    --ywcta-height-mobile: {{ s.height_mobile }};
    --ywcta-position: {{ s.bg_position }};
    --ywcta-position-mobile: {{ s.bg_position_mobile }};
    --ywcta-max-width: {{ s.content_width }};
  "
>
  {%- comment -%} Decorative: CSS background only — no markup image, no alt. {%- endcomment -%}
  <div class="ywcta__bg" aria-hidden="true"></div>
  <div class="ywcta__overlay" aria-hidden="true"></div>

  <div class="ywcta__container ywcta__container--{{ s.content_align }}">

    {%- if s.heading != blank -%}
      <h2 class="ywcta__heading" id="ywcta-heading-{{ uid }}">{{ s.heading }}</h2>
    {%- endif -%}

    {%- if s.description != blank -%}
      <div class="ywcta__description">{{ s.description }}</div>
    {%- endif -%}

    {%- comment -%} ---------------- Add to cart (subscription aware, single purchase) ---------------- {%- endcomment -%}
    {%- liquid
      assign atc_product = s.product
      assign atc_variant = null
      assign atc_selling_plan = null
      assign atc_plan_required = false

      if atc_product != blank
        assign atc_variant = atc_product.selected_or_first_available_variant
      endif

      if atc_variant != blank
        assign atc_plan_required = atc_variant.requires_selling_plan

        if atc_variant.selling_plan_allocations.size > 0
          if s.selling_plan_id != blank
            for allocation in atc_variant.selling_plan_allocations
              if allocation.selling_plan.id == s.selling_plan_id
                assign atc_selling_plan = allocation.selling_plan
                break
              endif
            endfor
          endif

          if atc_selling_plan == null
            assign atc_selling_plan = atc_variant.selling_plan_allocations.first.selling_plan
          endif
        endif
      endif

      assign atc_blocked = false
      if atc_plan_required and atc_selling_plan == null
        assign atc_blocked = true
      endif

      comment
        Membership is a one-per-cart item. Match on product_id so switching
        variants can't slip a second membership into the cart.
      endcomment
      assign ywcta_in_cart = false
      if atc_product != blank
        for line in cart.items
          if line.product_id == atc_product.id
            assign ywcta_in_cart = true
            break
          endif
        endfor
      endif
    -%}

    {%- if atc_product != blank and atc_variant != blank -%}
      <div class="ywcta__button-wrap">
        <form
          method="post"
          action="{{ routes.cart_add_url }}"
          class="ywcta__form"
          data-ywcta-form
          data-cart-behavior="{{ s.cart_behavior }}"
          data-product-id="{{ atc_product.id }}"
        >
          <input type="hidden" name="form_type" value="product">
          <input type="hidden" name="utf8" value="✓">
          <input type="hidden" name="id" value="{{ atc_variant.id }}">
          <input type="hidden" name="quantity" value="{{ s.quantity }}">
          {%- if atc_selling_plan != null -%}
            <input type="hidden" name="selling_plan" value="{{ atc_selling_plan.id }}" data-ywcta-selling-plan>
          {%- endif -%}

          {%- if atc_selling_plan != null and s.show_plan_name -%}
            <p class="ywcta__plan-name">{{ atc_selling_plan.name | escape }}</p>
          {%- endif -%}

          <button
            type="submit"
            class="ywcta__button{% if ywcta_in_cart %} ywcta__button--in-cart{% endif %}"
            data-ywcta-in-cart="{% if ywcta_in_cart %}true{% else %}false{% endif %}"
            {% if atc_variant.available == false or atc_blocked %}
              disabled
            {% endif %}
          >
            <span>
              {%- if atc_variant.available == false -%}
                {{ s.sold_out_text | default: 'SOLD OUT' | escape }}
              {%- else -%}
                {{ s.button_text | default: 'ADD TO CART' | escape }}
              {%- endif -%}
            </span>
          </button>

          {%- if atc_blocked and request.design_mode -%}
            <p class="ywcta__form-error">
              This variant can only be purchased with a selling plan, but no plan is attached to it. Check the
              subscription app's plan group for this product.
            </p>
          {%- endif -%}

          <p class="ywcta__form-error" data-ywcta-error hidden></p>
        </form>
      </div>

    {%- elsif s.button_text != blank -%}
      {%- comment -%} No product selected — fall back to a plain link {%- endcomment -%}
      <div class="ywcta__button-wrap">
        <a class="ywcta__button" href="{{ s.button_url | default: '#' }}">
          <span>{{ s.button_text | escape }}</span>
        </a>
      </div>
    {%- endif -%}

    {%- if s.badge != blank -%}
      <div class="ywcta__badge">
        {{
          s.badge
          | image_url: width: 512
          | image_tag:
            loading: 'lazy',
            widths: '128, 180, 256, 360, 512',
            sizes: '(max-width: 749px) 62px, 128px',
            class: 'ywcta__badge-image',
            alt: s.badge.alt | default: ''
        }}
      </div>
    {%- endif -%}

  </div>
</section>

<script>
  (function () {
    function getDrawer() {
      return document.querySelector('cart-drawer');
    }

    function getDrawerSectionId() {
      var el = document.getElementById('CartDrawer-SectionId');
      return el ? el.dataset.sectionId : 'cart-drawer';
    }

    function openDrawer() {
      var drawer = getDrawer();
      if (drawer && typeof drawer.open === 'function') {
        drawer.open();
        return true;
      }
      var toggle = document.querySelector('#cart-icon-bubble, a[href$="/cart"]');
      if (toggle) {
        toggle.click();
        return true;
      }
      return false;
    }

    function setButtonState(form, inCart) {
      var button = form.querySelector('.ywcta__button');
      if (!button) return;
      // State only — the label text never changes.
      button.dataset.ywctaInCart = inCart ? 'true' : 'false';
      button.classList.toggle('ywcta__button--in-cart', inCart);
    }

    // Check the live cart rather than trusting the server-rendered flag —
    // the customer may have removed the item from the drawer since page load.
    function isAlreadyInCart(productId) {
      return fetch(window.Shopify.routes.root + 'cart.js', {
        headers: { Accept: 'application/json' },
        cache: 'no-store',
      })
        .then(function (res) {
          return res.json();
        })
        .then(function (cart) {
          return (cart.items || []).some(function (line) {
            return String(line.product_id) === String(productId);
          });
        })
        .catch(function () {
          return false;
        });
    }

    function initYwctaForm(root) {
      root.querySelectorAll('[data-ywcta-form]').forEach(function (form) {
        if (form.dataset.ywctaBound) return;
        form.dataset.ywctaBound = 'true';

        form.addEventListener('submit', function (event) {
          event.preventDefault();

          var behavior = form.dataset.cartBehavior || 'drawer';
          var button = form.querySelector('.ywcta__button');
          var errorEl = form.querySelector('[data-ywcta-error]');
          if (errorEl) {
            errorEl.hidden = true;
            errorEl.textContent = '';
          }
          if (button) {
            button.setAttribute('aria-busy', 'true');
            button.disabled = true;
          }

          function release() {
            if (button) {
              button.removeAttribute('aria-busy');
              button.disabled = false;
            }
          }

          isAlreadyInCart(form.dataset.productId).then(function (inCart) {
            if (inCart) {
              setButtonState(form, true);
              release();
              if (!openDrawer()) {
                window.location.href = window.Shopify.routes.root + 'cart';
              }
              return;
            }

            setButtonState(form, false);

            if (behavior === 'cart') {
              form.submit();
              return;
            }

            var drawer = getDrawer();
            var planInput = form.querySelector('[data-ywcta-selling-plan]');

            var item = {
              id: Number(form.querySelector('input[name="id"]').value),
              quantity: Number(form.querySelector('input[name="quantity"]').value || 1),
            };
            if (planInput && planInput.value) {
              item.selling_plan = Number(planInput.value);
            }

            var payload = { items: [item] };

            // Ask Shopify to re-render the drawer sections in the same request,
            // otherwise the drawer keeps its stale markup until a reload.
            var sectionIds = [];
            if (drawer && drawer.getSectionsToRender) {
              sectionIds = drawer.getSectionsToRender().map(function (s) {
                return s.id;
              });
            }
            if (!sectionIds.length) {
              sectionIds = [getDrawerSectionId(), 'cart-icon-bubble'];
            }

            payload.sections = sectionIds.join(',');
            payload.sections_url = window.location.pathname;

            fetch(window.Shopify.routes.root + 'cart/add.js', {
              method: 'POST',
              headers: { 'Content-Type': 'application/json', Accept: 'application/javascript' },
              body: JSON.stringify(payload),
            })
              .then(function (res) {
                return res.json();
              })
              .then(function (data) {
                if (data.status) throw new Error(data.description || data.message);

                setButtonState(form, true);

                if (drawer && typeof drawer.renderContents === 'function') {
                  // Dawn's renderContents both repaints and opens the drawer.
                  drawer.renderContents(data);
                } else {
                  document.dispatchEvent(new CustomEvent('cart:refresh', { bubbles: true }));
                  if (behavior === 'drawer') openDrawer();
                  return;
                }

                if (behavior === 'stay' && drawer.classList.contains('active')) {
                  if (typeof drawer.close === 'function') drawer.close();
                }
              })
              .catch(function (err) {
                if (errorEl) {
                  errorEl.textContent = err.message || 'Could not add to cart.';
                  errorEl.hidden = false;
                }
              })
              .finally(release);
          });
        });
      });
    }

    initYwctaForm(document);
    document.addEventListener('shopify:section:load', function (e) {
      initYwctaForm(e.target);
    });
  })();
</script>

{% schema %}
{
  "name": "Yum Club Final CTA",
  "tag": "section",
  "class": "yw-membership-cta-section",
  "settings": [
    { "type": "header", "content": "Content" },
    {
      "type": "richtext",
      "id": "heading",
      "label": "Heading",
      "default": "<p>Feed your dog better for less, starting with the next order you place.</p>"
    },
    { "type": "richtext", "id": "description", "label": "Supporting text" },
    { "type": "text", "id": "button_text", "label": "Button text", "default": "JOIN YUMCLUB · $29/QTR" },
    {
      "type": "url",
      "id": "button_url",
      "label": "Button link",
      "info": "Only used when no product is selected below."
    },
    {
      "type": "product",
      "id": "product",
      "label": "Product to add to cart",
      "info": "Leave empty to use the button as a normal link instead."
    },
    {
      "type": "number",
      "id": "selling_plan_id",
      "label": "Selling plan ID (optional)",
      "info": "For subscription products. Leave empty to use the first available plan on the variant."
    },
    {
      "type": "checkbox",
      "id": "show_plan_name",
      "label": "Show selling plan name above the button",
      "default": false
    },
    { "type": "text", "id": "sold_out_text", "label": "Sold out text", "default": "SOLD OUT" },
    { "type": "range", "id": "quantity", "label": "Quantity", "min": 1, "max": 10, "step": 1, "default": 1 },
    {
      "type": "select",
      "id": "cart_behavior",
      "label": "After adding to cart",
      "options": [
        { "value": "stay", "label": "Stay on page" },
        { "value": "drawer", "label": "Open cart drawer" },
        { "value": "cart", "label": "Go to cart page" }
      ],
      "default": "drawer"
    },
    { "type": "image_picker", "id": "badge", "label": "Badge / sticker" },
    {
      "type": "select",
      "id": "content_align",
      "label": "Content alignment",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" },
        { "value": "right", "label": "Right" }
      ],
      "default": "center"
    },

    { "type": "header", "content": "Background image" },
    {
      "type": "image_picker",
      "id": "bg_image",
      "label": "Background image (desktop)",
      "info": "Applied as a CSS background. Leave empty to show the background color on desktop."
    },
    {
      "type": "image_picker",
      "id": "bg_image_mobile",
      "label": "Background image (mobile)",
      "info": "Falls back to the desktop image. Never shown on desktop."
    },
    {
      "type": "text",
      "id": "bg_position",
      "label": "Background position (desktop)",
      "default": "center center",
      "info": "CSS background-position, e.g. 'center center', '50% 40%', '60% center'."
    },
    {
      "type": "text",
      "id": "bg_position_mobile",
      "label": "Background position (mobile)",
      "default": "center center"
    },

    { "type": "header", "content": "Overlay" },
    { "type": "color", "id": "color_overlay", "label": "Overlay color", "default": "#000000" },
    {
      "type": "range",
      "id": "overlay_opacity",
      "label": "Overlay opacity",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 0,
      "info": "Sits above the background image, below the content. Raise this when using a photo background."
    },

    { "type": "header", "content": "Colors" },
    { "type": "color", "id": "color_bg", "label": "Background color", "default": "#e35b45" },
    { "type": "color", "id": "color_heading", "label": "Heading color", "default": "#661d1d" },
    { "type": "color", "id": "color_text", "label": "Body text color", "default": "#661d1d" },

    { "type": "header", "content": "Button" },
    { "type": "color", "id": "color_button_bg", "label": "Button background", "default": "#7ba6dd" },
    { "type": "color", "id": "color_button_text", "label": "Button text", "default": "#000000" },
    { "type": "color", "id": "color_button_border", "label": "Button border", "default": "#000000" },
    { "type": "color", "id": "color_button_hover_bg", "label": "Button background (hover)", "default": "#661d1d" },
    { "type": "color", "id": "color_button_hover_text", "label": "Button text (hover)", "default": "#fff9ef" },
    { "type": "text", "id": "button_radius", "label": "Button corner radius", "default": "160px" },

    { "type": "header", "content": "Layout" },
    { "type": "text", "id": "height_desktop", "label": "Height (desktop)", "default": "617px" },
    { "type": "text", "id": "height_mobile", "label": "Height (mobile)", "default": "343px" },
    { "type": "text", "id": "content_width", "label": "Content width", "default": "700px" }
  ],
  "presets": [{ "name": "Yum Club Final CTA" }]
}
{% endschema %}
