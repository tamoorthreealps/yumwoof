{{ 'css--yw-membership-club.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign s = section.settings
  assign benefits = section.blocks | where: 'type', 'benefit'
-%}

<section
  class="ywmc{% if s.bg_image != blank or s.bg_image_mobile != blank %} ywmc--has-bg-image{% endif %}"
  id="ywmc-{{ section.id }}"
  aria-labelledby="ywmc-heading-{{ section.id }}"
  style="
    --ywmc-bg: {{ s.color_bg }};
    --ywmc-heading: {{ s.color_heading }};
    --ywmc-text: {{ s.color_text }};
    --ywmc-accent: {{ s.color_accent }};
    --ywmc-button-bg: {{ s.color_button_bg }};
    --ywmc-button-text: {{ s.color_button_text }};
    --ywmc-button-hover-bg: {{ s.color_button_hover_bg }};
    --ywmc-button-hover-text: {{ s.color_button_hover_text }};
    --ywmc-button-border: {{ s.color_button_border }};
    --ywmc-icon: {{ s.color_icon }};
    --ywmc-border: {{ s.color_border }};
    --ywmc-button-radius: {{ s.button_radius }}px;
    --ywmc-pad-top: {{ s.padding_top }}px;
    --ywmc-pad-bottom: {{ s.padding_bottom }}px;
    --ywmc-pad-top-mobile: {{ s.padding_top_mobile }}px;
    --ywmc-pad-bottom-mobile: {{ s.padding_bottom_mobile }}px;
  "
>
  {%- if s.bg_image != blank or s.bg_image_mobile != blank -%}
    <div class="ywmc__bg" aria-hidden="true">
      {%- if s.bg_image_mobile != blank and s.bg_image != blank -%}
        <picture>
          <source
            media="(max-width: 749px)"
            srcset="
              {{ s.bg_image_mobile | image_url: width: 640 }} 640w,
              {{ s.bg_image_mobile | image_url: width: 880 }} 880w,
              {{ s.bg_image_mobile | image_url: width: 1200 }} 1200w
            "
            sizes="100vw"
          >
          {{
            s.bg_image
            | image_url: width: 2400
            | image_tag:
              loading: 'lazy',
              widths: '900, 1200, 1512, 1800, 2400',
              sizes: '100vw',
              class: 'ywmc__bg-image',
              alt: 'ywmc bg image'
          }}
        </picture>
      {%- else -%}
        {%- assign bg_single = s.bg_image | default: s.bg_image_mobile -%}
        {{
          bg_single
          | image_url: width: 2400
          | image_tag:
            loading: 'lazy',
            widths: '900, 1200, 1512, 1800, 2400',
            sizes: '100vw',
            class: 'ywmc__bg-image',
            alt: 'ywmc bg image'
        }}
      {%- endif -%}
    </div>
  {%- endif -%}

  <div class="ywmc__container">
    {%- comment -%} ---------------- Left column: brand + intro ---------------- {%- endcomment -%}
    <div class="ywmc__brand">
      {%- if s.logo != blank -%}
        {%- assign logo_alt = s.logo.alt | default: 'YumClub' -%}
        <div class="ywmc__logo">
          {{
            s.logo
            | image_url: width: 1040
            | image_tag:
              loading: 'lazy',
              widths: '280, 520, 780, 1040',
              sizes: '(max-width: 749px) 266px, 520px',
              class: 'ywmc__logo-image',
              alt: logo_alt
          }}
        </div>
      {%- endif -%}

      {%- if s.eyebrow != blank -%}
        <h2 class="ywmc__eyebrow" id="ywmc-heading-{{ section.id }}">{{ s.eyebrow | escape }}</h2>
      {%- endif -%}

      {%- if s.description != blank -%}
        <div class="ywmc__description">{{ s.description }}</div>
      {%- endif -%}
    </div>

    {%- comment -%} ---------------- Right column: benefits + CTA ---------------- {%- endcomment -%}
    <div class="ywmc__panel">
      {%- if s.benefits_title != blank -%}
        <h3 class="ywmc__benefits-title">{{ s.benefits_title | escape }}</h3>
      {%- endif -%}

      {%- if s.show_rule -%}
        <hr class="ywmc__rule">
      {%- endif -%}

      {%- if benefits.size > 0 -%}
        <ul class="ywmc__benefits" role="list">
          {%- for block in benefits -%}
            <li class="ywmc__benefit" {{ block.shopify_attributes }}>
              <span class="ywmc__benefit-icon ywmc__benefit-icon--{{ block.settings.icon_style }}" aria-hidden="true">
                {%- if block.settings.icon != blank -%}
                  {{
                    block.settings.icon
                    | image_url: width: 96
                    | image_tag:
                      loading: 'lazy',
                      widths: '32, 64, 96',
                      sizes: '(max-width: 749px) 28px, 32px',
                      class: 'ywmc__benefit-icon-image',
                      alt: 'benefit icon image'
                  }}
                {%- else -%}
                  <svg class="ywmc__check" viewBox="0 0 24 24" focusable="false" role="presentation">
                    <path d="M5 12.5 10 17.5 19 7" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round"/>
                  </svg>
                {%- endif -%}
              </span>

              <span class="ywmc__benefit-text">
                {%- if block.settings.title != blank -%}
                  <h4 class="ywmc__benefit-title">{{ block.settings.title | escape }}</h4>
                {%- endif -%}
                {%- if block.settings.description != blank -%}
                  <div class="ywmc__benefit-desc">
                    {{ block.settings.description | escape }}
                  </div>
                {%- endif -%}
              </span>
            </li>
          {%- endfor -%}
        </ul>
      {%- endif -%}

      {%- comment -%} ---------------- Add to cart (subscription aware, single purchase) ---------------- {%- endcomment -%}
      {%- liquid
        assign atc_product = s.product
        assign atc_variant = null
        assign atc_selling_plan = null
        assign atc_plan_required = false

        if atc_product != blank
          assign atc_variant = atc_product.selected_or_first_available_variant
        endif

        if atc_variant != blank
          assign atc_plan_required = atc_variant.requires_selling_plan

          if atc_variant.selling_plan_allocations.size > 0
            if s.selling_plan_id != blank
              for allocation in atc_variant.selling_plan_allocations
                if allocation.selling_plan.id == s.selling_plan_id
                  assign atc_selling_plan = allocation.selling_plan
                  break
                endif
              endfor
            endif

            if atc_selling_plan == null
              assign atc_selling_plan = atc_variant.selling_plan_allocations.first.selling_plan
            endif
          endif
        endif

        assign atc_blocked = false
        if atc_plan_required and atc_selling_plan == null
          assign atc_blocked = true
        endif

        comment
          Membership is a one-per-cart item. Match on product_id so switching
          variants can't slip a second membership into the cart.
        endcomment
        assign ywmc_in_cart = false
        if atc_product != blank
          for line in cart.items
            if line.product_id == atc_product.id
              assign ywmc_in_cart = true
              break
            endif
          endfor
        endif
      -%}

      {%- if atc_product != blank and atc_variant != blank -%}
        <form
          method="post"
          action="{{ routes.cart_add_url }}"
          class="ywmc__form"
          data-ywmc-form
          data-cart-behavior="{{ s.cart_behavior }}"
          data-product-id="{{ atc_product.id }}"
        >
          <input type="hidden" name="form_type" value="product">
          <input type="hidden" name="utf8" value="✓">
          <input type="hidden" name="id" value="{{ atc_variant.id }}">
          <input type="hidden" name="quantity" value="{{ s.quantity }}">
          {%- if atc_selling_plan != null -%}
            <input type="hidden" name="selling_plan" value="{{ atc_selling_plan.id }}" data-ywmc-selling-plan>
          {%- endif -%}

          {%- if atc_selling_plan != null and s.show_plan_name -%}
            <p class="ywmc__plan-name">{{ atc_selling_plan.name | escape }}</p>
          {%- endif -%}

          <button
            type="submit"
            class="ywmc__button{% if ywmc_in_cart %} ywmc__button--in-cart{% endif %}"
            data-ywmc-in-cart="{% if ywmc_in_cart %}true{% else %}false{% endif %}"
            {% if atc_variant.available == false or atc_blocked %}
              disabled
            {% endif %}
          >
            <span class="ywmc__button-label">
              {%- if atc_variant.available == false -%}
                {{ s.sold_out_text | default: 'SOLD OUT' | escape }}
              {%- else -%}
                {{ s.button_text | default: 'ADD TO CART' | escape }}
              {%- endif -%}
            </span>
          </button>

          {%- if atc_blocked -%}
            <p class="ywmc__form-error">
              {%- if request.design_mode -%}
                This variant can only be purchased with a selling plan, but no plan is attached to it. Check the
                subscription app's plan group for this product.
              {%- endif -%}
            </p>
          {%- endif -%}

          <p class="ywmc__form-error" data-ywmc-error hidden></p>
        </form>

      {%- elsif s.button_text != blank -%}
        {%- comment -%} No product selected — fall back to a plain link {%- endcomment -%}
        <a class="ywmc__button" href="{{ s.button_url | default: '#' }}">
          <span class="ywmc__button-label">{{ s.button_text | escape }}</span>
        </a>
      {%- endif -%}

      {%- if s.fine_print != blank -%}
        <div class="ywmc__fine-print">
          {{ s.fine_print }}
        </div>
      {%- endif -%}
    </div>
  </div>
</section>

<script>
  (function () {
    function getDrawer() {
      return document.querySelector('cart-drawer');
    }

    function getDrawerSectionId() {
      var el = document.getElementById('CartDrawer-SectionId');
      return el ? el.dataset.sectionId : 'cart-drawer';
    }

    function openDrawer() {
      var drawer = getDrawer();
      if (drawer && typeof drawer.open === 'function') {
        drawer.open();
        return true;
      }
      var toggle = document.querySelector('#cart-icon-bubble, a[href$="/cart"]');
      if (toggle) {
        toggle.click();
        return true;
      }
      return false;
    }

    function setButtonState(form, inCart) {
      var button = form.querySelector('.ywmc__button');
      if (!button) return;
      // State only — the label text never changes.
      button.dataset.ywmcInCart = inCart ? 'true' : 'false';
      button.classList.toggle('ywmc__button--in-cart', inCart);
    }

    // Check the live cart rather than trusting the server-rendered flag —
    // the customer may have removed the item from the drawer since page load.
    function isAlreadyInCart(productId) {
      return fetch(window.Shopify.routes.root + 'cart.js', {
        headers: { Accept: 'application/json' },
        cache: 'no-store',
      })
        .then(function (res) {
          return res.json();
        })
        .then(function (cart) {
          return (cart.items || []).some(function (line) {
            return String(line.product_id) === String(productId);
          });
        })
        .catch(function () {
          return false;
        });
    }

    function initYwmcForm(root) {
      root.querySelectorAll('[data-ywmc-form]').forEach(function (form) {
        if (form.dataset.ywmcBound) return;
        form.dataset.ywmcBound = 'true';

        form.addEventListener('submit', function (event) {
          event.preventDefault();

          var behavior = form.dataset.cartBehavior || 'drawer';
          var button = form.querySelector('.ywmc__button');
          var errorEl = form.querySelector('[data-ywmc-error]');
          if (errorEl) {
            errorEl.hidden = true;
            errorEl.textContent = '';
          }
          if (button) {
            button.setAttribute('aria-busy', 'true');
            button.disabled = true;
          }

          function release() {
            if (button) {
              button.removeAttribute('aria-busy');
              button.disabled = false;
            }
          }

          isAlreadyInCart(form.dataset.productId).then(function (inCart) {
            if (inCart) {
              setButtonState(form, true);
              release();
              if (!openDrawer()) {
                window.location.href = window.Shopify.routes.root + 'cart';
              }
              return;
            }

            setButtonState(form, false);

            if (behavior === 'cart') {
              form.submit();
              return;
            }

            var drawer = getDrawer();
            var planInput = form.querySelector('[data-ywmc-selling-plan]');

            var item = {
              id: Number(form.querySelector('input[name="id"]').value),
              quantity: Number(form.querySelector('input[name="quantity"]').value || 1),
            };
            if (planInput && planInput.value) {
              item.selling_plan = Number(planInput.value);
            }

            var payload = { items: [item] };

            // Ask Shopify to re-render the drawer sections in the same request,
            // otherwise the drawer keeps its stale markup until a reload.
            var sectionIds = [];
            if (drawer && drawer.getSectionsToRender) {
              sectionIds = drawer.getSectionsToRender().map(function (s) {
                return s.id;
              });
            }
            if (!sectionIds.length) {
              sectionIds = [getDrawerSectionId(), 'cart-icon-bubble'];
            }

            payload.sections = sectionIds.join(',');
            payload.sections_url = window.location.pathname;

            fetch(window.Shopify.routes.root + 'cart/add.js', {
              method: 'POST',
              headers: { 'Content-Type': 'application/json', Accept: 'application/javascript' },
              body: JSON.stringify(payload),
            })
              .then(function (res) {
                return res.json();
              })
              .then(function (data) {
                if (data.status) throw new Error(data.description || data.message);

                setButtonState(form, true);

                if (drawer && typeof drawer.renderContents === 'function') {
                  // Dawn's renderContents both repaints and opens the drawer.
                  drawer.renderContents(data);
                } else {
                  document.dispatchEvent(new CustomEvent('cart:refresh', { bubbles: true }));
                  if (behavior === 'drawer') openDrawer();
                  return;
                }

                if (behavior === 'stay' && drawer.classList.contains('active')) {
                  if (typeof drawer.close === 'function') drawer.close();
                }
              })
              .catch(function (err) {
                if (errorEl) {
                  errorEl.textContent = err.message || 'Could not add to cart.';
                  errorEl.hidden = false;
                }
              })
              .finally(release);
          });
        });
      });
    }

    initYwmcForm(document);
    document.addEventListener('shopify:section:load', function (e) {
      initYwmcForm(e.target);
    });
  })();
</script>

{% schema %}
{
  "name": "Yum Club Membership",
  "tag": "section",
  "class": "yw-membership-club-section",
  "settings": [
    { "type": "header", "content": "Branding" },
    { "type": "image_picker", "id": "logo", "label": "YumClub logo" },
    { "type": "text", "id": "eyebrow", "label": "Heading", "default": "MEMBERSHIP" },
    {
      "type": "richtext",
      "id": "description",
      "label": "Description",
      "default": "<p>We built Yumwoof because good dog food cost too much and did too little. YumClub is the rest of that answer. Pay in once a quarter and the whole counter drops by 25%, so feeding a dog properly stops being the expensive option.</p>"
    },

    { "type": "header", "content": "Benefits panel" },
    { "type": "text", "id": "benefits_title", "label": "Benefits title", "default": "Here's what you get:" },
    { "type": "checkbox", "id": "show_rule", "label": "Show rule under the benefits title", "default": true },

    { "type": "header", "content": "Button" },
    { "type": "text", "id": "button_text", "label": "Button text", "default": "JOIN YUMCLUB · $29/QTR" },
    {
      "type": "url",
      "id": "button_url",
      "label": "Button link",
      "info": "Only used when no product is selected below."
    },
    {
      "type": "product",
      "id": "product",
      "label": "Product to add to cart",
      "info": "Leave empty to use the button as a normal link instead."
    },
    {
      "type": "number",
      "id": "selling_plan_id",
      "label": "Selling plan ID (optional)",
      "info": "For subscription products. Leave empty to use the first available plan on the variant."
    },
    {
      "type": "checkbox",
      "id": "show_plan_name",
      "label": "Show selling plan name above the button",
      "default": false
    },
    { "type": "text", "id": "sold_out_text", "label": "Sold out text", "default": "SOLD OUT" },
    { "type": "range", "id": "quantity", "label": "Quantity", "min": 1, "max": 10, "step": 1, "default": 1 },
    {
      "type": "select",
      "id": "cart_behavior",
      "label": "After adding to cart",
      "options": [
        { "value": "stay", "label": "Stay on page" },
        { "value": "drawer", "label": "Open cart drawer" },
        { "value": "cart", "label": "Go to cart page" }
      ],
      "default": "drawer"
    },
    {
      "type": "range",
      "id": "button_radius",
      "label": "Button corner radius",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 160
    },
    {
      "type": "richtext",
      "id": "fine_print",
      "label": "Fine print",
      "default": "<p>$9.66/mo, billed quarterly. Cancel anytime.  ·  Already a member? Log in</p>"
    },

    { "type": "header", "content": "Background" },
    { "type": "color", "id": "color_bg", "label": "Background color", "default": "#cb8900" },
    {
      "type": "image_picker",
      "id": "bg_image",
      "label": "Background image (desktop, optional)"
    },
    {
      "type": "image_picker",
      "id": "bg_image_mobile",
      "label": "Background image (mobile, optional)",
      "info": "Falls back to the desktop background image if left empty."
    },

    { "type": "header", "content": "Colors" },
    { "type": "color", "id": "color_heading", "label": "Heading color", "default": "#661d1d" },
    { "type": "color", "id": "color_text", "label": "Body text color", "default": "#661d1d" },
    { "type": "color", "id": "color_accent", "label": "Accent color", "default": "#661d1d" },
    { "type": "color", "id": "color_icon", "label": "Benefit icon color", "default": "#661d1d" },
    { "type": "color", "id": "color_border", "label": "Border / rule color", "default": "#661d1d" },

    { "type": "header", "content": "Button colors" },
    { "type": "color", "id": "color_button_bg", "label": "Button background", "default": "#7ba6dd" },
    { "type": "color", "id": "color_button_text", "label": "Button text", "default": "#000000" },
    { "type": "color", "id": "color_button_border", "label": "Button border", "default": "#000000" },
    { "type": "color", "id": "color_button_hover_bg", "label": "Button background (hover)", "default": "#661d1d" },
    { "type": "color", "id": "color_button_hover_text", "label": "Button text (hover)", "default": "#fff9ef" },

    { "type": "header", "content": "Spacing" },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Padding top (desktop)",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 72
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Padding bottom (desktop)",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 84
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "label": "Padding top (mobile)",
      "min": 0,
      "max": 120,
      "step": 2,
      "unit": "px",
      "default": 44
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "label": "Padding bottom (mobile)",
      "min": 0,
      "max": 120,
      "step": 2,
      "unit": "px",
      "default": 40
    }
  ],
  "blocks": [
    {
      "type": "benefit",
      "name": "Benefit",
      "settings": [
        {
          "type": "image_picker",
          "id": "icon",
          "label": "Icon (optional)",
          "info": "Leave empty to use the built-in checkbox, which follows the benefit icon color."
        },
        {
          "type": "select",
          "id": "icon_style",
          "label": "Checkbox style",
          "options": [
            { "value": "filled", "label": "Filled" },
            { "value": "outline", "label": "Outline" }
          ],
          "default": "filled",
          "info": "Only applies to the built-in checkbox."
        },
        { "type": "text", "id": "title", "label": "Title", "default": "25% off every order" },
        {
          "type": "textarea",
          "id": "description",
          "label": "Description"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Yum Club Membership",
      "blocks": [{ "type": "benefit" }, { "type": "benefit" }, { "type": "benefit" }, { "type": "benefit" }]
    }
  ]
}
{% endschema %}
