            {%- endif -%}
            {%- comment -%}
              Members / membership-in-cart see only the success banner above; the spend
              tiers show for everyone else. (member_active = logged-in member OR the
              membership product is in the cart.)
            {%- endcomment -%}
            {%- if threshold_count > 0 and member_active == false -%}
              <div class="cd-rewards">
                <p class="cd-rewards__msg">{{ reward_message }}</p>

                <div class="cd-rewards__track">
                  {%- assign prev_cents = 0 -%}
                  {%- for i in (1..4) -%}
                    {%- assign ek = 'threshold_' | append: i | append: '_enable' -%}
                    {%- assign ak = 'threshold_' | append: i | append: '_amount_' | append: cur_suffix -%}
                    {%- assign lk = 'threshold_' | append: i | append: '_label' -%}
                    {%- assign enabled = section.settings[ek] -%}
                    {%- assign amt = section.settings[ak] -%}
                    {%- if amt == blank -%}
                      {%- assign ak_usd = 'threshold_' | append: i | append: '_amount_usd' -%}
                      {%- assign amt = section.settings[ak_usd] -%}
                    {%- endif -%}
                    {%- if enabled and amt > 0 -%}
                      {%- assign b_cents = amt | times: 100 -%}
                      {%- assign reached = false -%}
                      {%- if cart_cents >= b_cents -%}{%- assign reached = true -%}{%- endif -%}
                      {%- assign seg_pct = 0 -%}
                      {%- if reached -%}
                        {%- assign seg_pct = 100 -%}
                      {%- elsif cart_cents > prev_cents -%}
                        {%- assign span = b_cents | minus: prev_cents -%}
                        {%- assign done = cart_cents | minus: prev_cents -%}
                        {%- if span > 0 -%}{%- assign seg_pct = done | times: 100 | divided_by: span -%}{%- endif -%}
                      {%- endif -%}
                      <div class="cd-reward{% if reached %} is-reached{% endif %}">
                        <span class="cd-reward__bar"
                          ><span
                            class="cd-reward__fill"
                            style="--cd-fill: {{ seg_pct }}%; animation-delay: {{ forloop.index0 | times: 0.1 }}s"
                          ></span
                        ></span>
                        <span class="cd-reward__label">
                          {%- if reached -%}
                            <span class="cd-reward__check" aria-hidden="true">
                              <svg
                                width="12"
                                height="10"
                                viewBox="0 0 12 10"
                                fill="none"
                                xmlns="http://www.w3.org/2000/svg"
                              >
                                <path d="M11.7122 0C11.8577 0.0018294 11.9205 0.0810193 11.9971 0.189986C11.9996 0.271613 12.0137 0.353474 11.9456 0.413231C11.4218 0.867741 10.7136 1.2525 10.1426 1.64719C7.22808 3.66181 4.86316 6.41477 3.14271 9.46604C2.86159 9.9646 1.72375 10.2148 1.25595 9.76604C0.402264 8.94704 0.128021 7.44664 0.0194031 6.31542C-0.00555958 5.68404 -0.0426075 4.84947 0.170962 4.24878C0.250159 4.02609 0.597161 3.80423 0.834555 3.93559C1.14694 4.10851 1.19587 4.65626 1.29423 4.96828C1.55213 6.01946 1.79185 7.06178 2.14916 8.08649C3.90021 4.93724 8.16314 1.04108 11.7122 0Z" fill="black"/>
                              </svg>
                            </span>
                          {% endif -%}
                          {{- section.settings[lk] -}}
                        </span>
                        <span class="cd-reward__amount">{{ amt | times: 100 | money_without_trailing_zeros }}</span>
                      </div>
                      {%- assign prev_cents = b_cents -%}
                    {%- endif -%}
                  {%- endfor -%}
                </div>
              </div>
            {%- endif -%}
            {%- comment -%} ===== MEMBERSHIP / CONGRATS BANNER ===== {%- endcomment -%}
            {%- if show_membership_banner -%}
              {%- capture membership_img -%}
              {%- if section.settings.banner_image_desktop != blank -%}
                {%- assign bd_alt = section.settings.banner_image_desktop.alt | default: 'Add membership' -%}
                {{ section.settings.banner_image_desktop | image_url: width: 1000 | image_tag: class: 'cd-banner__img cd-banner__img--desktop', widths: '500, 750, 1000', alt: bd_alt, loading: 'lazy' }}
              {%- endif -%}
              {%- if section.settings.banner_image_mobile != blank -%}
                {%- assign bm_alt = section.settings.banner_image_mobile.alt | default: 'Add membership' -%}
                {{ section.settings.banner_image_mobile | image_url: width: 800 | image_tag: class: 'cd-banner__img cd-banner__img--mobile', widths: '400, 600, 800', alt: bm_alt, loading: 'lazy' }}
              {%- endif -%}
            {%- endcapture -%}
              {%- if membership_img != blank and banner_variant_id != blank -%}
                {%- assign banner_add_label = banner_product.title | escape -%}
                <div class="cd-banner cd-banner--membership">
                  <div class="cd-banner__content">
                    <div class="cd-banner__image">
                      {% if section.settings.banner_image_desktop != blank %}
                        {{
                          section.settings.banner_image_desktop
                          | image_url: width: 1200
                          | image_tag:
                            class: 'cd-banner__img yumclub--desktop--img',
                            loading: 'lazy',
                            alt: section.settings.banner_heading
                        }}
                      {% endif %}

                      {% if section.settings.banner_image_mobile != blank %}
                        {{
                          section.settings.banner_image_mobile
                          | image_url: width: 600
                          | image_tag:
                            class: 'cd-banner__img yumclub--mobile--img',
                            loading: 'lazy',
                            alt: section.settings.banner_heading
                        }}
                      {% endif %}
                    </div>

                    <div class="cd-banner__text">
                      <div class="cd-banner__text_inner">
                        {% if section.settings.banner_heading != blank %}
                          <p class="cd-banner__title">{{ section.settings.banner_heading }}</p>
                        {% endif %}
                        {% if section.settings.banner_text != blank %}
                          <p class="cd-banner__description">{{ section.settings.banner_text }}</p>
                        {% endif %}
                      </div>
                      <div class="cd-banner__btn_hold">
                        <button
                          type="button"
                          class="cd-banner__btn"
                          data-cd-add
                          data-variant-id="{{ banner_variant_id }}"
                          data-selling-plan="{{ banner_selling_plan_id }}"
                          aria-label="{{ 'products.product.add_to_cart' | t }}: {{ banner_product.title | escape }}"
                        >
                          {{ section.settings.banner_button_text }}
                          <span class="cd__desktop-text"
                            >- {{ banner_variant.price | money_without_trailing_zeros }}/QTR</span
                          >
                        </button>
                        <span class="cd__mobile-text">
                          {{- banner_variant.price | money_without_trailing_zeros }}/QTR</span
                        >
                      </div>
                    </div>
                  </div>
                </div>
              {%- endif -%}
            {%- endif -%}
            {%- comment -%} ===== CART ITEMS ===== {%- endcomment -%}
            <cart-drawer-items class="cd-items-wrap">
              <form
                action="{{ routes.cart_url }}"
                id="CartDrawer-Form"
                class="cart__contents cart-drawer__form"
                method="post"
              >
                <div id="CartDrawer-CartItems" class="js-contents cd-items">
                  {%- for item in cart.items -%}
                    {%- comment -%}
                      Logged-in Yum Club members already have membership, so hide the
                      membership product line. A logged-OUT shopper who adds it still
                      sees it (is_member is false for them).
                    {%- endcomment -%}
                    {%- if is_member and banner_product != blank and item.product.id == banner_product.id -%}
                      {%- continue -%}
                    {%- endif -%}
                    {%- liquid
                      assign is_sub = false
                      if item.selling_plan_allocation != null
                        assign is_sub = true
                      endif

                      # Identify the BASE subscription group — the plain "Subscribe & Save"
                      # group, NOT the bundle/member combined groups Appstle also attaches
                      # (those carry the pre-stacked tier/member rates and are switched by
                      # the discount engine, not chosen by the shopper). Picking the first
                      # group blindly would attach the 28.75% member plan to everyone.
                      assign base_prefix = section.settings.sub_base_group_prefix | default: 'Subscribe & Save'
                      assign base_group = null
                      for group in item.product.selling_plan_groups
                        if base_group == null and group.name contains base_prefix
                          assign base_group = group
                        endif
                      endfor
                      if base_group == null and item.product.selling_plan_groups.size > 0
                        assign base_group = item.product.selling_plan_groups.first
                      endif

                      # Subscription-only products (e.g. the Yum Club membership) can never be
                      # a one-time purchase, so their card hides the Auto-ship toggle.
                      assign force_sub = item.product.requires_selling_plan

                      assign has_plans = false
                      assign default_plan_id = null
                      assign default_plan_percent = 0
                      if base_group != null
                        assign has_plans = true
                        # Default plan for the toggle = the first NON-excluded frequency, so
                        # turning Auto-ship on never lands on a hidden cadence (e.g. 2 weeks).
                        assign base_default_plan = null
                        for plan in base_group.selling_plans
                          assign plan_excluded = false
                          if exclude_freq contains plan.name
                            assign plan_excluded = true
                          endif
                          if base_default_plan == null and plan_excluded == false
                            assign base_default_plan = plan
                          endif
                        endfor
                        if base_default_plan == null
                          assign base_default_plan = base_group.selling_plans.first
                        endif
                        assign default_plan_id = base_default_plan.id
                        assign base_adj = base_default_plan.price_adjustments.first
                        if base_adj.value_type == 'percentage'
                          assign default_plan_percent = base_adj.value
                        endif
                      endif

                      assign sub_percent = default_plan_percent
                      if is_sub
                        assign cur_adj = item.selling_plan_allocation.selling_plan.price_adjustments.first
                        if cur_adj.value_type == 'percentage'
                          assign sub_percent = cur_adj.value
                        endif
                      endif

                      assign item_compare_unit = item.variant.compare_at_price
                      if item.selling_plan_allocation != null and item.selling_plan_allocation.compare_at_price > item.final_price
                        assign item_compare_unit = item.selling_plan_allocation.compare_at_price
                      endif

                      assign item_compare_line = item_compare_unit | times: item.quantity
                      assign discount_pct = 0

                      if is_sub and cur_adj != null and cur_adj.value_type == 'percentage'
                        assign discount_pct = cur_adj.value
                      elsif item_compare_unit > item.final_price
                        assign saved_unit = item_compare_unit | minus: item.final_price
                        assign discount_pct = saved_unit | times: 100 | divided_by: item_compare_unit
                      endif

                      # Line note: drop the "Delivery " prefix so cadences read "Every 4 weeks".
                      # Non-delivery plan names (e.g. "Renews Quarterly") are left untouched.
                      assign sub_note = 'One-Time'
                      if is_sub
                        assign sub_note = item.selling_plan_allocation.selling_plan.name
                        if sub_note contains 'Delivery'
                          assign sub_note = sub_note | remove_first: 'Delivery ' | capitalize
                        endif
                      endif
                    -%}

                    <div
                      id="CartDrawer-Item-{{ item.index | plus: 1 }}"
                      class="cd-item handle-{{ item.title | handle }}"
                      role="row"
                    >
                      <div class="cd-item_hold">
                        <div class="cd-item__media">
                          {%- if item.image -%}
                            {%- assign cd_img_alt = item.image.alt | escape -%}
                            {% if banner_product != blank and item.product.id == banner_product.id %}
                              {{
                                item.image
                                | image_url: width: 240
                                | image_tag:
                                  class: 'cd-item__img',
                                  widths: '120, 180, 240',
                                  alt: cd_img_alt,
                                  loading: 'lazy'
                              }}
                            {% else %}
                              <a href="{{ item.url }}" tabindex="-1" aria-hidden="true">
                                {{
                                  item.image
                                  | image_url: width: 240
                                  | image_tag:
                                    class: 'cd-item__img',
                                    widths: '120, 180, 240',
                                    alt: cd_img_alt,
                                    loading: 'lazy'
                                }}
                              </a>
                            {% endif %}
                          {%- endif -%}
                        </div>
                        <div class="cd-item__main">
                          <div class="cd-item__top">
                            <div class="cd-item__titles">
                              {% assign variant_parts = item.variant.title | split: ' / ' %}
                              {% if banner_product != blank and item.product.id == banner_product.id %}
                                <span class="cd-item__name">{{ item.product.title | escape }}</span>
                              {% else %}
                                <a href="{{ item.url }}" class="cd-item__name">{{ item.product.title | escape }}</a>
                              {% endif %}
                              {% assign recipe_name = '' %}
                              {% assign recipe_value = '' %}

                              {% for option in item.product.options %}
                                {% if option == 'Recipe' %}
                                  {% assign recipe_name = option %}
                                  {% assign recipe_value = variant_parts[0] %}
                                {% endif %}
                              {% endfor %}

                              {%- unless item.product.has_only_default_variant -%}
                                <p class="cd-item__recipe">
                                  {{ recipe_value | escape }}
                                  {{ recipe_name }}
                                </p>
                              {%- endunless -%}
                              <p class="cd-item__note">
                                {% if variant_parts[1] != blank %}
                                  {{ variant_parts[1] | escape }} ·
                                {% endif %}
                                {{ sub_note }}
                              </p>
                            </div>
                            <div class="cd-item__price">
                              {%- if item_compare_unit > item.final_price -%}
                                <span class="cd-item__price-row">
                                  <s class="cd-item__compare">{{ item_compare_line | money }}</s>
                                  <span class="cd-item__final">{{ item.final_line_price | money }}</span>
                                </span>
                                <span class="cd-item__off">({{ discount_pct }}% Off)</span>
                              {%- else -%}
                                {% if item.original_line_price > item.final_line_price %}
                                  <span class="cd-item__price-row">
                                    <s class="cd-item__compare">{{ item.original_line_price | money }}</s>
                                    <span class="cd-item__final">{{ item.final_line_price | money }}</span>
                                  </span>
                                {% else %}
                                  <span class="cd-item__final">{{ item.final_line_price | money }}</span>
                                {% endif %}
                              {%- endif -%}
                            </div>
                          </div>

                          {%- comment -%} Automatic / code discounts allocated to this line (not subscription or compare-at). {%- endcomment -%}
                          {%- if item.line_level_discount_allocations.size > 0 -%}
                            <ul class="cd-item__discounts" role="list">
                              {%- for alloc in item.line_level_discount_allocations -%}
                                <li class="cd-item__discount">
                                  <span class="cd-item__discount-title">{{ alloc.discount_application.title }}</span>
                                  <span class="cd-item__discount-amount">&minus;{{ alloc.amount | money }}</span>
                                </li>
                              {%- endfor -%}
                            </ul>
                          {%- endif -%}

                          <div class="cd-item__bottom">
                            <quantity-input class="cd-qty">
                              <button
                                class="cd-qty__btn quantity__button"
                                name="minus"
                                type="button"
                                aria-label="{{ 'products.product.quantity.decrease' | t: product: item.product.title | escape }}"
                              >
                                &minus;
                              </button>
                              <input
                                class="cd-qty__input"
                                type="number"
                                name="updates[]"
                                value="{{ item.quantity }}"
                                data-quantity-variant-id="{{ item.variant.id }}"
                                data-cart-quantity="{{ cart | item_count_for_variant: item.variant.id }}"
                                min="0"
                                data-min="{{ item.variant.quantity_rule.min | default: 1 }}"
                                {% if item.variant.quantity_rule.max != null %}
                                  max="{{ item.variant.quantity_rule.max }}"
                                {% endif %}
                                step="{{ item.variant.quantity_rule.increment | default: 1 }}"
                                data-index="{{ item.index | plus: 1 }}"
                                id="Drawer-quantity-{{ item.index | plus: 1 }}"
                                aria-label="{{ 'products.product.quantity.input_label' | t: product: item.product.title | escape }}"
                              >
                              <button
                                class="cd-qty__btn quantity__button"
                                name="plus"
                                type="button"
                                aria-label="{{ 'products.product.quantity.increase' | t: product: item.product.title | escape }}"
                              >
                                +
                              </button>
                            </quantity-input>

                            <cart-remove-button
                              id="CartDrawer-Remove-{{ item.index | plus: 1 }}"
                              data-index="{{ item.index | plus: 1 }}"
                            >
                              <button
                                type="button"
                                class="cd-item__remove"
