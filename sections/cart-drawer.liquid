{{ 'css--cart-drawer.css' | asset_url | stylesheet_tag }}
<script src="{{ 'custom-cart-subscription.js' | asset_url }}" defer="defer"></script>
<script src="{{ 'cart.js' | asset_url }}" defer="defer"></script>
<script src="{{ 'quantity-popover.js' | asset_url }}" defer="defer"></script>

{%- style -%}
  #shopify-section-{{ section.id }} .cd {
    --cd-drawer-bg: {{ section.settings.drawer_bg }};
    --cd-header-bg: {{ section.settings.header_bg }};
    --cd-header-text: {{ section.settings.header_text }};
    --cd-accent: {{ section.settings.accent_color }};
    --cd-cta-bg: {{ section.settings.cta_bg }};
  }
{%- endstyle -%}

{%- liquid
  # Threshold progress is measured on the pre-discount subtotal, NOT cart.total_price.
  # items_subtotal_price already excludes cart/ORDER-level automatic discounts and
  # codes; we then add back any LINE-level automatic/code discount allocations so a
  # discount that targets the products themselves also can't lower the threshold
  # basis. Subscription (selling-plan) pricing is intentionally kept.
  # Example: a $200 item with 5% off still measures the tier against $200, not $190.
  assign cart_cents = cart.items_subtotal_price
  for cart_item in cart.items
    for cart_alloc in cart_item.line_level_discount_allocations
      assign cart_cents = cart_cents | plus: cart_alloc.amount
    endfor
  endfor

  # --- Active market currency: thresholds are entered per market (US/EU/UK/CH). ---
  # Pick the field suffix from the cart's currency, falling back to USD.
  assign cart_currency = cart.currency.iso_code | default: shop.currency
  assign cur_suffix = 'usd'
  if cart_currency == 'EUR'
    assign cur_suffix = 'eur'
  elsif cart_currency == 'GBP'
    assign cur_suffix = 'gbp'
  elsif cart_currency == 'CHF'
    assign cur_suffix = 'chf'
  endif

  # --- Yum Club membership: logged-in customers with the member tag get a flat
  #     member discount scheme instead of the spend-based tiered thresholds. ---
  assign member_tag = section.settings.member_tag | default: 'Yum! club member'
  assign is_member = false
  if customer and customer.tags contains member_tag
    assign is_member = true
  endif
  assign member_percent = section.settings.member_percent | default: 25
  assign show_member_scheme = false
  if section.settings.member_enable and is_member
    assign show_member_scheme = true
  endif

  # --- Membership banner ---
  # Non-members see a clickable banner that adds the membership product (no reload).
  # Logged-in members never see it. If the product is already in the cart, a
  # separate "congrats" banner is shown instead.
  assign banner_product = section.settings.banner_product
  assign banner_variant_id = ''
  assign banner_selling_plan_id = ''
  if banner_product != blank
    assign banner_variant = banner_product.selected_or_first_available_variant | default: banner_product.variants.first
    assign banner_variant_id = banner_variant.id
    # Membership products are subscriptions (requires_selling_plan) — the add MUST
    # include a selling plan, otherwise /cart/add.js rejects it.
    assign banner_alloc = banner_variant.selling_plan_allocations.first
    if banner_alloc != blank
      assign banner_selling_plan_id = banner_alloc.selling_plan.id
    endif
  endif
  assign banner_product_in_cart = false
  assign banner_product_qty = 0
  if banner_product != blank
    for item in cart.items
      if item.product.id == banner_product.id
        assign banner_product_in_cart = true
        assign banner_product_qty = banner_product_qty | plus: item.quantity
      endif
    endfor
  endif

  # The Yum Club discount is "active" for a shopper who is EITHER a logged-in member
  # (customer tagged) OR has the membership product in the cart. Both show the gold
  # success banner and hide the spend-tier thresholds. A logged-in member additionally
  # gets the membership line item hidden in the items loop below (they already have it).
  assign member_active = false
  if is_member or banner_product_in_cart
    assign member_active = true
  endif

  assign show_membership_banner = false
  assign show_congrats_banner = false
  if section.settings.banner_enable
    if member_active
      assign show_congrats_banner = true
    else
      assign show_membership_banner = true
    endif
  endif

  # Header count: when a member's membership line is hidden, drop it from the count too.
  assign display_item_count = cart.item_count
  if is_member and banner_product_in_cart
    assign display_item_count = cart.item_count | minus: banner_product_qty
  endif

  # Reward thresholds (up to 4) live in section settings so they survive AJAX re-renders.
  # NOTE: this section is in a section group (cart-drawer-group), so Shopify's isolated
  # Section Rendering API (?section_id=cart-drawer) renders it with SCHEMA DEFAULTS, not the
  # saved settings. To keep the tier count/amounts identical across the full-page render and
  # any isolated re-render, every threshold_* schema default MUST mirror the saved config in
  # cart-drawer-group.json (e.g. threshold_4_enable default is true because it's enabled there).
  assign threshold_count = 0
  assign max_threshold_cents = 0
  assign next_index = 0
  assign all_unlocked = true
  for i in (1..4)
    assign ek = 'threshold_' | append: i | append: '_enable'
    assign ak = 'threshold_' | append: i | append: '_amount_' | append: cur_suffix
    assign enabled = section.settings[ek]
    assign amt = section.settings[ak]
    if amt == blank
      assign ak_usd = 'threshold_' | append: i | append: '_amount_usd'
      assign amt = section.settings[ak_usd]
    endif
    if enabled and amt > 0
      assign threshold_count = threshold_count | plus: 1
      assign b_cents = amt | times: 100
      if b_cents > max_threshold_cents
        assign max_threshold_cents = b_cents
      endif
      if cart_cents < b_cents
        assign all_unlocked = false
        if next_index == 0
          assign next_index = i
        endif
      endif
    endif
  endfor

  assign extra_percent = 0
  if show_member_scheme
    assign extra_percent = member_percent
  elsif next_index > 0
    assign pk = 'threshold_' | append: next_index | append: '_percent'
    assign extra_percent = section.settings[pk]
  endif

  # Reward message (build the {remaining} replace here, never inside a {{ }} output tag)
  assign reward_message = ''
  if all_unlocked
    assign reward_message = section.settings.unlocked_message
  elsif next_index > 0
    assign mk = 'threshold_' | append: next_index | append: '_message'
    assign nak = 'threshold_' | append: next_index | append: '_amount_' | append: cur_suffix
    assign next_amt = section.settings[nak]
    if next_amt == blank
      assign nak_usd = 'threshold_' | append: next_index | append: '_amount_usd'
      assign next_amt = section.settings[nak_usd]
    endif
    assign next_cents = next_amt | times: 100
    assign remaining_money = next_cents | minus: cart_cents | money
    assign remaining_html = '<span class="cd-rewards__amount">' | append: remaining_money | append: '</span>'
    assign placeholder = '{remaining}'
    assign reward_message = section.settings[mk] | replace: placeholder, remaining_html
  endif

  # Member scheme message ({percent} is replaced here, never inside a {{ }} tag)
  assign member_message = ''
  if show_member_scheme
    assign member_message = section.settings.member_message | default: '{percent}% applied'
    assign member_message = member_message | replace: '{percent}', member_percent
  endif

  # Total savings against the best available compare-at price
  assign total_savings = 0
  for item in cart.items
    assign compare_unit = item.variant.compare_at_price
    if item.selling_plan_allocation != null and item.selling_plan_allocation.compare_at_price > item.final_price
      assign compare_unit = item.selling_plan_allocation.compare_at_price
    endif
    if compare_unit > item.final_price
      assign item_saving = compare_unit | minus: item.final_price | times: item.quantity
      assign total_savings = total_savings | plus: item_saving
    endif
  endfor

  assign rec_intent = section.settings.recommend_intent | default: 'related'

  # Subscription cadences hidden everywhere in the drawer. Mirrors the PDP Appstle
  # widget's exclude list (snippets/appstle-subscription.liquid) so the frequencies
  # offered in the cart match exactly what the PDP offers (e.g. "every 2 weeks" is
  # never selectable).
  assign exclude_freq = 'Delivery every 1 week,Delivery every 2 weeks,Delivery every 5 weeks,Delivery every 1 month,Delivery every 2 months,Delivery every 3 months' | split: ','
-%}

<cart-drawer class="drawer{% if cart == empty %} is-empty{% endif %}">
  <div id="CartDrawer" class="cart-drawer cd">
    <div id="CartDrawer-Overlay" class="cart-drawer__overlay"></div>

    <div
      class="drawer__inner cd__inner{% if cart == empty %} is-empty{% endif %}"
      role="dialog"
      aria-modal="true"
      aria-label="{{ 'sections.cart.title' | t }}"
      tabindex="-1"
    >
      <span id="CartDrawer-SectionId" data-section-id="{{ section.id }}" hidden></span>
      <div class="drawer__inner_container">
        {%- comment -%} ===== HEADER ===== {%- endcomment -%}
        <div class="cd__header">
          <p class="cd__title">
            {{ section.settings.title }}
            {%- if cart != empty -%}
              <span class="cd__count"
                >[{{ display_item_count }}
                {{ display_item_count | pluralize: 'ITEM', 'ITEMS' }}]</span
              >
            {%- endif -%}
          </p>
          <button
            class="drawer__close cd__close"
            type="button"
            onclick="this.closest('cart-drawer').close()"
            aria-label="{{ 'accessibility.close' | t }}"
          >
            <svg width="9" height="11" viewBox="0 0 9 11" fill="none" xmlns="http://www.w3.org/2000/svg">
              <path d="M4.37355 3.85209L4.82355 3.18609L5.66955 1.81809L6.67755 0.324093C6.80355 0.126093 7.01955 0.0180935 7.25355 0.0180935H8.20755C8.36955 9.36985e-05 8.51355 0.0900936 8.60355 0.216093C8.62155 0.270093 8.62155 0.324093 8.60355 0.360093L8.51355 0.558093L7.10955 2.70009L5.77755 4.77009L5.65155 5.00409C5.32755 5.45409 5.32755 5.45409 5.59755 5.88609L6.87555 7.86609L7.99155 9.66609L8.36955 10.1521C8.49555 10.2601 8.53155 10.4401 8.47755 10.5841C8.40555 10.7461 8.26155 10.7281 8.11755 10.7281H7.00155C6.80355 10.7461 6.62355 10.6381 6.51555 10.4761L5.34555 8.60409L4.48155 7.34409C4.42755 7.25409 4.30155 7.23609 4.22955 7.30809L3.90555 7.66809V7.68609C3.36555 8.51409 2.84355 9.36009 2.32155 10.2061C2.15955 10.5661 1.78155 10.7821 1.38555 10.7461C1.09755 10.7101 0.791547 10.7461 0.503547 10.7281C0.143547 10.7101 -0.00045301 10.4581 0.251547 10.2241C0.557547 9.84609 0.845547 9.43209 1.07955 9.01809C1.52955 8.33409 1.94355 7.65009 2.37555 6.96609L3.05955 5.90409C3.32955 5.45409 3.31155 5.45409 3.02355 5.02209C2.55555 4.32009 2.12355 3.60009 1.67355 2.89809C1.40355 2.46609 1.09755 2.07009 0.827547 1.63809L0.053547 0.414094C0.0355469 0.360093 0.0355469 0.306093 0.053547 0.252094C0.125547 0.0900936 0.233547 0.0360932 0.377547 0.0360932C0.755547 0.0360932 1.11555 0.0180935 1.49355 0.0360932C1.69155 0.054093 1.87155 0.162094 1.96155 0.324093C2.33955 0.918094 2.68155 1.53009 3.11355 2.08809C3.54555 2.64609 3.81555 3.25809 4.22955 3.79809C4.24755 3.81609 4.28355 3.81609 4.37355 3.85209Z" fill="#FFF9EF"/>
            </svg>
          </button>
        </div>

        {%- if cart == empty -%}
          {%- comment -%} ===== EMPTY STATE ===== {%- endcomment -%}
          <div class="drawer__inner-empty cd-empty">
            <span class="cd-empty__icon" aria-hidden="true">
              <svg width="46" height="56" viewBox="0 0 46 56" fill="none" xmlns="http://www.w3.org/2000/svg">
                <path d="M45.1918 47.0111C45.0797 45.7791 44.9677 44.6311 44.9677 42.2232C44.9677 37.2953 45.0237 37.2953 45.0237 32.3674C45.0237 29.8754 45.0237 28.6714 45.0237 27.4115C45.0237 26.1515 45.0237 24.9475 44.9397 22.5396V22.2596C44.9397 21.7276 44.9677 21.4476 45.0237 21.1116C45.0517 20.8036 45.1078 20.4396 45.1078 19.9356C45.1078 19.6276 45.1078 19.2916 45.0517 18.8716C44.7435 15.9597 44.4634 14.4757 44.2112 13.0477C43.9591 11.6198 43.7069 10.2478 43.4828 7.36385C43.4547 6.99986 43.4547 6.74787 43.4547 6.52387C43.4547 6.07588 43.4828 5.82388 43.5388 5.43189C43.5948 5.0399 43.6509 4.53591 43.6509 3.80792V3.55593C43.5108 1.62397 41.8858 0.139997 39.9246 0H39.7004C38.916 0 38.4397 0.0839983 38.0474 0.139997C37.6552 0.195996 37.375 0.251995 36.6466 0.251995H36.3664C32.1078 0.251995 32.0237 0.139997 27.5129 0.139997H27.4849C22.9461 0.139997 22.9181 0.167997 18.3793 0.167997C13.8405 0.167997 13.8405 0.0279994 9.24569 0.0279994H9.18966C8.26509 0.0279994 7.76078 0.0839983 7.3125 0.139997C6.86422 0.195996 6.5 0.223996 5.63147 0.251995C4.59483 0.279994 3.64224 0.643987 2.88578 1.25997C2.12931 1.87596 1.59698 2.79994 1.59698 3.86392C1.59698 5.34789 1.73707 5.76789 1.70905 6.46787C1.70905 6.74787 1.70905 7.08386 1.65302 7.61585C1.14871 13.5237 1.37284 13.4957 0.700431 19.3196C0.616379 20.3276 0.112069 21.4756 0.0840516 22.9315C0.0840516 27.8034 0.140086 27.8034 0.140086 32.6194V32.7034C0.140086 37.3793 0 37.4633 0 42.2232V42.3072C0 44.7711 0.140086 46.0311 0.252155 47.2631C0.364224 48.467 0.504311 49.615 0.504311 51.995C0.504311 53.0589 0.924569 54.0389 1.59698 54.7669C2.2694 55.5229 3.27802 56.0269 4.39871 55.9989C10.5345 55.9989 10.5345 55.7749 16.6142 55.7749C22.75 55.7749 22.75 55.5509 28.8297 55.5509C34.9095 55.5509 34.9095 55.6069 41.0453 55.6069C42.0539 55.6069 43.0905 55.2989 43.931 54.7109C44.7716 54.1509 45.5 53.2269 45.5 52.023C45.5 49.531 45.3879 48.243 45.2478 47.0111H45.1918ZM41.6056 28.1954C41.4935 29.3714 41.3535 30.6314 41.3535 33.0393C41.3535 37.