7284 5.57189Z" fill="black"/>
              </svg>

              <span class="cd-empty__count">0</span>
            </span>
            <h3 class="cd-empty__title">{{ section.settings.empty_heading }}</h3>
            {%- if section.settings.empty_text != blank -%}
              <p class="cd-empty__text">{{ section.settings.empty_text }}</p>
            {%- endif -%}

            {%- assign empty_coll = section.settings.empty_collection -%}
            {%- if empty_coll != blank and empty_coll.products_count > 0 -%}
              <div class="cd-shop--main">
                <div class="cd-shop__head">
                  <p class="cd-shop__label">{{ section.settings.empty_collection_title }}</p>
                  <div class="cd-carousel__nav">
                    <button type="button" class="cd-carousel__arrow empty-prev" aria-label="Previous">
                      <svg width="16" height="8" viewBox="0 0 16 8" fill="none" xmlns="http://www.w3.org/2000/svg">
                        <path d="M5.96542 8C5.67819 7.33884 5.37993 6.75482 5.07061 6.24793C4.76129 5.71901 4.45197 5.26722 4.14265 4.89256H16V3.10744H4.14265C4.45197 2.71074 4.76129 2.25895 5.07061 1.75207C5.37993 1.22314 5.67819 0.639119 5.96542 0H4.40778C3.01585 1.60882 1.54659 2.7989 0 3.57025V4.42975C1.54659 5.17906 3.01585 6.36915 4.40778 8H5.96542Z" fill="black"/>
                      </svg>
                    </button>
                    <button type="button" class="cd-carousel__arrow empty-next" aria-label="Next">
                      <svg width="16" height="8" viewBox="0 0 16 8" fill="none" xmlns="http://www.w3.org/2000/svg">
                        <path d="M10.0346 8C10.3218 7.33884 10.6201 6.75482 10.9294 6.24793C11.2387 5.71901 11.548 5.26722 11.8573 4.89256H0V3.10744H11.8573C11.548 2.71074 11.2387 2.25895 10.9294 1.75207C10.6201 1.22314 10.3218 0.639119 10.0346 0H11.5922C12.9841 1.60882 14.4534 2.7989 16 3.57025V4.42975C14.4534 5.17906 12.9841 6.36915 11.5922 8H10.0346Z" fill="black"/>
                      </svg>
                    </button>
                  </div>
                </div>
                <div class="cd-shop splide js-empty-cart-slider">
                  <div class="splide__track">
                    <ul class="splide__list">
                      {%- for product in empty_coll.products limit: 8 -%}
                        {%- comment -%} One card per Recipe (mirrors the collection page); products without a Recipe option render a single card. {%- endcomment -%}
                        {%- assign recipe_idx0 = -1 -%}
                        {%- for opt in product.options -%}
                          {%- assign optname = opt | downcase | strip -%}
                          {%- if optname == 'recipe' -%}{%- assign recipe_idx0 = forloop.index0 -%}{%- endif -%}
                        {%- endfor -%}
                        {%- if recipe_idx0 >= 0 -%}
                          {%- assign recipe_values = '' -%}
                          {%- for v in product.variants -%}
                            {%- assign token = v.options[recipe_idx0] | append: '||' -%}
                            {%- unless recipe_values contains token -%}
                              {%- assign recipe_values = recipe_values | append: token -%}
                            {%- endunless -%}
                          {%- endfor -%}
                          {%- assign recipe_list = recipe_values | split: '||' -%}
                          {%- for rv in recipe_list -%}
                            {%- assign rv_check = rv | strip | downcase -%}
                            {%- if rv_check == 'healthy grains (original)' -%}{%- continue -%}{%- endif -%}
                            <li class="splide__slide">
                              {% render 'cart-drawer-product-card', product: product, style: 'empty', recipe: rv %}
                            </li>
                          {%- endfor -%}
                        {%- else -%}
                          <li class="splide__slide">
                            {% render 'cart-drawer-product-card', product: product, style: 'empty' %}
                          </li>
                        {%- endif -%}
                      {%- endfor -%}
                    </ul>
                  </div>
                </div>
              </div>
            {%- endif -%}

            <a
              href="{{ section.settings.empty_button_link | default: routes.all_products_collection_url }}"
              class="cd-empty__shop-all"
            >
              {{ section.settings.empty_button_label }}
            </a>
          </div>
        {%- else -%}
          {%- comment -%} ===== REWARDS: member scheme OR spend-based tiers ===== {%- endcomment -%}
          {%- comment -%} Hide the spend tiers for members AND when the membership product is in the cart. {%- endcomment -%}
          <div class="fill--cart--container">
            {%- if show_congrats_banner -%}
              {%- comment -%} Membership added: gold status bar with the Yum Club logo + discount confirmation. {%- endcomment -%}
              {%- assign congrats_text = section.settings.banner_congrats_text
                | default: 'Your {percent}% discount has been applied!'
              -%}
              {%- assign congrats_text = congrats_text | replace: '{percent}', member_percent -%}
              <div class="cd-banner cd-banner--congrats">
                <div class="cd-congrats">
                  <span class="cd-congrats__logo" aria-hidden="true">
                    <svg
                      class="cd-congrats__logo-svg"
                      width="104"
                      height="36"
                      viewBox="0 0 104 36"
                      fill="none"
                      xmlns="http://www.w3.org/2000/svg"
                    >
