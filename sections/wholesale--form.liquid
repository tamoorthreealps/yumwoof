{%- comment -%}
  Extracted from the wholesale page block (.create_wholesale_act).
  Class names kept identical so the existing scroll-to script on
  .wholesale_opt_btn still finds this element.

  Torn top/bottom edges are drawn with CSS masks on ::before / ::after
  so the "torn" colour can be matched to whatever sits above and below
  the band in the theme editor.
{%- endcomment -%}

<div class="create_wholesale_act" id="create-wholesale-act-{{ section.id }}">
  <div class="wholesale_act_inner">

    <div class="wholesale_act_left">
      {%- if section.settings.eyebrow != blank -%}
        <div class="wholesale_act_eyebrow">{{ section.settings.eyebrow }}</div>
      {%- endif -%}

      {%- if section.settings.title != blank -%}
        <div class="wholesale_act_title">
          <span>{{ section.settings.title }}</span>
        </div>
      {%- endif -%}

      {%- if section.settings.description != blank -%}
        <div class="wholesale_act_dsc">
          <span>{{ section.settings.description }}</span>
        </div>
      {%- endif -%}

      {%- if section.blocks.size > 0 -%}
        <div class="wholesale_act_features">
          {%- for block in section.blocks -%}
            <div class="wholesale_act_feature" {{ block.shopify_attributes }}>
              {%- if block.settings.label != blank -%}
                <div class="wholesale_act_feature_label">{{ block.settings.label }}</div>
              {%- endif -%}
              {%- if block.settings.text != blank -%}
                <div class="wholesale_act_feature_text">{{ block.settings.text }}</div>
              {%- endif -%}
            </div>
          {%- endfor -%}
        </div>
      {%- endif -%}
    </div>

    {%- if section.settings.klaviyo_form_id != blank -%}
      <div class="wholesale_act_right">
        <div class="wholesale_act_klaviyo">
          <div class="klaviyo-form-{{ section.settings.klaviyo_form_id }}"></div>
        </div>
      </div>
    {%- endif -%}

  </div>
</div>

<style>
  #create-wholesale-act-{{ section.id }} {
    --wa-bg: {{ section.settings.bg_color }};
    --wa-text: {{ section.settings.text_color }};
    --wa-accent: {{ section.settings.accent_color }};
    --wa-field-bg: {{ section.settings.field_bg_color }};
    --wa-btn-bg: {{ section.settings.button_bg_color }};
    --wa-btn-text: {{ section.settings.button_text_color }};

    color: var(--wa-text);
    position: relative;
    display: block;
    max-width: 100%;
    font-family: Montserrat, sans-serif;
    padding: 80px 60px;
    background-color: var(--wa-bg);
    isolation: isolate;
  }

  /* --- torn edges --- */
  #create-wholesale-act-{{ section.id }}::before,
  #create-wholesale-act-{{ section.id }}::after {
    content: "";
    position: absolute;
    left: 0;
    right: 0;
    height: 20px;
    background-color: {{ section.settings.edge_color }};
    z-index: 1;
    pointer-events: none;
    -webkit-mask-repeat: repeat-x;
    mask-repeat: repeat-x;
    -webkit-mask-size: 1200px 20px;
    mask-size: 1200px 20px;
    -webkit-mask-image: var(--wa-tear);
    mask-image: var(--wa-tear);
  }

  #create-wholesale-act-{{ section.id }}::before { top: 0; }
  #create-wholesale-act-{{ section.id }}::after { bottom: 0; transform: scaleY(-1); }

  #create-wholesale-act-{{ section.id }} p { margin: 0; }

  /* --- layout --- */
  #create-wholesale-act-{{ section.id }} .wholesale_act_inner {
    position: relative;
    z-index: 2;
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    column-gap: 80px;
    row-gap: 40px;
    align-items: start;
    max-width: 1200px;
    margin: 0 auto;
  }

  /* --- left column --- */
  #create-wholesale-act-{{ section.id }} .wholesale_act_eyebrow {
    font-family: Montserrat, sans-serif;
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 1.5px;
    text-transform: uppercase;
    color: var(--wa-accent);
    margin-bottom: 12px;
  }

  #create-wholesale-act-{{ section.id }} .wholesale_act_title {
    font-size: 40px;
    font-family: GalanoGrotesque, sans-serif;
    font-weight: 600;
    line-height: 44px;
    letter-spacing: 0.5px;
    text-transform: uppercase;
    overflow-wrap: break-word;
  }

  #create-wholesale-act-{{ section.id }} .wholesale_act_dsc {
    font-size: 15px;
    max-width: 420px;
    font-family: Montserrat, sans-serif;
    font-weight: 400;
    line-height: 22px;
    margin-top: 32px;
    overflow-wrap: break-word;
  }

  #create-wholesale-act-{{ section.id }} .wholesale_act_features {
    margin-top: 32px;
    max-width: 420px;
  }

  #create-wholesale-act-{{ section.id }} .wholesale_act_feature {
    padding: 16px 0;
    border-top: 1px solid rgba(243, 230, 211, 0.25);
  }

  #create-wholesale-act-{{ section.id }} .wholesale_act_feature:last-child {
    border-bottom: 1px solid rgba(243, 230, 211, 0.25);
  }

  #create-wholesale-act-{{ section.id }} .wholesale_act_feature_label {
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 1.2px;
    text-transform: uppercase;
    color: var(--wa-accent);
    margin-bottom: 6px;
  }

  #create-wholesale-act-{{ section.id }} .wholesale_act_feature_text {
    font-size: 14px;
    line-height: 20px;
  }

  /* --- right column / Klaviyo --- */
  #create-wholesale-act-{{ section.id }} .wholesale_act_klaviyo {
    width: 100%;
  }

  #create-wholesale-act-{{ section.id }} .wholesale_act_klaviyo img {
    object-fit: fill;
    min-width: auto;
    max-height: none;
    min-height: auto;
  }

  /* Klaviyo embed overrides — scoped to this section only */
  #create-wholesale-act-{{ section.id }} .wholesale_act_klaviyo input[type="text"],
  #create-wholesale-act-{{ section.id }} .wholesale_act_klaviyo input[type="email"],
  #create-wholesale-act-{{ section.id }} .wholesale_act_klaviyo input[type="tel"],
  #create-wholesale-act-{{ section.id }} .wholesale_act_klaviyo input[type="url"],
  #create-wholesale-act-{{ section.id }} .wholesale_act_klaviyo select {
    width: 100%;
    box-sizing: border-box;
    height: 46px;
    padding: 0 18px;
    border: 0;
    border-radius: 8px;
    background-color: var(--wa-field-bg);
    font-family: Montserrat, sans-serif;
    font-size: 14px;
    color: #3A2318;
  }

  #create-wholesale-act-{{ section.id }} .wholesale_act_klaviyo input::placeholder {
    color: rgba(58, 35, 24, 0.6);
  }

  #create-wholesale-act-{{ section.id }} .wholesale_act_klaviyo button,
  #create-wholesale-act-{{ section.id }} .wholesale_act_klaviyo button[type="submit"] {
    width: 100%;
    height: 52px;
    border: 0;
    border-radius: 999px;
    background-color: var(--wa-btn-bg);
    color: var(--wa-btn-text);
    font-family: GalanoGrotesque, Montserrat, sans-serif;
    font-size: 15px;
    font-weight: 700;
    letter-spacing: 1.5px;
    text-transform: uppercase;
    cursor: pointer;
  }

  @media (max-width: 900px) {
    #create-wholesale-act-{{ section.id }} .wholesale_act_inner {
      column-gap: 40px;
    }
  }

  @media (max-width: 749px) {
    #create-wholesale-act-{{ section.id }} {
      padding: 56px 20px;
    }

    #create-wholesale-act-{{ section.id }}::before,
    #create-wholesale-act-{{ section.id }}::after {
      height: 14px;
      -webkit-mask-size: 600px 14px;
      mask-size: 600px 14px;
    }

    #create-wholesale-act-{{ section.id }} .wholesale_act_inner {
      grid-template-columns: minmax(0, 1fr);
      row-gap: 36px;
    }

    #create-wholesale-act-{{ section.id }} .wholesale_act_title {
      font-size: 28px;
      line-height: 32px;
    }

    #create-wholesale-act-{{ section.id }} .wholesale_act_dsc {
      font-size: 14px;
      line-height: 20px;
      margin-top: 20px;
      max-width: none;
    }

    #create-wholesale-act-{{ section.id }} .wholesale_act_features {
      max-width: none;
      margin-top: 24px;
    }
  }
</style>

{% schema %}
{
  "name": "Wholesale account form",
  "tag": "section",
  "class": "wholesale-create-account",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Apply"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "Create a wholesale account"
    },
    {
      "type": "richtext",
      "id": "description",
      "label": "Description",
      "default": "<p>Apply on yumwoof.com by completing the form. Once approved, your stores get access to our distributor pricing.</p>"
    },
    {
      "type": "text",
      "id": "klaviyo_form_id",
      "label": "Klaviyo form ID",
      "info": "The ID only, e.g. RAPfgV — renders as .klaviyo-form-RAPfgV",
      "default": "RAPfgV"
    },
    {
      "type": "header",
      "content": "Colours"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background",
      "default": "#6B2222"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text",
      "default": "#F3E6D3"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent (eyebrow and labels)",
      "default": "#E8A33D"
    },
    {
      "type": "color",
      "id": "field_bg_color",
      "label": "Form field background",
      "default": "#FDF3E3"
    },
    {
      "type": "color",
      "id": "button_bg_color",
      "label": "Button background",
      "default": "#F5C46B"
    },
    {
      "type": "color",
      "id": "button_text_color",
      "label": "Button text",
      "default": "#3A2318"
    },
    {
      "type": "color",
      "id": "edge_color",
      "label": "Torn edge colour",
      "info": "Should match the page background directly above and below this section.",
      "default": "#FDF3E3"
    }
  ],
  "blocks": [
    {
      "type": "feature",
      "name": "Benefit",
      "settings": [
        {
          "type": "text",
          "id": "label",
          "label": "Label",
          "default": "Distributor pricing"
        },
        {
          "type": "text",
          "id": "text",
          "label": "Text",
          "default": "No markup. The same price we sell at, direct."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Wholesale account form",
      "blocks": [
        { "type": "feature" },
        { "type": "feature" },
        { "type": "feature" },
        { "type": "feature" }
      ]
    }
  ]
}
{% endschema %}
