{{ 'css--about-hero.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign s = section.settings
  assign uid = section.id
-%}

<section
  class="about-hero"
  id="about-hero-{{ uid }}"
  style="
    --ah-grad-top: {{ s.color_grad_top }};
    --ah-grad-bottom: {{ s.color_grad_bottom }};
    --ah-text: {{ s.color_text }};
    --ah-muted: {{ s.color_muted }};
    --ah-stroke: {{ s.color_stroke }};
    --ah-badge-bg: {{ s.color_badge_bg }};
    --ah-badge-text: {{ s.color_badge_text }};
    --ah-pad-top: {{ s.padding_top }}px;
    --ah-pad-bottom: {{ s.padding_bottom }}px;
    --ah-pad-top-mobile: {{ s.padding_top_mobile }}px;
    --ah-pad-bottom-mobile: {{ s.padding_bottom_mobile }}px;
  "
>
  <div class="about-hero__inner">
{%- if s.headline != blank -%}
  <h1 class="about-hero__headline">
    {%- assign headline_words = s.headline | split: ' ' -%}
    {%- for word in headline_words -%}
      <span
        class="about-hero__headline-word"
        style="--delay: {{ forloop.index0 | times: 0.15 }}s;"
      >{{ word }}</span>{% unless forloop.last %}{% endunless %}
    {%- endfor -%}
  </h1>
{%- endif -%}

    {%- if s.stroke_image != blank or s.stroke_image_mobile != blank -%}
      <span class="about-hero__stroke {% if s.stroke_image != blank or s.stroke_image_mobile != blank %}about-hero__stroke_img{% endif %}" aria-hidden="true">
        {%- if s.stroke_image_mobile != blank -%}
          <picture>
            <source
              media="(max-width: 767px)"
              srcset="{{ s.stroke_image_mobile | image_url: width: 800 }}"
            >
            {%- if s.stroke_image != blank -%}
              {{ s.stroke_image | image_url: width: 1200 | image_tag: loading: 'lazy', alt: '' }}
            {%- endif -%}
          </picture>
        {%- elsif s.stroke_image != blank -%}
          {{ s.stroke_image | image_url: width: 1200 | image_tag: loading: 'lazy', alt: '' }}
        {%- endif -%}
      </span>
    {%- else -%}
      <span class="about-hero__stroke" aria-hidden="true"></span>
    {%- endif -%}

    {%- if s.intro != blank -%}
      <p class="about-hero__intro">{{ s.intro }}</p>
    {%- endif -%}

    {%- if s.lede != blank -%}
      <p class="about-hero__lede">{{ s.lede }}</p>
    {%- endif -%}

    {%- if s.image_1 != blank or s.image_2 != blank -%}
      <div class="about-hero__collage">
        {%- if s.image_1 != blank -%}
          <div class="about-hero__photo about-hero__photo--1">
            {{
              s.image_1
              | image_url: width: 1100
              | image_tag:
                loading: 'lazy',
                widths: '360, 544, 720, 1088',
                sizes: '(min-width: 768px) 540px, 68vw',
                alt: s.image_1.alt | default: ''
            }}
          </div>
        {%- endif -%}
        {%- if s.image_2 != blank -%}
          <div class="about-hero__photo about-hero__photo--2">
            {{
              s.image_2
              | image_url: width: 900
              | image_tag:
                loading: 'lazy',
                widths: '300, 448, 600, 896',
                sizes: '(min-width: 768px) 445px, 60vw',
                alt: s.image_2.alt | default: ''
            }}
          </div>
        {%- endif -%}
        {%- if s.badge_image != blank -%}
          <span class="about-hero__badge about-hero__badge_img">
            {{ s.badge_image | image_url: width: 300 | image_tag: loading: 'lazy', alt: '' }}
          </span>
        {%- elsif s.badge_text != blank -%}
          <span class="about-hero__badge">{{ s.badge_text }}</span>
        {%- endif -%}
      </div>
    {%- endif -%}

    {%- if s.closing != blank -%}
      <p class="about-hero__closing">{{ s.closing }}</p>
    {%- endif -%}

    {%- if s.signature_image != blank -%}
      <div class="about-hero__signature">
        {{
          s.signature_image
          | image_url: width: 574
          | image_tag:
            loading: 'lazy',
            widths: '200, 286, 430, 574',
            sizes: '(min-width: 768px) 286px, 200px',
            alt: s.signature_image.alt | default: 'Founders signature'
        }}
      </div>
    {%- endif -%}

    {%- if s.attribution != blank -%}
      <p class="about-hero__attribution">{{ s.attribution | escape }}</p>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "About Hero",
  "tag": "section",
  "class": "about-hero-section",
  "settings": [
    { "type": "header", "content": "Headline" },
    { "type": "text", "id": "headline", "label": "Headline", "default": "Dogs Deserve Real Food" },
    { "type": "image_picker", "id": "stroke_image", "label": "Underline image (optional)", "info": "A brush-stroke underline. Leave empty to use a solid colored line." },
    { "type": "image_picker", "id": "stroke_image_mobile", "label": "Underline image mobile (optional)", "info": "Mobile-specific brush-stroke underline. Leave empty to use the desktop underline image." },

    { "type": "header", "content": "Intro" },
    { "type": "textarea", "id": "intro", "label": "Intro statement", "default": "Yumwoof was founded by my wife Ana and me after years spent researching nutrition, inflammation, and gut health." },
    { "type": "textarea", "id": "lede", "label": "Supporting text", "default": "Along the way, we became increasingly frustrated by how much of the pet food industry relied on heavily processed ingredients, synthetic additives, and manufacturing shortcuts." },

    { "type": "header", "content": "Image collage" },
    { "type": "image_picker", "id": "image_1", "label": "Image 1 (front / left)" },
    { "type": "image_picker", "id": "image_2", "label": "Image 2 (back / right)" },
    { "type": "text", "id": "badge_text", "label": "Badge text", "default": "Family Owned", "info": "Leave empty to hide the badge." },
    { "type": "image_picker", "id": "badge_image", "label": "Badge image (optional)", "info": "If an image is selected, it will be shown instead of the badge text." },

    { "type": "header", "content": "Closing" },
    { "type": "textarea", "id": "closing", "label": "Closing text", "default": "Today, Yumwoof creates air-dried recipes built around premium proteins, healthy fats, and whole food nutrition. Rather than formulating around cost or convenience, we focus on creating food we would proudly feed our own dog, Sherlock." },
    { "type": "image_picker", "id": "signature_image", "label": "Signature image" },
    { "type": "text", "id": "attribution", "label": "Attribution", "default": "Jaron & Ana, Founders" },

    { "type": "header", "content": "Colors" },
    { "type": "color", "id": "color_grad_top", "label": "Background gradient top", "default": "#cfe0f4" },
    { "type": "color", "id": "color_grad_bottom", "label": "Background gradient bottom", "default": "#fff9ef" },
    { "type": "color", "id": "color_text", "label": "Text", "default": "#0d0d0d" },
    { "type": "color", "id": "color_muted", "label": "Muted text", "default": "#4d4d4d" },
    { "type": "color", "id": "color_stroke", "label": "Underline color", "default": "#661d1d" },
    { "type": "color", "id": "color_badge_bg", "label": "Badge background", "default": "#ffc069" },
    { "type": "color", "id": "color_badge_text", "label": "Badge text", "default": "#0d0d0d" },

    { "type": "header", "content": "Spacing" },
    { "type": "range", "id": "padding_top", "label": "Padding top (desktop)", "min": 0, "max": 320, "step": 4, "unit": "px", "default": 228 },
    { "type": "range", "id": "padding_bottom", "label": "Padding bottom (desktop)", "min": 0, "max": 320, "step": 4, "unit": "px", "default": 132 },
    { "type": "range", "id": "padding_top_mobile", "label": "Padding top (mobile)", "min": 0, "max": 240, "step": 4, "unit": "px", "default": 112 },
    { "type": "range", "id": "padding_bottom_mobile", "label": "Padding bottom (mobile)", "min": 0, "max": 240, "step": 4, "unit": "px", "default": 64 }
  ],
  "presets": [{ "name": "About Hero" }]
}
{% endschema %}
