{{ 'css--about-timeline.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign s = section.settings
  assign uid = section.id

  # Bottom wash (desktop): the cream fades to this colour so the CTA's blue
  # background starts in this section. Disabled → keep the base colour (no fade).
  assign wash_bottom = s.color_wash_bottom
  unless s.enable_wash
    assign wash_bottom = s.color_bg
  endunless
-%}


<section
  class="about-timeline"
  id="about-timeline-{{ uid }}"
  data-about-timeline
  style="
    --at-bg: {{ s.color_bg }};
    --at-text: {{ s.color_text }};
    --at-eyebrow: {{ s.color_eyebrow }};
    --at-body: {{ s.color_body }};
    --at-line: {{ s.color_line }};
    --at-wash-bottom: {{ wash_bottom }};
    --at-wash-band: {{ s.wash_band }}px;
    --at-pad-top: {{ s.padding_top }}px;
    --at-pad-bottom: {{ s.padding_bottom }}px;
    --at-pad-top-mobile: {{ s.padding_top_mobile }}px;
    --at-pad-bottom-mobile: {{ s.padding_bottom_mobile }}px;
    --at-slides: {{ section.blocks.size | at_least: 1 }};
  "
>
  <div class="about-timeline__inner">
    {%- if s.heading != blank -%}
      <h2 class="about-timeline__heading">{{ s.heading }}</h2>
    {%- endif -%}

    {%- if section.blocks.size > 0 -%}
      <div class="about-timeline__list">
        {%- for block in section.blocks -%}
          {%- assign b = block.settings -%}
          <div class="about-timeline__item" {{ block.shopify_attributes }}>
            <div class="about-timeline__text about-timeline__text_{{ forloop.index }}">
              {%- if b.date != blank -%}
                <p class="about-timeline__date">{{ b.date }}</p>
              {%- endif -%}
              {%- if b.title != blank -%}
                <h3 class="about-timeline__title">{{ b.title }}</h3>
              {%- endif -%}
              {%- if b.body != blank -%}
                <div class="about-timeline__body">{{ b.body }}</div>
              {%- endif -%}
            </div>

            {%- if b.image_a != blank or b.image_b != blank -%}
              <div class="about-timeline__photos" aria-hidden="true">
                {%- if b.image_a != blank -%}
                  <div class="about-timeline__photo about-timeline__photo--a about-timeline__photo--a-{{ forloop.index }}">
                    {{
                      b.image_a
                      | image_url: width: 600
                      | image_tag:
                        loading: 'lazy',
                        widths: '160, 266, 400, 532',
                        sizes: '(min-width: 768px) 266px, 46vw',
                        alt: b.image_a.alt | default: ''
                    }}
                  </div>
                {%- endif -%}
                {%- if b.image_b != blank -%}
                  <div class="about-timeline__photo about-timeline__photo--b about-timeline__photo--b-{{ forloop.index }}">
                    {{
                      b.image_b
                      | image_url: width: 600
                      | image_tag:
                        loading: 'lazy',
                        widths: '160, 266, 400, 532',
                        sizes: '(min-width: 768px) 266px, 46vw',
                        alt: b.image_b.alt | default: ''
                    }}
                  </div>
                {%- endif -%}
              </div>
            {%- endif -%}
          </div>
        {%- endfor -%}
      </div>
    {%- endif -%}
  </div>
</section>

<script>
/* ==========================================================================
   About Timeline — scroll-pinned storytelling
   - Heading entrance (IntersectionObserver)
   - Pinned mode: list becomes a sticky stage, entries cross-fade by scroll
   - Reveal mode: automatic fallback when an entry can't fit the viewport or
     an ancestor's overflow blocks position: sticky
   - prefers-reduced-motion: does nothing at all (section stays as designed)
   - Theme editor: section load/unload + block select supported
   ========================================================================== */
(function () {
  if (window.__aboutTimelineReady) return;
  window.__aboutTimelineReady = true;

  var SELECTOR = '.about-timeline';
  var HOLD = 0.2;        // portion of a step where an entry is fully visible
  var FADE = 0.25;       // portion of a step used to fade in / out
  var SHIFT = 36;        // px of vertical travel while fading
  var LERP = 0.12;       // scroll smoothing (1 = none)
  var FIT_MARGIN = 96;   // px of breathing room an entry needs inside the stage

  var reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
  var instances = new Map();

  function clamp(n, min, max) { return Math.min(max, Math.max(min, n)); }
  function smoothstep(t) { return t * t * (3 - 2 * t); }

  // position: sticky dies if any ancestor (below <body>) clips overflow.
  function findClippingAncestor(el) {
    var node = el.parentElement;
    while (node && node !== document.body && node !== document.documentElement) {
      var cs = getComputedStyle(node);
      if (/(auto|scroll|hidden)/.test(cs.overflowX + ' ' + cs.overflowY)) return node;
      node = node.parentElement;
    }
    return null;
  }

  function Timeline(section) {
    this.section = section;
    this.heading = section.querySelector('.about-timeline__heading');
    this.inner = section.querySelector('.about-timeline__inner');
    this.list = section.querySelector('.about-timeline__list');
    this.items = this.list ? Array.prototype.slice.call(this.list.querySelectorAll('.about-timeline__item')) : [];
    this.observers = [];
    this.mode = null;
    this.current = null;
    this.raf = 0;
    this.near = true;
    this.cache = [];
    this.lastWidth = 0;
    this.lastHeight = 0;

    this.onScroll = this.requestTick.bind(this);
    this.onResize = this.handleResize.bind(this);
    this.tick = this.tick.bind(this);

    this.setup();
  }

  Timeline.prototype.setup = function () {
    if (reduceMotion.matches) return;
    var self = this;
    this.section.classList.add('about-timeline--anim');

    if (this.heading) {
      var ho = new IntersectionObserver(function (entries) {
        entries.forEach(function (entry) {
          if (!entry.isIntersecting) return;
          entry.target.classList.add('is-inview');
          ho.disconnect();
        });
      }, { threshold: 0.2 });
      ho.observe(this.heading);
      this.observers.push(ho);
    }

    if (!this.list || !this.items.length) return;

    // Only do scroll work while the section is near the viewport.
    var so = new IntersectionObserver(function (entries) {
      self.near = entries[0].isIntersecting;
      if (self.near) self.requestTick();
    }, { rootMargin: '50% 0px 50% 0px' });
    so.observe(this.section);
    this.observers.push(so);

    window.addEventListener('scroll', this.onScroll, { passive: true });
    window.addEventListener('resize', this.onResize);
    this.layout();
  };

  Timeline.prototype.resetMode = function () {
    this.section.classList.remove('is-pinned', 'is-reveal');
    this.items.forEach(function (item) {
      item.classList.remove('is-inview');
      item.style.removeProperty('--at-v');
      item.style.removeProperty('--at-y');
    });
    if (this.revealObserver) { this.revealObserver.disconnect(); this.revealObserver = null; }
    this.cache = [];
    this.current = null;
    this.mode = null;
  };

  Timeline.prototype.layout = function () {
    this.resetMode();
    this.lastWidth = window.innerWidth;
    this.lastHeight = window.innerHeight;

    // Measure natural entry height (design padding excluded) before pinning.
    var tallest = 0;
    this.items.forEach(function (item) {
      var cs = getComputedStyle(item);
      var h = item.offsetHeight - parseFloat(cs.paddingTop) - parseFloat(cs.paddingBottom);
      if (h > tallest) tallest = h;
    });
    var stage = document.documentElement.clientHeight;
    var clipper = findClippingAncestor(this.list);
    var canPin = this.items.length > 1 && !clipper && tallest + FIT_MARGIN <= stage;

    if (clipper && window.Shopify && window.Shopify.designMode) {
      console.info('[about-timeline] Pinning disabled: this ancestor clips overflow (use overflow: clip instead of hidden).', clipper);
    }

    if (canPin) {
      this.mode = 'pinned';
      this.section.style.setProperty('--at-count', this.items.length);
      this.section.classList.add('is-pinned');
      this.total = parseFloat(getComputedStyle(this.inner, '::after').height) || 0;
      this.step = this.total / (this.items.length - 1);
      this.pinTop = parseFloat(getComputedStyle(this.list).top) || 0;
      this.requestTick();
    } else {
      this.mode = 'reveal';
      this.section.classList.add('is-reveal');
      var ro = new IntersectionObserver(function (entries) {
        entries.forEach(function (entry) {
          if (!entry.isIntersecting) return;
          entry.target.classList.add('is-inview');
          ro.unobserve(entry.target);
        });
      }, { threshold: 0.25 });
      this.items.forEach(function (item) { ro.observe(item); });
      this.revealObserver = ro;
    }
  };

  Timeline.prototype.handleResize = function () {
    // Ignore mobile URL-bar height jitter; re-layout on real changes only.
    var dw = Math.abs(window.innerWidth - this.lastWidth);
    var dh = Math.abs(window.innerHeight - this.lastHeight);
    if (dw < 2 && dh < 140) return;
    clearTimeout(this.resizeTimer);
    this.resizeTimer = setTimeout(this.layout.bind(this), 150);
  };

  Timeline.prototype.requestTick = function () {
    if (this.mode !== 'pinned' || !this.near || this.raf) return;
    this.raf = requestAnimationFrame(this.tick);
  };

  Timeline.prototype.readTarget = function () {
    var lr = this.list.getBoundingClientRect();
    var pre = lr.top - this.pinTop;
    var p;
    if (pre > 1) {
      p = -pre / this.step;                       // approaching the pin
    } else {
      var ir = this.inner.getBoundingClientRect();
      p = (this.total - (ir.bottom - lr.bottom)) / this.step;   // inside / after
    }
    return clamp(p, -1, this.items.length - 1);
  };

  Timeline.prototype.tick = function () {
    this.raf = 0;
    if (this.mode !== 'pinned') return;
    var target = this.readTarget();                // reads
    if (this.current === null) this.current = target;
    this.current += (target - this.current) * LERP;
    var settled = Math.abs(target - this.current) < 0.0005;
    if (settled) this.current = target;
    this.render(this.current);                     // writes
    if (!settled) this.raf = requestAnimationFrame(this.tick);
  };

  Timeline.prototype.render = function (p) {
    var last = this.items.length - 1;
    for (var i = 0; i <= last; i++) {
      var d = p - i;
      if (i === last && d > 0) d = 0;              // last entry stays for the release
      var v = smoothstep(clamp(1 - (Math.abs(d) - HOLD) / FADE, 0, 1));
      var y = (1 - v) * SHIFT * (d < 0 ? 1 : -1);  // in from below, out upward
      var key = v.toFixed(3) + '|' + y.toFixed(1);
      if (this.cache[i] === key) continue;
      this.cache[i] = key;
      this.items[i].style.setProperty('--at-v', v.toFixed(3));
      this.items[i].style.setProperty('--at-y', y.toFixed(1) + 'px');
    }
  };

  // Theme editor: jump the pinned scroll to a given entry.
  Timeline.prototype.goTo = function (index) {
    if (this.mode !== 'pinned') return;
    var ir = this.inner.getBoundingClientRect();
    var pinStart = window.scrollY + ir.bottom - this.total - this.list.offsetHeight - this.pinTop;
    window.scrollTo(0, Math.round(pinStart + index * this.step));
  };

  Timeline.prototype.destroy = function () {
    cancelAnimationFrame(this.raf);
    clearTimeout(this.resizeTimer);
    window.removeEventListener('scroll', this.onScroll);
    window.removeEventListener('resize', this.onResize);
    this.observers.forEach(function (o) { o.disconnect(); });
    this.observers = [];
    this.resetMode();
    this.section.classList.remove('about-timeline--anim');
    if (this.heading) this.heading.classList.remove('is-inview');
  };

  function create(section) {
    if (instances.has(section)) instances.get(section).destroy();
    instances.set(section, new Timeline(section));
  }
  function initAll(root) {
    (root || document).querySelectorAll(SELECTOR).forEach(create);
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', function () { initAll(); });
  } else {
    initAll();
  }

  // Re-measure once fonts/images have settled.
  window.addEventListener('load', function () {
    instances.forEach(function (inst) { if (inst.mode) inst.layout(); });
  });

  reduceMotion.addEventListener('change', function () {
    instances.forEach(function (inst, section) { inst.destroy(); });
    instances.clear();
    initAll();
  });

  document.addEventListener('shopify:section:load', function (e) { initAll(e.target); });
  document.addEventListener('shopify:section:unload', function (e) {
    e.target.querySelectorAll(SELECTOR).forEach(function (section) {
      if (!instances.has(section)) return;
      instances.get(section).destroy();
      instances.delete(section);
    });
  });
  document.addEventListener('shopify:block:select', function (e) {
    instances.forEach(function (inst) {
      var index = inst.items.indexOf(e.target);
      if (index > -1) inst.goTo(index);
    });
  });
})();

</script>

{% schema %}
{
  "name": "About Timeline",
  "tag": "section",
  "class": "about-timeline-section",
  "settings": [
    { "type": "header", "content": "Heading" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "The Origin" },

    { "type": "header", "content": "Colors" },
    { "type": "color", "id": "color_bg", "label": "Background", "default": "#fff9ef" },
    { "type": "color", "id": "color_text", "label": "Heading / title", "default": "#0d0d0d" },
    { "type": "color", "id": "color_eyebrow", "label": "Date eyebrow", "default": "#661d1d" },
    { "type": "color", "id": "color_body", "label": "Body text", "default": "#1a1a1a" },
    { "type": "color", "id": "color_line", "label": "Connector line", "default": "#bfbbb3" },

    { "type": "header", "content": "Bottom wash (desktop)", "info": "Fades the background to the CTA's wash colour across the bottom of this section, so the blue background starts here rather than in the CTA. Desktop only." },
    { "type": "checkbox", "id": "enable_wash", "label": "Enable bottom wash", "default": true },
    { "type": "color", "id": "color_wash_bottom", "label": "Wash bottom color", "default": "#cfe0f4" },
    { "type": "range", "id": "wash_band", "label": "Fade height", "min": 120, "max": 800, "step": 8, "unit": "px", "default": 400 },

    { "type": "header", "content": "Spacing" },
    { "type": "range", "id": "padding_top", "label": "Padding top (desktop)", "min": 0, "max": 400, "step": 4, "unit": "px", "default": 120 },
    { "type": "range", "id": "padding_bottom", "label": "Padding bottom (desktop)", "min": 0, "max": 400, "step": 4, "unit": "px", "default": 120 },
    { "type": "range", "id": "padding_top_mobile", "label": "Padding top (mobile)", "min": 0, "max": 400, "step": 4, "unit": "px", "default": 80 },
    { "type": "range", "id": "padding_bottom_mobile", "label": "Padding bottom (mobile)", "min": 0, "max": 400, "step": 4, "unit": "px", "default": 80 }
  ],
  "blocks": [
    {
      "type": "entry",
      "name": "Timeline entry",
      "settings": [
        { "type": "text", "id": "date", "label": "Date / period", "default": "2017–2018" },
        { "type": "text", "id": "title", "label": "Title", "default": "Food was the problem" },
        { "type": "richtext", "id": "body", "label": "Body", "default": "<p>We were dealing with our own health challenges when our dog Sherlock started showing similar signs. The connection between food and long-term health became impossible to ignore.</p>" },
        { "type": "image_picker", "id": "image_a", "label": "Photo (left)" },
        { "type": "image_picker", "id": "image_b", "label": "Photo (right)" }
      ]
    }
  ],
  "presets": [
    {
      "name": "About Timeline",
      "blocks": [
        {
          "type": "entry",
          "settings": {
            "date": "2017–2018",
            "title": "Food was the problem",
            "body": "<p>We were dealing with our own health challenges when our dog Sherlock started showing similar signs. The connection between food and long-term health became impossible to ignore. That sent us searching for food we could actually trust — and deep into the research behind why so few options seemed to exist for dogs.</p>"
          }
        },
        {
          "type": "entry",
          "settings": {
            "date": "2019–2020",
            "title": "We couldn't find it, so we made it",
            "body": "<p>Unable to find a dog food that reflected our standards, we decided to create one ourselves. We set out to combine premium proteins, healthy fats, nutrient-dense organ meats, and minimal processing into a food inspired by nature and informed by science. In 2020, we launched one of the first cluster-style air-dried dog foods.</p>"
          }
        },
        {
          "type": "entry",
          "settings": {
            "date": "2021–2023",
            "title": "The same patterns kept emerging",
            "body": "<p>As more families joined the Yumwoof community, we spent hundreds of hours speaking directly with dog parents about the health challenges they were facing. The same concerns surfaced again and again — allergies, digestive issues, skin problems, and picky eating. Those conversations reinforced the research, helping shape The Canine Cocomega™ Effect and the nutritional philosophy behind every Yumwoof recipe.</p>"
          }
        },
        {
          "type": "entry",
          "settings": {
            "date": "2024–Today",
            "title": "One bowl became something bigger",
            "body": "<p>As more families joined us, our recipes expanded, our network of trusted farmers, ranchers, and fishermen deepened, and our standards continued to evolve. What never changed was our commitment to creating food we would proudly feed our own dog. What began with a single bowl has grown into multiple ways to help dogs eat better.</p>"
          }
        }
      ]
    }
  ]
}
{% endschema %}
