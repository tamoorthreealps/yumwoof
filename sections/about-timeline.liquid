{{ 'css--about-timeline.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign s = section.settings
  assign uid = section.id

  # Bottom wash (desktop): the cream fades to this colour so the CTA's blue
  # background starts in this section. Disabled → keep the base colour (no fade).
  assign wash_bottom = s.color_wash_bottom
  unless s.enable_wash
    assign wash_bottom = s.color_bg
  endunless
-%}

<section
  class="about-timeline"
  id="about-timeline-{{ uid }}"
  data-about-timeline
  style="
    --at-bg: {{ s.color_bg }};
    --at-text: {{ s.color_text }};
    --at-eyebrow: {{ s.color_eyebrow }};
    --at-body: {{ s.color_body }};
    --at-line: {{ s.color_line }};
    --at-wash-bottom: {{ wash_bottom }};
    --at-wash-band: {{ s.wash_band }}px;
    --at-pad-top: {{ s.padding_top }}px;
    --at-pad-bottom: {{ s.padding_bottom }}px;
    --at-pad-top-mobile: {{ s.padding_top_mobile }}px;
    --at-pad-bottom-mobile: {{ s.padding_bottom_mobile }}px;
    --at-slides: {{ section.blocks.size | at_least: 1 }};
  "
>
  <div class="about-timeline__inner">
    {%- if s.heading != blank -%}
      <h2 class="about-timeline__heading">{{ s.heading }}</h2>
    {%- endif -%}

    {%- if section.blocks.size > 0 -%}
      <div class="about-timeline__list">
        {%- for block in section.blocks -%}
          {%- assign b = block.settings -%}
          <div class="about-timeline__item" {{ block.shopify_attributes }}>
            <div class="about-timeline__text about-timeline__text_{{ forloop.index }}">
              {%- if b.date != blank -%}
                <p class="about-timeline__date">{{ b.date }}</p>
              {%- endif -%}
              {%- if b.title != blank -%}
                <h3 class="about-timeline__title">{{ b.title }}</h3>
              {%- endif -%}
              {%- if b.body != blank -%}
                <div class="about-timeline__body">{{ b.body }}</div>
              {%- endif -%}
            </div>

            {%- if b.image_a != blank or b.image_b != blank -%}
              <div class="about-timeline__photos" aria-hidden="true">
                {%- if b.image_a != blank -%}
                  <div class="about-timeline__photo about-timeline__photo--a about-timeline__photo--a-{{ forloop.index }}">
                    {{
                      b.image_a
                      | image_url: width: 600
                      | image_tag:
                        loading: 'lazy',
                        widths: '160, 266, 400, 532',
                        sizes: '(min-width: 768px) 266px, 46vw',
                        alt: b.image_a.alt | default: ''
                    }}
                  </div>
                {%- endif -%}
                {%- if b.image_b != blank -%}
                  <div class="about-timeline__photo about-timeline__photo--b about-timeline__photo--b-{{ forloop.index }}">
                    {{
                      b.image_b
                      | image_url: width: 600
                      | image_tag:
                        loading: 'lazy',
                        widths: '160, 266, 400, 532',
                        sizes: '(min-width: 768px) 266px, 46vw',
                        alt: b.image_b.alt | default: ''
                    }}
                  </div>
                {%- endif -%}
              </div>
            {%- endif -%}
          </div>
        {%- endfor -%}
      </div>
    {%- endif -%}
  </div>
</section>

<script>
  (function () {
    /* Defined once, even if the section is rendered several times or
       re-rendered by the theme editor. */
    if (!window.AboutTimeline) {
      var mqDesktop = window.matchMedia('(min-width: 991px)');
      var mqReduce = window.matchMedia('(prefers-reduced-motion: reduce)');

      var clamp = function (v, a, b) { return v < a ? a : v > b ? b : v; };
      var easeOut = function (t) { return 1 - Math.pow(1 - t, 3); };
      var easeIn = function (t) { return t * t * t; };

      /* ---- Tunables ------------------------------------------------ */
      var SMOOTHING = 0.12;   // 0–1. Lower = silkier / more trailing
      var TEXT_SHIFT = 36;    // px the text rises while entering / leaving
      var IMG_SCALE = 0.08;   // images go 0.92 → 1 → 0.92
      var DRIFT_A = 0.10;     // left image vertical parallax (× viewport h)
      var DRIFT_B = 0.16;     // right image vertical parallax
      /* Timing windows, in "slide units" (0 = slide centred, ±1 = neighbour) */
      var IMG_START = 0.75, IMG_END = 0.15;   // images travel |d| 0.75 → 0.15
      var TXT_START = 0.5,  TXT_END = 0.2;    // text fades   |d| 0.5  → 0.2

      function Timeline(root) {
        this.root = root;
        this.heading = root.querySelector('.about-timeline__heading');
        this.list = root.querySelector('.about-timeline__list');
        this.items = this.list ? [].slice.call(this.list.querySelectorAll('.about-timeline__item')) : [];
        this.slides = this.items.map(function (el) {
          return {
            el: el,
            text: el.querySelector('.about-timeline__text'),
            a: el.querySelector('.about-timeline__photo--a'),
            b: el.querySelector('.about-timeline__photo--b')
          };
        });
        this.pinned = false;
        this.current = null;
        this.raf = 0;

        this.onScroll = this.requestTick.bind(this);
        this.onResize = this.handleResize.bind(this);
        this.onMode = this.evaluate.bind(this);
        this.tick = this.tick.bind(this);

        mqDesktop.addEventListener('change', this.onMode);
        mqReduce.addEventListener('change', this.onMode);
        this.evaluate();
      }

      Timeline.prototype.evaluate = function () {
        var motionOk = !mqReduce.matches;
        this.root.classList.toggle('about-timeline--js', motionOk);
        if (motionOk) this.watchHeading();
        var shouldPin = motionOk && mqDesktop.matches && this.items.length > 0;
        if (shouldPin && !this.pinned) this.enable();
        if (!shouldPin && this.pinned) this.disable();
      };

      /* Heading: one-shot reveal when it enters the viewport. (The slides
         themselves never use an observer — they are purely scroll-driven.) */
      Timeline.prototype.watchHeading = function () {
        var h = this.heading;
        if (!h || this.headingIO || h.classList.contains('is-revealed')) return;
        if (!('IntersectionObserver' in window)) { h.classList.add('is-revealed'); return; }
        var self = this;
        this.headingIO = new IntersectionObserver(function (entries) {
          if (entries[0].isIntersecting) {
            h.classList.add('is-revealed');
            self.headingIO.disconnect();
          }
        }, {
          threshold: 0.1,
          rootMargin: '0px 0px -40% 0px'
        });
        this.headingIO.observe(h);
      };

      Timeline.prototype.enable = function () {
        this.pinned = true;
        this.root.classList.add('about-timeline--pinned');
        this.measure();
        window.addEventListener('scroll', this.onScroll, { passive: true });
        window.addEventListener('resize', this.onResize);
        window.addEventListener('load', this.onResize);
        this.current = this.target();
        this.render(this.current);
      };

      Timeline.prototype.disable = function () {
        this.pinned = false;
        cancelAnimationFrame(this.raf);
        this.raf = 0;
        window.removeEventListener('scroll', this.onScroll);
        window.removeEventListener('resize', this.onResize);
        window.removeEventListener('load', this.onResize);
        this.root.classList.remove('about-timeline--pinned');
        this.slides.forEach(function (s) {
          s.el.style.visibility = '';
          s.el.style.zIndex = '';
          s.el.style.pointerEvents = '';
          if (s.text) { s.text.style.opacity = ''; s.text.style.removeProperty('--at-ty'); }
          [s.a, s.b].forEach(function (p) {
            if (p) { p.style.translate = ''; p.style.scale = ''; p.style.opacity = ''; }
          });
        });
      };

      Timeline.prototype.destroy = function () {
        if (this.pinned) this.disable();
        if (this.headingIO) this.headingIO.disconnect();
        mqDesktop.removeEventListener('change', this.onMode);
        mqReduce.removeEventListener('change', this.onMode);
      };

      Timeline.prototype.measure = function () {
        var n = this.items.length;
        var hold = parseFloat(getComputedStyle(this.root).getPropertyValue('--at-hold')) || 0;
        this.vh = window.innerHeight;
        this.vw = window.innerWidth;
        this.listTop = this.list.getBoundingClientRect().top + window.pageYOffset;
        var stage = this.items[0].offsetHeight;
        var track = Math.max(this.list.offsetHeight - stage, 1);
        /* scroll distance that equals one slide */
        this.step = track / Math.max(n - 1 + hold, 0.0001);
        /* how far images travel in from / out to the sides */
        this.travel = Math.max(this.vw * 0.34, 340);
      };

      Timeline.prototype.handleResize = function () {
        if (!this.pinned) return;
        this.measure();
        this.requestTick();
      };

      /* Scroll position → fractional slide index.
         < 0 : section is approaching, slide 1 is sliding in
         0…n-1 : pinned, scroll drives the slideshow                  */
      Timeline.prototype.target = function () {
        var n = this.items.length;
        var y = window.pageYOffset - this.listTop;
        if (y <= 0) return -IMG_START * clamp(-y / this.vh, 0, 1);
        return clamp(y / this.step, 0, n - 1);
      };

      Timeline.prototype.requestTick = function () {
        if (!this.raf) this.raf = requestAnimationFrame(this.tick);
      };

      Timeline.prototype.tick = function () {
        this.raf = 0;
        var t = this.target();
        var diff = t - this.current;
        if (Math.abs(diff) < 0.0005) {
          this.current = t;
        } else {
          this.current += diff * SMOOTHING;
          this.requestTick();
        }
        this.render(this.current);
      };

      Timeline.prototype.render = function (f) {
        var vh = this.vh, travel = this.travel;

        for (var i = 0; i < this.slides.length; i++) {
          var s = this.slides[i];
          var d = f - i;            // <0 entering · 0 centred · >0 leaving
          var ad = Math.abs(d);
          var visible = ad < IMG_START;

          s.el.style.visibility = visible ? 'visible' : 'hidden';
          s.el.style.pointerEvents = ad < 0.5 ? '' : 'none';
          s.el.style.zIndex = ad < 0.5 ? 2 : 1;
          if (!visible) continue;

          /* -- centre text: outgoing clears before incoming arrives -- */
          if (s.text) {
            var tt = 1 - clamp((ad - TXT_END) / (TXT_START - TXT_END), 0, 1);
            var ty = d < 0 ? (1 - easeOut(tt)) * TEXT_SHIFT : -easeIn(1 - tt) * TEXT_SHIFT;
            s.text.style.opacity = tt.toFixed(3);
            s.text.style.setProperty('--at-ty', ty.toFixed(2) + 'px');
          }

          /* -- side images: continuous horizontal travel -- */
          var it = 1 - clamp((ad - IMG_END) / (IMG_START - IMG_END), 0, 1);
          var m = d < 0 ? 1 - easeOut(it) : easeIn(1 - it);   // 1 = off-screen, 0 = home
          var op = clamp(it * 1.8, 0, 1).toFixed(3);
          var sc = (1 - IMG_SCALE * m).toFixed(4);

          if (s.a) {
            s.a.style.translate = (-m * travel).toFixed(1) + 'px ' + (-d * DRIFT_A * vh).toFixed(1) + 'px';
            s.a.style.scale = sc;
            s.a.style.opacity = op;
          }
          if (s.b) {
            s.b.style.translate = (m * travel).toFixed(1) + 'px ' + (-d * DRIFT_B * vh).toFixed(1) + 'px';
            s.b.style.scale = sc;
            s.b.style.opacity = op;
          }
        }
      };

      /* Theme editor: jump to the slide whose block was selected */
      Timeline.prototype.goTo = function (index) {
        if (!this.pinned) return;
        this.measure();
        window.scrollTo({ top: this.listTop + index * this.step + 1, behavior: 'smooth' });
      };

      var registry = new Map();
      var api = window.AboutTimeline = {
        init: function (scope) {
          [].forEach.call((scope || document).querySelectorAll('[data-about-timeline]'), function (el) {
            if (!registry.has(el)) registry.set(el, new Timeline(el));
          });
        },
        destroy: function (scope) {
          registry.forEach(function (inst, el) {
            if (!scope || scope.contains(el)) { inst.destroy(); registry.delete(el); }
          });
        }
      };

      document.addEventListener('shopify:section:load', function (e) { api.init(e.target); });
      document.addEventListener('shopify:section:unload', function (e) { api.destroy(e.target); });
      document.addEventListener('shopify:block:select', function (e) {
        var root = e.target.closest && e.target.closest('[data-about-timeline]');
        var inst = root && registry.get(root);
        if (inst) inst.goTo(inst.items.indexOf(e.target));
      });
    }

    window.AboutTimeline.init();
  })();
</script>

{% schema %}
{
  "name": "About Timeline",
  "tag": "section",
  "class": "about-timeline-section",
  "settings": [
    { "type": "header", "content": "Heading" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "The Origin" },

    { "type": "header", "content": "Colors" },
    { "type": "color", "id": "color_bg", "label": "Background", "default": "#fff9ef" },
    { "type": "color", "id": "color_text", "label": "Heading / title", "default": "#0d0d0d" },
    { "type": "color", "id": "color_eyebrow", "label": "Date eyebrow", "default": "#661d1d" },
    { "type": "color", "id": "color_body", "label": "Body text", "default": "#1a1a1a" },
    { "type": "color", "id": "color_line", "label": "Connector line", "default": "#bfbbb3" },

    { "type": "header", "content": "Bottom wash (desktop)", "info": "Fades the background to the CTA's wash colour across the bottom of this section, so the blue background starts here rather than in the CTA. Desktop only." },
    { "type": "checkbox", "id": "enable_wash", "label": "Enable bottom wash", "default": true },
    { "type": "color", "id": "color_wash_bottom", "label": "Wash bottom color", "default": "#cfe0f4" },
    { "type": "range", "id": "wash_band", "label": "Fade height", "min": 120, "max": 800, "step": 8, "unit": "px", "default": 400 },

    { "type": "header", "content": "Spacing" },
    { "type": "range", "id": "padding_top", "label": "Padding top (desktop)", "min": 0, "max": 400, "step": 4, "unit": "px", "default": 120 },
    { "type": "range", "id": "padding_bottom", "label": "Padding bottom (desktop)", "min": 0, "max": 400, "step": 4, "unit": "px", "default": 120 },
    { "type": "range", "id": "padding_top_mobile", "label": "Padding top (mobile)", "min": 0, "max": 400, "step": 4, "unit": "px", "default": 80 },
    { "type": "range", "id": "padding_bottom_mobile", "label": "Padding bottom (mobile)", "min": 0, "max": 400, "step": 4, "unit": "px", "default": 80 }
  ],
  "blocks": [
    {
      "type": "entry",
      "name": "Timeline entry",
      "settings": [
        { "type": "text", "id": "date", "label": "Date / period", "default": "2017–2018" },
        { "type": "text", "id": "title", "label": "Title", "default": "Food was the problem" },
        { "type": "richtext", "id": "body", "label": "Body", "default": "<p>We were dealing with our own health challenges when our dog Sherlock started showing similar signs. The connection between food and long-term health became impossible to ignore.</p>" },
        { "type": "image_picker", "id": "image_a", "label": "Photo (left)" },
        { "type": "image_picker", "id": "image_b", "label": "Photo (right)" }
      ]
    }
  ],
  "presets": [
    {
      "name": "About Timeline",
      "blocks": [
        {
          "type": "entry",
          "settings": {
            "date": "2017–2018",
            "title": "Food was the problem",
            "body": "<p>We were dealing with our own health challenges when our dog Sherlock started showing similar signs. The connection between food and long-term health became impossible to ignore. That sent us searching for food we could actually trust — and deep into the research behind why so few options seemed to exist for dogs.</p>"
          }
        },
        {
          "type": "entry",
          "settings": {
            "date": "2019–2020",
            "title": "We couldn't find it, so we made it",
            "body": "<p>Unable to find a dog food that reflected our standards, we decided to create one ourselves. We set out to combine premium proteins, healthy fats, nutrient-dense organ meats, and minimal processing into a food inspired by nature and informed by science. In 2020, we launched one of the first cluster-style air-dried dog foods.</p>"
          }
        },
        {
          "type": "entry",
          "settings": {
            "date": "2021–2023",
            "title": "The same patterns kept emerging",
            "body": "<p>As more families joined the Yumwoof community, we spent hundreds of hours speaking directly with dog parents about the health challenges they were facing. The same concerns surfaced again and again — allergies, digestive issues, skin problems, and picky eating. Those conversations reinforced the research, helping shape The Canine Cocomega™ Effect and the nutritional philosophy behind every Yumwoof recipe.</p>"
          }
        },
        {
          "type": "entry",
          "settings": {
            "date": "2024–Today",
            "title": "One bowl became something bigger",
            "body": "<p>As more families joined us, our recipes expanded, our network of trusted farmers, ranchers, and fishermen deepened, and our standards continued to evolve. What never changed was our commitment to creating food we would proudly feed our own dog. What began with a single bowl has grown into multiple ways to help dogs eat better.</p>"
          }
        }
      ]
    }
  ]
}
{% endschema %}
