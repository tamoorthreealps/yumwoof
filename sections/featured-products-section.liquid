{{ 'css--featured-products-section.css' | asset_url | stylesheet_tag }}

{%- style -%}
  #shopify-section-{{ section.id }} .fp {
    --fp-bg: {{ section.settings.background_color }};
    --fp-text: {{ section.settings.text_color }};
    --fp-card-bg: {{ section.settings.card_background }};
    --fp-card-border: {{ section.settings.card_border }};
    --fp-label: {{ section.settings.label_color }};
  }
{%- endstyle -%}

{%- comment -%} Metafield keys come from settings as "namespace.key". {%- endcomment -%}
{%- assign labels_parts = section.settings.metafield_labels | split: '.' -%}
{%- assign desc_parts = section.settings.metafield_description | split: '.' -%}
{%- assign recipes_parts = section.settings.metafield_recipes_link | split: '.' -%}
{%- assign products = section.settings.products -%}

<section class="fp{% if section.settings.uppercase_heading %} fp--uppercase{% endif %}">
  <div class="fp__inner">
    <div class="fp__inner__head">
      {%- if section.settings.heading != blank -%}
        <h2 class="fp__heading">{{ section.settings.heading }}</h2>
      {%- endif -%}
      {%- if section.settings.button_label != blank -%}
        <a href="{{ section.settings.button_link | default: '#' }}" class="fp__button desktop_fp__button">
          {{ section.settings.button_label }}
        </a>
      {%- endif -%}
    </div>

    <div class="fp__viewport" data-fp-viewport>
      <ul class="fp__track" data-fp-track role="list">
        {%- if products.size > 0 -%}
          {%- for product in products -%}
            {%- assign p_index = forloop.index -%}
            {%- assign popup = product.metafields.custom.ingredient_popup.value -%}
            {%- assign desc_mf = product.metafields[desc_parts[0]][desc_parts[1]] -%}
            {%- assign recipes_mf = product.metafields[recipes_parts[0]][recipes_parts[1]] -%}
            {%- assign recipes_url = recipes_mf.value | default: product.url -%}
            {%- liquid
              assign new_badge = false
              if product.tags contains 'new' or product.tags contains 'New' or product.tags contains 'NEW'
                assign new_badge = true
              endif
            -%}
            {%- comment -%} Locate the "Recipe" option so cards can be split by recipe (ignoring Size etc.). {%- endcomment -%}
            {%- assign recipe_pos = 0 -%}
            {%- for opt in product.options_with_values -%}
              {%- assign opt_name_dc = opt.name | downcase -%}
              {%- if opt_name_dc == 'recipe' -%}{%- assign recipe_pos = forloop.index -%}{%- endif -%}
            {%- endfor -%}

            {%- if section.settings.split_by_recipe and recipe_pos > 0 -%}
              {%- assign recipe_index0 = recipe_pos | minus: 1 -%}
              {%- assign seen_recipes = '|' -%}
              {%- assign card_n = 0 -%}
              {%- for v in product.variants -%}
                {%- assign recipe_val = v.options[recipe_index0] -%}
                {%- assign recipe_key = '|' | append: recipe_val | append: '|' -%}
                {%- if seen_recipes contains recipe_key -%}{%- continue -%}{%- endif -%}
                {%- assign seen_recipes = seen_recipes | append: recipe_val | append: '|' -%}
                {%- assign card_n = card_n | plus: 1 -%}
                {%- assign card_uid = p_index | append: '-' | append: card_n -%}
                {%- assign v_hover = v.metafields.custom.variant_image_hover.value -%}
                {%- assign card_img = v.metafields.custom.variant_image.value | default: product.featured_image -%}
                {%- assign v_desc_mf = v.metafields[desc_parts[0]][desc_parts[1]] -%}
                {%- assign v_desc = v_desc_mf.value | default: desc_mf.value -%}
                <li class="fp__card{% if v_hover != blank %} fp__card__hover{% endif %}" data-fp-slide>
                  {% if new_badge %}
                    <span class="hp_card card_new_badge mobile_badge">
                      <svg xmlns="http://www.w3.org/2000/svg" width="36" height="28" viewBox="0 0 36 28" fill="none">
                        <ellipse cx="18" cy="14" rx="18" ry="14" fill="#D9D9D9"/>
                        <ellipse cx="18" cy="14" rx="18" ry="14" fill="#6DB8D8"/>
