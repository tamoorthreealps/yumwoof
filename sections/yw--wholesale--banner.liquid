    { "type": "text", "id": "kibble_5_right", "label": "Right (desktop)" },
    { "type": "text", "id": "kibble_5_bottom", "label": "Bottom (desktop)" },
    { "type": "text", "id": "kibble_5_left", "label": "Left (desktop)" },
    { "type": "text", "id": "kibble_5_width", "label": "Width (desktop)", "default": "90px" },
    { "type": "text", "id": "kibble_5_top_mobile", "label": "Top (mobile)" },
    { "type": "text", "id": "kibble_5_right_mobile", "label": "Right (mobile)" },
    { "type": "text", "id": "kibble_5_bottom_mobile", "label": "Bottom (mobile)" },
