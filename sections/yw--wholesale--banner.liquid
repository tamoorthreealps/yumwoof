{%- comment -%}
  Section: yw--wholesale--banner
  Green "SELL YUMWOOF / IN YOUR STORE" wholesale banner with hexagon cards + kibble decor.
  All CSS scoped under .yw--wholesale--banner
{%- endcomment -%}

{%- liquid
  assign s = section.settings
  assign uid = section.id
-%}

<style>
  #shopify-section-{{ uid }} .yw--wholesale--banner {
    /* colors */
    --yw-wholesale-banner-bg: {{ s.bg_color }};
    --yw-wholesale-banner-heading: {{ s.heading_color }};
    --yw-wholesale-banner-text: {{ s.text_color }};
    --yw-wholesale-banner-card-bg: {{ s.card_bg }};
    --yw-wholesale-banner-card-border: {{ s.card_border }};
    --yw-wholesale-banner-card-heading: {{ s.card_heading_color }};
    --yw-wholesale-banner-card-text: {{ s.card_text_color }};
    --yw-wholesale-banner-button-bg: {{ s.button_bg }};
    --yw-wholesale-banner-button-text: {{ s.button_text }};
    --yw-wholesale-banner-button-border: {{ s.button_border }};
    --yw-wholesale-banner-button-hover-bg: {{ s.button_hover_bg }};
    --yw-wholesale-banner-button-hover-text: {{ s.button_hover_text }};
    --yw-wholesale-banner-button-radius: {{ s.button_radius }};
    --yw-wholesale-banner-kibble: {{ s.kibble_color }};

    /* layout */
    --yw-wholesale-banner-height: {{ s.height_desktop }};
    --yw-wholesale-banner-height-mobile: {{ s.height_mobile }};
    --yw-wholesale-banner-max-width: {{ s.content_max_width }};
    --yw-wholesale-banner-mobile-width: {{ s.mobile_content_width }};
    --yw-wholesale-banner-pt: {{ s.padding_top }};
    --yw-wholesale-banner-pb: {{ s.padding_bottom }};
    --yw-wholesale-banner-pt-mobile: {{ s.padding_top_mobile }};
    --yw-wholesale-banner-pb-mobile: {{ s.padding_bottom_mobile }};
    --yw-wholesale-banner-gap: {{ s.card_gap }};
    --yw-wholesale-banner-gap-mobile: {{ s.card_gap_mobile }};
  }

  #shopify-section-{{ uid }} { position: relative; }

  .yw--wholesale--banner {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    box-sizing: border-box;
    width: 100%;
    min-height: var(--yw-wholesale-banner-height);
    padding: var(--yw-wholesale-banner-pt) 20px var(--yw-wholesale-banner-pb);
    background-color: var(--yw-wholesale-banner-bg);
  }
  .yw--wholesale--banner *,
  .yw--wholesale--banner *::before,
  .yw--wholesale--banner *::after { box-sizing: border-box; }

  .yw--wholesale--banner__inner {
    position: relative;
    z-index: 2;
    max-width: var(--yw-wholesale-banner-max-width);
    margin: 0 auto;
  }

  /* ---------- Heading ---------- */
  .yw--wholesale--banner__heading {
    margin: 0;
    text-align: center;
    color: var(--yw-wholesale-banner-heading);
  }
  .yw--wholesale--banner__heading-line1 {
    display: block;
    font-family: var(--font-heading-family, var(--font-heading, inherit));
    font-weight: 800;
    font-size: clamp(40px, 5.6vw, 76px);
    line-height: 1.02;
    letter-spacing: 0.01em;
    text-transform: uppercase;
  }
  .yw--wholesale--banner__heading-line2 {
    display: block;
    margin-top: 10px;
    font-family: var(--font-heading-family, var(--font-heading, inherit));
    font-weight: 700;
    font-size: clamp(20px, 2.2vw, 32px);
    line-height: 1.1;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  /* ---------- Description ---------- */
  .yw--wholesale--banner__description {
    max-width: 660px;
    margin: 22px auto 0;
    text-align: center;
    color: var(--yw-wholesale-banner-text);
    font-family: var(--font-body-family, inherit);
    font-size: 17px;
    line-height: 1.55;
  }
  .yw--wholesale--banner__description > *:first-child { margin-top: 0; }
  .yw--wholesale--banner__description > *:last-child { margin-bottom: 0; }

  /* ---------- Cards ---------- */
  .yw--wholesale--banner__cards {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--yw-wholesale-banner-gap);
    align-items: stretch;
    margin-top: 46px;
  }

  .yw--wholesale--banner__card {
    position: relative;
    display: flex;
    padding: 4px; /* outline thickness */
    background: var(--yw-wholesale-banner-card-border);
    -webkit-clip-path: polygon(
      0% 7%, 7% 0%, 93% 0%, 100% 7%,
      100% 87%, 93% 96%, 54% 96%, 50% 100%, 46% 96%, 7% 96%, 0% 87%
    );
    clip-path: polygon(
      0% 7%, 7% 0%, 93% 0%, 100% 7%,
      100% 87%, 93% 96%, 54% 96%, 50% 100%, 46% 96%, 7% 96%, 0% 87%
    );
  }

  .yw--wholesale--banner__card-inner {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: flex-start;
    width: 100%;
    padding: 40px 30px 62px;
    text-align: center;
    background: var(--yw-wholesale-banner-card-bg);
    -webkit-clip-path: polygon(
      0% 7%, 7% 0%, 93% 0%, 100% 7%,
      100% 87%, 93% 96%, 54% 96%, 50% 100%, 46% 96%, 7% 96%, 0% 87%
    );
    clip-path: polygon(
      0% 7%, 7% 0%, 93% 0%, 100% 7%,
      100% 87%, 93% 96%, 54% 96%, 50% 100%, 46% 96%, 7% 96%, 0% 87%
    );
  }

  .yw--wholesale--banner__logo {
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 56px;
    margin-bottom: 18px;
  }
  .yw--wholesale--banner__logo img {
    display: block;
    max-width: 200px;
    max-height: 56px;
    width: auto;
    height: auto;
    object-fit: contain;
  }

  .yw--wholesale--banner__title {
    margin: 0 0 14px;
    font-family: var(--font-body-family, inherit);
    font-weight: 700;
    font-size: 15px;
    line-height: 1.3;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--yw-wholesale-banner-card-heading);
  }

  .yw--wholesale--banner__text {
    margin: 0;
    font-family: var(--font-body-family, inherit);
    font-size: 15.5px;
    line-height: 1.55;
    color: var(--yw-wholesale-banner-card-text);
  }
  .yw--wholesale--banner__text > *:last-child { margin-bottom: 0; }

  /* ---------- Button ---------- */
  .yw--wholesale--banner__button {
    display: inline-block;
    margin-top: 24px;
    padding: 13px 26px;
    border: 1.5px solid var(--yw-wholesale-banner-button-border);
    border-radius: var(--yw-wholesale-banner-button-radius);
    background: var(--yw-wholesale-banner-button-bg);
    color: var(--yw-wholesale-banner-button-text);
    font-family: var(--font-body-family, inherit);
    font-weight: 700;
    font-size: 13px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    text-decoration: none;
    line-height: 1;
    transition: background-color .25s ease, color .25s ease, border-color .25s ease;
  }
  .yw--wholesale--banner__button:hover,
  .yw--wholesale--banner__button:focus-visible {
    background: var(--yw-wholesale-banner-button-hover-bg);
    color: var(--yw-wholesale-banner-button-hover-text);
  }
  .yw--wholesale--banner__button:focus-visible { outline: 2px solid currentColor; outline-offset: 3px; }

  /* ---------- Decorative kibble ---------- */
  .yw--wholesale--banner__decor {
    position: absolute;
    inset: 0;
    z-index: 1;
    pointer-events: none;
    overflow: hidden;
  }
  .yw--wholesale--banner__decor-item {
    position: absolute;
    display: block;
    width: var(--k-size, 90px);
    transform: translate(-50%, -50%) rotate(var(--k-rot, 0deg));
  }
  .yw--wholesale--banner__decor-item img {
    display: block;
    width: 100%;
    height: auto;
  }
  /* CSS fallback kibble shape when no image is chosen */
  .yw--wholesale--banner__decor-item--css {
    aspect-ratio: 1 / 0.86;
    background: var(--yw-wholesale-banner-kibble);
    border-radius: 42% 58% 48% 52% / 55% 44% 56% 45%;
    box-shadow: inset -6px -8px 14px rgba(0,0,0,.22), inset 5px 6px 10px rgba(255,255,255,.14);
  }

  /* ---------- Tablet ---------- */
  @media screen and (max-width: 989px) {
    .yw--wholesale--banner__cards { gap: 20px; }
    .yw--wholesale--banner__card-inner { padding: 30px 20px 54px; }
    .yw--wholesale--banner__text { font-size: 14.5px; }
    .yw--wholesale--banner__decor-item { width: calc(var(--k-size, 90px) * .8); }
  }

  /* ---------- Mobile ---------- */
  @media screen and (max-width: 749px) {
    .yw--wholesale--banner {
      min-height: var(--yw-wholesale-banner-height-mobile);
      padding: var(--yw-wholesale-banner-pt-mobile) 16px var(--yw-wholesale-banner-pb-mobile);
    }
    .yw--wholesale--banner__inner { max-width: var(--yw-wholesale-banner-mobile-width); }
    .yw--wholesale--banner__heading-line1 { font-size: clamp(34px, 11vw, 48px); }
    .yw--wholesale--banner__heading-line2 { font-size: clamp(17px, 5.4vw, 24px); letter-spacing: 0.12em; }
    .yw--wholesale--banner__description { font-size: 15px; margin-top: 16px; }

    .yw--wholesale--banner__cards {
      grid-template-columns: minmax(0, 1fr);
      gap: var(--yw-wholesale-banner-gap-mobile);
      margin-top: 34px;
    }
    .yw--wholesale--banner__card-inner { padding: 32px 24px 56px; }
    .yw--wholesale--banner__logo img { max-height: 48px; }
    .yw--wholesale--banner__title { font-size: 14px; }
    .yw--wholesale--banner__button { font-size: 12.5px; padding: 12px 22px; }

    /* decor repositioned to the outer edges, behind cards, never over text */
    .yw--wholesale--banner__decor-item {
      width: calc(var(--k-size, 90px) * .62);
      left: var(--k-left-m, var(--k-left, 50%));
      top: var(--k-top-m, var(--k-top, 50%));
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .yw--wholesale--banner__button { transition: none; }
  }
</style>

<section
  class="yw--wholesale--banner"
  {{ block.shopify_attributes }}
  aria-labelledby="yw-wholesale-banner-heading-{{ uid }}"
>
  {%- comment -%} Decorative kibble layer {%- endcomment -%}
  <div class="yw--wholesale--banner__decor" aria-hidden="true">
    {%- for i in (1..6) -%}
      {%- liquid
        assign img_key = 'kibble_image_' | append: i
        assign left_key = 'kibble_' | append: i | append: '_left'
        assign top_key = 'kibble_' | append: i | append: '_top'
        assign left_m_key = 'kibble_' | append: i | append: '_left_mobile'
        assign top_m_key = 'kibble_' | append: i | append: '_top_mobile'
        assign size_key = 'kibble_' | append: i | append: '_size'
        assign rot_key = 'kibble_' | append: i | append: '_rotation'
        assign k_img = s[img_key]
        assign k_left = s[left_key]
        assign k_top = s[top_key]
        assign k_left_m = s[left_m_key]
        assign k_top_m = s[top_m_key]
        assign k_size = s[size_key]
        assign k_rot = s[rot_key]
      -%}
      {%- if k_left != blank and k_top != blank -%}
        <span
          class="yw--wholesale--banner__decor-item{% unless k_img %} yw--wholesale--banner__decor-item--css{% endunless %}"
          style="
            --k-left: {{ k_left }};
            --k-top: {{ k_top }};
            --k-left-m: {{ k_left_m | default: k_left }};
            --k-top-m: {{ k_top_m | default: k_top }};
            --k-size: {{ k_size | default: '90px' }};
            --k-rot: {{ k_rot | default: '0deg' }};
            left: var(--k-left);
            top: var(--k-top);
          "
        >
          {%- if k_img -%}
            {{ k_img | image_url: width: 400 | image_tag: loading: 'lazy', alt: '', widths: '120,200,300,400', sizes: '(max-width: 749px) 22vw, 12vw' }}
          {%- endif -%}
        </span>
      {%- endif -%}
    {%- endfor -%}
  </div>

  <div class="yw--wholesale--banner__inner">
    <h2 class="yw--wholesale--banner__heading" id="yw-wholesale-banner-heading-{{ uid }}">
      {%- if s.heading_line_1 != blank -%}
        <span class="yw--wholesale--banner__heading-line1">{{ s.heading_line_1 }}</span>
      {%- endif -%}
      {%- if s.heading_line_2 != blank -%}
        <span class="yw--wholesale--banner__heading-line2">{{ s.heading_line_2 }}</span>
      {%- endif -%}
    </h2>

    {%- if s.description != blank -%}
      <div class="yw--wholesale--banner__description">{{ s.description }}</div>
    {%- endif -%}

    {%- if section.blocks.size > 0 -%}
      <div class="yw--wholesale--banner__cards">
        {%- for block in section.blocks -%}
          {%- if block.type == 'card' -%}
            <div class="yw--wholesale--banner__card" {{ block.shopify_attributes }}>
              <div class="yw--wholesale--banner__card-inner">
                {%- if block.settings.logo -%}
                  <div class="yw--wholesale--banner__logo">
                    {{ block.settings.logo
                      | image_url: width: 500
                      | image_tag:
                        loading: 'lazy',
                        widths: '150,250,350,500',
                        sizes: '(max-width: 749px) 60vw, 20vw',
                        alt: block.settings.logo_alt | default: block.settings.title | escape
                    }}
                  </div>
                {%- endif -%}

                {%- if block.settings.title != blank -%}
                  <h3 class="yw--wholesale--banner__title">{{ block.settings.title }}</h3>
                {%- endif -%}

                {%- if block.settings.text != blank -%}
                  <div class="yw--wholesale--banner__text">{{ block.settings.text }}</div>
                {%- endif -%}

                {%- if block.settings.button_label != blank -%}
                  <a
                    class="yw--wholesale--banner__button"
                    href="{{ block.settings.button_url | default: '#' }}"
                    {% if block.settings.button_new_tab %}target="_blank" rel="noopener"{% endif %}
                  >
                    {{ block.settings.button_label }}
                  </a>
                {%- endif -%}
              </div>
            </div>
          {%- endif -%}
        {%- endfor -%}
      </div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "YW Wholesale Banner",
  "tag": "section",
  "class": "yw--wholesale--banner-section",
  "settings": [
    { "type": "header", "content": "Content" },
    { "type": "text", "id": "heading_line_1", "label": "Heading line 1", "default": "Sell Yumwoof" },
    { "type": "text", "id": "heading_line_2", "label": "Heading line 2", "default": "In your store" },
    {
      "type": "richtext",
      "id": "description",
      "label": "Description",
      "default": "<p>Wholesale pricing for independent pet retailers with physical stores. Premium air-dried dog food — human-grade, GMO-free, and boosted with Cocomega™ superfats backed by research linked to longevity.</p>"
    },

    { "type": "header", "content": "Colors" },
    { "type": "color", "id": "bg_color", "label": "Background", "default": "#4B8B5B" },
    { "type": "color", "id": "heading_color", "label": "Heading", "default": "#111111" },
    { "type": "color", "id": "text_color", "label": "Description", "default": "#111111" },
    { "type": "color", "id": "card_bg", "label": "Card background", "default": "#FFFFFF" },
    { "type": "color", "id": "card_border", "label": "Card border", "default": "#14351F" },
    { "type": "color", "id": "card_heading_color", "label": "Card heading", "default": "#6E1B1B" },
    { "type": "color", "id": "card_text_color", "label": "Card text", "default": "#111111" },
    { "type": "color", "id": "kibble_color", "label": "Decorative kibble (CSS fallback)", "default": "#8A5A2B" },

    { "type": "header", "content": "Buttons" },
    { "type": "color", "id": "button_bg", "label": "Button background", "default": "#FFFFFF" },
    { "type": "color", "id": "button_text", "label": "Button text", "default": "#111111" },
    { "type": "color", "id": "button_border", "label": "Button border", "default": "#111111" },
    { "type": "color", "id": "button_hover_bg", "label": "Button hover background", "default": "#111111" },
    { "type": "color", "id": "button_hover_text", "label": "Button hover text", "default": "#FFFFFF" },
    { "type": "text", "id": "button_radius", "label": "Button border radius", "default": "999px" },

    { "type": "header", "content": "Layout" },
    { "type": "text", "id": "height_desktop", "label": "Height (desktop)", "default": "500px" },
    { "type": "text", "id": "height_mobile", "label": "Height (mobile)", "default": "1200px" },
    { "type": "text", "id": "content_max_width", "label": "Content max width (desktop)", "default": "1240px" },
    { "type": "text", "id": "mobile_content_width", "label": "Content width (mobile)", "default": "100%" },
    { "type": "text", "id": "padding_top", "label": "Padding top (desktop)", "default": "70px" },
    { "type": "text", "id": "padding_bottom", "label": "Padding bottom (desktop)", "default": "110px" },
    { "type": "text", "id": "padding_top_mobile", "label": "Padding top (mobile)", "default": "44px" },
    { "type": "text", "id": "padding_bottom_mobile", "label": "Padding bottom (mobile)", "default": "60px" },
    { "type": "text", "id": "card_gap", "label": "Card gap (desktop)", "default": "26px" },
    { "type": "text", "id": "card_gap_mobile", "label": "Card gap (mobile)", "default": "26px" },

    { "type": "header", "content": "Decorative kibble 1" },
    { "type": "image_picker", "id": "kibble_image_1", "label": "Image" },
    { "type": "text", "id": "kibble_1_left", "label": "Left (desktop)", "default": "9%" },
    { "type": "text", "id": "kibble_1_top", "label": "Top (desktop)", "default": "16%" },
    { "type": "text", "id": "kibble_1_left_mobile", "label": "Left (mobile)", "default": "92%" },
    { "type": "text", "id": "kibble_1_top_mobile", "label": "Top (mobile)", "default": "24%" },
    { "type": "text", "id": "kibble_1_size", "label": "Size", "default": "120px" },
    { "type": "text", "id": "kibble_1_rotation", "label": "Rotation", "default": "-8deg" },

    { "type": "header", "content": "Decorative kibble 2" },
    { "type": "image_picker", "id": "kibble_image_2", "label": "Image" },
    { "type": "text", "id": "kibble_2_left", "label": "Left (desktop)", "default": "90%" },
    { "type": "text", "id": "kibble_2_top", "label": "Top (desktop)", "default": "19%" },
    { "type": "text", "id": "kibble_2_left_mobile", "label": "Left (mobile)", "default": "5%" },
    { "type": "text", "id": "kibble_2_top_mobile", "label": "Top (mobile)", "default": "36%" },
    { "type": "text", "id": "kibble_2_size", "label": "Size", "default": "100px" },
    { "type": "text", "id": "kibble_2_rotation", "label": "Rotation", "default": "14deg" },

    { "type": "header", "content": "Decorative kibble 3" },
    { "type": "image_picker", "id": "kibble_image_3", "label": "Image" },
    { "type": "text", "id": "kibble_3_left", "label": "Left (desktop)", "default": "5%" },
    { "type": "text", "id": "kibble_3_top", "label": "Top (desktop)", "default": "62%" },
    { "type": "text", "id": "kibble_3_left_mobile", "label": "Left (mobile)", "default": "94%" },
    { "type": "text", "id": "kibble_3_top_mobile", "label": "Top (mobile)", "default": "60%" },
    { "type": "text", "id": "kibble_3_size", "label": "Size", "default": "78px" },
    { "type": "text", "id": "kibble_3_rotation", "label": "Rotation", "default": "-22deg" },

    { "type": "header", "content": "Decorative kibble 4" },
    { "type": "image_picker", "id": "kibble_image_4", "label": "Image" },
    { "type": "text", "id": "kibble_4_left", "label": "Left (desktop)", "default": "95%" },
    { "type": "text", "id": "kibble_4_top", "label": "Top (desktop)", "default": "70%" },
    { "type": "text", "id": "kibble_4_left_mobile", "label": "Left (mobile)", "default": "4%" },
    { "type": "text", "id": "kibble_4_top_mobile", "label": "Top (mobile)", "default": "78%" },
    { "type": "text", "id": "kibble_4_size", "label": "Size", "default": "110px" },
    { "type": "text", "id": "kibble_4_rotation", "label": "Rotation", "default": "10deg" },

    { "type": "header", "content": "Decorative kibble 5" },
    { "type": "image_picker", "id": "kibble_image_5", "label": "Image" },
    { "type": "text", "id": "kibble_5_left", "label": "Left (desktop)", },
    { "type": "text", "id": "kibble_5_top", "label": "Top (desktop)" },
    { "type": "text", "id": "kibble_5_left_mobile", "label": "Left (mobile)" },
    { "type": "text", "id": "kibble_5_top_mobile", "label": "Top (mobile)" },
    { "type": "text", "id": "kibble_5_size", "label": "Size", "default": "90px" },
    { "type": "text", "id": "kibble_5_rotation", "label": "Rotation", "default": "0deg" },

    { "type": "header", "content": "Decorative kibble 6" },
    { "type": "image_picker", "id": "kibble_image_6", "label": "Image" },
    { "type": "text", "id": "kibble_6_left", "label": "Left (desktop)" },
    { "type": "text", "id": "kibble_6_top", "label": "Top (desktop)" },
    { "type": "text", "id": "kibble_6_left_mobile", "label": "Left (mobile)" },
