{%- comment -%}
  Section: yw--wholesale--banner
  Green "SELL YUMWOOF / IN YOUR STORE" wholesale banner.
  - Hexagon card shapes come from image assets (image_picker), never clip-path.
  - Card content is a separate layer above the shape and always stays inside it.
  - Kibble decor is fully positionable per breakpoint from the Theme Editor.
  All CSS scoped under .yw--wholesale--banner
{%- endcomment -%}
{{ 'css--yw--wholesale--banner.css' | asset_url | stylesheet_tag }}
{%- liquid
  assign s = section.settings
  assign uid = section.id

  assign desktop_bg = s.bg_image_desktop
  assign mobile_bg = s.bg_image_mobile

  comment
    Background resolution rules:
    desktop img + mobile img  -> each on its own breakpoint
    desktop img only          -> desktop img on both breakpoints
    mobile img only           -> color on desktop, mobile img on mobile
    neither                   -> color on both
  endcomment

  assign desktop_bg_url = blank
  if desktop_bg != blank
    assign desktop_bg_url = desktop_bg | image_url: width: 2400
  endif

  assign mobile_bg_url = blank
  if mobile_bg != blank
    assign mobile_bg_url = mobile_bg | image_url: width: 1200
  elsif desktop_bg != blank
    assign mobile_bg_url = desktop_bg | image_url: width: 1200
  endif
-%}

<style>
    #shopify-section-{{ uid }} .yw--wholesale--banner {
      /* colors */
      --yw-wholesale-banner-bg: {{ s.bg_color }};
      --yw-wholesale-banner-font: {{ s.heading_color }};
      --yw-wholesale-banner-text: {{ s.text_color }};
      --yw-wholesale-banner-card-title: {{ s.card_title_color }};
      --yw-wholesale-banner-card-text: {{ s.card_text_color }};
      --yw-wholesale-banner-card-border: {{ s.card_border_color }};
      --yw-wholesale-banner-button-bg: {{ s.button_bg }};
      --yw-wholesale-banner-button-text: {{ s.button_text }};
      --yw-wholesale-banner-button-border: {{ s.button_border }};
      --yw-wholesale-banner-button-hover-bg: {{ s.button_hover_bg }};
      --yw-wholesale-banner-button-hover-text: {{ s.button_hover_text }};
      --yw-wholesale-banner-button-radius: {{ s.button_radius }};

      /* layout */
      --yw-wholesale-banner-height: {{ s.height_desktop }};
      --yw-wholesale-banner-height-mobile: {{ s.height_mobile }};
      --yw-wholesale-banner-max-width: {{ s.content_max_width }};
      --yw-wholesale-banner-pt: {{ s.padding_top }};
      --yw-wholesale-banner-pb: {{ s.padding_bottom }};
      --yw-wholesale-banner-pt-mobile: {{ s.padding_top_mobile }};
      --yw-wholesale-banner-pb-mobile: {{ s.padding_bottom_mobile }};
      --yw-wholesale-banner-gap: {{ s.card_gap }};
      --yw-wholesale-banner-gap-mobile: {{ s.card_gap_mobile }};

      /* card shape padding — keeps content inside the hexagon */
      --yw-wholesale-banner-card-pad-x: {{ s.card_padding_x }};
      --yw-wholesale-banner-card-pad-top: {{ s.card_padding_top }};
      --yw-wholesale-banner-card-pad-bottom: {{ s.card_padding_bottom }};
      --yw-wholesale-banner-card-pad-x-mobile: {{ s.card_padding_x_mobile }};
      --yw-wholesale-banner-card-pad-top-mobile: {{ s.card_padding_top_mobile }};
      --yw-wholesale-banner-card-pad-bottom-mobile: {{ s.card_padding_bottom_mobile }};
    }



    {%- comment -%} Desktop background: only ever the DESKTOP image. {%- endcomment -%}
    {%- if desktop_bg_url != blank -%}
      @media screen and (min-width: 750px) {
        #shopify-section-{{ uid }} .yw--wholesale--banner {
          background-image: url("{{ desktop_bg_url }}");
          background-position: {{ s.bg_position_desktop | default: 'center center' }};
        }
      }
    {%- endif -%}

    {%- comment -%} Mobile background: mobile image, else desktop image as fallback. {%- endcomment -%}
    {%- if mobile_bg_url != blank -%}
      @media screen and (max-width: 749px) {
        #shopify-section-{{ uid }} .yw--wholesale--banner {
          background-image: url("{{ mobile_bg_url }}");
          background-position: {{ s.bg_position_mobile | default: 'center center' }};
        }
      }
    {%- endif -%}
</style>

<section class="yw--wholesale--banner" aria-labelledby="yw-wholesale-banner-heading-{{ uid }}">
  {%- comment -%} Decorative kibbles — behind content (z-index 1), content is z-index 2 {%- endcomment -%}
  {%- for i in (1..6) -%}
    {%- liquid
      assign k_img_key = 'kibble_image_' | append: i
      assign k_top_key = 'kibble_' | append: i | append: '_top'
      assign k_right_key = 'kibble_' | append: i | append: '_right'
      assign k_bottom_key = 'kibble_' | append: i | append: '_bottom'
      assign k_left_key = 'kibble_' | append: i | append: '_left'
      assign k_w_key = 'kibble_' | append: i | append: '_width'

      assign k_top_m_key = 'kibble_' | append: i | append: '_top_mobile'
      assign k_right_m_key = 'kibble_' | append: i | append: '_right_mobile'
      assign k_bottom_m_key = 'kibble_' | append: i | append: '_bottom_mobile'
      assign k_left_m_key = 'kibble_' | append: i | append: '_left_mobile'
      assign k_w_m_key = 'kibble_' | append: i | append: '_width_mobile'

      assign k_img = s[k_img_key]
      assign k_top = s[k_top_key]
      assign k_right = s[k_right_key]
      assign k_bottom = s[k_bottom_key]
      assign k_left = s[k_left_key]
      assign k_w = s[k_w_key]

      assign k_top_m = s[k_top_m_key]
      assign k_right_m = s[k_right_m_key]
      assign k_bottom_m = s[k_bottom_m_key]
      assign k_left_m = s[k_left_m_key]
      assign k_w_m = s[k_w_m_key]

      assign k_range_key = 'kibble_' | append: i | append: '_parallax_range'
      assign k_range_m_key = 'kibble_' | append: i | append: '_parallax_range_mobile'
      assign k_dir_key = 'kibble_' | append: i | append: '_parallax_dir'
      assign k_range = s[k_range_key]
      assign k_range_m = s[k_range_m_key]
      assign k_dir = s[k_dir_key]
    -%}
    {%- if k_img != blank -%}
      <span
        class="yw--wholesale--banner__kibble yw--wholesale--banner__kibble-{{ i }}"
        aria-hidden="true"
        data-yum-parallax
        data-parallax-range="{{ k_range | default: s.kibble_parallax_range | default: 60 }}"
        data-parallax-range-mobile="{{ k_range_m | default: s.kibble_parallax_range_mobile | default: 30 }}"
        data-parallax-dir="{{ k_dir | default: '1' }}"
        style="
          --k-top: {{ k_top | default: 'auto' }};
          --k-right: {{ k_right | default: 'auto' }};
          --k-bottom: {{ k_bottom | default: 'auto' }};
          --k-left: {{ k_left | default: 'auto' }};
          --k-w: {{ k_w | default: '100px' }};
          --k-top-m: {{ k_top_m | default: k_top | default: 'auto' }};
          --k-right-m: {{ k_right_m | default: k_right | default: 'auto' }};
          --k-bottom-m: {{ k_bottom_m | default: k_bottom | default: 'auto' }};
          --k-left-m: {{ k_left_m | default: k_left | default: 'auto' }};
          --k-w-m: {{ k_w_m | default: k_w | default: '100px' }};
        "
      >
        {{
          k_img
          | image_url: width: 400
          | image_tag: loading: 'lazy', alt: '', widths: '120,200,300,400', sizes: '(max-width: 749px) 26vw, 12vw'
        }}
      </span>
    {%- endif -%}
  {%- endfor -%}

  <div class="yw--wholesale--banner__inner">
    <h2 class="yw--wholesale--banner__heading" id="yw-wholesale-banner-heading-{{ uid }}">
      {%- if s.heading_line_1 != blank -%}
        <span class="yw--wholesale--banner__heading-line1">{{ s.heading_line_1 }}</span>
      {%- endif -%}
      {%- if s.heading_line_2 != blank -%}
        <span class="yw--wholesale--banner__heading-line2">{{ s.heading_line_2 }}</span>
      {%- endif -%}
    </h2>

    {%- if s.description != blank -%}
      <div class="yw--wholesale--banner__description">{{ s.description }}</div>
    {%- endif -%}

    {%- if section.blocks.size > 0 -%}
      <div class="yw--wholesale--banner__cards">
        {%- for block in section.blocks -%}
          {%- if block.type == 'card' -%}
            {%- liquid
              assign shape = block.settings.shape_image
              if shape == blank
                assign shape = s.card_shape_default
              endif
            -%}
            <div class="yw--wholesale--banner__card" {{ block.shopify_attributes }}>
              {%- if shape != blank -%}
                <span
                  class="yw--wholesale--banner__card-shape"
                  aria-hidden="true"
                  style="background-image: url('{{ shape | image_url: width: 1200 }}');"
                ></span>
              {%- else -%}
                <span
                  class="yw--wholesale--banner__card-shape yw--wholesale--banner__card-shape--fallback"
                  aria-hidden="true"
                ></span>
              {%- endif -%}

              <div class="yw--wholesale--banner__card-content">
                {%- if block.settings.logo -%}
                  <div class="yw--wholesale--banner__logo">
                    {{
                      block.settings.logo
                      | image_url: width: 500
                      | image_tag:
                        loading: 'lazy',
                        widths: '150,250,350,500',
                        sizes: '(max-width: 749px) 60vw, 20vw',
                        alt: block.settings.logo_alt
                      | default: block.settings.title
                      | escape
                    }}
                  </div>
                {%- endif -%}

                {%- if block.settings.title != blank -%}
                  <h3 class="yw--wholesale--banner__title">{{ block.settings.title }}</h3>
                {%- endif -%}

                {%- if block.settings.text != blank -%}
                  <div class="yw--wholesale--banner__text">{{ block.settings.text }}</div>
                {%- endif -%}

                {%- if block.settings.button_label != blank -%}
                  <a
                    class="yw--wholesale--banner__button"
                    href="{{ block.settings.button_url | default: '#' }}"
                    {% if block.settings.button_new_tab %}
                      target="_blank" rel="noopener"
                    {% endif %}
                  >
                    {{ block.settings.button_label }}
                  </a>
                {%- endif -%}
              </div>
            </div>
          {%- endif -%}
        {%- endfor -%}
      </div>
    {%- endif -%}
  </div>
</section>

<script>
  (function () {
    var MQ = window.matchMedia('(max-width: 749px)');
    var REDUCED = window.matchMedia('(prefers-reduced-motion: reduce)');
    var items = [];
    var ticking = false;

    function collect(root) {
      var scope = root || document;
      var found = scope.querySelectorAll('.yw--wholesale--banner [data-yum-parallax]');
      for (var i = 0; i < found.length; i++) {
        if (items.indexOf(found[i]) === -1) items.push(found[i]);
      }
    }

    function update() {
      ticking = false;
      if (REDUCED.matches) return;

      var vh = window.innerHeight || document.documentElement.clientHeight;
      var mobile = MQ.matches;

      for (var i = 0; i < items.length; i++) {
        var el = items[i];
        if (!el.isConnected) continue;

        var rect = el.getBoundingClientRect();
        if (rect.bottom < -200 || rect.top > vh + 200) continue;

        var range = parseFloat(mobile ? el.dataset.parallaxRangeMobile : el.dataset.parallaxRange);
        if (isNaN(range)) range = mobile ? 30 : 60;

        var dir = parseFloat(el.dataset.parallaxDir);
        if (isNaN(dir)) dir = 1;

        // 0 when entering from the bottom, 1 when leaving at the top
        var progress = (vh - rect.top) / (vh + rect.height);
        progress = Math.max(0, Math.min(1, progress));

        var shift = (progress - 0.5) * 2 * range * dir;
        el.style.setProperty('--k-shift', shift.toFixed(2) + 'px');
      }
    }

    function onScroll() {
      if (!ticking) {
        ticking = true;
        window.requestAnimationFrame(update);
      }
    }

    function init(root) {
      collect(root);
      update();
    }

    init();
    window.addEventListener('scroll', onScroll, { passive: true });
    window.addEventListener('resize', onScroll, { passive: true });

    // Theme Editor re-init
    document.addEventListener('shopify:section:load', function (e) {
      items = items.filter(function (el) {
        return el.isConnected;
      });
      init(e.target);
    });
    document.addEventListener('shopify:section:unload', function () {
      items = items.filter(function (el) {
        return el.isConnected;
      });
    });
  })();
</script>
{% schema %}
{
  "name": "YW Wholesale Banner",
  "tag": "section",
  "class": "yw--wholesale--banner-section",
  "settings": [
    { "type": "header", "content": "Content" },
    { "type": "text", "id": "heading_line_1", "label": "Heading line 1", "default": "Sell Yumwoof" },
    { "type": "text", "id": "heading_line_2", "label": "Heading line 2", "default": "In your store" },
    {
      "type": "richtext",
      "id": "description",
      "label": "Description",
      "default": "<p>Wholesale pricing for independent pet retailers with physical stores. Premium air-dried dog food — human-grade, GMO-free, and boosted with Cocomega™ superfats backed by research linked to longevity.</p>"
    },

    { "type": "header", "content": "Background" },
    { "type": "image_picker", "id": "bg_image_desktop", "label": "Background image (desktop)" },
    { "type": "image_picker", "id": "bg_image_mobile", "label": "Background image (mobile)" },
    {
      "type": "text",
      "id": "bg_position_desktop",
      "label": "Background position (desktop)",
      "default": "center center"
    },
    { "type": "text", "id": "bg_position_mobile", "label": "Background position (mobile)", "default": "center center" },
    { "type": "color", "id": "bg_color", "label": "Background color", "default": "#4B8B5B" },

    { "type": "header", "content": "Colors" },
    { "type": "color", "id": "heading_color", "label": "Heading color", "default": "#111111" },
    { "type": "color", "id": "text_color", "label": "Description color", "default": "#111111" },
    { "type": "color", "id": "card_title_color", "label": "Card title color", "default": "#6E1B1B" },
    { "type": "color", "id": "card_text_color", "label": "Card text color", "default": "#111111" },
    {
      "type": "color",
      "id": "card_border_color",
      "label": "Card border color (fallback shape only)",
      "default": "#14351F"
    },

    { "type": "header", "content": "Buttons" },
    { "type": "color", "id": "button_bg", "label": "Button background", "default": "#FFFFFF" },
    { "type": "color", "id": "button_text", "label": "Button text", "default": "#111111" },
    { "type": "color", "id": "button_border", "label": "Button border", "default": "#111111" },
    { "type": "color", "id": "button_hover_bg", "label": "Button hover background", "default": "#111111" },
    { "type": "color", "id": "button_hover_text", "label": "Button hover text", "default": "#FFFFFF" },
    { "type": "text", "id": "button_radius", "label": "Button border radius", "default": "999px" },

    { "type": "header", "content": "Layout" },
    { "type": "text", "id": "height_desktop", "label": "Height (desktop)", "default": "500px" },
    { "type": "text", "id": "height_mobile", "label": "Height (mobile)", "default": "1200px" },
    { "type": "text", "id": "content_max_width", "label": "Content max width", "default": "1240px" },
    { "type": "text", "id": "padding_top", "label": "Padding top (desktop)", "default": "70px" },
    { "type": "text", "id": "padding_bottom", "label": "Padding bottom (desktop)", "default": "110px" },
    { "type": "text", "id": "padding_top_mobile", "label": "Padding top (mobile)", "default": "44px" },
    { "type": "text", "id": "padding_bottom_mobile", "label": "Padding bottom (mobile)", "default": "60px" },
    { "type": "text", "id": "card_gap", "label": "Card gap (desktop)", "default": "26px" },
    { "type": "text", "id": "card_gap_mobile", "label": "Card gap (mobile)", "default": "26px" },

    { "type": "header", "content": "Card shape and padding" },
    {
      "type": "image_picker",
      "id": "card_shape_default",
      "label": "Default hexagon shape image (used when a card has none)"
    },
    { "type": "text", "id": "card_padding_x", "label": "Card padding left/right (desktop)", "default": "38px" },
    { "type": "text", "id": "card_padding_top", "label": "Card padding top (desktop)", "default": "42px" },
    { "type": "text", "id": "card_padding_bottom", "label": "Card padding bottom (desktop)", "default": "66px" },
