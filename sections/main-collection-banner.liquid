{{ 'css--main-collection-banner.css' | asset_url | stylesheet_tag }}

{%- style -%}
  #shopify-section-{{ section.id }} .mcb {
    --mcb-band-bg: {{ section.settings.band_color }};
    --mcb-band-text: {{ section.settings.band_text_color }};
    --mcb-accent: {{ section.settings.accent_color }};
  }
{%- endstyle -%}

<div class="mcb page-width">
  {%- comment -%} Breadcrumb {%- endcomment -%}
  <nav class="mcb__crumbs" aria-label="Breadcrumb">
    <a href="{{ routes.root_url }}">Home</a>
    <span aria-hidden="true">/</span>
    <span class="mcb__crumb-current">{{ collection.title | default: section.settings.heading }}</span>
  </nav>

  {%- comment -%} Dark banner band {%- endcomment -%}
  <div
    class="mcb__band{% if section.settings.band_image != blank %} mcb__band--image{% endif %}"
    {% if section.settings.band_image != blank %}style="background-image: url({{ section.settings.band_image | image_url: width: 1600 }});"{% endif %}
  >
    <div class="mcb__band-inner">
      {%- assign banner_heading = section.settings.heading | default: collection.title -%}
      {%- if banner_heading != blank -%}
        <h1 class="mcb__heading">{{ banner_heading }}</h1>
      {%- endif -%}
      {%- assign banner_sub = section.settings.subheading -%}
      {%- if banner_sub == blank -%}
        {%- assign banner_sub = collection.metafields.custom.short_description -%}
      {%- endif -%}
      {%- if banner_sub == blank and section.settings.show_collection_description -%}
        {%- assign banner_sub = collection.description -%}
      {%- endif -%}
      {%- if banner_sub != blank -%}
        <p class="mcb__subheading">{{ banner_sub }}</p>
      {%- endif -%}
    </div>
  </div>

  {%- comment -%} Category tabs (from a menu / link list) {%- endcomment -%}
  {%- if section.settings.category_menu != blank -%}
    <nav class="mcb__tabs" aria-label="Categories">
      {%- for link in section.settings.category_menu.links -%}
        <a
          class="mcb__tab{% if link.current or link.child_current %} is-active{% endif %}"
          href="{{ link.url }}"
          {% if link.current %}aria-current="page"{% endif %}
        >
          {{- link.title -}}
        </a>
      {%- endfor -%}
    </nav>
  {%- endif -%}

  {%- comment -%} Health-goal pills (from a menu / link list) {%- endcomment -%}
  {%- if section.settings.health_menu != blank -%}
    <div class="mcb__goals">
      {%- if section.settings.health_label != blank -%}
        <span class="mcb__goals-label">{{ section.settings.health_label }}</span>
      {%- endif -%}
      <div class="mcb__goals-pills">
        {%- for link in section.settings.health_menu.links -%}
          <a class="mcb__pill{% if link.current %} is-active{% endif %}" href="{{ link.url }}">{{ link.title }}</a>
        {%- endfor -%}
      </div>
    </div>
  {%- endif -%}
</div>

{% schema %}
{
  "name": "Collection banner",
  "tag": "section",
  "class": "section-main-collection-banner",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "info": "Defaults to the collection title." },
    { "type": "textarea", "id": "subheading", "label": "Subheading" },
    { "type": "checkbox", "id": "show_collection_description", "label": "Fall back to collection description", "default": true },
    { "type": "image_picker", "id": "band_image", "label": "Banner background image" },
    { "type": "header", "content": "Category tabs" },
    { "type": "link_list", "id": "category_menu", "label": "Tabs menu", "info": "Each link becomes a tab; the current page's link is highlighted." },
    { "type": "header", "content": "Health goals" },
    { "type": "text", "id": "health_label", "label": "Label", "default": "Shop by health goal" },
    { "type": "link_list", "id": "health_menu", "label": "Health goal menu", "info": "Each link becomes a pill." },
    { "type": "header", "content": "Colors" },
    { "type": "color", "id": "band_color", "label": "Banner background", "default": "#1A1A1A" },
    { "type": "color", "id": "band_text_color", "label": "Banner text", "default": "#FFF9EF" },
    { "type": "color", "id": "accent_color", "label": "Active accent", "default": "#000000" }
  ],
  "enabled_on": { "templates": ["collection"] }
}
{% endschema %}
