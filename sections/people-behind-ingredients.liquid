{{ 'people-behind-ingredients.css' | asset_url | stylesheet_tag }}

<div
  id="PeopleBehindIngredientsTrack-{{ section.id }}"
  class="people-behind-ingredients__track"
  style="--pbi-slides: {{ section.blocks.size }};"
>
  <section
    id="PeopleBehindIngredients-{{ section.id }}"
    class="people-behind-ingredients"
    style="
      --pbi-bg: {{ section.settings.background_color }};
      --pbi-bg-image: {% if section.settings.background_image != blank %}url('{{ section.settings.background_image | image_url: width: 2400 }}'){% else %}none{% endif %};
      --pbi-text-color: {{ section.settings.text_color }};
      --pbi-media-height: {{ section.settings.media_height }}px;
      --pbi-desktop-padding-top: {{ section.settings.desktop_padding_top }}px;
      --pbi-desktop-padding-bottom: {{ section.settings.desktop_padding_bottom }}px;
      --pbi-mobile-padding-top: {{ section.settings.mobile_padding_top }}px;
      --pbi-mobile-padding-bottom: {{ section.settings.mobile_padding_bottom }}px;
      --pbi-scroll-span: {{ section.settings.scroll_span | divided_by: 100.0 }};
    "
  >
    <div class="people-behind-ingredients__inner">

      {% if section.settings.heading != blank %}
        <div class="people-behind-ingredients__heading">
          {{ section.settings.heading }}
        </div>
      {% endif %}

      {% if section.blocks.size > 0 %}
        <div
          id="PeopleBehindIngredientsSlider-{{ section.id }}"
          class="splide people-behind-ingredients__slider"
          aria-label="{{ section.settings.heading | strip_html | escape }}"
        >
          <div class="splide__track">
            <ul class="splide__list">
              {% for block in section.blocks %}
                <li
                  class="splide__slide people-behind-ingredients__slide"
                  {{ block.shopify_attributes }}
                >
                  <div class="people-behind-ingredients__media">
                    {% if block.settings.image != blank %}
                      {{
                        block.settings.image
                        | image_url: width: 1200
                        | image_tag:
                          class: 'people-behind-ingredients__image',
                          loading: 'lazy',
                          widths: '500,700,900,1200',
                          sizes: '(max-width: 767px) 100vw, 50vw',
                          alt: block.settings.title
                      }}
                    {% endif %}
                  </div>

                  <div class="people-behind-ingredients__content">
                    {% if block.settings.title != blank %}
                      <div class="people-behind-ingredients__title">
                        {{ block.settings.title | escape }}
                      </div>
                    {% endif %}

                    {% if block.settings.description != blank %}
                      <div class="people-behind-ingredients__description">
                        {{ block.settings.description }}
                      </div>
                    {% endif %}

                    <div class="people-behind-ingredients__pagination">
                      <div class="people-behind-ingredients__progress">
                        {% for item in section.blocks %}
                          <button
                            type="button"
                            class="people-behind-ingredients__progress-item"
                            aria-label="Go to slide {{ forloop.index }}"
                          >
                            <span class="people-behind-ingredients__progress-fill"></span>
                          </button>
                        {% endfor %}
                      </div>

                      <div class="people-behind-ingredients__counter">
                        <span class="people-behind-ingredients__current">01</span>
                        <span>/</span>
                        <span class="people-behind-ingredients__total">
                          {{ section.blocks.size | prepend: '00' | slice: -2, 2 }}
                        </span>
                      </div>
                    </div>
                  </div>
                </li>
              {% endfor %}
            </ul>
          </div>
        </div>
      {% endif %}

    </div>
  </section>
</div>

<script>
  document.addEventListener('DOMContentLoaded', function () {
    const track = document.querySelector('#PeopleBehindIngredientsTrack-{{ section.id }}');
    const section = document.querySelector('#PeopleBehindIngredients-{{ section.id }}');
    if (!track || !section || typeof Splide === 'undefined') return;

    const slider = section.querySelector('.people-behind-ingredients__slider');
    const currentEls = section.querySelectorAll('.people-behind-ingredients__current');
    const progressGroups = section.querySelectorAll('.people-behind-ingredients__progress');
    if (!slider) return;

    const splide = new Splide(slider, {
      /* Slides are stacked and swapped instantly — no fade, no drag, no autoplay.
         Position within the section is what drives which slide is shown. */
      type: 'fade',
      rewind: false,
      perPage: 1,
      perMove: 1,
      arrows: false,
      pagination: false,
      drag: false,
      speed: 0,
      autoplay: false,
      gap: 0
    });

    splide.on('mounted move', function () {
      const number = String(splide.index + 1).padStart(2, '0');
      currentEls.forEach(function (el) {
        el.textContent = number;
      });
    });

    splide.mount();

    /* ---------- Natural scroll → slide progress (no pinning) ---------- */

    const total = splide.length;
    const last = Math.max(total - 1, 0);

    /* How much of the section's pass through the viewport is used to run through
       all the slides. 0.7 = the middle 70% of the pass. Exposed as a setting. */
    const spanSetting = parseFloat(
      getComputedStyle(section).getPropertyValue('--pbi-scroll-span')
    );
    const span = isNaN(spanSetting) ? 0.7 : Math.min(Math.max(spanSetting, 0.3), 0.95);
    const startAt = 0.5 + span / 2; /* section centre this far down the viewport = slide 1 */
    const endAt = 0.5 - span / 2;   /* section centre this far up = last slide */

    let targetRaw = 0;   /* 0 .. last, straight from scroll position */
    let shownRaw = -1;   /* eased value actually rendered */
    let current = -1;
    let running = false;
    let inView = true;

    function measure() {
      if (total < 2) return 0;
      const rect = section.getBoundingClientRect();
      const vh = window.innerHeight || document.documentElement.clientHeight;
      if (!vh) return 0;

      const centre = (rect.top + rect.height / 2) / vh;
      const p = (startAt - centre) / (startAt - endAt);
      return Math.min(Math.max(p, 0), 1) * last;
    }

    function paint(raw) {
      const index = Math.min(Math.floor(raw + 0.0001), last);

      if (index !== current) {
        current = index;
        splide.go(index);
      }

      progressGroups.forEach(function (group) {
        Array.prototype.forEach.call(group.children, function (item, i) {
          const fill = Math.min(Math.max(raw - i, 0), 1);
          item.style.setProperty('--pbi-fill', fill.toFixed(4));
          item.classList.toggle('is-active', i === index);
          item.setAttribute('aria-current', i === index ? 'true' : 'false');
        });
      });
    }

    /* Easing loop: the rendered value chases the scroll value, which smooths out
       both coarse wheel steps and momentum scrolling. */
    function loop() {
      const diff = targetRaw - shownRaw;

      if (Math.abs(diff) < 0.0008) {
        shownRaw = targetRaw;
        paint(shownRaw);
        running = false;
        return;
      }

      shownRaw += diff * 0.16;
      paint(shownRaw);
      requestAnimationFrame(loop);
    }

    function kick() {
      targetRaw = measure();
      if (shownRaw < 0) shownRaw = targetRaw;
      if (running) return;
      running = true;
      requestAnimationFrame(loop);
    }

    window.addEventListener('scroll', kick, { passive: true });
    window.addEventListener('resize', kick, { passive: true });

    /* Only run the easing loop while the section is anywhere near the viewport. */
    if ('IntersectionObserver' in window) {
      new IntersectionObserver(
        function (entries) {
          inView = entries[0].isIntersecting;
          if (inView) kick();
        },
        { rootMargin: '100% 0px' }
      ).observe(section);
    }

    /* Clicking a bar scrolls the page to the point where that slide is showing —
       still a normal smooth page scroll, nothing is locked. */
    progressGroups.forEach(function (group) {
      Array.prototype.forEach.call(group.children, function (item, i) {
        item.addEventListener('click', function (e) {
          e.preventDefault();
          if (total < 2) return;

          const vh = window.innerHeight || document.documentElement.clientHeight;
          const rect = section.getBoundingClientRect();
          const pageTop = rect.top + window.pageYOffset;
          const wanted = i / last;
          const centreRatio = startAt - wanted * (startAt - endAt);
          const top = pageTop + rect.height / 2 - centreRatio * vh;

          window.scrollTo({ top: Math.max(top, 0), behavior: 'smooth' });
        });
      });
    });

    kick();
  });
</script>

{% schema %}
{
  "name": "People Behind Ingredients",
  "tag": "section",
  "class": "section-people-behind-ingredients",
  "settings": [
    {
      "type": "richtext",
      "id": "heading",
      "label": "Heading",
      "default": "<h2>THE PEOPLE BEHIND OUR INGREDIENTS</h2>"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background color",
      "default": "#FFF9EF"
    },
    {
      "type": "image_picker",
      "id": "background_image",
      "label": "Background image"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "default": "#111111"
    },
    {
      "type": "range",
      "id": "media_height",
      "label": "Image height (desktop)",
      "min": 300,
      "max": 800,
      "step": 10,
      "unit": "px",
      "default": 560
    },
    {
      "type": "range",
      "id": "scroll_span",
      "label": "Scroll range used for slide changes",
      "info": "Lower = slides change over a shorter stretch of scrolling.",
      "min": 30,
      "max": 95,
      "step": 5,
      "unit": "%",
      "default": 70
    },
    {
      "type": "header",
      "content": "Desktop Spacing"
    },
    {
      "type": "range",
      "id": "desktop_padding_top",
      "label": "Top padding",
      "min": 0,
      "max": 300,
      "step": 5,
      "unit": "px",
      "default": 45
    },
    {
      "type": "range",
      "id": "desktop_padding_bottom",
      "label": "Bottom padding",
      "min": 0,
      "max": 300,
      "step": 5,
      "unit": "px",
      "default": 60
    },
    {
      "type": "header",
      "content": "Mobile Spacing"
    },
    {
      "type": "range",
      "id": "mobile_padding_top",
      "label": "Top padding",
      "min": 0,
      "max": 200,
      "step": 5,
      "unit": "px",
      "default": 35
    },
    {
      "type": "range",
      "id": "mobile_padding_bottom",
      "label": "Bottom padding",
      "min": 0,
      "max": 200,
      "step": 5,
      "unit": "px",
      "default": 40
    }
  ],
  "blocks": [
    {
      "type": "person",
      "name": "Ingredient Partner",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "GROWERS"
        },
        {
          "type": "richtext",
          "id": "description",
          "label": "Description",
          "default": "<p>Sweet potatoes, blueberries, kelp, thyme, ginger, cumin, and rose hips bring naturally occurring nutrients from the plant world.</p>"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "People Behind Ingredients",
      "blocks": [
        { "type": "person", "settings": { "title": "GROWERS" } },
        { "type": "person", "settings": { "title": "FISHERMEN" } },
        { "type": "person", "settings": { "title": "RANCHERS" } },
        { "type": "person", "settings": { "title": "SUPPLIERS" } }
      ]
    }
  ]
}
{% endschema %}