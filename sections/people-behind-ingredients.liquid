{{ 'people-behind-ingredients.css' | asset_url | stylesheet_tag }}

<section
  id="PeopleBehindIngredients-{{ section.id }}"
  class="people-behind-ingredients"
  style="
    --pbi-bg: {{ section.settings.background_color }};
    --pbi-bg-image: {% if section.settings.background_image != blank %}url('{{ section.settings.background_image | image_url: width: 2400 }}'){% else %}none{% endif %};
    --pbi-text-color: {{ section.settings.text_color }};
    --pbi-media-height: {{ section.settings.media_height }}px;
    --pbi-desktop-padding-top: {{ section.settings.desktop_padding_top }}px;
    --pbi-desktop-padding-bottom: {{ section.settings.desktop_padding_bottom }}px;
    --pbi-mobile-padding-top: {{ section.settings.mobile_padding_top }}px;
    --pbi-mobile-padding-bottom: {{ section.settings.mobile_padding_bottom }}px;
  "
>
  <div class="people-behind-ingredients__inner">

    {% if section.settings.heading != blank %}
      <div class="people-behind-ingredients__heading">
        {{ section.settings.heading }}
      </div>
    {% endif %}

    {% if section.blocks.size > 0 %}
      <div
        id="PeopleBehindIngredientsSlider-{{ section.id }}"
        class="splide people-behind-ingredients__slider"
        aria-label="{{ section.settings.heading | strip_html | escape }}"
      >
        <div class="splide__track">
          <ul class="splide__list">
            {% for block in section.blocks %}
              <li
                class="splide__slide people-behind-ingredients__slide"
                {{ block.shopify_attributes }}
              >
                <div class="people-behind-ingredients__media">
                  {% if block.settings.image != blank %}
                    {{
                      block.settings.image
                      | image_url: width: 1200
                      | image_tag:
                        class: 'people-behind-ingredients__image',
                        loading: 'lazy',
                        widths: '500,700,900,1200',
                        sizes: '(max-width: 767px) 100vw, 50vw',
                        alt: block.settings.title
                    }}
                  {% endif %}
                </div>

                <div class="people-behind-ingredients__content">
                  {% if block.settings.title != blank %}
                    <div class="people-behind-ingredients__title">
                      {{ block.settings.title | escape }}
                    </div>
                  {% endif %}

                  {% if block.settings.description != blank %}
                    <div class="people-behind-ingredients__description">
                      {{ block.settings.description }}
                    </div>
                  {% endif %}

                  <div class="people-behind-ingredients__pagination">
                    <div class="people-behind-ingredients__progress">
                      {% for item in section.blocks %}
                        <button
                          type="button"
                          class="people-behind-ingredients__progress-item"
                          aria-label="Go to slide {{ forloop.index }}"
                        ></button>
                      {% endfor %}
                    </div>

                    <div class="people-behind-ingredients__counter">
                      <span class="people-behind-ingredients__current">01</span>
                      <span>/</span>
                      <span class="people-behind-ingredients__total">
                        {{ section.blocks.size | prepend: '00' | slice: -2, 2 }}
                      </span>
                    </div>
                  </div>
                </div>
              </li>
            {% endfor %}
          </ul>
        </div>
      </div>
    {% endif %}

  </div>
</section>

<script>
  document.addEventListener('DOMContentLoaded', function () {
    const section = document.querySelector('#PeopleBehindIngredients-{{ section.id }}');
    if (!section || typeof Splide === 'undefined') return;

    const slider = section.querySelector('.people-behind-ingredients__slider');
    const currentEls = section.querySelectorAll('.people-behind-ingredients__current');
    const progressGroups = section.querySelectorAll('.people-behind-ingredients__progress');

    if (!slider) return;

    const splide = new Splide(slider, {
      /* 'fade' gives the soft crossfade. Note: fade mode has no drag —
         to bring swipe back, use type: 'loop' and rewind: false instead. */
      type: 'fade',
      rewind: false,
      perPage: 1,
      perMove: 1,
      arrows: false,
      pagination: false,
      speed: 700,
      easing: 'cubic-bezier(0.4, 0, 0.2, 1)',
      autoplay: false,
      gap: 0
    });

    splide.on('mounted move', function () {
      const index = splide.index;
      const number = String(index + 1).padStart(2, '0');

      currentEls.forEach(function (el) {
        el.textContent = number;
      });

      progressGroups.forEach(function (group) {
        Array.prototype.forEach.call(group.children, function (item, itemIndex) {
          item.classList.toggle('is-active', itemIndex === index);
          item.setAttribute('aria-current', itemIndex === index ? 'true' : 'false');
        });
      });
    });

    splide.mount();

    progressGroups.forEach(function (group) {
      Array.prototype.forEach.call(group.children, function (item, itemIndex) {
        item.addEventListener('click', function () {
          splide.go(itemIndex);
        });
      });
    });

    /* ---------- Scroll-controlled slider ---------- */

        /* ---------- Scroll-controlled slider ---------- */

    const lastIndex = splide.length - 1;
    const SETTLE = 780;   // must exceed the 700ms slide transition
    const ALIGN = 420;    // time allowed for the one-time centering scroll
    const SNAP = 0.45;    // how close to centered before we take over

    let phase = 'idle';   // idle | aligning | locked | released
    let lockedY = 0;
    let busy = false;
    let touchY = null;
    let exitDir = 0;

    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const body = document.body;

    function offset() {
      const rect = section.getBoundingClientRect();
      return (rect.top + rect.height / 2) - window.innerHeight / 2;
    }

    function inRange() {
      const rect = section.getBoundingClientRect();
      if (rect.height >= window.innerHeight) {
        return rect.top <= 0 && rect.bottom >= window.innerHeight;
      }
      return Math.abs(offset()) < window.innerHeight * SNAP;
    }

    function lockBody() {
      lockedY = window.pageYOffset;
      // Compensate for the scrollbar so fixing the body causes no reflow.
      const barWidth = window.innerWidth - document.documentElement.clientWidth;
      body.style.position = 'fixed';
      body.style.top = -lockedY + 'px';
      body.style.left = '0';
      body.style.right = '0';
      body.style.width = '100%';
      if (barWidth > 0) body.style.paddingRight = barWidth + 'px';
      phase = 'locked';
    }

    function unlockBody() {
      body.style.position = '';
      body.style.top = '';
      body.style.left = '';
      body.style.right = '';
      body.style.width = '';
      body.style.paddingRight = '';
      // Restore instantly at the exact same offset — no visual jump.
      const prev = document.documentElement.style.scrollBehavior;
      document.documentElement.style.scrollBehavior = 'auto';
      window.scrollTo(0, lockedY);
      document.documentElement.style.scrollBehavior = prev;
      phase = 'released';
    }

    function beginAlign() {
      phase = 'aligning';
      const target = window.pageYOffset + offset();
      if (reduceMotion || Math.abs(offset()) < 2) {
        window.scrollTo(0, target);
        lockBody();
        return;
      }
      window.scrollTo({ top: target, behavior: 'smooth' });
      setTimeout(function () {
        if (phase !== 'aligning') return;
        window.scrollTo(0, window.pageYOffset + offset()); // kill any residual drift
        lockBody();
      }, ALIGN);
    }

    // Returns true when the event should be swallowed.
    function handle(direction) {
      if (phase === 'released') return false;
      if (phase === 'aligning') return true;   // eat everything mid-alignment

      if (phase === 'idle') {
        if (!inRange()) return false;
        beginAlign();
        return true;
      }

      // phase === 'locked'
      const atEdge =
        (direction > 0 && splide.index >= lastIndex) ||
        (direction < 0 && splide.index <= 0);

      if (atEdge) {
        exitDir = direction;
        unlockBody();
        // Hand the gesture back to the page with a nudge in the same direction,
        // so releasing never feels like a dead scroll.
        window.scrollBy({ top: direction * 60, behavior: reduceMotion ? 'auto' : 'smooth' });
        return true;
      }

      if (busy) return true;   // swallow momentum during the transition

      busy = true;
      splide.go(direction > 0 ? '+1' : '-1');
      setTimeout(function () { busy = false; }, SETTLE);
      return true;
    }

    window.addEventListener('wheel', function (e) {
      if (phase === 'locked' || phase === 'aligning') {
        e.preventDefault();   // nothing gets through, momentum included
        handle(e.deltaY > 0 ? 1 : -1);
        return;
      }
      if (Math.abs(e.deltaY) < 2) return;
      if (handle(e.deltaY > 0 ? 1 : -1)) e.preventDefault();
    }, { passive: false });

    window.addEventListener('keydown', function (e) {
      const down = e.key === 'ArrowDown' || e.key === 'PageDown' || e.key === ' ';
      const up = e.key === 'ArrowUp' || e.key === 'PageUp';
      if (!down && !up) return;
      if (handle(down ? 1 : -1)) e.preventDefault();
    });

    window.addEventListener('touchstart', function (e) {
      touchY = e.touches[0].clientY;
    }, { passive: true });

    window.addEventListener('touchmove', function (e) {
      if (phase === 'locked' || phase === 'aligning') e.preventDefault();
      if (touchY === null) return;
      const delta = touchY - e.touches[0].clientY;
      if (Math.abs(delta) < 12) return;
      touchY = e.touches[0].clientY;
      if (handle(delta > 0 ? 1 : -1)) e.preventDefault();
    }, { passive: false });

    window.addEventListener('touchend', function () { touchY = null; }, { passive: true });

    // Re-arm once the section has fully left the viewport in either direction.
    window.addEventListener('scroll', function () {
      if (phase !== 'released') return;
      const rect = section.getBoundingClientRect();
      if (rect.bottom < 0 || rect.top > window.innerHeight) {
        phase = 'idle';
        exitDir = 0;
      }
    }, { passive: true });

    window.addEventListener('resize', function () {
      if (phase === 'locked') { unlockBody(); phase = 'idle'; }
    });

    if (window.Shopify && window.Shopify.designMode) phase = 'released';
    });
</script>

{% schema %}
{
  "name": "People Behind Ingredients",
  "tag": "section",
  "class": "section-people-behind-ingredients",
  "settings": [
    {
      "type": "richtext",
      "id": "heading",
      "label": "Heading",
      "default": "<h2>THE PEOPLE BEHIND OUR INGREDIENTS</h2>"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background color",
      "default": "#FFF9EF"
    },
    {
      "type": "image_picker",
      "id": "background_image",
      "label": "Background image"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "default": "#111111"
    },
    {
      "type": "range",
      "id": "media_height",
      "label": "Image height (desktop)",
      "min": 300,
      "max": 800,
      "step": 10,
      "unit": "px",
      "default": 560
    },
    {
      "type": "header",
      "content": "Desktop Spacing"
    },
    {
      "type": "range",
      "id": "desktop_padding_top",
      "label": "Top padding",
      "min": 0,
      "max": 300,
      "step": 5,
      "unit": "px",
      "default": 45
    },
    {
      "type": "range",
      "id": "desktop_padding_bottom",
      "label": "Bottom padding",
      "min": 0,
      "max": 300,
      "step": 5,
      "unit": "px",
      "default": 60
    },
    {
      "type": "header",
      "content": "Mobile Spacing"
    },
    {
      "type": "range",
      "id": "mobile_padding_top",
      "label": "Top padding",
      "min": 0,
      "max": 200,
      "step": 5,
      "unit": "px",
      "default": 35
    },
    {
      "type": "range",
      "id": "mobile_padding_bottom",
      "label": "Bottom padding",
      "min": 0,
      "max": 200,
      "step": 5,
      "unit": "px",
      "default": 40
    }
  ],
  "blocks": [
    {
      "type": "person",
      "name": "Ingredient Partner",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "GROWERS"
        },
        {
          "type": "richtext",
          "id": "description",
          "label": "Description",
          "default": "<p>Sweet potatoes, blueberries, kelp, thyme, ginger, cumin, and rose hips bring naturally occurring nutrients from the plant world.</p>"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "People Behind Ingredients",
      "blocks": [
        {
          "type": "person",
          "settings": {
            "title": "GROWERS"
          }
        },
        {
          "type": "person",
          "settings": {
            "title": "FISHERMEN"
          }
        },
        {
          "type": "person",
          "settings": {
            "title": "RANCHERS"
          }
        },
        {
          "type": "person",
          "settings": {
            "title": "SUPPLIERS"
          }
        }
      ]
    }
  ]
}
{% endschema %}
