{{ 'people-behind-ingredients.css' | asset_url | stylesheet_tag }}

<section
  id="PeopleBehindIngredients-{{ section.id }}"
  class="people-behind-ingredients"
  style="
    --pbi-bg: {{ section.settings.background_color }};
    --pbi-bg-image: {% if section.settings.background_image != blank %}url('{{ section.settings.background_image | image_url: width: 2400 }}'){% else %}none{% endif %};
    --pbi-text-color: {{ section.settings.text_color }};
    --pbi-media-height: {{ section.settings.media_height }}px;
    --pbi-desktop-padding-top: {{ section.settings.desktop_padding_top }}px;
    --pbi-desktop-padding-bottom: {{ section.settings.desktop_padding_bottom }}px;
    --pbi-mobile-padding-top: {{ section.settings.mobile_padding_top }}px;
    --pbi-mobile-padding-bottom: {{ section.settings.mobile_padding_bottom }}px;
  "
>
  <div class="people-behind-ingredients__inner">

    {% if section.settings.heading != blank %}
      <div class="people-behind-ingredients__heading">
        {{ section.settings.heading }}
      </div>
    {% endif %}

    {% if section.blocks.size > 0 %}
      <div
        id="PeopleBehindIngredientsSlider-{{ section.id }}"
        class="splide people-behind-ingredients__slider"
        aria-label="{{ section.settings.heading | strip_html | escape }}"
      >
        <div class="splide__track">
          <ul class="splide__list">
            {% for block in section.blocks %}
              <li
                class="splide__slide people-behind-ingredients__slide"
                {{ block.shopify_attributes }}
              >
                <div class="people-behind-ingredients__media">
                  {% if block.settings.image != blank %}
                    {{
                      block.settings.image
                      | image_url: width: 1200
                      | image_tag:
                        class: 'people-behind-ingredients__image',
                        loading: 'lazy',
                        widths: '500,700,900,1200',
                        sizes: '(max-width: 767px) 100vw, 50vw',
                        alt: block.settings.title
                    }}
                  {% endif %}
                </div>

                <div class="people-behind-ingredients__content">
                  {% if block.settings.title != blank %}
                    <div class="people-behind-ingredients__title">
                      {{ block.settings.title | escape }}
                    </div>
                  {% endif %}

                  {% if block.settings.description != blank %}
                    <div class="people-behind-ingredients__description">
                      {{ block.settings.description }}
                    </div>
                  {% endif %}

                  <div class="people-behind-ingredients__pagination">
                    <div class="people-behind-ingredients__progress">
                      {% for item in section.blocks %}
                        <button
                          type="button"
                          class="people-behind-ingredients__progress-item"
                          aria-label="Go to slide {{ forloop.index }}"
                        ></button>
                      {% endfor %}
                    </div>

                    <div class="people-behind-ingredients__counter">
                      <span class="people-behind-ingredients__current">01</span>
                      <span>/</span>
                      <span class="people-behind-ingredients__total">
                        {{ section.blocks.size | prepend: '00' | slice: -2, 2 }}
                      </span>
                    </div>
                  </div>
                </div>
              </li>
            {% endfor %}
          </ul>
        </div>
      </div>
    {% endif %}

  </div>
</section>

<script>
  document.addEventListener('DOMContentLoaded', function () {
    const section = document.querySelector('#PeopleBehindIngredients-{{ section.id }}');
    if (!section || typeof Splide === 'undefined') return;

    const slider = section.querySelector('.people-behind-ingredients__slider');
    const currentEls = section.querySelectorAll('.people-behind-ingredients__current');
    const progressGroups = section.querySelectorAll('.people-behind-ingredients__progress');

    if (!slider) return;

    const splide = new Splide(slider, {
      type: 'fade',
      rewind: false,
      perPage: 1,
      perMove: 1,
      arrows: false,
      pagination: false,
      speed: 700,
      easing: 'cubic-bezier(0.4, 0, 0.2, 1)',
      autoplay: false,
      gap: 0
    });

    splide.on('mounted move', function () {
      const index = splide.index;
      const number = String(index + 1).padStart(2, '0');

      currentEls.forEach(function (el) {
        el.textContent = number;
      });

      progressGroups.forEach(function (group) {
        Array.prototype.forEach.call(group.children, function (item, itemIndex) {
          item.classList.toggle('is-active', itemIndex === index);
          item.setAttribute('aria-current', itemIndex === index ? 'true' : 'false');
        });
      });
    });

    splide.mount();

    progressGroups.forEach(function (group) {
      Array.prototype.forEach.call(group.children, function (item, itemIndex) {
        item.addEventListener('click', function () {
          if (phase === 'active' && !aligning) {
            nextAllowed = Date.now() + SETTLE;
          }
          splide.go(itemIndex);
        });
      });
    });

    /* ---------- Scroll-controlled slider ---------- */

    const body = document.body;
    const lastIndex = splide.length - 1;

    const SETTLE = 820;   // cooldown between slides (must exceed the 700ms fade)
    const ALIGN_MS = 480; // duration of the self-driven centering animation
    const ARM_MS = 140;   // grace after centering before the first slide step
    const WHEEL_MIN = 3;
    const TOUCH_MIN = 14;
    const EXIT_NUDGE = 90;

    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    let phase = 'idle';       // idle | active | released
    let aligning = false;
    let lockedY = 0;
    let nextAllowed = 0;
    let touchY = null;
    let lastScrollY = window.pageYOffset;
    let rafId = null;

    /* Must be called BEFORE locking: once body is fixed, pageYOffset is 0. */
    function centerTarget() {
      const rect = section.getBoundingClientRect();
      const top = rect.top + window.pageYOffset;
      const max = Math.max(0, document.documentElement.scrollHeight - window.innerHeight);
      const target = top + rect.height / 2 - window.innerHeight / 2;
      return Math.max(0, Math.min(target, max));
    }

    function inViewport() {
      const rect = section.getBoundingClientRect();
      return rect.top < window.innerHeight && rect.bottom > 0;
    }

    function setLockedY(y) {
      lockedY = y;
      body.style.top = -y + 'px';
    }

    function lockBody(y) {
      const barWidth = window.innerWidth - document.documentElement.clientWidth;
      body.style.position = 'fixed';
      body.style.left = '0';
      body.style.right = '0';
      body.style.width = '100%';
      if (barWidth > 0) body.style.paddingRight = barWidth + 'px';
      setLockedY(y);
    }

    function unlockBody() {
      body.style.position = '';
      body.style.top = '';
      body.style.left = '';
      body.style.right = '';
      body.style.width = '';
      body.style.paddingRight = '';
      const prev = document.documentElement.style.scrollBehavior;
      document.documentElement.style.scrollBehavior = 'auto';
      window.scrollTo(0, lockedY);
      document.documentElement.style.scrollBehavior = prev;
      lastScrollY = lockedY;
    }

    /* Animate the *locked* offset — visually identical to a smooth scroll,
       but nothing native is running, so momentum can't fight it. */
    function animateTo(target, done) {
      if (rafId) cancelAnimationFrame(rafId);
      const from = lockedY;
      const distance = target - from;

      if (reduceMotion || Math.abs(distance) < 2) {
        setLockedY(target);
        done();
        return;
      }

      const start = performance.now();
      (function step(now) {
        const t = Math.min((now - start) / ALIGN_MS, 1);
        const eased = t < 0.5 ? 4 * t * t * t : 1 - Math.pow(-2 * t + 2, 3) / 2;
        setLockedY(from + distance * eased);
        if (t < 1) {
          rafId = requestAnimationFrame(step);
        } else {
          rafId = null;
          done();
        }
      })(start);
    }

    function activate(direction) {
      const startY = window.pageYOffset;
      const target = centerTarget();

      phase = 'active';
      aligning = true;
      lockBody(startY);

      /* Entering downward starts on slide 1, upward starts on the last slide. */
      splide.go(direction > 0 ? 0 : lastIndex);

      animateTo(target, function () {
        aligning = false;
        nextAllowed = Date.now() + ARM_MS;
      });
    }

    function release(direction) {
      if (rafId) { cancelAnimationFrame(rafId); rafId = null; }
      phase = 'released';
      aligning = false;
      unlockBody();
      window.scrollBy({
        top: direction * EXIT_NUDGE,
        behavior: reduceMotion ? 'auto' : 'smooth'
      });
    }

    /* Returns true when the gesture was consumed. */
    function handle(direction) {
      if (phase === 'released') return false;

      if (phase === 'idle') {
        if (!inViewport()) return false;
        activate(direction);
        return true;
      }

      /* phase === 'active' — swallow everything, including momentum. */
      if (aligning) return true;
      if (Date.now() < nextAllowed) return true;

      const atEdge =
        (direction > 0 && splide.index >= lastIndex) ||
        (direction < 0 && splide.index <= 0);

      if (atEdge) {
        release(direction);
        return true;
      }

      splide.go(direction > 0 ? '+1' : '-1');
      nextAllowed = Date.now() + SETTLE;
      return true;
    }

    window.addEventListener('wheel', function (e) {
      if (phase === 'active') {
        e.preventDefault();
        if (Math.abs(e.deltaY) >= WHEEL_MIN) handle(e.deltaY > 0 ? 1 : -1);
        return;
      }
      if (Math.abs(e.deltaY) < WHEEL_MIN) return;
      if (handle(e.deltaY > 0 ? 1 : -1)) e.preventDefault();
    }, { passive: false });

    window.addEventListener('keydown', function (e) {
      const down = e.key === 'ArrowDown' || e.key === 'PageDown' || e.key === ' ';
      const up = e.key === 'ArrowUp' || e.key === 'PageUp';
      if (!down && !up) return;
      if (handle(down ? 1 : -1)) e.preventDefault();
    });

    window.addEventListener('touchstart', function (e) {
      touchY = e.touches[0].clientY;
    }, { passive: true });

    window.addEventListener('touchmove', function (e) {
      if (phase === 'active') e.preventDefault();
      if (touchY === null) return;
      const delta = touchY - e.touches[0].clientY;
      if (Math.abs(delta) < TOUCH_MIN) return;
      touchY = e.touches[0].clientY;
      if (handle(delta > 0 ? 1 : -1)) e.preventDefault();
    }, { passive: false });

    window.addEventListener('touchend', function () { touchY = null; }, { passive: true });

    /* Catches entries that don't come from wheel/key (scrollbar drag, anchor,
       flick momentum) and re-arms the section once it has fully left. */
    window.addEventListener('scroll', function () {
      if (phase === 'active') return;

      const y = window.pageYOffset;
      const direction = y > lastScrollY ? 1 : -1;
      lastScrollY = y;

      if (phase === 'released') {
        const rect = section.getBoundingClientRect();
        if (rect.bottom < 0 || rect.top > window.innerHeight) phase = 'idle';
        return;
      }

      if (phase === 'idle' && inViewport()) activate(direction);
    }, { passive: true });

    window.addEventListener('resize', function () {
      if (phase === 'active') {
        if (rafId) { cancelAnimationFrame(rafId); rafId = null; }
        aligning = false;
        unlockBody();
        phase = 'released';
      }
    });

    if (window.Shopify && window.Shopify.designMode) phase = 'released';
  });
</script>

{% schema %}
{
  "name": "People Behind Ingredients",
  "tag": "section",
  "class": "section-people-behind-ingredients",
  "settings": [
    {
      "type": "richtext",
      "id": "heading",
      "label": "Heading",
      "default": "<h2>THE PEOPLE BEHIND OUR INGREDIENTS</h2>"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background color",
      "default": "#FFF9EF"
    },
    {
      "type": "image_picker",
      "id": "background_image",
      "label": "Background image"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "default": "#111111"
    },
    {
      "type": "range",
      "id": "media_height",
      "label": "Image height (desktop)",
      "min": 300,
      "max": 800,
      "step": 10,
      "unit": "px",
      "default": 560
    },
    {
      "type": "header",
      "content": "Desktop Spacing"
    },
    {
      "type": "range",
      "id": "desktop_padding_top",
      "label": "Top padding",
      "min": 0,
      "max": 300,
      "step": 5,
      "unit": "px",
      "default": 45
    },
    {
      "type": "range",
      "id": "desktop_padding_bottom",
      "label": "Bottom padding",
      "min": 0,
      "max": 300,
      "step": 5,
      "unit": "px",
      "default": 60
    },
    {
      "type": "header",
      "content": "Mobile Spacing"
    },
    {
      "type": "range",
      "id": "mobile_padding_top",
      "label": "Top padding",
      "min": 0,
      "max": 200,
      "step": 5,
      "unit": "px",
      "default": 35
    },
    {
      "type": "range",
      "id": "mobile_padding_bottom",
      "label": "Bottom padding",
      "min": 0,
      "max": 200,
      "step": 5,
      "unit": "px",
      "default": 40
    }
  ],
  "blocks": [
    {
      "type": "person",
      "name": "Ingredient Partner",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "GROWERS"
        },
        {
          "type": "richtext",
          "id": "description",
          "label": "Description",
          "default": "<p>Sweet potatoes, blueberries, kelp, thyme, ginger, cumin, and rose hips bring naturally occurring nutrients from the plant world.</p>"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "People Behind Ingredients",
      "blocks": [
        {
          "type": "person",
          "settings": {
            "title": "GROWERS"
          }
        },
        {
          "type": "person",
          "settings": {
            "title": "FISHERMEN"
          }
        },
        {
          "type": "person",
          "settings": {
            "title": "RANCHERS"
          }
        },
        {
          "type": "person",
          "settings": {
            "title": "SUPPLIERS"
          }
        }
      ]
    }
  ]
}
{% endschema %}
