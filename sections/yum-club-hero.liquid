{%- comment -%}
  Yum Club Hero — membership hero with wordmark, copy, CTA and login line.
  Figma: Yumwoof (Final) — desktop 8638:1439 (1512w), mobile 8640:1762 (392w).
  Namespace: .yum-club-hero  |  JS: window.yumClubHero (cart), window.yumClubHeroMotion (motion)
  Motion: background image parallax (scroll-linked, weaker on mobile) and a one-time,
  staggered soft reveal of wordmark → description → CTA → login. The reveal waits for
  the membership loader's doors to open when the loader is on the page.
{%- endcomment -%}

{%- liquid
  assign s = section.settings
  assign img_d = s.image_desktop
  assign img_m = s.image_mobile

  assign login_url = s.login_link | default: routes.account_login_url
  assign show_login = s.show_login
  if s.hide_login_for_customers and customer
    assign show_login = false
  endif

  assign heading_tag = s.heading_tag | default: 'h2'
-%}

<style>
  .yum-club-hero {
    --ych-s: clamp(0.6px, calc(100vw / 1512), 1px);
    --ych-m: clamp(0.816px, calc(100vw / 392), 1.3px);
    --ych-text: {{ s.text_color }};
    --ych-scrim: {{ s.scrim_strength | divided_by: 100.0 }};
    --ych-overlay-m: {{ s.overlay_mobile | divided_by: 100.0 }};
    --ych-font-body: 'Matter', 'Matter Medium', 'Matter-Medium', sans-serif;
    --ych-font-button: 'Blur', 'Blur Medium', 'Blur-Medium', sans-serif;
    display: block;
    margin-top: {{ s.margin_top_desktop }}px;
    margin-bottom: {{ s.margin_bottom_desktop }}px;
  }

  .yum-club-hero__card {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    width: 100%;
    height: calc(860 * var(--ych-s));
    border-radius: 0 0 calc(64 * var(--ych-s)) calc(64 * var(--ych-s));
    background-color: #000;
  }

  /* ---------- media ---------- */
  .yum-club-hero__media {
    position: absolute;
    inset: 0;
    z-index: 0;
    overflow: hidden;
  }
  .yum-club-hero__media img,
  .yum-club-hero__media svg {
    position: absolute;
    inset: 0;
    display: block;
    width: 100%;
    height: 100%;
    max-width: none;
    object-fit: cover;
  }
  .yum-club-hero__media svg { background: #3d3d3d; fill: rgba(255, 255, 255, 0.2); }
  .yum-club-hero__media--mobile { display: none; }

  /* Figma: 50% black → transparent at 53.142% */
  .yum-club-hero__scrim {
    position: absolute;
    inset: 0;
    z-index: 1;
    pointer-events: none;
    background: linear-gradient(90deg, rgba(0, 0, 0, var(--ych-scrim)) 0%, rgba(0, 0, 0, 0) 53.142%);
  }

  /* ---------- content ---------- */
  .yum-club-hero__inner {
    position: absolute;
    z-index: 2;
    left: calc(8.3333% + 50 * var(--ych-s));
    top: calc(224 * var(--ych-s));
    width: calc(552 * var(--ych-s));
    min-width: 300px;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: calc(32 * var(--ych-s));
    filter: drop-shadow(0 4px 16px rgba(0, 0, 0, 0.5));
    color: var(--ych-text);
    text-align: center;
  }

  .yum-club-hero__intro {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: calc(30 * var(--ych-s));
    width: 100%;
  }

  .yum-club-hero__title {
    margin: 0;
    padding: 0;
    line-height: 0;
    color: var(--ych-text);
  }
  .yum-club-hero__wordmark {
    display: block;
    width: calc(278 * var(--ych-s));
    height: calc(226 * var(--ych-s));
    max-width: none;
    object-fit: contain;
    color: var(--ych-text);
  }

  .yum-club-hero__text {
    margin: 0;
    width: 100%;
    font-family: var(--ych-font-body);
    font-weight: 500;
    font-style: normal;
    font-size: max(16px, calc(24 * var(--ych-s)));
    line-height: 1.3333;
    color: var(--ych-text);
    word-break: break-word;
    letter-spacing: 0;
  }

  .yum-club-hero__actions {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: calc(12 * var(--ych-s));
    width: max(300px, calc(380 * var(--ych-s)));
  }

.yum-club-hero__button {
  display: flex;
  align-items: center;
  justify-content: space-between;
  box-sizing: border-box;
  width: 100%;
  height: max(48px, calc(56 * var(--ych-s)));
  padding: 0 calc(30 * var(--ych-s));
  border: 0;
  border-radius: 160px;
  background-image: linear-gradient(90deg, #fff9ef 0%, #fff1d3 50%, #fff9ef 100%);
  background-color: #fff9ef;
  color: #000;
  text-decoration: none;
  font-family: 'FFBlurProMedium';
  font-weight: 500;
  font-style: normal;
  font-size: max(14px, calc(16 * var(--ych-s)));
  line-height: 1.25;
  letter-spacing: 0.08em;
  text-transform: uppercase;
  white-space: nowrap;
  cursor: pointer;
  background-size: 250% 100%;
  background-position: 100% 0;
  animation: buttonShine_yc_hero 4s linear infinite;
  position: relative;
  overflow: hidden;
  isolation: isolate;
}

.yum-club-hero__button::before {
  content: "";
  position: absolute;
  inset: 0;
  z-index: -1;
  background: #000;
  transform: translateY(102%);
  transition: transform .5s cubic-bezier(.2,.8,.2,1);
  pointer-events: none;
}

.yum-club-hero__button:hover::before {
  transform: translateY(0);
}

.yum-club-hero__button:hover {
  color: #fff9ef;
  box-shadow: 0 4px 16px rgba(0, 0, 0, 0.25);
}

.yum-club-hero__button:focus-visible {
  outline: 2px solid var(--ych-text);
  outline-offset: 3px;
}

@keyframes buttonShine_yc_hero {
  0% {
    background-position: 100% 0;
  }

  45% {
    background-position: 0% 0;
  }

  100% {
    background-position: 0% 0;
  }
}
  /* Add-to-cart form — same box as the old link, so layout is untouched */
  .yum-club-hero__form {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: calc(8 * var(--ych-s));
    width: 100%;
    margin: 0;
  }
  button.yum-club-hero__button {
    -webkit-appearance: none;
    appearance: none;
    margin: 0;
    text-align: left;
  }
  .yum-club-hero__button[aria-busy='true'] { cursor: progress; }
  .yum-club-hero__button:disabled:not([aria-busy='true']) {
    cursor: not-allowed;
    opacity: 0.6;
    box-shadow: none;
  }
  .yum-club-hero__plan-name,
  .yum-club-hero__form-error {
    margin: 0;
    width: 100%;
    font-family: var(--ych-font-body);
    font-weight: 500;
    font-size: max(13px, calc(14 * var(--ych-s)));
    line-height: 1.4;
    color: var(--ych-text);
    text-align: center;
  }
  .yum-club-hero__form-error:empty { display: none; }

  .yum-club-hero__login {
    margin: 0;
    width: 100%;
    font-family: var(--ych-font-body);
    font-weight: 500;
    font-size: max(14px, calc(16 * var(--ych-s)));
    line-height: 1.5;
    color: var(--ych-text);
    letter-spacing: 0;
  }
  .yum-club-hero__login a {
    color: inherit;
    text-decoration: underline;
    text-decoration-skip-ink: none;
    text-underline-position: from-font;
  }
  .yum-club-hero__login a:focus-visible {
    outline: 2px solid var(--ych-text);
    outline-offset: 2px;
  }

  .yum-club-hero__sr {
    position: absolute !important;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  /* ---------- Motion: image parallax ----------
     JS writes translate3d() scale() on the image each frame. The starting zoom is set here
     too, so the crop doesn't jump when the script takes over. */
  .yum-club-hero--parallax .yum-club-hero__media img {
    transform: scale(var(--ych-zoom, 1.06));
    transform-origin: 50% 50%;
    will-change: transform;
    backface-visibility: hidden;
  }

  /* ---------- Motion: staggered soft reveal ----------
     Hidden state is rendered by Liquid (no flash before JS runs); JS adds .is-revealed once.
     Each piece fades up from a light blur. <noscript> and reduced motion show it straight away. */
  .yum-club-hero--reveal .ych-reveal {
    opacity: 0;
    filter: blur(var(--ych-r-blur, 6px));
    transform: translate3d(0, var(--ych-r-y, 12px), 0);
    transition:
      opacity var(--ych-r-dur, 0.8s) cubic-bezier(0.22, 1, 0.36, 1) var(--ych-r-delay, 0s),
      filter var(--ych-r-dur, 0.8s) cubic-bezier(0.22, 1, 0.36, 1) var(--ych-r-delay, 0s),
      transform var(--ych-r-dur, 0.8s) cubic-bezier(0.22, 1, 0.36, 1) var(--ych-r-delay, 0s);
  }
  .yum-club-hero--reveal .ych-reveal--logo  { --ych-r-dur: 0.8s; --ych-r-delay: 0s;    --ych-r-blur: 8px; --ych-r-y: 14px; }
  .yum-club-hero--reveal .ych-reveal--text  { --ych-r-dur: 0.8s; --ych-r-delay: 0.15s; --ych-r-blur: 6px; --ych-r-y: 12px; }
  .yum-club-hero--reveal .ych-reveal--cta   { --ych-r-dur: 0.7s; --ych-r-delay: 0.3s;  --ych-r-blur: 4px; --ych-r-y: 10px; }
  .yum-club-hero--reveal .ych-reveal--login { --ych-r-dur: 0.7s; --ych-r-delay: 0.4s;  --ych-r-blur: 4px; --ych-r-y: 8px; }
  .yum-club-hero--reveal.is-revealed .ych-reveal {
    opacity: 1;
    filter: none;
    transform: none;
  }

  @media (prefers-reduced-motion: reduce) {
    .yum-club-hero__button { transition: none; }
    .yum-club-hero--reveal .ych-reveal { opacity: 1; filter: none; transform: none; transition: none; }
    .yum-club-hero--parallax .yum-club-hero__media img { transform: none; will-change: auto; }
  }

  /* ---------- mobile (separate Figma layout) ---------- */
  @media screen and (max-width: 749px) {
    .yum-club-hero {
      margin-top: {{ s.margin_top_mobile }}px;
      margin-bottom: {{ s.margin_bottom_mobile }}px;
      --ych-zoom: 1.03;
    }
    .yum-club-hero__card {
      height: calc(736 * var(--ych-m));
      border-radius: 0 0 calc(32 * var(--ych-m)) calc(32 * var(--ych-m));
    }
    .yum-club-hero__media--desktop,
    .yum-club-hero__scrim { display: none; }
    .yum-club-hero__media--mobile { display: block; }
    .yum-club-hero__media--mobile::after {
      content: '';
      position: absolute;
      inset: 0;
      background: rgba(0, 0, 0, var(--ych-overlay-m));
    }

    .yum-club-hero__inner {
      top: calc(104 * var(--ych-m));
      bottom: calc(51 * var(--ych-m));
      left: calc(24 * var(--ych-m));
      right: calc(24 * var(--ych-m));
      width: auto;
      min-width: 0;
      gap: 0;
      justify-content: space-between;
      filter: none;
    }
    .yum-club-hero__intro { gap: calc(16 * var(--ych-m)); }
    .yum-club-hero__wordmark {
      width: calc(168 * var(--ych-m));
      height: calc(136 * var(--ych-m));
    }
    .yum-club-hero__text {
      width: calc(312 * var(--ych-m));
      max-width: 100%;
      font-size: calc(18 * var(--ych-m));
      line-height: calc(24 * var(--ych-m));
    }
    .yum-club-hero__br { display: none; }

    .yum-club-hero__actions {
      width: 100%;
      gap: calc(12 * var(--ych-m));
    }
    .yum-club-hero__button {
      height: calc(48 * var(--ych-m));
      padding: 0 calc(30.5 * var(--ych-m));
      border-radius: 141.474px;
      font-size: calc(14.147 * var(--ych-m));
      line-height: calc(17.684 * var(--ych-m));
      letter-spacing: 0.08em;
    }
    .yum-club-hero__login {
      font-size: calc(14 * var(--ych-m));
      line-height: calc(20 * var(--ych-m));
    }

    /* Shorter reveal travel on mobile */
    .yum-club-hero--reveal .ych-reveal--logo  { --ych-r-y: 8px; --ych-r-blur: 6px; }
    .yum-club-hero--reveal .ych-reveal--text  { --ych-r-y: 7px; --ych-r-blur: 5px; }
    .yum-club-hero--reveal .ych-reveal--cta   { --ych-r-y: 6px; --ych-r-blur: 3px; }
    .yum-club-hero--reveal .ych-reveal--login { --ych-r-y: 5px; --ych-r-blur: 3px; }
  }
</style>

{%- if s.enable_reveal -%}
  <noscript><style>#yum-club-hero-{{ section.id }} .ych-reveal{opacity:1!important;filter:none!important;transform:none!important}</style></noscript>
{%- endif -%}

<section
  class="yum-club-hero{% if s.enable_parallax %} yum-club-hero--parallax{% endif %}{% if s.enable_reveal %} yum-club-hero--reveal{% endif %}"
  id="yum-club-hero-{{ section.id }}"
  {% if s.enable_parallax or s.enable_reveal %}data-yum-club-hero-motion{% endif %}
>
  <div class="yum-club-hero__card">
    <div class="yum-club-hero__media yum-club-hero__media--desktop">
      {%- if img_d != blank -%}
        {%- capture pos_d -%}object-position: {{ img_d.presentation.focal_point }};{%- endcapture -%}
        {{
          img_d
          | image_url: width: 3200
          | image_tag:
            loading: 'eager',
            fetchpriority: 'high',
            widths: '750, 1100, 1500, 1800, 2200, 2600, 3200',
            sizes: '100vw',
            alt: img_d.alt,
            style: pos_d
        }}
      {%- else -%}
        {{ 'lifestyle-1' | placeholder_svg_tag }}
      {%- endif -%}
    </div>

    {%- comment -%} Figma mobile hero is solid black; an optional mobile image can be layered in. {%- endcomment -%}
    {%- if img_m != blank -%}
      <div class="yum-club-hero__media yum-club-hero__media--mobile">
        {%- capture pos_m -%}object-position: {{ img_m.presentation.focal_point }};{%- endcapture -%}
        {{
          img_m
          | image_url: width: 1600
          | image_tag:
            loading: 'lazy',
            widths: '400, 600, 800, 1000, 1200, 1600',
            sizes: '(max-width: 749px) 100vw, 1px',
            alt: img_m.alt,
            style: pos_m
        }}
      </div>
    {%- endif -%}

    <div class="yum-club-hero__scrim" aria-hidden="true"></div>

    <div class="yum-club-hero__inner">
      <div class="yum-club-hero__intro">
        <{{ heading_tag }} class="yum-club-hero__title ych-reveal ych-reveal--logo">
          <span class="yum-club-hero__sr">{{ s.heading_text | escape }}</span>
          {%- if s.wordmark_image != blank -%}
            {{
              s.wordmark_image
              | image_url: width: 834
              | image_tag: class: 'yum-club-hero__wordmark', alt: '', loading: 'eager'
            }}
          {%- else -%}
            <svg class="yum-club-hero__wordmark" viewBox="0 0 278 226" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true" focusable="false">
