1 243.276 187.704C246.48 183.023 250.602 177.004 254.529 173.7C258.026 170.749 260.703 170.375 262.754 171.182C264.884 172.008 265.079 180.643 260.586 188.038L260.605 188.019Z"/>
            </svg>
          {%- endif -%}
        </{{ heading_tag }}>

        {%- if s.description != blank -%}
          <p class="yum-club-hero__text ych-reveal ych-reveal--text">
            {{- s.description | escape | newline_to_br | replace: '<br />', '<br class="yum-club-hero__br">' -}}
          </p>
        {%- endif -%}
      </div>

      <div class="yum-club-hero__actions">
        {%- comment -%} ---------- Add to cart (same logic as yw-membership-club) ---------- {%- endcomment -%}
        {%- liquid
          assign atc_product = s.product
          assign atc_variant = null
          assign atc_selling_plan = null
          assign atc_plan_required = false

          if atc_product != blank
            assign atc_variant = atc_product.selected_or_first_available_variant
          endif

          if atc_variant != blank
            assign atc_plan_required = atc_variant.requires_selling_plan

            if atc_variant.selling_plan_allocations.size > 0
              if s.selling_plan_id != blank
                for allocation in atc_variant.selling_plan_allocations
                  if allocation.selling_plan.id == s.selling_plan_id
                    assign atc_selling_plan = allocation.selling_plan
                    break
                  endif
                endfor
              endif

              if atc_selling_plan == null
                assign atc_selling_plan = atc_variant.selling_plan_allocations.first.selling_plan
              endif
            endif
          endif

          assign atc_blocked = false
          if atc_plan_required and atc_selling_plan == null
            assign atc_blocked = true
          endif

          comment
            Membership is a one-per-cart item. Match on product_id so switching
            variants can't slip a second membership into the cart.
          endcomment
          assign ych_in_cart = false
          if atc_product != blank
            for line in cart.items
              if line.product_id == atc_product.id
                assign ych_in_cart = true
                break
              endif
            endfor
          endif
        -%}

        {%- if atc_product != blank and atc_variant != blank -%}
          <form
            method="post"
            action="{{ routes.cart_add_url }}"
            class="yum-club-hero__form ych-reveal ych-reveal--cta"
            data-yum-club-hero-form
            data-cart-behavior="{{ s.cart_behavior }}"
            data-product-id="{{ atc_product.id }}"
          >
            <input type="hidden" name="form_type" value="product">
            <input type="hidden" name="utf8" value="✓">
            <input type="hidden" name="id" value="{{ atc_variant.id }}">
            <input type="hidden" name="quantity" value="{{ s.quantity }}">
            {%- if atc_selling_plan != null -%}
              <input type="hidden" name="selling_plan" value="{{ atc_selling_plan.id }}" data-yum-club-hero-selling-plan>
            {%- endif -%}

            {%- if atc_selling_plan != null and s.show_plan_name -%}
              <p class="yum-club-hero__plan-name">{{ atc_selling_plan.name | escape }}</p>
            {%- endif -%}

            <button
              type="submit"
              class="yum-club-hero__button{% if ych_in_cart %} yum-club-hero__button--in-cart{% endif %}"
              data-yum-club-hero-in-cart="{% if ych_in_cart %}true{% else %}false{% endif %}"
              {% if atc_variant.available == false or atc_blocked %}
                disabled
              {% endif %}
            >
              {%- if atc_variant.available == false -%}
                <span>{{ s.sold_out_text | default: 'SOLD OUT' | escape }}</span>
              {%- else -%}
                <span>{{ s.button_label | default: 'JOIN MEMBERSHIP' | escape }}</span>
                {%- if s.button_price != blank -%}
                  <span>{{ s.button_price | escape }}</span>
                {%- endif -%}
              {%- endif -%}
            </button>

            {%- if atc_blocked and request.design_mode -%}
              <p class="yum-club-hero__form-error">
                This variant can only be purchased with a selling plan, but no plan is attached to it. Check the
                subscription app's plan group for this product.
              </p>
            {%- endif -%}

            <p class="yum-club-hero__form-error" data-yum-club-hero-error role="alert" hidden></p>
          </form>

        {%- elsif s.button_label != blank -%}
          {%- comment -%} No product selected — plain link, as before {%- endcomment -%}
          <a class="yum-club-hero__button ych-reveal ych-reveal--cta" href="{{ s.button_link | default: '#' }}">
            <span>{{ s.button_label | escape }}</span>
            {%- if s.button_price != blank -%}
              <span>{{ s.button_price | escape }}</span>
            {%- endif -%}
          </a>
        {%- endif -%}

        {%- if show_login -%}
          <p class="yum-club-hero__login ych-reveal ych-reveal--login">
            {{- s.login_prefix | escape }} <a href="{{ login_url }}">{{ s.login_label | escape }}</a>
          </p>
        {%- endif -%}
      </div>
    </div>
  </div>
</section>

<script>
  (function () {
    // One shared instance, however many Yum Club Hero sections are on the page.
    if (window.yumClubHero && window.yumClubHero.init) {
      window.yumClubHero.init(document);
      return;
    }

    function getDrawer() {
      return document.querySelector('cart-drawer');
    }

    function getDrawerSectionId() {
      var el = document.getElementById('CartDrawer-SectionId');
      return el ? el.dataset.sectionId : 'cart-drawer';
    }

    function openDrawer() {
      var drawer = getDrawer();
      if (drawer && typeof drawer.open === 'function') {
        drawer.open();
        return true;
      }
      var toggle = document.querySelector('#cart-icon-bubble, a[href$="/cart"]');
      if (toggle) {
        toggle.click();
        return true;
      }
      return false;
    }

    function setButtonState(form, inCart) {
      var button = form.querySelector('.yum-club-hero__button');
      if (!button) return;
      // State only — the label text never changes.
      button.dataset.yumClubHeroInCart = inCart ? 'true' : 'false';
      button.classList.toggle('yum-club-hero__button--in-cart', inCart);
    }

    // Check the live cart rather than trusting the server-rendered flag —
    // the customer may have removed the item from the drawer since page load.
    function isAlreadyInCart(productId) {
      return fetch(window.Shopify.routes.root + 'cart.js', {
        headers: { Accept: 'application/json' },
        cache: 'no-store',
      })
        .then(function (res) {
          return res.json();
        })
        .then(function (cart) {
          return (cart.items || []).some(function (line) {
            return String(line.product_id) === String(productId);
          });
        })
        .catch(function () {
          return false;
        });
    }

    function init(root) {
      (root || document).querySelectorAll('[data-yum-club-hero-form]').forEach(function (form) {
        if (form.dataset.yumClubHeroBound) return;
        form.dataset.yumClubHeroBound = 'true';

        form.addEventListener('submit', function (event) {
          event.preventDefault();

          var behavior = form.dataset.cartBehavior || 'drawer';
          var button = form.querySelector('.yum-club-hero__button');
          var errorEl = form.querySelector('[data-yum-club-hero-error]');
          if (errorEl) {
            errorEl.hidden = true;
            errorEl.textContent = '';
          }
          if (button) {
            button.setAttribute('aria-busy', 'true');
            button.disabled = true;
          }

          function release() {
            if (button) {
              button.removeAttribute('aria-busy');
              button.disabled = false;
            }
          }

          isAlreadyInCart(form.dataset.productId).then(function (inCart) {
            if (inCart) {
              setButtonState(form, true);
              release();
              if (!openDrawer()) {
                window.location.href = window.Shopify.routes.root + 'cart';
              }
              return;
            }

            setButtonState(form, false);

            if (behavior === 'cart') {
              form.submit();
              return;
            }

            var drawer = getDrawer();
            var planInput = form.querySelector('[data-yum-club-hero-selling-plan]');

            var item = {
              id: Number(form.querySelector('input[name="id"]').value),
              quantity: Number(form.querySelector('input[name="quantity"]').value || 1),
            };
            if (planInput && planInput.value) {
              item.selling_plan = Number(planInput.value);
            }

            var payload = { items: [item] };

            // Ask Shopify to re-render the drawer sections in the same request,
            // otherwise the drawer keeps its stale markup until a reload.
            var sectionIds = [];
            if (drawer && drawer.getSectionsToRender) {
              sectionIds = drawer.getSectionsToRender().map(function (sec) {
                return sec.id;
              });
            }
            if (!sectionIds.length) {
              sectionIds = [getDrawerSectionId(), 'cart-icon-bubble'];
            }

            payload.sections = sectionIds.join(',');
            payload.sections_url = window.location.pathname;

            fetch(window.Shopify.routes.root + 'cart/add.js', {
              method: 'POST',
              headers: { 'Content-Type': 'application/json', Accept: 'application/javascript' },
              body: JSON.stringify(payload),
            })
              .then(function (res) {
                return res.json();
              })
              .then(function (data) {
                if (data.status) throw new Error(data.description || data.message);

                setButtonState(form, true);

                if (drawer && typeof drawer.renderContents === 'function') {
                  // Dawn's renderContents both repaints and opens the drawer.
                  drawer.renderContents(data);
                } else {
                  document.dispatchEvent(new CustomEvent('cart:refresh', { bubbles: true }));
                  if (behavior === 'drawer') openDrawer();
                  return;
                }

                if (behavior === 'stay' && drawer.classList.contains('active')) {
                  if (typeof drawer.close === 'function') drawer.close();
                }
              })
              .catch(function (err) {
                if (errorEl) {
                  errorEl.textContent = err.message || 'Could not add to cart.';
                  errorEl.hidden = false;
                }
              })
              .finally(release);
          });
        });
      });
    }

    window.yumClubHero = { init: init };

    init(document);
    document.addEventListener('shopify:section:load', function (e) {
      init(e.target);
    });
  })();
</script>

<script>
  (function () {
    /* Hero motion (separate from the cart script): image parallax + one-time staggered reveal. */
    if (window.yumClubHeroMotion) return window.yumClubHeroMotion(document);

    var reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    var mobileMq = window.matchMedia('(max-width: 749px)');
    var CFG = {
      desktop: { zoomStart: 1.06, zoomEnd: 1.16 },
      mobile:  { zoomStart: 1.03, zoomEnd: 1.08 },
      span: 0.6 // share of the hero height scrolled to reach the full effect
    };

    // Run cb once the membership loader has gone (right away if there's no loader).
    function afterLoader(cb) {
      var loader = document.getElementById('yw-membership-loader');
      var done = false;
      var go = function () { if (!done) { done = true; cb(); } };
      if (!loader || !loader.isConnected) return go();
      var mo = new MutationObserver(function () {
        if (!loader.isConnected) { mo.disconnect(); go(); }
      });
      mo.observe(loader.parentNode, { childList: true });
      setTimeout(go, 15000); // safety: never leave the hero hidden
    }

    function setup(root) {
      if (root.dataset.ychMotionReady) return;
      root.dataset.ychMotionReady = '1';
      if (reduced) return root.classList.add('is-revealed');

      // Reveal: wordmark → description → CTA → login (timing lives in the CSS)
      if (root.classList.contains('yum-club-hero--reveal')) {
        var show = function () { requestAnimationFrame(function () { root.classList.add('is-revealed'); }); };
        if (window.Shopify && Shopify.designMode) root.classList.add('is-revealed');
        else if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', function () { afterLoader(show); });
        else afterLoader(show);
      }

      // Parallax: image pushes in and drifts down, never past its zoom margin (no edge shows)
      if (!root.classList.contains('yum-club-hero--parallax')) return;
      var card = root.querySelector('.yum-club-hero__card');
      var imgD = root.querySelector('.yum-club-hero__media--desktop img');
      var imgM = root.querySelector('.yum-club-hero__media--mobile img');
      var ticking = false;

      function frame() {
        ticking = false;
        var mob = mobileMq.matches, cfg = mob ? CFG.mobile : CFG.desktop, img = mob ? imgM : imgD;
        if (!img || !card.isConnected) return;
        var r = card.getBoundingClientRect();
        if (r.bottom < 0 || r.top > window.innerHeight) return;
        var p = Math.min(Math.max(-r.top / (r.height * CFG.span), 0), 1);
        var zoom = cfg.zoomStart + (cfg.zoomEnd - cfg.zoomStart) * p;
        var y = p * (zoom - 1) * r.height / 2;
        img.style.transform = 'translate3d(0,' + y.toFixed(2) + 'px,0) scale(' + zoom.toFixed(4) + ')';
      }
      function onScroll() { if (!ticking) { ticking = true; requestAnimationFrame(frame); } }

      window.addEventListener('scroll', onScroll, { passive: true });
      window.addEventListener('resize', onScroll, { passive: true });
      frame();
    }

    window.yumClubHeroMotion = function (scope) {
      scope.querySelectorAll('[data-yum-club-hero-motion]').forEach(setup);
    };
    window.yumClubHeroMotion(document);
    document.addEventListener('shopify:section:load', function (e) { window.yumClubHeroMotion(e.target); });
  })();
</script>

{% schema %}
{
  "name": "Yum Club Hero",
  "tag": "div",
  "class": "section-yum-club-hero",
  "settings": [
    { "type": "header", "content": "Background" },
    {
      "type": "image_picker",
      "id": "image_desktop",
      "label": "Desktop image",
      "info": "Recommended 3024 × 1720px. Use the focal point to control the crop."
    },
    {
      "type": "range",
      "id": "scrim_strength",
      "label": "Desktop left scrim",
      "min": 0,
      "max": 80,
      "step": 5,
      "unit": "%",
      "default": 50
    },
    {
      "type": "image_picker",
      "id": "image_mobile",
      "label": "Mobile image (optional)",
      "info": "The Figma mobile hero is solid black. Leave empty to match it."
    },
    {
      "type": "range",
      "id": "overlay_mobile",
      "label": "Mobile image dimming",
      "min": 0,
      "max": 80,
      "step": 5,
      "unit": "%",
      "default": 40
    },
    { "type": "header", "content": "Heading" },
    {
      "type": "image_picker",
      "id": "wordmark_image",
      "label": "Wordmark override",
      "info": "Leave empty to use the built-in Yum Club wordmark from Figma."
    },
    {
      "type": "text",
      "id": "heading_text",
      "label": "Heading text (for screen readers / SEO)",
      "default": "Yum Club"
    },
    {
      "type": "select",
      "id": "heading_tag",
      "label": "Heading tag",
      "default": "h1",
      "options": [
        { "value": "h1", "label": "H1" },
        { "value": "h2", "label": "H2" }
      ]
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Description",
      "info": "Line breaks apply on desktop only.",
      "default": "The Yum Club is for big dog families who\nlove the good stuff. Members get 25% off everything and much more."
    },
    {
      "type": "color",
      "id": "text_color",
