{{ 'css--main-collection-products-grid.css' | asset_url | stylesheet_tag }}

{%- style -%}
  #shopify-section-{{ section.id }} .mcg {
    --mcg-cols: {{ section.settings.columns_desktop }};
  }
{%- endstyle -%}

{%- assign current_collection_promo = blank -%}

{%- for promo in shop.metaobjects.collection_promo.values -%}
  {%- if promo.collection.value != blank and promo.collection.value.handle == collection.handle -%}
    {%- assign current_collection_promo = promo -%}
    {%- break -%}
  {%- endif -%}
{%- endfor -%}

<div class="mcg page-width" style="--mcg-cols: {{ section.settings.columns_desktop }};">

  {%- if collection.handle == section.settings.all_collection_handle -%}

    {%- for block in section.blocks -%}
      {%- if block.type == 'product_group' -%}

        {%- assign group_products = block.settings.products -%}
        {%- assign group_collection = block.settings.collection -%}
        {%- assign group_promo = blank -%}

        {%- if group_collection != blank -%}
          {%- for promo in shop.metaobjects.collection_promo.values -%}
            {%- if promo.collection.value != blank and promo.collection.value.handle == group_collection.handle -%}
              {%- assign group_promo = promo -%}
              {%- break -%}
            {%- endif -%}
          {%- endfor -%}
        {%- endif -%}

        {%- if group_products.count > 0 -%}

          <div class="mcg__group mcg__group--{{ block.settings.heading | handleize }}" {{ block.shopify_attributes }}>

            {%- if block.settings.heading != blank -%}
              <h2 class="mcg__group-heading">{{ block.settings.heading }}</h2>
            {%- endif -%}

            {%- if block.settings.subheading != blank -%}
              <p class="mcg__group-sub">{{ block.settings.subheading }}</p>
            {%- endif -%}

            {%- if group_promo != blank and group_promo.promo_text.value != blank -%}
              <div class="mcg__promo">

                <div class="mcg__promo-desktop">
                  {{ group_promo.promo_text.value }}
                </div>

                <div class="mcg__promo-mobile">

                  {%- assign promo_images = group_promo.images.value -%}

                  {%- if promo_images != blank -%}
                    {%- for image in promo_images -%}
                      <div class="mcg__promo-slide">
                        {{ image | image_url: width: 400 | image_tag: loading: 'eager' }}
                      </div>
                    {%- endfor -%}
                  {%- endif -%}

                  <div class="mcg__promo-mobile-text">
                    {{ group_promo.promo_text.value }}
                  </div>

                </div>

              </div>
            {%- endif -%}

            <div class="mcg__grid">
              {%- for product in group_products -%}
                {% render 'card-product-yw',
                  product: product,
                  short_desc_mf: section.settings.short_desc_metafield
                %}
              {%- endfor -%}
            </div>

          </div>

        {%- endif -%}

      {%- endif -%}
    {%- endfor -%}

  {%- else -%}

    {%- if collection.products.size > 0 -%}

      <div class="mcg__group mcg__group--collection">

        {%- if current_collection_promo != blank and current_collection_promo.promo_text.value != blank -%}

          <div class="mcg__promo">

            <div class="mcg__promo-desktop">
              {{ current_collection_promo.promo_text.value }}
            </div>

            <div class="mcg__promo-mobile">

              {%- assign promo_images = current_collection_promo.images.value -%}

              {%- if promo_images != blank -%}
                {%- for image in promo_images -%}
                  <div class="mcg__promo-slide">
                    {{ image | image_url: width: 400 | image_tag: loading: 'eager' }}
                  </div>
                {%- endfor -%}
              {%- endif -%}

              <div class="mcg__promo-mobile-text">
                {{ current_collection_promo.promo_text.value }}
              </div>

            </div>

          </div>

        {%- endif -%}

        {%- if section.settings.collection_heading != blank -%}
          <h2 class="mcg__group-heading">
            {{ section.settings.collection_heading }}
          </h2>
        {%- endif -%}

        {%- paginate collection.products by section.settings.products_per_page -%}

          <div class="mcg__grid">
            {%- for product in collection.products -%}
              {% render 'card-product-yw',
                product: product,
                short_desc_mf: section.settings.short_desc_metafield
              %}
            {%- endfor -%}
          </div>

          {%- if paginate.pages > 1 -%}
            {% render 'pagination', paginate: paginate, anchor: '' %}
          {%- endif -%}

        {%- endpaginate -%}

      </div>

    {%- endif -%}

  {%- endif -%}

</div>

<script>
  document.addEventListener('DOMContentLoaded', function () {
    document.querySelectorAll('.mcg__promo-mobile').forEach(function (promo) {
      const slides = promo.querySelectorAll('.mcg__promo-slide');

      if (!slides.length) return;

      slides.forEach(function (slide, index) {
        slide.style.display = index === 0 ? 'block' : 'none';
      });

      if (slides.length <= 1) return;

      let current = 0;

      setInterval(function () {
        slides[current].style.display = 'none';
        current = (current + 1) % slides.length;
        slides[current].style.display = 'block';
      }, 3000);
    });
  });
</script>

{% schema %}
{
  "name": "Collection products",
  "tag": "section",
  "class": "section-main-collection-products",
  "settings": [
    {
      "type": "text",
      "id": "all_collection_handle",
      "label": "Catch-all collection handle",
      "default": "all"
    },
    {
      "type": "checkbox",
      "id": "show_collection_products",
      "label": "Show this collection's products",
      "default": false
    },
    {
      "type": "text",
      "id": "collection_heading",
      "label": "Collection products heading"
    },
    {
      "type": "range",
      "id": "products_per_page",
      "min": 8,
      "max": 48,
      "step": 4,
      "label": "Products per page",
      "default": 24
    },
    {
      "type": "range",
      "id": "columns_desktop",
      "min": 2,
      "max": 4,
      "step": 1,
      "label": "Columns (desktop)",
      "default": 3
    },
    {
      "type": "text",
      "id": "short_desc_metafield",
      "label": "Short description metafield",
      "info": "namespace.key shown above the price on each card.",
      "default": "custom.collection_short_description"
    }
  ],
  "blocks": [
    {
      "type": "product_group",
      "name": "Product group",
      "settings": [
        {
          "type": "collection",
          "id": "collection",
          "label": "Collection",
          "info": "Select the collection this product group belongs to."
        },
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "Air dried food"
        },
        {
          "type": "textarea",
          "id": "subheading",
          "label": "Subheading"
        },
        {
          "type": "product_list",
          "id": "products",
          "label": "Products",
          "limit": 12
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Collection products"
    }
  ],
  "enabled_on": {
    "templates": ["collection"]
  }
}
{% endschema %}