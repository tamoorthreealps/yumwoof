{{ 'css--main-collection-products-grid.css' | asset_url | stylesheet_tag }}

{%- style -%}
  #shopify-section-{{ section.id }} .mcg {
    --mcg-cols: {{ section.settings.columns_desktop }};
  }
{%- endstyle -%}

{%- comment -%} Are we on the catch-all page, or a specific collection? {%- endcomment -%}
{%- assign is_all = false -%}
{%- if collection.handle == section.settings.all_collection_handle -%}
  {%- assign is_all = true -%}
{%- endif -%}

{%- comment -%} Find the product group whose picked collection matches the current one {%- endcomment -%}
{%- assign matched_block = blank -%}
{%- for block in section.blocks -%}
  {%- if block.type == 'product_group' and block.settings.collection != blank -%}
    {%- if block.settings.collection.handle == collection.handle -%}
      {%- assign matched_block = block -%}
      {%- break -%}
    {%- endif -%}
  {%- endif -%}
{%- endfor -%}

<div class="mcg page-width" style="--mcg-cols: {{ section.settings.columns_desktop }};">

  {%- comment -%} Curated groups: only rendered on the catch-all collection page {%- endcomment -%}
  {%- if is_all -%}
    {%- for block in section.blocks -%}
      {%- if block.type == 'product_group' -%}
        {%- assign group_products = block.settings.products -%}
        {%- if group_products.count > 0 -%}
          <div class="mcg__group mcg__group--{{ block.settings.heading | handleize }}" {{ block.shopify_attributes }}>
            {%- if block.settings.heading != blank -%}
              <h2 class="mcg__group-heading">{{ block.settings.heading }}</h2>
            {%- endif -%}

            {%- if block.settings.subheading != blank -%}
              <p class="mcg__group-sub">{{ block.settings.subheading }}</p>
            {%- endif -%}

            {% render 'mcg-promo', block: block %}

            <div class="mcg__grid">
              {%- for product in group_products -%}
                {% render 'card-product-yw', product: product, short_desc_mf: section.settings.short_desc_metafield %}
              {%- endfor -%}
            </div>
          </div>
        {%- endif -%}
      {%- endif -%}
    {%- endfor -%}
  {%- endif -%}

  {%- comment -%}
    The collection's own products.
    Always shown on a specific collection page; on the catch-all page it
    still respects the "Show this collection's products" checkbox.
  {%- endcomment -%}
  {%- if collection.products.size > 0 -%}
    {%- if is_all == false or section.settings.show_collection_products -%}
      <div class="mcg__group mcg__group--collection">

        {%- comment -%} Reuse the matching group's promo banner, settings and all {%- endcomment -%}
        {%- if is_all == false and matched_block != blank -%}
          {% render 'mcg-promo', block: matched_block %}
        {%- endif -%}

        {%- if section.settings.collection_heading != blank -%}
          <h2 class="mcg__group-heading">{{ section.settings.collection_heading }}</h2>
        {%- endif -%}

        {%- paginate collection.products by section.settings.products_per_page -%}
          <div class="mcg__grid">
            {%- for product in collection.products -%}
              {% render 'card-product-yw', product: product, short_desc_mf: section.settings.short_desc_metafield %}
            {%- endfor -%}
          </div>

          {%- if paginate.pages > 1 -%}
            {% render 'pagination', paginate: paginate, anchor: '' %}
          {%- endif -%}
        {%- endpaginate -%}

      </div>
    {%- endif -%}
  {%- endif -%}

</div>

<script>
  document.addEventListener('DOMContentLoaded', function () {
    document.querySelectorAll('.mcg__promo-mobile').forEach(function (promo) {
      const slides = promo.querySelectorAll('.mcg__promo-slide');

      if (!slides.length) return;

      slides.forEach(function (slide, index) {
        slide.style.display = index === 0 ? 'block' : 'none';
      });

      if (slides.length <= 1) return;

      let current = 0;

      setInterval(function () {
        slides[current].style.display = 'none';
        current = (current + 1) % slides.length;
        slides[current].style.display = 'block';
      }, 3000);
    });
  });
</script>

{% schema %}
{
  "name": "Collection products",
  "tag": "section",
  "class": "section-main-collection-products",
  "settings": [
    {
      "type": "text",
      "id": "all_collection_handle",
      "label": "Catch-all collection handle",
      "info": "The collection where the curated product groups are shown (e.g. all). On any other collection, only the matching group's promo banner is shown.",
      "default": "all"
    },
    {
      "type": "checkbox",
      "id": "show_collection_products",
      "label": "Show this collection's products",
      "default": false,
      "info": "Applies to the catch-all page only. On individual collections the products always show."
    },
    { "type": "text", "id": "collection_heading", "label": "Collection products heading" },
    {
      "type": "range",
      "id": "products_per_page",
      "min": 8,
      "max": 48,
      "step": 4,
      "label": "Products per page",
      "default": 24
    },
    {
      "type": "range",
      "id": "columns_desktop",
      "min": 2,
      "max": 4,
      "step": 1,
      "label": "Columns (desktop)",
      "default": 3
    },
    {
      "type": "text",
      "id": "short_desc_metafield",
      "label": "Short description metafield",
      "info": "namespace.key shown above the price on each card.",
      "default": "custom.collection_short_description"
    }
  ],
  "blocks": [
    {
      "type": "product_group",
      "name": "Product group",
      "settings": [
        {
          "type": "collection",
          "id": "collection",
          "label": "Collection",
          "info": "Select the collection this product group belongs to. Its promo banner will also show on that collection's page."
        },
        { "type": "text", "id": "heading", "label": "Heading", "default": "Air dried food" },
        { "type": "textarea", "id": "subheading", "label": "Subheading" },
        { "type": "product_list", "id": "products", "label": "Products", "limit": 12 },
        { "type": "text", "id": "promo_text", "label": "Promo text" },
        { "type": "image_picker", "id": "promo_image_1", "label": "Promo image 1" },
        { "type": "image_picker", "id": "promo_image_2", "label": "Promo image 2" },
        { "type": "image_picker", "id": "promo_image_3", "label": "Promo image 3" }
      ]
    }
  ],
  "presets": [{ "name": "Collection products" }],
  "enabled_on": { "templates": ["collection"] }
}
{% endschema %}
