{{ 'css--main-collection-products-grid.css' | asset_url | stylesheet_tag }}

{%- style -%}
  #shopify-section-{{ section.id }} .mcg {
    --mcg-cols: {{ section.settings.columns_desktop }};
  }
{%- endstyle -%}

<div class="mcg page-width" style="--mcg-cols: {{ section.settings.columns_desktop }};">
  {%- comment -%} Curated groups: each block = heading + subheading + selected products {%- endcomment -%}
  {%- for block in section.blocks -%}
    {%- if block.type == 'product_group' -%}
      {%- assign group_products = block.settings.products -%}
      {%- if group_products.count > 0 -%}
        <div class="mcg__group mcg__group--{{ block.settings.heading | handleize }}" {{ block.shopify_attributes }}>
          {%- if block.settings.heading != blank -%}
            <h2 class="mcg__group-heading">{{ block.settings.heading }}</h2>
          {%- endif -%}
          {%- if block.settings.subheading != blank -%}
            <p class="mcg__group-sub">{{ block.settings.subheading }}</p>
          {%- endif -%}
          {%- if block.settings.promo_text != blank -%}
            <div class="mcg__promo">
              <div class="mcg__promo-desktop">
                {{ block.settings.promo_text }}
              </div>

              <div class="mcg__promo-mobile">
                <div class="mcg__promo-slides">
                  {%- for i in (1..3) -%}
                    {%- assign image_key = 'promo_image_' | append: i -%}
                    {%- if block.settings[image_key] != blank -%}
                      <div class="mcg__promo-slide">
                        {{ block.settings[image_key] | image_url: width: 200 | image_tag: loading: 'lazy' }}
                      </div>
                    {%- endif -%}
                  {%- endfor -%}
                </div>

                <div class="mcg__promo-mobile-text">
                  {{ block.settings.promo_text }}
                </div>
              </div>
            </div>
          {%- endif -%}
          <div class="mcg__grid">
            {%- for product in group_products -%}
              {% render 'card-product-yw', product: product, short_desc_mf: section.settings.short_desc_metafield %}
            {%- endfor -%}
          </div>
        </div>
      {%- endif -%}
    {%- endif -%}
  {%- endfor -%}

  {%- comment -%} Optionally show the collection's own products below the curated groups {%- endcomment -%}
  {%- if section.settings.show_collection_products and collection.products.size > 0 -%}
    <div class="mcg__group mcg__group--collection">
      {%- if section.settings.collection_heading != blank -%}
        <h2 class="mcg__group-heading">{{ section.settings.collection_heading }}</h2>
      {%- endif -%}
      {%- paginate collection.products by section.settings.products_per_page -%}
        <div class="mcg__grid">
          {%- for product in collection.products -%}
            {% render 'card-product-yw', product: product, short_desc_mf: section.settings.short_desc_metafield %}
          {%- endfor -%}
        </div>
        {%- if paginate.pages > 1 -%}
          {% render 'pagination', paginate: paginate, anchor: '' %}
        {%- endif -%}
      {%- endpaginate -%}
    </div>
  {%- endif -%}
</div>
<script>
  document.addEventListener('DOMContentLoaded', function () {
    document.querySelectorAll('.mcg__promo-mobile').forEach(function (promo) {
      const slides = promo.querySelectorAll('.mcg__promo-slide');

      if (slides.length <= 1) return;

      let current = 0;

      slides.forEach(function (slide, index) {
        slide.style.opacity = index === 0 ? '1' : '0';
      });

      setInterval(function () {
        const next = (current + 1) % slides.length;

        slides[current].style.opacity = '0';
        slides[next].style.opacity = '1';

        current = next;
      }, 3000);
    });
  });
</script>
{% schema %}
{
  "name": "Collection products",
  "tag": "section",
  "class": "section-main-collection-products",
  "settings": [
    {
      "type": "checkbox",
      "id": "show_collection_products",
      "label": "Show this collection's products",
      "default": false,
      "info": "When on, the collection's own products are shown (paginated) below the curated groups."
    },
    { "type": "text", "id": "collection_heading", "label": "Collection products heading" },
    {
      "type": "range",
      "id": "products_per_page",
      "min": 8,
      "max": 48,
      "step": 4,
      "label": "Products per page",
      "default": 24
    },
    {
      "type": "range",
      "id": "columns_desktop",
      "min": 2,
      "max": 4,
      "step": 1,
      "label": "Columns (desktop)",
      "default": 3
    },
    {
      "type": "text",
      "id": "short_desc_metafield",
      "label": "Short description metafield",
      "info": "namespace.key shown above the price on each card.",
      "default": "custom.collection_short_description"
    }
  ],
  "blocks": [
    {
      "type": "product_group",
      "name": "Product group",
      "settings": [
        { "type": "text", "id": "heading", "label": "Heading", "default": "Air dried food" },
        { "type": "textarea", "id": "subheading", "label": "Subheading" },
        { "type": "product_list", "id": "products", "label": "Products", "limit": 12 },
        { "type": "text", "id": "promo_text", "label": "Promo text" },
        { "type": "image_picker", "id": "promo_image_1", "label": "Promo image 1" },
        { "type": "image_picker", "id": "promo_image_2", "label": "Promo image 2" },
        { "type": "image_picker", "id": "promo_image_3", "label": "Promo image 3" }
      ]
    }
  ],
  "presets": [{ "name": "Collection products" }],
  "enabled_on": { "templates": ["collection"] }
}
{% endschema %}
