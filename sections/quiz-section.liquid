{{ 'css--quiz-section.css' | asset_url | stylesheet_tag }}

{%- style -%}
  #shopify-section-{{ section.id }} .quiz {
    --quiz-bg: {{ section.settings.background_color }};
    --quiz-text: {{ section.settings.text_color }};

    {% if section.settings.background_image != blank %}
      background-image: url('{{ section.settings.background_image | image_url: width: 2500 }}');
      background-size: cover;
      background-position: center;
      background-repeat: no-repeat;
    {% endif %}
  }

  @media (max-width: 989px) {
    #shopify-section-{{ section.id }} .quiz {
      {% if section.settings.background_image_mobile != blank %}
        background-image: url('{{ section.settings.background_image_mobile | image_url: width: 1200 }}');
      {% elsif section.settings.background_image != blank %}
        background-image: url('{{ section.settings.background_image | image_url: width: 1200 }}');
      {% endif %}
    }
  }
{%- endstyle -%}

<section
  class="quiz{% if section.settings.uppercase_heading %} quiz--uppercase{% endif %}"
  data-quiz-cta
>
  {%- if section.settings.decor_left != blank -%}
    <span class="quiz__decor quiz__decor--left" aria-hidden="true">
      {{
        section.settings.decor_left
        | image_url: width: 264
        | image_tag: alt: '', widths: '64, 132, 264', loading: 'lazy'
      }}
    </span>
  {%- endif -%}
  {%- if section.settings.decor_right != blank -%}
    <span class="quiz__decor quiz__decor--right" aria-hidden="true">
      {{
        section.settings.decor_right
        | image_url: width: 264
        | image_tag: alt: '', widths: '64, 132, 264', loading: 'lazy'
      }}
    </span>
  {%- endif -%}

  <div class="quiz__inner__container">
    <div class="quiz__inner">
      {%- if section.settings.heading != blank -%}
        <h2 class="quiz__heading">{{ section.settings.heading }}</h2>
      {%- endif -%}
      {%- if section.settings.subheading != blank -%}
        <p class="quiz__subheading">{{ section.settings.subheading }}</p>
      {%- endif -%}
      {%- if section.settings.button_label != blank -%}
        <a class="quiz__button" href="{{ section.settings.button_link | default: '#' }}">
          <span class="quiz__button-label">{{ section.settings.button_label }}</span>
        </a>
      {%- endif -%}
      {%- if section.settings.offer_text != blank -%}
        <p class="quiz__offer">{{ section.settings.offer_text }}</p>
      {%- endif -%}
    </div>
  </div>

  {%- if section.settings.bags_image != blank -%}
    <div class="quiz__bags" aria-hidden="true">
      <picture>
        {%- if section.settings.bags_image_mobile != blank -%}
          <source
            media="(max-width: 989px)"
            srcset="
              {{ section.settings.bags_image_mobile | image_url: width: 400 }} 400w,
              {{ section.settings.bags_image_mobile | image_url: width: 800 }} 800w,
              {{ section.settings.bags_image_mobile | image_url: width: 1200 }} 1200w
            "
          >
        {%- endif -%}
        {{
          section.settings.bags_image
          | image_url: width: 1600
          | image_tag: alt: '', widths: '400, 800, 1200, 1600', loading: 'lazy', class: 'quiz__bags-img'
        }}
      </picture>
    </div>
  {%- endif -%}
</section>

<script>
  (function () {
    var sections = document.querySelectorAll(
      '#shopify-section-{{ section.id }} [data-quiz-cta]'
    );

    if (!sections.length) return;

    sections.forEach(function (section) {
      var image = section.querySelector('.quiz__bags-img');

      if (!image) return;

      var currentY = 48;
      var targetY = 48;
      var ticking = false;

      /*
       * Calculate how much of the section has entered
       * the viewport.
       *
       * 0 = section is outside / not entered
       * 1 = section is fully in the viewport
       */
      function updateTarget() {
        var rect = section.getBoundingClientRect();
        var viewportHeight = window.innerHeight;

        /*
         * Start animation when the section starts entering
         * the viewport and finish when it reaches roughly
         * the middle of the viewport.
         */
        var progress =
          (viewportHeight - rect.top) /
          (viewportHeight * 0.75);

        progress = Math.max(0, Math.min(1, progress));

        /*
         * Image starts 48px lower and smoothly moves to 0px.
         */
        targetY = 48 * (1 - progress);
      }

      /*
       * Smooth interpolation.
       * This prevents the image from jumping directly
       * to the scroll position.
       */
      function animate() {
        currentY += (targetY - currentY) * 0.1;

        /*
         * Stop tiny unnecessary movements.
         */
        if (Math.abs(targetY - currentY) < 0.05) {
          currentY = targetY;
        }

        image.style.transform =
          'translate3d(-50%, ' + currentY + 'px, 0)';

        ticking = false;

        /*
         * Keep running while the image is still settling.
         */
        if (Math.abs(targetY - currentY) > 0.05) {
          ticking = true;
          requestAnimationFrame(animate);
        }
      }

      function onScroll() {
        updateTarget();

        if (!ticking) {
          ticking = true;
          requestAnimationFrame(animate);
        }
      }

      function onResize() {
        updateTarget();

        if (!ticking) {
          ticking = true;
          requestAnimationFrame(animate);
        }
      }

      /*
       * Initial position.
       */
      updateTarget();
      currentY = targetY;

      image.style.transform =
        'translate3d(-50%, ' + currentY + 'px, 0)';

      window.addEventListener('scroll', onScroll, {
        passive: true
      });

      window.addEventListener('resize', onResize, {
        passive: true
      });
    });
  })();
</script>

{% schema %}
{
  "name": "Quiz call to action",
  "tag": "section",
  "class": "section-quiz",
  "settings": [
    {
      "type": "image_picker",
      "id": "background_image",
      "label": "Desktop Background Image"
    },
    {
      "type": "image_picker",
      "id": "background_image_mobile",
      "label": "Mobile Background Image"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Your dog's food is our life's work."
    },
    {
      "type": "checkbox",
      "id": "uppercase_heading",
      "label": "Uppercase heading",
      "default": true
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "Take our quiz to find the recipe that's right for your dog."
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Take the quiz"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link"
    },
    {
      "type": "text",
      "id": "offer_text",
      "label": "Offer text",
      "default": "Get 30% Off and Free Shipping."
    },
    {
      "type": "header",
      "content": "Product image"
    },
    {
      "type": "image_picker",
      "id": "bags_image",
      "label": "Product bags",
      "info": "Single image of the three bags. The bottom is clipped by the section, matching the Figma mask."
    },
    {
      "type": "image_picker",
      "id": "bags_image_mobile",
      "label": "Product bags - Mobile",
      "info": "Optional. If no mobile image is selected, the desktop product image will be used."
    },
    {
      "type": "header",
      "content": "Decoration"
    },
    {
      "type": "image_picker",
      "id": "decor_left",
      "label": "Kibble (top)",
      "info": "Top-left on desktop, top-right on mobile."
    },
    {
      "type": "image_picker",
      "id": "decor_right",
      "label": "Kibble (side)",
      "info": "Right edge on desktop, left edge on mobile."
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background",
      "default": "#7BA6DD"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text",
      "default": "#000000"
    }
  ],
  "presets": [
    {
      "name": "Quiz call to action"
    }
  ]
}
{% endschema %}
