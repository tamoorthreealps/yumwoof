{{ 'css--legal--page.css' | asset_url | stylesheet_tag }}

{%- comment -%} Resolve heading: page title vs. customizer override {%- endcomment -%}
{%- assign legal_heading = page.title -%}
{%- if section.settings.title_source == 'custom' and section.settings.custom_title != blank -%}
  {%- assign legal_heading = section.settings.custom_title -%}
{%- endif -%}

{%- comment -%} Resolve last updated date: page updated_at vs. customizer override {%- endcomment -%}
{%- assign legal_updated = page.updated_at | date: '%B %d, %Y' -%}
{%- if section.settings.date_source == 'custom' and section.settings.custom_date != blank -%}
  {%- assign legal_updated = section.settings.custom_date -%}
{%- endif -%}

<div
  class="legal-page"
  style="
    --legal-section-bg: {{ section.settings.section_background }};
    --legal-container-bg: {{ section.settings.container_background }};
    --legal-text: {{ section.settings.text_color }};
    --legal-heading: {{ section.settings.heading_color }};
  "
>
  <div class="legal-page__card">
    <div class="legal-page__card_container">
      {% if section.settings.show_breadcrumb %}
        <nav class="legal-page__breadcrumb" aria-label="breadcrumb">
          <a href="{{ routes.root_url }}">Home</a>
          <span class="legal-page__breadcrumb-sep" aria-hidden="true">/</span>
          <span class="legal-page__breadcrumb-current">{{ legal_heading }}</span>
        </nav>
      {% endif %}

      {% if legal_heading != blank %}
        <div class="legal-page__header">
          <h1 class="legal-page__title">{{ legal_heading }}</h1>
          {% if legal_updated != blank %}
            <p class="legal-page__updated">Last updated: {{ legal_updated }}</p>
          {% endif %}
        </div>
      {% endif %}

      {% if section.settings.show_overview and section.settings.overview_text != blank %}
        <div class="legal-page__overview">
          {% if section.settings.overview_heading != blank %}
            <h2 class="legal-page__section-heading">{{ section.settings.overview_heading }}</h2>
          {% endif %}
          <div class="legal-page__rte">{{ section.settings.overview_text }}</div>
        </div>
      {% endif %}

      {% for block in section.blocks %}
        <div class="legal-page__section" {{ block.shopify_attributes }}>
          {% if block.settings.heading != blank %}
            <h2 class="legal-page__section-heading">{{ block.settings.heading }}</h2>
          {% endif %}
          {% if block.settings.content != blank %}
            <div class="legal-page__rte">{{ block.settings.content }}</div>
          {% endif %}
        </div>
      {% endfor %}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Legal page",
  "settings": [
    {
      "type": "header",
      "content": "Breadcrumb"
    },
    {
      "type": "checkbox",
      "id": "show_breadcrumb",
      "label": "Show breadcrumb",
      "default": true
    },
    {
      "type": "header",
      "content": "Page title"
    },
    {
      "type": "select",
      "id": "title_source",
      "label": "Title source",
      "options": [
        { "value": "page", "label": "Page title" },
        { "value": "custom", "label": "Customizer (custom text)" }
      ],
      "default": "page"
    },
    {
      "type": "text",
      "id": "custom_title",
      "label": "Custom title",
      "info": "Used only when Title source is set to Customizer"
    },
    {
      "type": "header",
      "content": "Last updated"
    },
    {
      "type": "select",
      "id": "date_source",
      "label": "Date source",
      "options": [
        { "value": "page", "label": "Page's last updated date" },
        { "value": "custom", "label": "Customizer (custom text)" }
      ],
      "default": "page"
    },
    {
      "type": "text",
      "id": "custom_date",
      "label": "Custom date",
      "info": "Used only when Date source is set to Customizer, e.g. January 2026"
    },
    {
      "type": "header",
      "content": "Overview"
    },
    {
      "type": "checkbox",
      "id": "show_overview",
      "label": "Show overview text",
      "default": true
    },
    {
      "type": "text",
      "id": "overview_heading",
      "label": "Overview heading",
      "default": "Overview"
    },
    {
      "type": "richtext",
      "id": "overview_text",
      "label": "Overview text",
      "default": "<p>Add your introductory paragraph here.</p>"
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading color",
      "default": "#000"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "default": "#333333"
    },
    {
      "type": "color",
      "id": "section_background",
      "label": "Section background",
      "default": "#7BA6DD"
    }
  ],
  "blocks": [
    {
      "type": "legal_section",
      "name": "Section",
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "Section 1 — Heading"
        },
        {
          "type": "richtext",
          "id": "content",
          "label": "Content",
          "default": "<p>Add section text here.</p>"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Legal page Block",
      "blocks": [{ "type": "legal_section" }, { "type": "legal_section" }, { "type": "legal_section" }]
    }
  ]
}
{% endschema %}
