{{ 'butcher-quality-standard.css' | asset_url | stylesheet_tag }}

<section
  id="ButcherQualityStandard-{{ section.id }}"
  class="butcher-quality-standard"
  data-bqs-parallax
  style="
    --bqs-desktop-bg: {{ section.settings.desktop_background_color }};
    --bqs-mobile-bg: {{ section.settings.mobile_background_color }};
    --bqs-text-color: {{ section.settings.text_color }};
    --bqs-line-color: {{ section.settings.line_color }};
    --bqs-desktop-image: {% if section.settings.desktop_background_image != blank %}url('{{ section.settings.desktop_background_image | image_url: width: 3000 }}'){% else %}none{% endif %};
    --bqs-mobile-image: {% if section.settings.mobile_background_image != blank %}url('{{ section.settings.mobile_background_image | image_url: width: 1600 }}'){% else %}none{% endif %};
  "
>
  <div class="butcher-quality-standard__bg" aria-hidden="true"></div>

  <div class="butcher-quality-standard__inner">
    <div class="butcher-quality-standard__content">
      {% if section.settings.heading != blank %}
        <div class="butcher-quality-standard__heading">
          {{ section.settings.heading | replace: '™', '<span class="trademark">™</span>' }}
        </div>
      {% endif %}

      {% if section.settings.description_1 != blank %}
        <div class="butcher-quality-standard__description">
          {{ section.settings.description_1 | replace: '<p></p>', '' }}
        </div>
      {% endif %}
    </div>

    <div class="butcher-quality-standard__principles{% if section.settings.divider_image != blank %} butcher-quality-standard__principles--image-divider{% endif %}">
      {% if section.settings.divider_image != blank %}
        <div class="butcher-quality-standard__divider-image">
          {{ section.settings.divider_image | image_url: width: 2000 | image_tag: loading: 'lazy', alt: '' }}
        </div>
      {% endif %}

      {% if section.settings.principles_label != blank %}
        <div class="butcher-quality-standard__principles-label">
          {{ section.settings.principles_label | escape }}
        </div>
      {% endif %}

      <div class="butcher-quality-standard__grid">
        {% for block in section.blocks %}
          {%- liquid
            # Fall back to the desktop art when no mobile art is uploaded
            assign main_mobile = block.settings.mobile_icon
            if main_mobile == blank
              assign main_mobile = block.settings.icon
            endif

            assign center_desktop = block.settings.center_icon
            assign center_mobile = block.settings.mobile_center_icon
            if center_mobile == blank
              assign center_mobile = center_desktop
            endif

            assign center_w = block.settings.center_icon_width | default: 40
            assign center_w_mobile = block.settings.mobile_center_icon_width
            if center_w_mobile == 0 or center_w_mobile == blank
              assign center_w_mobile = center_w
            endif
          -%}

          <div
            class="butcher-quality-standard__item"
            style="--bqs-center-w: {{ center_w }}px; --bqs-center-w-mobile: {{ center_w_mobile }}px;"
            {{ block.shopify_attributes }}
          >
            <div class="butcher-quality-standard__circle">
              {% if block.settings.icon != blank or main_mobile != blank %}
                {% if block.settings.icon != blank %}
                  {{
                    block.settings.icon
                    | image_url: width: 400
                    | image_tag:
                      class: 'butcher-quality-standard__icon butcher-quality-standard__icon--desktop',
                      loading: 'lazy',
                      widths: '100,160,240,400',
                      sizes: '(max-width: 767px) 33vw, 160px',
                      alt: block.settings.short_label
                  }}
                {% endif %}

                {% if main_mobile != blank %}
                  {{
                    main_mobile
                    | image_url: width: 400
                    | image_tag:
                      class: 'butcher-quality-standard__icon butcher-quality-standard__icon--mobile',
                      loading: 'lazy',
                      widths: '100,160,240,400',
                      sizes: '33vw',
                      alt: block.settings.short_label
                  }}
                {% endif %}
              {% else %}
                <span class="butcher-quality-standard__fallback-icon">
                  {{ block.settings.short_label | escape }}
                </span>
              {% endif %}

              {% if center_desktop != blank or center_mobile != blank %}
                <span class="butcher-quality-standard__center">
                  {% if center_desktop != blank %}
                    {{
                      center_desktop
                      | image_url: width: 300
                      | image_tag:
                        class: 'butcher-quality-standard__center-icon butcher-quality-standard__center-icon--desktop',
                        loading: 'lazy',
                        widths: '80,150,300',
                        sizes: '80px',
                        alt: ''
                    }}
                  {% endif %}

                  {% if center_mobile != blank %}
                    {{
                      center_mobile
                      | image_url: width: 300
                      | image_tag:
                        class: 'butcher-quality-standard__center-icon butcher-quality-standard__center-icon--mobile',
                        loading: 'lazy',
                        widths: '80,150,300',
                        sizes: '60px',
                        alt: ''
                    }}
                  {% endif %}
                </span>
              {% endif %}
            </div>

            {% if block.settings.title != blank %}
              <div class="butcher-quality-standard__item-title">
                {{ block.settings.title | escape }}
              </div>
            {% endif %}
          </div>
        {% endfor %}
      </div>
    </div>
  </div>
</section>

<script>
  (() => {
    const RANGE = 100; // max px of background drift
    const EASE = 0.12; // lower = smoother/slower catch-up

    const init = (root = document) => {
      const sections = root.querySelectorAll('[data-bqs-parallax]');
      if (!sections.length) return;

      const items = [];
      sections.forEach((section) => {
        const layer = section.querySelector('.butcher-quality-standard__bg');
        if (!layer) return;
        items.push({ section, layer, current: null, target: 0, visible: false });
      });
      if (!items.length) return;

      const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

      const measure = () => {
        const vh = window.innerHeight;
        items.forEach((item) => {
          const rect = item.section.getBoundingClientRect();
          item.visible = rect.bottom > -200 && rect.top < vh + 200;
          if (!item.visible) return;
          // 0 when the section's top edge first touches the bottom of the viewport,
          // 1 once it has fully scrolled past — so it always starts from 0, no jump.
          const total = vh + rect.height;
          let progress = (vh - rect.top) / total;
          progress = Math.min(Math.max(progress, 0), 1);
          item.target = progress * RANGE;
        });
      };

      let running = false;

      const render = () => {
        let active = false;
        items.forEach((item) => {
          if (!item.visible) return;
          if (item.current === null) {
            item.current = item.target; // first paint snaps, so nothing jumps in
          } else {
            item.current += (item.target - item.current) * EASE;
          }
          if (Math.abs(item.target - item.current) > 0.1) active = true;
          item.layer.style.transform =
            'translate3d(0,' + item.current.toFixed(2) + 'px,0)';
        });

        if (active) {
          requestAnimationFrame(render);
        } else {
          running = false;
        }
      };

      const start = () => {
        measure();
        if (reduce) {
          items.forEach((item) => {
            item.layer.style.transform = 'none';
          });
          return;
        }
        if (running) return;
        running = true;
        requestAnimationFrame(render);
      };

      window.addEventListener('scroll', start, { passive: true });
      window.addEventListener('resize', start, { passive: true });
      window.addEventListener('load', start);
      start();
    };

    document.readyState === 'loading'
      ? document.addEventListener('DOMContentLoaded', () => init())
      : init();

    document.addEventListener('shopify:section:load', (e) => init(e.target));
  })();
</script>

{% schema %}
{
  "name": "Butcher Quality Standard",
  "tag": "section",
  "class": "section-butcher-quality-standard",
  "settings": [
    {
      "type": "richtext",
      "id": "heading",
      "label": "Heading"
    },
    {
      "type": "richtext",
      "id": "description_1",
      "label": "Description"
    },
    {
      "type": "text",
      "id": "principles_label",
      "label": "Principles label",
      "default": "EVERY YUMWOOF RECIPE IS GUIDED BY THESE 8 PRINCIPLES:"
    },
    {
      "type": "header",
      "content": "Background"
    },
    {
      "type": "color",
      "id": "desktop_background_color",
      "label": "Desktop background color",
      "default": "#0B0B0B"
    },
    {
      "type": "image_picker",
      "id": "desktop_background_image",
      "label": "Desktop background image"
    },
    {
      "type": "color",
      "id": "mobile_background_color",
      "label": "Mobile background color",
      "default": "#0B0B0B"
    },
    {
      "type": "image_picker",
      "id": "mobile_background_image",
      "label": "Mobile background image"
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "default": "#FFFFFF"
    },
    {
      "type": "color",
      "id": "line_color",
      "label": "Divider color",
      "default": "#5B5B5B"
    },
    {
      "type": "image_picker",
      "id": "divider_image",
      "label": "Divider Image (optional)"
    }
  ],
  "blocks": [
    {
      "type": "principle",
      "name": "Principle",
      "settings": [
        {
          "type": "header",
          "content": "Desktop"
        },
        {
          "type": "image_picker",
          "id": "icon",
          "label": "Main icon"
        },
        {
          "type": "image_picker",
          "id": "center_icon",
          "label": "Center icon (optional)"
        },
        {
          "type": "range",
          "id": "center_icon_width",
          "label": "Center icon width",
          "unit": "px",
          "min": 40,
          "max": 150,
          "step": 2,
          "default": 40
        },
        {
          "type": "header",
          "content": "Mobile",
          "info": "Leave empty to reuse the desktop icons on mobile."
        },
        {
          "type": "image_picker",
          "id": "mobile_icon",
          "label": "Main icon (mobile)"
        },
        {
          "type": "image_picker",
          "id": "mobile_center_icon",
          "label": "Center icon (mobile)"
        },
        {
          "type": "range",
          "id": "mobile_center_icon_width",
          "label": "Center icon width (mobile)",
          "unit": "px",
          "min": 0,
          "max": 150,
          "step": 2,
          "default": 0,
          "info": "0 = use the desktop width."
        },
        {
          "type": "header",
          "content": "Fallback"
        },
        {
          "type": "text",
          "id": "short_label",
          "label": "Fallback label",
          "default": "WHOLE FOOD"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Our Standard - Butcher Quality",
      "blocks": [
        { "type": "principle", "settings": { "short_label": "WHOLE FOOD" } },
        { "type": "principle", "settings": { "short_label": "SEED OIL" } },
        { "type": "principle", "settings": { "short_label": "NON GMO" } },
        { "type": "principle", "settings": { "short_label": "AIR DRIED" } },
        { "type": "principle", "settings": { "short_label": "TESTED" } },
        { "type": "principle", "settings": { "short_label": "AIR DRIED" } },
        { "type": "principle", "settings": { "short_label": "3RD PARTY" } },
        { "type": "principle", "settings": { "short_label": "HEAVY METAL" } }
      ]
    }
  ]
}
{% endschema %}