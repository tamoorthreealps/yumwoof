{{ 'butcher-quality-promise.css' | asset_url | stylesheet_tag }}

<section
  id="ButcherQualityPromise-{{ section.id }}"
  class="butcher-quality-promise"
  style="
    --bqp-desktop-bg: {{ section.settings.desktop_background_color }};
    --bqp-mobile-bg: {{ section.settings.mobile_background_color }};
    --bqp-text-color: {{ section.settings.text_color }};
    --bqp-card-text-color: {{ section.settings.card_text_color }};
    --bqp-desktop-image: {% if section.settings.desktop_background_image != blank %}url('{{ section.settings.desktop_background_image | image_url: width: 2400 }}'){% else %}none{% endif %};
    --bqp-mobile-image: {% if section.settings.mobile_background_image != blank %}url('{{ section.settings.mobile_background_image | image_url: width: 1600 }}'){% else %}none{% endif %};
    --bqp-desktop-padding-top: {{ section.settings.desktop_padding_top }}px;
    --bqp-desktop-padding-bottom: {{ section.settings.desktop_padding_bottom }}px;
    --bqp-mobile-padding-top: {{ section.settings.mobile_padding_top }}px;
    --bqp-mobile-padding-bottom: {{ section.settings.mobile_padding_bottom }}px;
  "
>
  <div class="butcher-quality-promise__inner">
    {% if section.settings.heading != blank %}
      <div class="butcher-quality-promise__heading">
        {{ section.settings.heading | replace: '™', '<span class="bq-trademark">™</span>' }}
      </div>
    {% endif %}

    {% if section.settings.description != blank %}
      <div class="butcher-quality-promise__description">
        {{ section.settings.description }}
      </div>
    {% endif %}

    <div class="butcher-quality-promise__grid">
      {% for block in section.blocks %}
        <div
          class="butcher-quality-promise__card"
          style="--bqp-card-index: {{ forloop.index0 }}; --bqp-card-count: {{ section.blocks.size }};"
          {{ block.shopify_attributes }}
        >
          {% if block.settings.image != blank %}
            {{
              block.settings.image
              | image_url: width: 1000
              | image_tag:
                class: 'butcher-quality-promise__card-image',
                loading: 'lazy',
                widths: '400,600,800,1000',
                sizes: '(max-width: 767px) 100vw, 33.333vw',
                alt: block.settings.title
            }}
          {% endif %}

          <div class="butcher-quality-promise__overlay"></div>

          <div class="butcher-quality-promise__card-content">
            {% if block.settings.title != blank %}
              <div class="butcher-quality-promise__card-title">
                {{ block.settings.title }}
              </div>
            {% endif %}

            {% if block.settings.description != blank %}
              <div class="butcher-quality-promise__card-description">
                {{ block.settings.description }}
              </div>
            {% endif %}
          </div>
        </div>
      {% endfor %}
    </div>
  </div>
</section>
<script>
document.addEventListener('DOMContentLoaded', () => {
  const sections = document.querySelectorAll('.butcher-quality-promise');

  sections.forEach(section => {
    const cards = Array.from(
      section.querySelectorAll('.butcher-quality-promise__card')
    );

    if (!cards.length) return;

    const SCALE_STEP = 0.04;
    const SHIFT_STEP = 6;
    const MAX_DEPTH = 4;

    const IMAGE_MAX_ZOOM = 0.14;
    const IMAGE_SMOOTHING = 0.12;

    // Keep separate smooth scale values for every image
    const imageScales = new Map();

    cards.forEach(card => {
      const image = card.querySelector(
        '.butcher-quality-promise__card-image'
      );

      if (image) {
        imageScales.set(image, 1);
      }
    });

    const updateCards = () => {
      const isMobile = window.innerWidth <= 767;

      /* --------------------------------
         DESKTOP
      -------------------------------- */

      if (!isMobile) {
        cards.forEach(card => {
          card.style.transform = '';

          const image = card.querySelector(
            '.butcher-quality-promise__card-image'
          );

          if (!image) return;

          const rect = card.getBoundingClientRect();

          let progress =
            (window.innerHeight - rect.top) /
            (window.innerHeight + rect.height);

          progress = Math.max(
            0,
            Math.min(progress, 1)
          );

          const targetScale =
            1 + progress * IMAGE_MAX_ZOOM;

          const currentScale =
            imageScales.get(image) || 1;

          const newScale =
            currentScale +
            (targetScale - currentScale) *
            IMAGE_SMOOTHING;

          imageScales.set(image, newScale);

          image.style.transform =
            `scale(${newScale})`;
        });

        return;
      }

      /* --------------------------------
         MOBILE CARD STACKING PROGRESS
      -------------------------------- */

      const progress = cards.map((card, index) => {
        if (index === cards.length - 1) {
          return 0;
        }

        const cardTop =
          parseFloat(getComputedStyle(card).top) || 0;

        const nextRect =
          cards[index + 1].getBoundingClientRect();

        return Math.max(
          0,
          Math.min(
            1,
            (
              cardTop +
              card.offsetHeight -
              nextRect.top
            ) / card.offsetHeight
          )
        );
      });

      /* --------------------------------
         APPLY CARD STACKING
      -------------------------------- */

      let depth = 0;

      for (let i = cards.length - 1; i >= 0; i--) {
        const card = cards[i];

        const cappedDepth =
          Math.min(depth, MAX_DEPTH);

        const scale =
          1 - (
            cappedDepth *
            SCALE_STEP
          );

        const translateY =
          cappedDepth *
          -SHIFT_STEP;

        card.style.transform =
          `translateY(${translateY}px) scale(${scale})`;

        depth += progress[i];
      }

      /* --------------------------------
         MOBILE IMAGE ZOOM
      -------------------------------- */

      cards.forEach(card => {
        const image = card.querySelector(
          '.butcher-quality-promise__card-image'
        );

        if (!image) return;

        const rect =
          card.getBoundingClientRect();

        /*
         * Image starts at 100% when the card
         * enters the viewport and gradually
         * zooms to 114% as it moves through.
         */

        let imageProgress =
          (window.innerHeight - rect.top) /
          (window.innerHeight + rect.height);

        imageProgress = Math.max(
          0,
          Math.min(
            imageProgress,
            1
          )
        );

        const targetScale =
          1 +
          imageProgress *
          IMAGE_MAX_ZOOM;

        const currentScale =
          imageScales.get(image) || 1;

        /*
         * Smooth interpolation.
         * Scrolling down = zoom in.
         * Scrolling back up = zoom out.
         */

        const newScale =
          currentScale +
          (targetScale - currentScale) *
          IMAGE_SMOOTHING;

        imageScales.set(
          image,
          newScale
        );

        image.style.transform =
          `scale(${newScale})`;
      });
    };

    /* --------------------------------
       SMOOTH SCROLL LOOP
    -------------------------------- */

    let ticking = false;

    const handleScroll = () => {
      if (ticking) return;

      ticking = true;

      requestAnimationFrame(() => {
        updateCards();
        ticking = false;
      });
    };

    window.addEventListener(
      'scroll',
      handleScroll,
      { passive: true }
    );

    window.addEventListener(
      'resize',
      updateCards
    );

    updateCards();
  });
});
</script>
{% schema %}
{
  "name": "Butcher Quality Promise",
  "tag": "section",
  "class": "section-butcher-quality-promise",
  "settings": [
    {
      "type": "richtext",
      "id": "heading",
      "label": "Heading",
      "default": "<h2>OUR BUTCHER QUALITY PROMISE</h2>"
    },
    {
      "type": "richtext",
      "id": "description",
      "label": "Description",
      "default": "<p>From sourcing to testing, these commitments guide every YUMWOOF recipe.</p>"
    },
    {
      "type": "header",
      "content": "Background"
    },
    {
      "type": "color",
      "id": "desktop_background_color",
      "label": "Desktop background color",
      "default": "#FFF9EF"
    },
    {
      "type": "image_picker",
      "id": "desktop_background_image",
      "label": "Desktop background image"
    },
    {
      "type": "color",
      "id": "mobile_background_color",
      "label": "Mobile background color",
      "default": "#FFF9EF"
    },
    {
      "type": "image_picker",
      "id": "mobile_background_image",
      "label": "Mobile background image"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Head text color",
      "default": "#000000"
    },
    {
    "type": "color",
    "id": "card_text_color",
    "label": "Card text color",
    "default": "#FFFFFF"
    },
    {
      "type": "header",
      "content": "Desktop Spacing"
    },
    {
      "type": "range",
      "id": "desktop_padding_top",
      "label": "Top padding",
      "min": 0,
      "max": 300,
      "step": 5,
      "unit": "px",
      "default": 40
    },
    {
      "type": "range",
      "id": "desktop_padding_bottom",
      "label": "Bottom padding",
      "min": 0,
      "max": 300,
      "step": 5,
      "unit": "px",
      "default": 40
    },
    {
      "type": "header",
      "content": "Mobile Spacing"
    },
    {
      "type": "range",
      "id": "mobile_padding_top",
      "label": "Top padding",
      "min": 0,
      "max": 200,
      "step": 5,
      "unit": "px",
      "default": 30
    },
    {
      "type": "range",
      "id": "mobile_padding_bottom",
      "label": "Bottom padding",
      "min": 0,
      "max": 200,
      "step": 5,
      "unit": "px",
      "default": 30
    }
  ],
  "blocks": [
    {
      "type": "promise",
      "name": "Promise Card",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "richtext",
          "id": "title",
          "label": "Title",
          "default": "<p>TRUSTED FARMS & FISHERMEN</p>"
        },
        {
          "type": "richtext",
          "id": "description",
          "label": "Description",
          "default": "<p>We partner with farmers, ranchers, and fishermen we trust.</p>"
        }
      ]
    }
  ],
"presets": [
  {
    "name": "Butcher Quality Promise",
    "blocks": [
      {
        "type": "promise",
        "settings": {
          "title": "<p>Trusted Farms<br>& Fishermen</p>"
        }
      },
      {
        "type": "promise",
        "settings": {
          "title": "<p>Premium<br>Proteins</p>"
        }
      },
      {
        "type": "promise",
        "settings": {
          "title": "<p>Whole Food<br>Nutrition</p>"
        }
      },
      {
        "type": "promise",
        "settings": {
          "title": "<p>Healthy Fats<br>By Design</p>"
        }
      },
      {
        "type": "promise",
        "settings": {
          "title": "<p>Gently Air-Dried</p>"
        }
      },
      {
        "type": "promise",
        "settings": {
          "title": "<p>Independent<br>Testing</p>"
        }
      }
    ]
  }
]
}
{% endschema %}