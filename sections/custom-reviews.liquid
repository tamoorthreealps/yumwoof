<section class="reviews-section">
  <div class="reviews-section__container">
    {% content_for 'blocks' %}
  </div>
</section>


<style>
.reviews-section{
    background-image: url(//yumwoof.com/cdn/shop/files/BG.png?v=1785419077&width=2500);
    background-size: 100% 100%;
    background-position: center;
    background-repeat: no-repeat;
    background-color: #fff9ef;
    padding:120px 0 96px;
}
.reviews-section__container {
    max-width: 1244px;
    margin: 0 auto;
    padding: 0 2.4rem;
}
.opw-overflow-hidden.opw-reviews-border-style.opw-cornerRadius.opw-boxShadow {
    border: 2px solid #000;
    border-radius: 24px;
    background: #FFF9EF;
    padding: 40px 50px;
}
</style>

{% schema %}
{
  "name": "Custom Reviews",
  "tag": "section",
  "class": "section-custom-reviews",
  "blocks": [
    {
      "type": "@app"
    }
  ],
  "presets": [
    {
      "name": "Custom Reviews"
    }
  ]
}
{% endschema %}