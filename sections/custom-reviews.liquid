{% schema %}
{
  "name": "Custom Reviews",
  "tag": "section",
  "class": "section-custom-reviews",
  "settings": [
    {
      "type": "image_picker",
      "id": "bg_image_desktop",
      "label": "Desktop Background Image"
    },
    {
      "type": "image_picker",
      "id": "bg_image_mobile",
      "label": "Mobile Background Image"
    },
    {
      "type": "color",
      "id": "bg_color_desktop",
      "label": "Desktop Background Color",
      "default": "#FFF9EF"
    },
    {
      "type": "color",
      "id": "bg_color_mobile",
      "label": "Mobile Background Color",
      "default": "#7BA6DD"
    },
    {
      "type": "image_picker",
      "id": "left_bone",
      "label": "Left Bone Image"
    },
    {
      "type": "image_picker",
      "id": "right_bone",
      "label": "Right Bone Image"
    }
  ],
  "blocks": [
    {
      "type": "@app"
    }
  ],
  "presets": [
    {
      "name": "Custom Reviews"
    }
  ]
}
{% endschema %}
