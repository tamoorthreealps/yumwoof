<section class="reviews-section">
  <div class="reviews-section__container">
    {% if section.settings.left_bone != blank %}
      {{
        section.settings.left_bone
        | image_url: width: 300
        | image_tag: class: 'review-card__bone review-card__bone--left', loading: 'lazy'
      }}
    {% endif %}

    {% if section.settings.right_bone != blank %}
      {{
        section.settings.right_bone
        | image_url: width: 300
        | image_tag: class: 'review-card__bone review-card__bone--right', loading: 'lazy'
      }}
    {% endif %}
    {% content_for 'blocks' %}
  </div>
</section>

<style>
      div#opinew-app-container {
      padding: 0 !important;
      margin: 0 !important;
      width: 100% !important;
  }
    .reviews-section {
        background-color:{{ section.settings.bg_color_desktop }};
        {% if section.settings.bg_image_desktop != blank %}
            background-image:url('{{ section.settings.bg_image_desktop | image_url: width: 2500 }}');
        {% endif %}
        background-size: 100% 100%;
        background-position: center;
        background-repeat: no-repeat;
        background-color: #fff9ef;
        padding:120px 0 96px;
        overflow: hidden;
    }
    .reviews-section__container {
        max-width: 1244px;
        margin: 0 auto;
        padding: 0 2.4rem;
        position: relative;
    }
  img.review-card__bone.review-card__bone--left {
      width: 128px;
      position: absolute;
      top: -60px;
      left: -55px;
      z-index: 1;
      animation: boneRotateLeft 80s linear infinite;
      transform-origin: center;
          height: auto;
  }

  img.review-card__bone.review-card__bone--right {
      width: 126px;
      position: absolute;
      right: -55px;
      top: 120px;
      z-index: 1;
      animation: boneRotateRight 80s linear infinite;
      transform-origin: center;
          height: auto;
  }

  @keyframes boneRotateLeft {
      from {
          transform: rotate(0deg);
      }
      to {
          transform: rotate(-360deg);
      }
  }

  @keyframes boneRotateRight {
      from {
          transform: rotate(0deg);
      }
      to {
          transform: rotate(360deg);
      }
  }
