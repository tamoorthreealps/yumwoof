{{ 'css--yw-membership-banner.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign s = section.settings

  assign focal_d = s.focal_desktop | default: 'center center'
  assign focal_m = s.focal_mobile | default: 'center 60%'

  assign img_d = s.image | default: s.image_mobile
  assign img_m = s.image_mobile | default: s.image
-%}

{%- if img_d != blank -%}
  <link
    rel="preload"
    as="image"
    href="{{ img_d | image_url: width: 1800 }}"
    imagesrcset="{{ img_d | image_url: width: 1200 }} 1200w, {{ img_d | image_url: width: 1800 }} 1800w, {{ img_d | image_url: width: 2400 }} 2400w"
    imagesizes="100vw"
    media="(min-width: 750px)"
  >
{%- endif -%}
{%- if img_m != blank -%}
  <link
    rel="preload"
    as="image"
    href="{{ img_m | image_url: width: 880 }}"
    imagesrcset="{{ img_m | image_url: width: 640 }} 640w, {{ img_m | image_url: width: 880 }} 880w, {{ img_m | image_url: width: 1200 }} 1200w"
    imagesizes="100vw"
    media="(max-width: 749px)"
  >
{%- endif -%}

{%- style -%}
  #ywmb-{{ section.id }} {
    --ywmb-height: {{ s.height_desktop | default: '812px' }};
    --ywmb-height-mobile: {{ s.height_mobile | default: '455px' }};
    --ywmb-focal: {{ focal_d }};
    --ywmb-focal-mobile: {{ focal_m }};
    --ywmb-scrim-opacity: {{ s.scrim_opacity | default: 100 | divided_by: 100.0 }};
    {%- if img_d != blank %}
    --ywmb-bg: image-set(
      url("{{ img_d | image_url: width: 1200 }}") 1x,
      url("{{ img_d | image_url: width: 2400 }}") 2x
    );
    {%- endif %}
  }

  {%- if img_m != blank %}
  @media (max-width: 749px) {
    #ywmb-{{ section.id }} {
      --ywmb-bg: image-set(
        url("{{ img_m | image_url: width: 880 }}") 1x,
        url("{{ img_m | image_url: width: 1200 }}") 2x
      );
    }
  }
  {%- endif %}
{%- endstyle -%}

<section
  id="ywmb-{{ section.id }}"
  class="ywmb{% if img_d == blank and img_m == blank %} ywmb--no-image{% endif %}"
>
  {%- if img_d == blank and img_m == blank -%}
    <div class="ywmb__placeholder">
      {{ 'lifestyle-1' | placeholder_svg_tag: 'ywmb__placeholder-svg' }}
    </div>
  {%- endif -%}

  <div class="ywmb__scrim" aria-hidden="true"></div>

  <div class="ywmb__content">
    <div class="ywmb__inner">
      {%- if s.heading_line_1 != blank or s.heading_line_2 != blank -%}
        <h1 class="ywmb__heading" id="ywmb-heading-{{ section.id }}">
          {%- if s.heading_line_1 != blank -%}
            <span class="ywmb__line ywmb__line--1">{{ s.heading_line_1 | escape }}</span>
          {%- endif -%}
          {%- if s.heading_line_2 != blank -%}
            <span class="ywmb__line ywmb__line--2">{{ s.heading_line_2 | escape }}</span>
          {%- endif -%}
        </h1>
      {%- endif -%}
    </div>
  </div>

  {%- if s.badge != blank -%}
    <div class="ywmb__badge">
      {{
        s.badge
        | image_url: width: 512
        | image_tag:
          loading: 'eager',
          widths: '176, 256, 356, 512',
          sizes: '(max-width: 749px) 88px, 178px',
          alt: s.badge.alt | default: ''
      }}
    </div>
  {%- endif -%}
</section>



{% schema %}
{
  "name": "Membership banner",
  "tag": "section",
  "class": "yw-membership-banner-section",
  "settings": [
    { "type": "header", "content": "Background image" },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Background image (desktop)"
    },
    {
      "type": "image_picker",
      "id": "image_mobile",
      "label": "Background image (mobile)",
      "info": "Falls back to the desktop image if left empty."
    },
    {
      "type": "text",
      "id": "focal_desktop",
      "label": "Desktop focal point",
      "default": "center center",
      "info": "CSS object-position, e.g. 'center center' or '60% 40%'."
    },
    {
      "type": "text",
      "id": "focal_mobile",
      "label": "Mobile focal point",
      "default": "center 60%",
      "info": "The mobile crop sits lower so the bowl stays in frame."
    },

    { "type": "header", "content": "Heading" },
    {
      "type": "text",
      "id": "heading_line_1",
      "label": "Line 1",
      "default": "WELL-FED DOGS"
    },
    {
      "type": "text",
      "id": "heading_line_2",
      "label": "Line 2",
      "default": "PAY LESS FOR IT."
    },

    { "type": "header", "content": "Badge" },
    {
      "type": "image_picker",
      "id": "badge",
      "label": "Badge / sticker",
      "info": "The 'EXTRA 25% OFF' sticker. Decorative — leave the alt text empty in the media library unless it carries meaning."
    },

    { "type": "header", "content": "Layout" },
    {
      "type": "text",
      "id": "height_desktop",
      "label": "Height (desktop)",
      "default": "812px"
    },
    {
      "type": "text",
      "id": "height_mobile",
      "label": "Height (mobile)",
      "default": "455px"
    },
    {
      "type": "range",
      "id": "scrim_opacity",
      "label": "Scrim strength",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 100,
      "info": "Darkens the top of the image so the cream heading stays legible."
    }
  ],
  "presets": [{ "name": "YM-Membership banner" }]
}
{% endschema %}
