    .sticky-atc__btn {
      appearance: none;
      -webkit-appearance: none;
      cursor: pointer;
      border: 1px solid #000000;
      border-radius: 8px;
      background: #ffc069;
      color: #000000;
      font-family: "FFBlurProMedium";
      font-size: 16px;
      line-height: 24px;
      letter-spacing: 0.96px;
      text-transform: uppercase;
      padding: 11.2px 26.29px;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 8px;
      position: relative;
      transition: background 0.2s ease, color 0.2s ease, opacity 0.2s ease;
    }
    .sticky-atc__btn:hover {
      background: #000000 !important;
      color: #fff9ef;
    }

    .sticky-atc__btn:hover s.sticky-atc__btn-was {
      color: #fff9ef;
    }
    .sticky-atc__btn[disabled] {
      cursor: not-allowed;
      opacity: 0.5;
      background: #e6e0d7;
      color: #1a1a1a;
    }
    .sticky-atc__btn[disabled]:hover {
      background: #e6e0d7;
      color: #1a1a1a;
    }
    /* In-button price is mobile-only; desktop shows the standalone price. */
    .sticky-atc__btn-price {
      display: none;
    }

    /* Loading spinner — same behaviour as the main add-to-cart button. */
    .sticky-atc__btn .loading__spinner {
      position: absolute;
      top: 50%;
      left: 50%;
      transform: translate(-50%, -50%);
      width: 2rem;
      height: auto;
      align-items: center;
      justify-content: center;
    }
    .sticky-atc__btn .loading__spinner .path {
      stroke: #1a1a1a;
    }
    .sticky-atc__btn.is-loading {
      color: transparent;
      cursor: default;
