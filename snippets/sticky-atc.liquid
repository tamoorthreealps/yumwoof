{% comment %}
  Sticky add-to-cart bar for the product page (desktop + mobile).

  - Mirrors the main PDP add-to-cart button: price (selected plan), compare price,
    label and disabled/sold-out/unavailable state, and updates on variant / swatch /
    subscription changes.
  - The sticky button proxies a click to the real #ProductSubmitButton so the live
    form (selling plan, quantity, cart drawer) handles the add.
  - Shows only while the main add-to-cart button is out of the viewport.
  - Not rendered at all when the product is unavailable in the current market
    (custom.unavailable_markets), matching snippets/buy-buttons.liquid.
  - Desktop title shows "<Recipe> Recipe" (falls back to the product title).
  - Thumb prefers the variant-level custom.sticky_atc_image metafield.
  - CSS-only slide up/down on show/hide (including footer-visible).
  - Desktop (>= 749px) only: compact `in-product-main` layout while the main
    add-to-cart button is still below the fold.

  Accepts:
  - product: {Object} product object
  - section_id: {String} id of the main-product section
  - label: {String} (optional) button label, defaults to "Add to Bag"
  - mode: {String} (optional) 'default' | 'scrolled-past', defaults to 'default'

  Usage:
  {% render 'sticky-atc', product: product, section_id: section.id, label: section.settings.sticky_atc_button_label %}
{% endcomment %}

{%- liquid
  # ----- Market availability (same rule as buy-buttons.liquid) -----
  assign is_market_unavailable = false
  assign unavailable_markets = product.metafields.custom.unavailable_markets.value
  if unavailable_markets != blank
    assign cur_market_handle = localization.market.handle | downcase | strip
    assign cur_country_code = localization.country.iso_code | downcase | strip
    for um in unavailable_markets
      assign um_key = um | downcase | strip | replace: ' ', '-'
      if um_key == cur_market_handle or um_key == cur_country_code
        assign is_market_unavailable = true
      endif
    endfor
  endif
-%}

{%- if product != blank and is_market_unavailable == false -%}
  {%- liquid
    assign st_variant = product.selected_or_first_available_variant | default: product.variants.first

    # Locate the Recipe / Size option indexes (used to build the meta line in JS)
    assign recipe_index = -1
    assign size_index = -1
    for opt in product.options
      assign optn = opt | downcase | strip
      if optn == 'recipe'
        assign recipe_index = forloop.index0
      endif
      if optn == 'size'
        assign size_index = forloop.index0
      endif
    endfor

    assign st_thumb = st_variant.featured_image | default: product.featured_image

    # Initial desktop title: "<Recipe> Recipe", falling back to the product title.
    assign st_title = product.title
    if recipe_index >= 0
      assign st_recipe = st_variant.options[recipe_index] | strip
      if st_recipe != blank and st_recipe != 'Default Title'
        assign st_title = st_recipe | append: ' Recipe'
      endif
    endif

    # Variant-level custom.sticky_atc_image: initial thumb + id→url map for JS.
    assign st_variant_images = ''
    assign st_variant_img = st_variant.metafields.custom.sticky_atc_image.value
    if st_variant_img != blank
      assign st_thumb = st_variant_img
    endif
    for v in product.variants
      assign vimg = v.metafields.custom.sticky_atc_image.value
      if vimg != blank
        assign vurl = vimg | image_url: width: 300 | json
        assign ventry = '"' | append: v.id | append: '":' | append: vurl
        if st_variant_images == ''
          assign st_variant_images = ventry
        else
          assign st_variant_images = st_variant_images | append: ',' | append: ventry
        endif
      endif
    endfor

    assign st_size = ''
    if size_index >= 0
      assign st_size = st_variant.options[size_index]
    endif

    # Initial meta line (JS keeps this in sync afterwards). Built from the
    # variant option values, skipping blanks and the Shopify "Default Title"
    # that single-variant products carry.
    #   Desktop: every option except Recipe (Recipe is the desktop heading).
    #   Mobile:  every option, with Recipe shown as "<Recipe> Recipe".
    assign st_meta_desktop = ''
    assign st_meta_mobile = ''

    for ov in st_variant.options
      assign ov_index = forloop.index0
      assign ov_clean = ov | strip

      if ov_clean != blank and ov_clean != 'Default Title'
        if ov_index != recipe_index
          if st_meta_desktop == ''
            assign st_meta_desktop = ov_clean
          else
            assign st_meta_desktop = st_meta_desktop | append: ' · ' | append: ov_clean
          endif
        endif

        assign mobile_value = ov_clean

        if ov_index == recipe_index
          assign mobile_value = ov_clean | append: ' Recipe'
        endif

        if st_meta_mobile == ''
          assign st_meta_mobile = mobile_value
        else
          assign st_meta_mobile = st_meta_mobile | append: ' · ' | append: mobile_value
        endif
      endif
    endfor
  -%}

  <sticky-atc-bar
    id="StickyAtc-{{ section_id }}"
    class="sticky-atc"
    data-section-id="{{ section_id }}"
    data-product-title="{{ product.title | escape }}"
    data-recipe-index="{{ recipe_index }}"
    data-size-index="{{ size_index }}"
    data-size-value="{{ st_size | escape }}"
    data-initial-mobile-meta="{{ st_meta_mobile | escape }}"
    data-label="{{ label | default: 'Add to Bag' | escape }}"
    data-mode="{{ mode | default: 'default' }}"
    aria-hidden="true"
  >
    <div class="sticky-atc__inner">
      <div class="sticky-atc__info">
        {%- if st_thumb != blank -%}
          <img
            class="sticky-atc__thumb{% if st_variant_img != blank %} sticky-atc__var_thumb{% endif %}"
            src="{{ st_thumb | image_url: width: 240 }}"
            srcset="{{ st_thumb | image_url: width: 120 }} 120w, {{ st_thumb | image_url: width: 180 }} 180w, {{ st_thumb | image_url: width: 240 }} 240w, {{ st_thumb | image_url: width: 300 }} 300w"
            sizes="60px"
            width="60"
            height="60"
            alt="{{ product.title | escape }}"
            loading="lazy"
            decoding="async"
            data-sticky-thumb
          >
        {%- endif -%}
        <div class="sticky-atc__text">
          <p class="sticky-atc__title" data-sticky-title>{{ st_title | escape }}</p>
          <p class="sticky-atc__meta sticky-atc__meta--desktop" data-sticky-meta-desktop>{{ st_meta_desktop }}</p>
          <p class="sticky-atc__meta sticky-atc__meta--mobile" data-sticky-meta-mobile>{{ st_meta_mobile }}</p>
        </div>
      </div>
      <div class="sticky-atc__buy">
        <div class="sticky-atc__price sticky-atc__price--standalone" data-sticky-price>
          <s class="sticky-atc__was" data-sticky-was>
            {%- if st_variant.compare_at_price > st_variant.price -%}
              {{ st_variant.compare_at_price | money }}
            {%- endif -%}
          </s>
          <span class="sticky-atc__now" data-sticky-now>{{ st_variant.price | money }}</span>
        </div>
        <button
          type="button"
          class="sticky-atc__btn"
          data-sticky-btn
          aria-label="{{ 'products.product.add_to_cart' | t }}: {{ product.title | escape }}"
        >
          <span data-sticky-btn-label>{{ label | default: 'Add to Bag' }}</span>
          <s class="sticky-atc__btn-was" data-sticky-btn-was></s>
          <span class="sticky-atc__btn-price" data-sticky-btn-price></span>
          {%- render 'loading-spinner' -%}
        </button>
      </div>
    </div>
    <script type="application/json" data-sticky-variant-images>
      { {{ st_variant_images }} }
    </script>
  </sticky-atc-bar>

  <script>
    (function () {
      if (!('customElements' in window) || customElements.get('sticky-atc-bar')) return;

      var capitalize = function (s) {
        return s ? s.charAt(0).toUpperCase() + s.slice(1) : s;
      };
      var text = function (el) {
        return el ? (el.textContent || '').trim() : '';
      };

      class StickyAtcBar extends HTMLElement {
        connectedCallback() {
          if (this._bound) return;
          this._bound = true;

          this.sectionId = this.dataset.sectionId;
          this.productTitle = this.dataset.productTitle || '';
          this.recipeIndex = parseInt(this.dataset.recipeIndex, 10);
          this.sizeIndex = parseInt(this.dataset.sizeIndex, 10);
          this.initialSize = this.dataset.sizeValue || '';
          this.initialMobileMeta = this.dataset.initialMobileMeta || '';
          this.enabledLabel = this.dataset.label || 'Add to Bag';
          // Visibility mode:
          //   'default'       → visible whenever the main button is out of view
          //                     (above OR below).
          //   'scrolled-past' → mobile: visible only once the main button has
          //                     scrolled ABOVE the viewport. Desktop: also visible
          //                     while the button is still below the fold, in step
          //                     with the `in-product-main` compact layout.
          this.mode = this.dataset.mode || 'default';

          // Elements owned by the bar
          this.thumbEl = this.querySelector('[data-sticky-thumb]');
          this.metaDesktopEl = this.querySelector('[data-sticky-meta-desktop]');
          this.metaMobileEl = this.querySelector('[data-sticky-meta-mobile]');
          this.wasEl = this.querySelector('[data-sticky-was]');
          this.nowEl = this.querySelector('[data-sticky-now]');
          this.btn = this.querySelector('[data-sticky-btn]');
          this.btnLabel = this.querySelector('[data-sticky-btn-label]');
          this.btnPrice = this.querySelector('[data-sticky-btn-price]');
          this.btnWas = this.querySelector('[data-sticky-btn-was]');
          this.spinnerEl = this.querySelector('.loading__spinner');
          this.titleEl = this.querySelector('[data-sticky-title]');

          // Variant id → custom.sticky_atc_image url map (rendered in Liquid).
          this.variantImages = null;
          var mapEl = this.querySelector('[data-sticky-variant-images]');
          if (mapEl) {
            try {
              this.variantImages = JSON.parse(mapEl.textContent || '{}');
            } catch (err) {
              this.variantImages = null;
            }
          }

          // Stable server-rendered base for the desktop meta, captured before any
          // sync so appended frequency never accumulates.
          this.baseDesktopMeta = text(this.metaDesktopEl);

          // Live PDP elements this bar mirrors
          this.mainBtn = document.getElementById('ProductSubmitButton-' + this.sectionId);
          this.priceHost = document.getElementById('price-' + this.sectionId);
          this.productInfo = document.getElementById('MainProduct-' + this.sectionId);

          if (!this.mainBtn) {
            // No purchasable form on the page — nothing to mirror.
            this.remove();
            return;
          }

          // Proxy the sticky click to the real add-to-cart button.
          this.btn.addEventListener(
            'click',
            function () {
              if (this.mainBtn && !this.mainBtn.hasAttribute('disabled')) this.mainBtn.click();
            }.bind(this)
          );

          this.bindObservers();
          this.syncAll();
        }

        // Scope to THIS section's product-info so a product with no subscription
        // widget reports no frequency (rather than borrowing another section's).
        aswWidget() {
          if (this.productInfo) return this.productInfo.querySelector('appstle-subscription-widget');
          return document.querySelector('appstle-subscription-widget');
        }

        // ----- Price (mirror the selected purchase option) -----
        syncPrice() {
          var was = '';
          var now = '';
          var asw = this.aswWidget();
          var selected = asw && asw.querySelector('.asw-option.is-selected');
          if (selected) {
            was = text(selected.querySelector('.asw-option__price-was'));
            now = text(selected.querySelector('.asw-option__price-now'));
          }
          if (!now && this.priceHost) {
            now =
              text(this.priceHost.querySelector('.price-item--sale')) ||
              text(this.priceHost.querySelector('.price-item--regular'));
            var cmp = this.priceHost.querySelector('.price__sale s .price-item, s.price-item--regular');
            was = text(cmp);
          }
          if (this.wasEl) this.wasEl.textContent = was || '';
          if (this.btnWas) this.btnWas.textContent = was || '';
          if (this.nowEl && now) this.nowEl.textContent = now;

          this._was = was || '';
          this._now = now || this._now || '';
        }

        // ----- Button label / disabled / loading state (mirror the main ATC) -----
        syncButton() {
          if (!this.mainBtn) return;
          var disabled = this.mainBtn.hasAttribute('disabled') || this.mainBtn.disabled;
          var mainText = text(this.mainBtn.querySelector('span')) || text(this.mainBtn);
          this.btn.disabled = disabled;
          this.btn.setAttribute('aria-disabled', disabled ? 'true' : 'false');
          if (disabled) {
            this.btnLabel.textContent = (mainText || 'Sold out').toUpperCase();
            this.btnPrice.textContent = '';

            if (this.btnWas) {
              this.btnWas.textContent = '';
            }
          } else {
            this.btnLabel.textContent = this.enabledLabel.toUpperCase();
            this.btnPrice.textContent = this._now ? '| ' + this._now : '';

            if (this.btnWas) {
              this.btnWas.textContent = this._was || '';
            }
          }
          this.syncSpinner();
        }

        // Mirror the main button's loading spinner while an add is in flight.
        syncSpinner() {
          if (!this.mainBtn) return;
          var loading = this.mainBtn.classList.contains('loading');
          this.btn.classList.toggle('is-loading', loading);
          if (this.spinnerEl) this.spinnerEl.classList.toggle('hidden', !loading);
        }

        // ----- Meta line: option values + frequency -----
        //   Desktop: every option except Recipe (Recipe is the desktop heading).
        //   Mobile:  every option, with Recipe shown as "<Recipe> Recipe".
        syncMeta() {
          var variant = this._variant;
          var options = variant && variant.options ? variant.options : null;

          // Frequency from the Appstle widget (subscription vs one-time).
          var freq = '';
          var asw = this.aswWidget();
          if (asw) {
            var sub = asw.querySelector('input[value="subsave"]');
            var isSub = !!(sub && sub.checked);
            if (isSub) {
              // Frequency is a custom ul/li dropdown (not a native <select>): read
              // the current label from the trigger, falling back to the selected li.
              var sel = asw.querySelector('[data-asw-freq]');
              if (sel) {
                var cur =
                  sel.querySelector('[data-asw-freq-current]') || sel.querySelector('.asw-freq__opt.is-selected');
                if (cur) freq = capitalize((cur.textContent || '').trim());
              }
            } else {
              freq = 'One-Time';
            }
          }

          // Rebuilt from fresh variant options, else the server-rendered base
          // (already filtered) — never from the element's own text, so frequency
          // never accumulates. Skips blanks and the Shopify "Default Title".
          var desktopParts = [];
          var mobileParts = [];

          if (options && options.length) {
            for (var i = 0; i < options.length; i++) {
              var v = (options[i] || '').trim();
              if (!v || v === 'Default Title') continue;

              if (i === this.recipeIndex) {
                mobileParts.push(v + ' Recipe');
              } else {
                desktopParts.push(v);
                mobileParts.push(v);
              }
            }
          } else {
            if (this.baseDesktopMeta) desktopParts.push(this.baseDesktopMeta);
            if (this.initialMobileMeta) mobileParts.push(this.initialMobileMeta);
          }

          if (freq) {
            desktopParts.push(freq);
            mobileParts.push(freq);
          }

          if (this.metaDesktopEl) this.metaDesktopEl.textContent = desktopParts.join(' · ');
          if (this.metaMobileEl) this.metaMobileEl.textContent = mobileParts.join(' · ');
        }

        // ----- Desktop title = "<Recipe> Recipe" (falls back to the product title) -----
        syncTitle() {
          if (!this.titleEl) return;
          var variant = this._variant;
          if (!variant) return; // keep the server-rendered title until a variant change arrives
          var title = this.productTitle;
          if (variant.options && this.recipeIndex >= 0) {
            var recipe = (variant.options[this.recipeIndex] || '').trim();
            if (recipe && recipe !== 'Default Title') title = recipe + ' Recipe';
          }
          this.titleEl.textContent = title;
        }

        syncThumb() {
          var variant = this._variant;
          if (!variant || !this.thumbEl) return;
          var src = '';
          // 1. Variant-level custom.sticky_atc_image.
          if (this.variantImages && variant.id != null) {
            src = this.variantImages[String(variant.id)] || '';
          }
          // 2. Variant featured image.
          if (!src) {
            var img = variant.featured_image || (variant.featured_media && variant.featured_media.preview_image);
            src = img && img.src;
          }
          // 3. Nothing available → leave the current image in place.
          if (!src) return;
          // High-DPI crisp: request 240px (4x the 60px box) and rebuild srcset.
          var base = src.split('?')[0];
          var sized = function (w) {
            return base + '?width=' + w;
          };
          this.thumbEl.src = sized(240);
          this.thumbEl.srcset =
            sized(120) + ' 120w, ' + sized(180) + ' 180w, ' + sized(240) + ' 240w, ' + sized(300) + ' 300w';
          if (variant.featured_media && variant.featured_media.alt) this.thumbEl.alt = variant.featured_media.alt;
        }

        syncAll() {
          this.syncPrice();
          this.syncMeta();
          this.syncTitle();
          this.syncButton();
        }

        bindVariantSync() {
          if (this._variantBound) return true;
          if (
            typeof subscribe !== 'function' ||
            typeof PUB_SUB_EVENTS === 'undefined' ||
            !PUB_SUB_EVENTS.variantChange
          ) {
            return false;
          }
          var self = this;
          this._variantBound = true;
          subscribe(PUB_SUB_EVENTS.variantChange, function (event) {
            self._variant = event && event.data && event.data.variant;
            self.syncThumb();
            window.requestAnimationFrame(function () {
              self.syncAll();
            });
          });
          return true;
        }

        bindObservers() {
          var self = this;
          var hasIO = 'IntersectionObserver' in window;
          var desktopMq = window.matchMedia('(min-width: 749px)');
          var raf = function () {
            window.requestAnimationFrame(function () {
              self.syncAll();
            });
          };

          // Variant / swatch change → get the fresh variant object, then re-sync
          // after Appstle has swapped its widget (deferred a frame). pubsub.js is
          // deferred, so on the initial parse `subscribe` may not exist yet; retry
          // on DOMContentLoaded (same pattern as appstle-subscription.liquid).
          if (!this.bindVariantSync()) {
            document.addEventListener('DOMContentLoaded', this.bindVariantSync.bind(this), { once: true });
          }

          // Main add-to-cart button: label + disabled + loading (class) state.
          if (this.mainBtn) {
            new MutationObserver(function () {
              self.syncButton();
            }).observe(this.mainBtn, {
              attributes: true,
              attributeFilter: ['disabled', 'class'],
              childList: true,
              subtree: true,
              characterData: true,
            });
          }

          // Main price block re-renders on variant change.
          if (this.priceHost) {
            new MutationObserver(function () {
              self.syncPrice();
              self.syncButton();
            }).observe(this.priceHost, {
              childList: true,
              subtree: true,
              characterData: true,
            });
          }

          // Subscription / frequency selection (Appstle widget). Delegated because
          // the widget element is replaced on variant change.
          document.addEventListener('change', function (e) {
            if (e.target && e.target.closest && e.target.closest('appstle-subscription-widget')) raf();
          });

          // ----- is-visible: main ATC's position relative to the viewport -----
          var visibilityIo = null;
          if (hasIO) {
            visibilityIo = new IntersectionObserver(
              function (entries) {
                entries.forEach(function (entry) {
                  if (self.mode === 'scrolled-past') {
                    var top = entry.rootBounds ? entry.rootBounds.top : 0;
                    var bottom = entry.rootBounds ? entry.rootBounds.bottom : window.innerHeight;
                    // Button scrolled ABOVE the viewport → show.
                    var above = !entry.isIntersecting && entry.boundingClientRect.bottom <= top;
                    // Desktop: button still BELOW the fold → show too, together
                    // with the in-product-main compact layout.
                    var below =
                      desktopMq.matches && !entry.isIntersecting && entry.boundingClientRect.top >= bottom;
                    self.setVisible(above || below);
                  } else {
                    self.setVisible(!entry.isIntersecting);
                  }
                });
              },
              { root: null, threshold: 0 }
            );
            visibilityIo.observe(this.mainBtn);
          } else if (self.mode !== 'scrolled-past') {
            // No IntersectionObserver: default mode shows; scrolled-past can't be
            // detected cheaply, so it stays hidden.
            this.setVisible(true);
          }

          // ----- in-product-main: compact layout, desktop (>= 749px) only -----
          // One observer at a time; (re)built only when the 749px breakpoint is
          // actually crossed, so resize never stacks observers.
          var atcObserver = null;
          var atcDesktop = null;
          var atcRemoveTimer = null;
          var ATC_REMOVE_DELAY = 1000;

          var clearAtcRemoveTimer = function () {
            if (atcRemoveTimer) {
              window.clearTimeout(atcRemoveTimer);
              atcRemoveTimer = null;
            }
          };

          var removeInProductMain = function (delayed) {
            if (!delayed) {
              clearAtcRemoveTimer();
              self.classList.remove('in-product-main');
              return;
            }
            if (atcRemoveTimer || !self.classList.contains('in-product-main')) return;
            atcRemoveTimer = window.setTimeout(function () {
              atcRemoveTimer = null;
              self.classList.remove('in-product-main');
            }, ATC_REMOVE_DELAY);
          };

          var disconnectAtcObserver = function () {
            if (atcObserver) {
              atcObserver.disconnect();
              atcObserver = null;
            }
            removeInProductMain(false);
          };

          var initAtcObserver = function () {
            disconnectAtcObserver();

            if (!hasIO) return;
            if (!self.mainBtn) return;

            atcObserver = new IntersectionObserver(
              function (entries) {
                entries.forEach(function (entry) {
                  var bottom = entry.rootBounds ? entry.rootBounds.bottom : window.innerHeight;
                  var belowViewport = entry.boundingClientRect.top >= bottom;

                  if (!entry.isIntersecting && belowViewport) {
                    // Main button is below the fold → compact layout, cancel any pending removal.
                    clearAtcRemoveTimer();
                    self.classList.add('in-product-main');
                  } else if (entry.isIntersecting) {
                    // Main button in view → is-visible is removed now (bar slides out);
                    // keep in-product-main for 1s so the layout doesn't change mid-animation.
                    removeInProductMain(true);
                  } else {
                    // Main button scrolled ABOVE the viewport → bar is showing in its full
                    // layout, so drop the class right away.
                    removeInProductMain(false);
                  }
                });
              },
              { root: null, threshold: 0 }
            );

            atcObserver.observe(self.mainBtn);
          };

          var syncAtcObserver = function () {
            var desktop = desktopMq.matches;

            if (desktop === atcDesktop) return;

            atcDesktop = desktop;

            if (desktop) {
              initAtcObserver();
            } else {
              disconnectAtcObserver();
            }

            // Breakpoint crossed → make the visibility observer re-evaluate, since
            // 'scrolled-past' behaves differently on desktop and mobile.
            if (visibilityIo && self.mainBtn) {
              visibilityIo.unobserve(self.mainBtn);
              visibilityIo.observe(self.mainBtn);
            }
          };

          syncAtcObserver();
          window.addEventListener('resize', syncAtcObserver);
        }

        setVisible(show) {
          this.classList.toggle('is-visible', !!show);
          this.setAttribute('aria-hidden', show ? 'false' : 'true');
        }
      }

      customElements.define('sticky-atc-bar', StickyAtcBar);
    })();
  </script>

  {%- style -%}
    .sticky-atc {
      position: fixed;
      left: 0;
      right: 0;
      bottom: 0;
      z-index: 3;
      padding: 0;
      box-shadow: 0 0 32px 0 rgba(123, 166, 221, 0.75);
      background: #fff9efcc;
      -webkit-backdrop-filter: blur(10px);
      backdrop-filter: blur(10px);
      border-radius: 24px 24px 0 0;
      visibility: hidden;
      opacity: 1;
      transform: translateY(120%);
      transition: transform 0.45s cubic-bezier(0.22, 0.61, 0.36, 1),
        opacity 0.45s ease, visibility 0s linear 0.45s;
      pointer-events: none;
    }
    /* Smooth slide up on show / slide down on hide (is-visible + footer-visible). */
    .sticky-atc.is-visible {
      visibility: visible;
      opacity: 1;
      transform: translateY(0);
      transition: transform 0.45s cubic-bezier(0.22, 0.61, 0.36, 1),
        opacity 0.45s ease, visibility 0s;
      pointer-events: auto;
    }
    .sticky-atc.is-visible.footer-visible {
      visibility: hidden;
      opacity: 0;
      transform: translateY(120%);
      transition: transform 0.45s cubic-bezier(0.22, 0.61, 0.36, 1),
        opacity 0.45s ease, visibility 0s linear 0.45s;
      pointer-events: none;
    }
    .sticky-atc__inner {
      max-width: 1006px;
      margin: 0 auto;
      border: 0;
      border-radius: 0;
      display: flex;
      align-items: center;
      gap: 16px;
      padding: 16px;
      background: transparent;
      -webkit-backdrop-filter: none;
      backdrop-filter: none;
    }
    .sticky-atc__info {
      display: flex;
      align-items: center;
      gap: 20px;
      min-width: 0;
      flex: 1 1 auto;
    }
    .sticky-atc__thumb {
      flex: 0 0 auto;
      width: 64px;
      height: 64px;
      border-radius: 8px;
    }
    .sticky-atc__thumb.sticky-atc__var_thumb {
      width: 136px;
    }
    .sticky-atc__text {
      min-width: 0;
      display: flex;
      flex-direction: column;
      gap: 0;
    }
    .sticky-atc__title {
      margin: 0;
      font-family: "TAY Birdie";
      text-transform: uppercase;
      color: #000000;
      font-size: 20px;
      line-height: 32px;
      letter-spacing: -0.4px;
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
      max-width: 46ch;
      transform: translateY(3px);
    }
    .sticky-atc__meta {
      margin: 0;
      font-family: "Matter";
      color: #000000;
      font-size: 16px;
      line-height: 24px;
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
      max-width: 52ch;
      letter-spacing: 0;
    }
    .sticky-atc__meta--mobile {
      display: none;
    }
    .sticky-atc__buy {
      display: flex;
      align-items: center;
      gap: 20px;
      flex: 0 0 auto;
    }
    .sticky-atc__price {
      display: flex;
      align-items: baseline;
      gap: 11px;
      white-space: nowrap;
    }
    .sticky-atc__was,
    s.sticky-atc__btn-was {
      font-family: "Matter";
      font-size: 18px;
      line-height: 24px;
      letter-spacing: 0;
      color: rgba(0, 0, 0, 0.5);
      text-decoration: line-through;
    }
    .sticky-atc__was:empty {
      display: none;
    }
    .sticky-atc__now {
      font-family: "Matter";
      font-size: 18px;
      line-height: 24px;
      letter-spacing: 0;
      color: #000000;
    }
    .sticky-atc__btn {
      appearance: none;
      -webkit-appearance: none;
      cursor: pointer;
      border: 1px solid #000000;
      border-radius: 8px;
      color: #000000;
      font-family: "FFBlurProMedium";
      font-size: 20px;
      line-height: 24px;
      letter-spacing: 1.2px;
      text-transform: uppercase;
      padding: 11.2px 46.29px;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 8px;
      position: relative;
      background: linear-gradient(
        90deg,
        #ffc069 0%,
        #ffc069 35%,
        #ffd8a2 50%,
        #ffc069 65%,
        #ffc069 100%
      );
      background-size: 250% 100%;
      background-position: 100% 0;
      animation: buttonShine_sticky 4s linear infinite;
      transition: background 0.2s ease, color 0.2s ease, opacity 0.2s ease;
    }

    @keyframes buttonShine_sticky {
      0% {
        background-position: 100% 0;
      }

      45% {
        background-position: 0% 0;
      }

      100% {
        background-position: 0% 0;
      }
    }
    .sticky-atc__btn:hover {
      background: #000000 !important;
      color: #fff9ef;
    }

    .sticky-atc__btn:hover s.sticky-atc__btn-was {
      color: #fff9ef;
    }
    .sticky-atc__btn[disabled] {
      cursor: not-allowed;
      opacity: 0.5;
      color: #1a1a1a;
    }
    .sticky-atc__btn[disabled]:hover {
      color: #1a1a1a;
    }
    /* In-button price + compare price are mobile-only; desktop shows the standalone price. */
    .sticky-atc__btn-price {
      display: none;
    }
    s.sticky-atc__btn-was {
      display: none;
    }

    /* Loading spinner — same behaviour as the main add-to-cart button. */
    .sticky-atc__btn .loading__spinner {
      position: absolute;
      top: 50%;
      left: 50%;
      transform: translate(-50%, -50%);
      width: 2rem;
      height: auto;
      align-items: center;
      justify-content: center;
    }
    .sticky-atc__btn .loading__spinner .path {
      stroke: #1a1a1a;
    }
    .sticky-atc__btn.is-loading {
      color: transparent;
      cursor: default;
    }
    .sticky-atc__btn.is-loading:hover {
      color: transparent;
    }
    .sticky-atc__btn.is-loading [data-sticky-btn-label],
    .sticky-atc__btn.is-loading .sticky-atc__btn-price {
      visibility: hidden;
    }

    /* ----- in-product-main: compact layout while the main ATC is below the fold (desktop) ----- */
    .sticky-atc.in-product-main {
      box-shadow: none;
      background: transparent;
      -webkit-backdrop-filter: none;
      backdrop-filter: none;
      border-radius: 0;
      max-width: 1286px;
      margin: 0 auto;
      padding: 0 24px;
    }
    .sticky-atc.in-product-main .sticky-atc__inner {
      padding: 12px 34px 16px;
      max-width: 532px;
      gap: 12px;
      margin-left: auto;
      margin-right: 0;
      border-radius: 24px 24px 0 0;
      box-shadow: 0 0 32px 0 rgba(123, 166, 221, 0.75);
      background: #fff9efcc;
      -webkit-backdrop-filter: blur(10px);
      backdrop-filter: blur(10px);
      flex-direction: column;
      align-items: flex-start;
    }
    .sticky-atc.in-product-main .sticky-atc__thumb {
      display: none;
    }
    .sticky-atc.in-product-main .sticky-atc__price {
      position: absolute;
      right: 34px;
      top: 16px;
    }
    .sticky-atc.in-product-main .sticky-atc__buy,
    .sticky-atc.in-product-main .sticky-atc__btn {
      width: 100%;
    }
    .sticky-atc.in-product-main .sticky-atc__meta {
      font-size: 14px;
    }
    .sticky-atc.in-product-main .sticky-atc__btn {
      font-size: 22px;
      padding: 15.2px;
    }

    @media screen and (max-width: 749px) {
      .sticky-atc {
        box-shadow: inherit;
        background: transparent;
        -webkit-backdrop-filter: none;
        backdrop-filter: none;
        border-radius: 0;
      }
      .sticky-atc__inner {
        flex-direction: column;
        align-items: stretch;
        gap: 8px;
        padding: 12px 24px 16px;
        border-radius: 24px 24px 0 0;
        box-shadow: 0 0 32px 0 rgba(123, 166, 221, 0.75);
        background: #fff9efcc;
        -webkit-backdrop-filter: blur(10px);
        backdrop-filter: blur(10px);
      }
      .sticky-atc__thumb {
        display: none;
      }
      .sticky-atc__title {
        display: none;
      }
      .sticky-atc__meta--desktop {
        display: none;
      }
      .sticky-atc__meta--mobile {
        display: block;
        text-align: center;
        font-size: 13px;
        line-height: 20px;
        color: #000000;
        white-space: normal;
        max-width: none;
      }
      .sticky-atc__buy {
        width: 100%;
      }
      .sticky-atc__price--standalone {
        display: none;
      }
      .sticky-atc__btn {
        width: 100%;
        font-size: 16px;
        line-height: 24px;
        letter-spacing: 0.96px;
        padding: 8.4px 20px;
        justify-content: space-between;
      }

      .sticky-atc__btn:hover {
        background: #ffc069 !important;
        color: #000000;
      }

      .sticky-atc__btn:hover s.sticky-atc__btn-was {
        color: #000000;
      }
      .sticky-atc__btn-price {
        display: inline;
        font-size: 16px;
        line-height: 20px;
        font-family: "Matter";
        letter-spacing: 0;
        transform: translateY(2px);
      }
      .sticky-atc__btn-price:empty {
        display: none;
      }
      .sticky-atc__btn-price::first-letter {
        font-size: 0;
      }
      s.sticky-atc__btn-was {
        display: inline;
        margin-left: auto;
        font-size: 16px;
        line-height: 20px;
        font-family: "Matter";
        font-weight: 400;
        letter-spacing: 0;
        text-decoration: line-through;
        white-space: nowrap;
      }
    }
  {%- endstyle -%}
{%- endif -%}
