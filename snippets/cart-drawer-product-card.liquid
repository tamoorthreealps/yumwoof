{%- comment -%}
  Reusable product card for the cart drawer.

  Accepts:
  - product {product} - the product to render
  - style {string} - 'recommend' (compact, ADD button) or 'empty' (tall, SHOP NOW)
  - recipe {string} - (optional, 'empty' style) render this card for a single Recipe
      value; image + link come from that recipe's cheapest variant.
{%- endcomment -%}

{%- liquid
  assign card_variant = product.selected_or_first_available_variant
  assign compare = card_variant.compare_at_price
  assign price = card_variant.price
  assign card_alt = product.title | escape
-%}

{%- if style == 'empty' -%}
  {%- liquid
    # Representative variant: cheapest variant of the passed recipe, else the
    # product's selected/first-available variant.
    assign rep = product.selected_or_first_available_variant
    assign recipe_label = recipe
    if recipe != blank
      assign recipe_idx = -1
      for opt in product.options
        assign optn = opt | downcase | strip
        if optn == 'recipe'
          assign recipe_idx = forloop.index0
        endif
      endfor
      if recipe_idx >= 0
        assign rep_price = 0
        for v in product.variants
          if v.options[recipe_idx] == recipe
            if rep_price == 0 or v.price < rep_price
              assign rep_price = v.price
              assign rep = v
            endif
          endif
        endfor
      endif
    endif

    # Image: variant desktop/mobile metafields -> variant image -> product image.
    assign card_desktop = rep.metafields.custom.variant_image_collection_card.value | default: rep.image | default: product.featured_image
    assign card_mobile = rep.metafields.custom.variant_image_collection_card_mobile.value | default: card_desktop
    assign card_url = rep.url | default: product.url
    assign card_short_desc = rep.metafields.custom.product_card_short_description.value | default: product.metafields.custom.product_card_short_description.value
  -%}
  <div class="cd-shop-card">
    <a href="{{ card_url }}" class="cd-shop-card__media" tabindex="-1" aria-hidden="true">
      {%- if card_desktop != blank -%}
        {{
          card_desktop
          | image_url: width: 400
          | image_tag:
            class: 'cd-shop-card__img cd-shop-card__img--desktop',
            widths: '160, 260, 400',
            alt: card_alt,
            loading: 'lazy'
        }}
        {{
          card_mobile
          | image_url: width: 400
          | image_tag:
            class: 'cd-shop-card__img cd-shop-card__img--mobile',
            widths: '160, 260, 400',
            alt: card_alt,
            loading: 'lazy'
        }}
      {%- else -%}
        {{ 'product-1' | placeholder_svg_tag: 'cd-shop-card__img' }}
      {%- endif -%}
    </a>
    <div class="cd-shop-card__body">
      {%- if recipe_label != blank -%}
        <p class="cd-shop-card__type">{{ recipe_label }}</p>
      {%- elsif product.type != blank -%}
        <p class="cd-shop-card__type">{{ product.type }}</p>
      {%- endif -%}
      <a href="{{ card_url }}" class="cd-shop-card__title">{{ product.title | escape }}</a>
      {%- if card_short_desc != blank -%}
        <p class="cd-shop-card__desc">{{ card_short_desc }}</p>
      {%- endif -%}
    </div>
    <a href="{{ card_url }}" class="cd-hex-btn cd-shop-card__btn">SHOP NOW</a>
  </div>

{%- else -%}
  <div class="cd-rec-card">
    <a href="{{ product.url }}" class="cd-rec-card__media" tabindex="-1" aria-hidden="true">
      {%- if product.featured_image -%}
        {{
          product.featured_image
          | image_url: width: 240
          | image_tag: class: 'cd-rec-card__img', widths: '120, 180, 240', alt: card_alt, loading: 'lazy'
        }}
      {%- else -%}
        {{ 'product-1' | placeholder_svg_tag: 'cd-rec-card__img' }}
      {%- endif -%}
    </a>
    <div class="cd-rec-card__body__main">
      <div class="cd-rec-card__body__content">
        <div class="cd-rec-card__body">
          <p class="cd-rec-card__title">{{ product.title | escape }}</p>
          {% comment %}
            {%- assign recipe = product.metafields.custom.recipe | default: product.type -%}
            {%- if recipe != blank -%}
              <p class="cd-rec-card__subtitle">{{ recipe }}</p>
            {%- endif -%}
          {% endcomment %}
          {%- assign recipe_label = blank -%}

          {%- for option in product.options -%}
            {%- if option == 'Recipe' -%}
              {%- assign recipe_label = option -%}
              {%- break -%}
            {%- endif -%}
          {%- endfor -%}

          {%- if recipe_label != blank -%}
            <p class="cd-rec-card__subtitle">{{ recipe_label }}</p>
          {%- endif -%}
          {%- assign rec_variant = product.selected_or_first_available_variant -%}
          {%- assign rec_variant = product.selected_or_first_available_variant -%}
          {%- assign size_value = blank -%}

          {%- for option in product.options -%}
            {%- if option == 'Size' -%}
              {%- assign size_value = rec_variant.options[forloop.index0] -%}
            {%- endif -%}
          {%- endfor -%}

          {%- assign display_size = product.metafields.custom.pack_size.value | default: size_value -%}

          {%- if display_size != blank -%}
            {%- assign display_size = display_size | remove: 'Full Bag (' | remove: 'Topper Size (' | remove: ')' -%}
            {%- unless display_size contains 'Bag' -%}
              {%- assign display_size = display_size | append: ' Bag' -%}
            {%- endunless -%}

            <p class="cd-rec-card__meta">{{ display_size }}</p>
          {%- endif -%}
        </div>
        <div class="cd-rec-card__price">
          <span class="cd-rec-card__final">{{ price | money }}</span>
          {%- if compare > price -%}
            <s class="cd-rec-card__compare">{{ compare | money }}</s>
          {%- endif -%}
        </div>
      </div>
      {%- if card_variant.available -%}
        <button
          type="button"
          class="cd-hex-btn cd-rec-card__add"
          data-cd-add
          data-variant-id="{{ card_variant.id }}"
          aria-label="{{ 'products.product.add_to_cart' | t }}: {{ product.title | escape }}"
        >
          ADD
        </button>
      {%- else -%}
        <span class="cd-hex-btn cd-rec-card__add cd-rec-card__add--disabled">SOLD OUT</span>
      {%- endif -%}
    </div>
  </div>
{%- endif -%}
