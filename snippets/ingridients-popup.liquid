{% assign popup = product.metafields.custom.ingredient_popup.value %}
<div class="ingredients-popup" id="ingredients-popup-1">
  <div class="ingredients-popup__overlay"></div>

  <div class="ingredients-popup__panel">
    <div class="ingredients-popup__panel_head">
      <button class="ingredients-popup__close">
        <svg width="21" height="24" viewBox="0 0 21 24" fill="none" xmlns="http://www.w3.org/2000/svg">
          <path d="M4.32 5.288C4.32 5.544 4.064 5.608 3.744 5.832C3.36 6.12 3.04 6.568 3.04 7.336C3.04 9.672 3.008 9.96 2.752 10.376C2.56 10.696 2.272 11.016 2.272 11.4C2.272 11.656 2.4 11.912 2.656 12.232C3.008 12.68 3.04 13.128 3.04 13.544V15.432C3.04 16.968 4.32 17.032 4.32 17.48C4.32 17.768 4.16 17.864 3.712 17.864C2.464 17.864 1.696 17.128 1.696 15.688V13.96C1.696 13.544 1.6 12.968 1.44 12.712C1.312 12.52 1.12 12.296 0.8 12.072C0.512 11.88 0.224 11.688 0.224 11.4C0.224 11.08 0.416 10.92 0.992 10.536C1.536 10.184 1.696 9.32 1.696 9.096V7.112C1.696 5.768 2.432 4.936 3.552 4.936C4.256 4.936 4.32 5.064 4.32 5.288Z" fill="black"/>
          <path d="M9.544 14.024L8.232 16.072C7.752 16.808 7.4 17 6.824 17H5.896C5.448 17 5.128 16.68 5.288 16.36C5.384 16.168 5.384 16.2 5.512 16.008L8.232 12.168C8.488 11.816 8.648 11.432 8.648 11.144C8.648 10.824 8.456 10.472 8.36 10.312L6.152 7.208C5.736 6.696 5.832 6.152 6.44 6.152H7.496C8.008 6.152 8.424 6.408 8.712 6.888L9.576 8.296C9.832 8.712 10.152 8.968 10.504 8.968C10.792 8.968 11.08 8.776 11.304 8.392L12.168 7.016C12.552 6.376 12.904 6.152 13.608 6.152H14.376C15.112 6.152 15.08 6.696 14.856 7.016L12.744 9.992C12.424 10.472 12.264 10.792 12.264 11.112C12.264 11.368 12.328 11.688 12.744 12.264L14.952 15.368C15.688 16.424 15.624 16.36 15.624 16.552C15.624 16.84 15.4 17 14.952 17H13.992C13.512 17 13.064 16.744 12.744 16.264L11.336 14.024C10.984 13.512 10.76 13.352 10.472 13.352C10.088 13.352 9.8 13.608 9.544 14.024Z" fill="black"/>
          <path d="M16.68 5.288C16.68 5.544 16.936 5.608 17.256 5.832C17.64 6.12 17.96 6.568 17.96 7.336C17.96 9.672 17.992 9.96 18.248 10.376C18.44 10.696 18.728 11.016 18.728 11.4C18.728 11.656 18.6 11.912 18.344 12.232C17.992 12.68 17.96 13.128 17.96 13.544V15.432C17.96 16.968 16.68 17.032 16.68 17.48C16.68 17.768 16.84 17.864 17.288 17.864C18.536 17.864 19.304 17.128 19.304 15.688V13.96C19.304 13.544 19.4 12.968 19.56 12.712C19.688 12.52 19.88 12.296 20.2 12.072C20.488 11.88 20.776 11.688 20.776 11.4C20.776 11.08 20.584 10.92 20.008 10.536C19.464 10.184 19.304 9.32 19.304 9.096V7.112C19.304 5.768 18.568 4.936 17.448 4.936C16.744 4.936 16.68 5.064 16.68 5.288Z" fill="black"/>
        </svg>
      </button>

      <div class="ingredients-popup__left">
        <h2 class="ingredients-popup__title">{{ popup.title }}</h2>

        <p class="ingredients-popup__subtitle">
          {{ product.title | upcase }} -
          <span class="ingredients-popup__active-tab">
            {{ popup.tab_1_title }}
          </span>
        </p>
      </div>
    </div>
    <div class="ingredients-popup__tabs_main">
      <div class="ingredients-popup__tabs">
        <button class="active" data-tab="1">
          {% if popup.tab_1_icon %}
            {{ popup.tab_1_icon | image_url: width: 80 | image_tag: loading: 'lazy', alt: popup.tab_1_title }}
          {% endif %}

          <span>{{ popup.tab_1_title }}</span>
        </button>

        <button data-tab="2">
          {% if popup.tab_2_icon %}
            {{ popup.tab_2_icon | image_url: width: 80 | image_tag: loading: 'lazy', alt: popup.tab_2_title }}
          {% endif %}

          <span>{{ popup.tab_2_title }}</span>
        </button>

        <button data-tab="3">
          {% if popup.tab_3_icon %}
            {{ popup.tab_3_icon | image_url: width: 80 | image_tag: loading: 'lazy', alt: popup.tab_3_title }}
          {% endif %}

          <span>{{ popup.tab_3_title }}</span>
        </button>
      </div>

      <div class="ingredients-popup__content active" data-content="1">
        {{ popup.tab_1_description | metafield_tag }}
      </div>

      <div class="ingredients-popup__content" data-content="2">
        {{ popup.tab_2_description | metafield_tag }}
      </div>

      <div class="ingredients-popup__content" data-content="3">
        {{ popup.tab_3_description | metafield_tag }}
      </div>
    </div>
  </div>
</div>
<style>
       	/*----- popup--css--code -----*/
       .ingredients-popup {
       	position: fixed;
       	inset: 0;
       	z-index: 9999;
       	visibility: hidden;
       	opacity: 0;
       	transition: .35s;
       }

       .ingredients-popup.active {
       	visibility: visible;
       	opacity: 1;
       }

       .ingredients-popup__overlay {
       	position: absolute;
       	inset: 0;
       	background: rgba(0, 0, 0, .45);
       	display: block !important;
       }

     .ingredients-popup__panel {
       position: absolute;
       top: 50%;
       left: 50%;
       transform: translate(-50%, -110%);
       transition: transform .6s cubic-bezier(.22, 1, .36, 1);
       width: fit-content;
  min-width: 464px;
  max-width: min(90vw, 900px);
       background: rgba(255, 255, 255, 0.9);
       border-radius: 24px;
       -webkit-backdrop-filter: blur(10px);
       backdrop-filter: blur(10px);
   }

       .ingredients-popup.active .ingredients-popup__panel {
       	transform: translate(-50%, -50%);
       }
     .ingredients-popup__panel_head {
         background-color: rgba(132, 149, 75, 0.9);
         border-radius: 23px 23px 0 0;
         border-bottom: 1px solid #000000;
         padding: 32px 24px 28px;
     }
       .ingredients-popup__left {
       	width: 100%;
       }

       .ingredients-popup__right {
       	width: 50%;
       	display: flex;
       	align-items: center;
       	justify-content: center;
       }

       .ingredients-popup__right_img {
       	height: 400px;
       	width: 100%;
       	margin: 0 0 -30px;
       }

       .ingredients-popup__right img {
       	max-width: 100%;
       	max-height: 100%;
       	width: auto;
       	height: auto;
       	object-fit: contain;
       }

       .ingredients-popup__right_img_bowl {
       	position: absolute;
       	right: -135px;
       	height: 436px;
       	width: auto;
       	bottom: 30px;
       }

       .ingredients-popup__right_img_bowl img {
       	margin: 0;
       	height: 100%;
       	width: 100%;
       	object-fit: contain;
       	animation: bowlRotatepop 150s linear infinite;
       	transform-origin: center center;
       	will-change: transform;
       }

       @keyframes bowlRotatepop {
       	from {
       		transform: rotate(0deg);
       	}

       	to {
       		transform: rotate(360deg);
       	}
       }

     .ingredients-popup__close {
         position: absolute;
         right: 29px;
         top: 16px;
         border: none;
         border-radius: 50%;
         cursor: pointer;
         background: transparent;
         padding: 0;
         margin: 0;
     }

     .ingredients-popup__title {
         margin: 0;
         font-size: 44px;
         line-height: 48px;
         font-family: TAYRosemary;
         letter-spacing: -0.44px;
         font-weight: 400;
         color: #000000;
     }

     .ingredients-popup__subtitle {
         margin: 0;
         font-size: 16px;
         line-height: 20px;
         color: #000000;
         letter-spacing: -0.16px;
         font-weight: 500;
         font-family: 'TAY Birdie';
         text-transform: uppercase;
     }
     .ingredients-popup__tabs_main {
         padding: 24px 24px 32px;
     }
      .ingredients-popup__tabs {
         display: flex;
         gap: 12px;
         margin-bottom: 32px;
     }

   .ingredients-popup__tabs button {
       padding: 0;
       background: none;
       cursor: pointer;
       font-size: 16px;
       line-height: 24px;
       letter-spacing: 0;
       font-weight: 500;
       color: #000;
       font-family: 'Matter';
       text-transform: capitalize;
       border: 1px solid rgba(0, 0, 0, .1);
       border-radius: 8px;
       flex: 1;
       display: flex;
       align-items: center;
       gap: 8px;
    padding: 0 11px 0 0;
        width: 202px;
     height: 56px;
   }

      .ingredients-popup__tabs button.active {
         color: #000;
         border-color: #000000;
         background: rgba(0, 0, 0, 0.1);
     }

     .ingredients-popup__tabs button img {
       width: 56px;
       height: 56px;
       object-fit: cover;
   }

       .ingredients-popup__content {
       	display: none;
       	max-width: 100%;
       }

       .ingredients-popup__content.active {
       	display: block;
       }

       .ingredients-popup__content p {
         font-size: 16px;
         line-height: 24px;
         margin: 0 0 32px;
         letter-spacing: 0;
         color: #000000;
     }

  .ingredients-popup__content p:last-child{
  	margin:0;
  }

       .ingredients-popup__content_btn {
       	background: url(https://yumwoof-2.myshopify.com/cdn/shop/files/megamenu-desktop-btn-ng.svg?v=1784203684) center / 100% 100% no-repeat;
       	color: #000;
       	text-decoration: none;
       	font-size: 16px;
       	line-height: 24px;
       	letter-spacing: 0.64px;
       	width: 164px;
       	height: 72px;
       	display: flex;
       	justify-content: center;
       	align-items: center;
       	font-family: "FFBlurProMedium";
       	margin: 48px 0 0;
       }

       @media(max-width:768px) {

       	    .ingredients-popup__panel {
        overflow-y: auto;
        min-width: 100%;
        border-radius: 20px;
    }
	.ingredients-popup__panel_head {
		border-radius: 20px 20px 0 0;
		padding: 28px 24px 20px;
	}

       	.ingredients-popup__left,
       	.ingredients-popup__right {
       		width: 100%;
       	}

       	    .ingredients-popup__title {
        font-size: 36px;
        line-height: 40px;
        letter-spacing: -0.36px;
    }

       	    .ingredients-popup__subtitle {
        font-size: 14px;
        line-height: 20px;
        letter-spacing: -0.14px;
    }
	.ingredients-popup__tabs_main {
    padding: 24px 24px 28px;
}

           .ingredients-popup__tabs {
        margin-bottom: 0;
        padding-bottom: 20px;
		gap: 8px;
		        flex-wrap: wrap;
    }

             .ingredients-popup__tabs button {
        padding: 0 16px 0 0;
        font-size: 14px;
        line-height: 20px;
        letter-spacing: 0;
        gap: 12px;
        width: calc(50% - 4px);
    }

       	.ingredients-popup__content p {
       		font-size: 14px;
       		line-height: 20px;
       	}

       	.ingredients-popup__content_btn {
       		font-size: 12px;
       		line-height: 18px;
       		letter-spacing: .96px;
       		width: 120px;
       		height: 50px;
       		margin: 24px 0 0;
       	}

       	.ingredients-popup__right {
       		justify-content: flex-end;
       	}

       	.ingredients-popup__right_img {
       		height: 194px;
       		width: 244px;
       		margin: 0;
       	}

       	.ingredients-popup__right_img_bowl {
       		right: -100px;
       		height: 220px;
       		width: auto;
       		bottom: 18px;
       	}

       	.ingredients-popup__close {
       		right: 16px;
       		top: 16px;
       		width: 24px;
       		height: 20px;
       	}

       	.ingredients-popup__close svg {
       		display: block;
       		max-width: 100%;
       		height: auto;
       	}

       }
</style>

{% comment %} required--js--code {% endcomment %}
<script>
    {% comment %} popup--js--code {% endcomment %}
  document.querySelectorAll(".recipe-view-ingredients").forEach(function(button) {
    button.addEventListener("click", function(e) {
      e.preventDefault();

      document.querySelector(".ingredients-popup").classList.add("active");
    });
  });

  document.querySelectorAll(".ingredients-popup").forEach(function(popup) {
    popup.querySelector(".ingredients-popup__close").addEventListener("click", function() {
      popup.classList.remove("active");
    });

    popup.querySelector(".ingredients-popup__overlay").addEventListener("click", function() {
      popup.classList.remove("active");
    });
  });

     document.querySelectorAll(".ingredients-popup").forEach(function(popup){
         const tabs = popup.querySelectorAll(".ingredients-popup__tabs button");
         const contents = popup.querySelectorAll(".ingredients-popup__content");
         tabs.forEach(function(tab){
             tab.addEventListener("click",function(){
                 tabs.forEach(function(btn){
                     btn.classList.remove("active");
                 });
                 contents.forEach(function(content){
                     content.classList.remove("active");
                 });
                 tab.classList.add("active");
                 popup
                     .querySelector('[data-content="'+tab.dataset.tab+'"]')
                     .classList.add("active");
				const activeTitle = popup.querySelector(".ingredients-popup__active-tab");

				if (activeTitle) {
					activeTitle.textContent = tab.querySelector("span").textContent;
				}
             });
         });
     });
</script>
