{% comment %}
  Renders product variant options

  Accepts:
  - product: {Object} product object.
  - option: {Object} current product_option object.
  - block: {Object} block object.
  - picker_type: {String} type of picker to dispay


  Usage:
  {% render 'product-variant-options',
    product: product,
    option: option,
    block: block
    picker_type: picker_type
  %}
{% endcomment %}
{%- liquid
  assign product_form_id = 'product-form-' | append: section.id
-%}

{%- for value in option.values -%}
  {%- liquid
    assign swatch_focal_point = null
    if value.swatch.image
      assign image_url = value.swatch.image | image_url: width: 50
      assign swatch_value = 'url(' | append: image_url | append: ')'
      assign swatch_focal_point = value.swatch.image.presentation.focal_point
    elsif value.swatch.color
      assign swatch_value = 'rgb(' | append: value.swatch.color.rgb | append: ')'
    else
      assign swatch_value = null
    endif

      assign option_disabled = true
  if value.available
    assign option_disabled = false
  endif

  # US only: Ancestral Blend – Turkey / 1 Pound Bag OOS (AB-TURKEY-1LB)
  if localization.country.iso_code == 'US' and product.handle == 'ancestral-blend'
    if option.name == 'Size' and value == '1 Pound Bag'
      assign selected_recipe = null
      for opt in product.options_with_values
        assign opt_name_down = opt.name | downcase
        if opt_name_down == 'recipe' or opt_name_down == 'recipes'
          assign selected_recipe = opt.selected_value
          break
        endif
      endfor
      if selected_recipe == 'Turkey'
        assign option_disabled = true
      endif
    endif
  endif
-%}

  {%- capture input_id -%}
    {{ section.id }}-{{ option.position }}-{{ forloop.index0 -}}
  {%- endcapture -%}

  {%- capture input_name -%}
    {{ option.name }}-{{ option.position }}
  {%- endcapture -%}

  {%- capture input_dataset -%}
    data-product-url="{{ value.product_url }}"
    data-option-value-id="{{ value.id }}"
    data-option-name="{{ option.name | escape }}"
  {%- endcapture -%}

  {%- capture label_unavailable -%}
    <span class="visually-hidden label-unavailable">
      {{- 'products.product.variant_sold_out_or_unavailable' | t -}}
    </span>
  {%- endcapture -%}

  {% assign escaped_value = value | escape %}

  {%- if picker_type == 'recipe_image' -%}
    {%- comment -%}
      Recipe swatch images come from the "recipe_swatches" metaobject: match its
      swatch_title to this option value, then use its desktop/mobile image fields.
      If no entry matches, no image is shown (title/badge only).
    {%- endcomment -%}
    {%- assign value_key = value | strip | downcase -%}
    {%- assign swatch_desktop = null -%}
    {%- assign swatch_mobile = null -%}
    {%- for rs in shop.metaobjects.recipe_swatches.values -%}
      {%- assign rs_title = rs.swatch_title | strip | downcase -%}
      {%- if rs_title == value_key -%}
        {%- assign swatch_desktop = rs.swatch_desktop_image -%}
        {%- assign swatch_mobile = rs.swatch_mobile_image -%}
        {%- break -%}
      {%- endif -%}
    {%- endfor -%}
    {%- comment -%} Each falls back to the other if only one image is set. {%- endcomment -%}
    {%- assign recipe_desktop_src = swatch_desktop | default: swatch_mobile -%}
    {%- assign recipe_mobile_src = swatch_mobile | default: swatch_desktop -%}
    {%- comment -%} Optional badge (e.g. POPULAR) from the matching variant's swatch_badge metafield. {%- endcomment -%}
    {%- assign swatch_badge = '' -%}
    {%- assign value_name = value | strip -%}
    {%- assign recipe_opt_idx = option.position | minus: 1 -%}
    {%- for v in product.variants -%}
      {%- if v.options[recipe_opt_idx] == value_name -%}
        {%- assign vb = v.metafields.custom.swatch_badge.value -%}
        {%- if vb != blank -%}
          {%- assign swatch_badge = vb -%}
        {%- endif -%}
        {%- break -%}
      {%- endif -%}
    {%- endfor -%}
    {% unless value == 'Healthy Grains (Original)' %}
    <div class="recipe-swatch">
      <input
        type="radio"
        class="recipe-swatch__input{% if option_disabled %} disabled{% endif %}"
        id="{{ input_id }}"
        name="{{ input_name | escape }}"
        value="{{ escaped_value }}"
        form="{{ product_form_id }}"
        {% if value.selected %}
          checked
        {% endif %}
        {{ input_dataset }}
      >
      <label class="recipe-swatch__label" for="{{ input_id }}">
        {%- if recipe_desktop_src != blank -%}
          <img class="recipe-swatch__img recipe-swatch__img--desktop" src="{{ recipe_desktop_src | image_url: width: 128 }}" alt="Recipe Swatch Image" loading="lazy" width="64" height="64">
          <img class="recipe-swatch__img recipe-swatch__img--mobile" src="{{ recipe_mobile_src | image_url: width: 128 }}" alt="Recipe Swatch Image" loading="lazy" width="64" height="64">
        {%- endif -%}
        <span class="recipe-swatch__title">{{ value }}</span>
        {{ label_unavailable }}
      </label>
      {%- if swatch_badge != blank -%}
        <span class="recipe-swatch__badge">{{ swatch_badge }}</span>
      {%- endif -%}
    </div>
  {% endunless %}
  {%- elsif picker_type == 'swatch' -%}
    {%- capture help_text -%}
      <span class="visually-hidden">{{ escaped_value }}</span>
      {{ label_unavailable }}
    {%- endcapture -%}
{% unless value == '3.5 Pound Bag' or value == '1.75 Pound Box' %}
    {% render 'swatch-input',
      id: input_id,
      name: input_name,
      value: escaped_value,
      swatch: value.swatch,
      product_form_id: product_form_id,
      checked: value.selected,
      visually_disabled: option_disabled,
      shape: block.settings.swatch_shape,
      help_text: help_text,
      additional_props: input_dataset
    %}
  {% endunless %}
  {%- elsif picker_type == 'button' -%}
    {%- comment -%}
      Optional per-value subtitle (e.g. bag size "Everyday feeding" / "Trial or topper"),
      read from the matching variant's custom.swatch_subtitle metafield.
    {%- endcomment -%}
    {%- assign swatch_subtitle = '' -%}
    {%- assign value_name = value | strip -%}
    {%- assign opt_idx = option.position | minus: 1 -%}
    {%- for v in product.variants -%}
      {%- if v.options[opt_idx] == value_name -%}
        {%- assign vs = v.metafields.custom.swatch_subtitle.value -%}
        {%- if vs != blank -%}
          {%- assign swatch_subtitle = vs -%}
        {%- endif -%}
        {%- break -%}
      {%- endif -%}
    {%- endfor -%}
    {% unless value == '3.5 Pound Bag' or value == '1.75 Pound Box' %}
    <input
      type="radio"
      id="{{ input_id }}"
      name="{{ input_name | escape }}"
      value="{{ escaped_value }}"
      form="{{ product_form_id }}"
      {% if value.selected %}
        checked
      {% endif %}
      {% if option_disabled %}
        class="disabled"
      {% endif %}
      {{ input_dataset }}
    >
    <label for="{{ input_id }}"{% if swatch_subtitle != blank %} class="has-subtitle"{% endif %}>
      {%- if swatch_subtitle != blank -%}
        <span class="pill__title">{{ value }}</span>
        <span class="pill__subtitle">{{ swatch_subtitle }}</span>
      {%- else -%}
        {{ value -}}
      {%- endif -%}
      {{ label_unavailable }}
    </label>
    {% endunless %}
  {%- elsif picker_type == 'dropdown' or picker_type == 'swatch_dropdown' -%}
    <option
      id="{{ input_id }}"
      value="{{ escaped_value }}"
      {% if value.selected %}
        selected="selected"
      {% endif %}
      {% if swatch_value and picker_type == 'swatch_dropdown' %}
        data-option-swatch-value="{{ swatch_value }}"
        {% if swatch_focal_point %}
          data-option-swatch-focal-point="{{ swatch_focal_point }}"
        {% endif %}
      {% endif %}
      {{ input_dataset }}
    >
      {% if option_disabled -%}
        {{- 'products.product.value_unavailable' | t: option_value: value -}}
      {%- else -%}
        {{- value -}}
      {%- endif %}
    </option>
  {%- endif -%}
{%- endfor -%}