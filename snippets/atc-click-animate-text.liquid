<span class="yw-atb__label yw-atb__label--load">
    Adding
<span class="yw-atb__dots" aria-hidden="true"><i></i><i></i><i></i></span>
</span>

<style>
    .yw-atb__dots {
  display: inline-flex;
  gap: 5px;
}

.yw-atb__dots i {
  width: 6px;
  height: 6px;
  border-radius: 50%;
  background: #fff9ef;
  opacity: 0;
  animation: yw-dot-1 1.5s linear infinite;
}

.yw-atb__dots i:nth-child(2) {
  animation-name: yw-dot-2;
}

.yw-atb__dots i:nth-child(3) {
  animation-name: yw-dot-3;
}

@keyframes yw-dot-1 {
  0% { opacity: 0; }
  4%, 88% { opacity: 1; }
  94%, 100% { opacity: 0; }
}

@keyframes yw-dot-2 {
  0%, 30% { opacity: 0; }
  34%, 88% { opacity: 1; }
  94%, 100% { opacity: 0; }
}

@keyframes yw-dot-3 {
  0%, 60% { opacity: 0; }
  64%, 88% { opacity: 1; }
  94%, 100% { opacity: 0; }
}
</style>