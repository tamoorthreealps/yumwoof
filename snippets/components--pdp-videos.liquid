</section>


<script>
document.addEventListener("DOMContentLoaded", function () {

    const popup = document.querySelector(".yumw-video-popup");

    if (!popup) {
        console.error("Popup not found");
        return;
    }

    const popupClose = popup.querySelector(".yumw-video-popup__close");
    const video = popup.querySelector("video");
    const source = popup.querySelector("source");

    document.addEventListener("click", function (e) {

        const card = e.target.closest(".yumw-video-card");

        if (card) {

            e.preventDefault();

            const videoSrc = card.dataset.video;

            if (!videoSrc) return;

            source.src = videoSrc;
            video.load();

            popup.classList.add("active");

            video.play().catch(() => {});

            return;
        }

        if (e.target.closest(".yumw-video-popup__close")) {
            closePopup();
            return;
        }

        if (e.target === popup) {
            closePopup();
        }

    });

    document.addEventListener("keydown", function (e) {
        if (e.key === "Escape" && popup.classList.contains("active")) {
            closePopup();
        }
    });

    function closePopup() {
        video.pause();
        video.currentTime = 0;
        source.src = "";
        video.load();
        popup.classList.remove("active");
    }

});
</script>