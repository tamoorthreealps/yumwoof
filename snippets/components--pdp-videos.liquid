<style>
    .yumw-video-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 10px;
}

.yumw-video-card {
    position: relative;
    aspect-ratio: 9 / 16;
    border-radius: 12px;
    overflow: hidden;
    cursor: pointer;
    background: #1f1f1f;
}

.yumw-video-card img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
}

.yumw-video-play {
    position: absolute;
    left: 10px;
    bottom: 10px;
    width: 34px;
    height: 34px;
    border: 0;
    border-radius: 50%;
    background: #fff;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    transition: .25s;
}

.yumw-video-play:hover {
    transform: scale(1.08);
}

.yumw-video-play svg {
    width: 10px;
    height: 12px;
    margin-left: 2px;
}

.yumw-video-popup {
    position: fixed;
    inset: 0;
    background: rgba(0, 0, 0, .7);
    display: flex;
    justify-content: center;
    align-items: center;
    opacity: 0;
    visibility: hidden;
    transition: .3s;
    z-index: 9999;
}

.yumw-video-popup.active {
    opacity: 1;
    visibility: visible;
}

.yumw-video-popup__inner {
    position: relative;
    background: #fff;
    padding: 18px;
    border-radius: 8px;
    max-width: 420px;
    width: calc(100% - 30px);
}

.yumw-video-popup__close {
    position: absolute;
    top: -12px;
    right: -12px;
    width: 34px;
    height: 34px;
    border: 0;
    border-radius: 50%;
    background: #fff;
    font-size: 26px;
    line-height: 1;
    cursor: pointer;
}

.yumw-video-popup video {
    width: 100%;
    aspect-ratio: 9 / 16;
    display: block;
    border-radius: 24px;
    background: #000;
}

@media (max-width: 767px) {
    .yumw-video-grid {
        gap: 8px;
    }

    .yumw-video-play {
        width: 30px;
        height: 30px;
    }

    .yumw-video-play svg {
        width: 9px;
        height: 11px;
    }
}
</style>


<section class="yumw-video-testimonials">
    <div class="yumw-video-grid">

        <div class="yumw-video-card"
             data-video="https://cdn.shopify.com/videos/c/o/v/2e5ebf46a2ba4169973643496ffa2f1c.mp4">

            <video autoplay muted loop playsinline preload="metadata">
                <source src="https://cdn.shopify.com/videos/c/o/v/2e5ebf46a2ba4169973643496ffa2f1c.mp4" type="video/mp4">
            </video>

            <button class="yumw-video-play" type="button">
                <svg width="12" height="14" viewBox="0 0 12 14" fill="none">
                    <path d="M12 7L0 14V0L12 7Z" fill="black"/>
                </svg>
            </button>

        </div>

        <div class="yumw-video-card"
             data-video="https://cdn.shopify.com/videos/c/o/v/2e5ebf46a2ba4169973643496ffa2f1c.mp4">

            <video autoplay muted loop playsinline preload="metadata">
                <source src="https://cdn.shopify.com/videos/c/o/v/2e5ebf46a2ba4169973643496ffa2f1c.mp4" type="video/mp4">
            </video>

            <button class="yumw-video-play" type="button">
                <svg width="12" height="14" viewBox="0 0 12 14" fill="none">
                    <path d="M12 7L0 14V0L12 7Z" fill="black"/>
                </svg>
            </button>

        </div>

        <div class="yumw-video-card"
             data-video="https://cdn.shopify.com/videos/c/o/v/2e5ebf46a2ba4169973643496ffa2f1c.mp4">

            <video autoplay muted loop playsinline preload="metadata">
                <source src="https://cdn.shopify.com/videos/c/o/v/2e5ebf46a2ba4169973643496ffa2f1c.mp4" type="video/mp4">
            </video>

            <button class="yumw-video-play" type="button">
                <svg width="12" height="14" viewBox="0 0 12 14" fill="none">
                    <path d="M12 7L0 14V0L12 7Z" fill="black"/>
