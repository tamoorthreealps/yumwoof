<style>
    .ek-video-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 10px;
}

.ek-video-card {
    position: relative;
    aspect-ratio: 9 / 16;
    border-radius: 12px;
    overflow: hidden;
    cursor: pointer;
    background: #1f1f1f;
}

.ek-video-card img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
}

.ek-video-play {
    position: absolute;
    left: 10px;
    bottom: 10px;
    width: 34px;
    height: 34px;
    border: 0;
    border-radius: 50%;
    background: #fff;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    transition: .25s;
}

.ek-video-play:hover {
    transform: scale(1.08);
}

.ek-video-play svg {
    width: 10px;
    height: 12px;
    margin-left: 2px;
}

.ek-video-popup {
    position: fixed;
    inset: 0;
    background: rgba(0, 0, 0, .7);
    display: flex;
    justify-content: center;
    align-items: center;
    opacity: 0;
    visibility: hidden;
    transition: .3s;
    z-index: 9999;
}

.ek-video-popup.active {
    opacity: 1;
    visibility: visible;
}

.ek-video-popup__inner {
    position: relative;
    background: #fff;
    padding: 18px;
    border-radius: 8px;
    max-width: 420px;
    width: calc(100% - 30px);
}

.ek-video-popup__close {
    position: absolute;
    top: -12px;
    right: -12px;
    width: 34px;
    height: 34px;
    border: 0;
    border-radius: 50%;
    background: #fff;
    font-size: 26px;
    line-height: 1;
    cursor: pointer;
}

.ek-video-popup video {
    width: 100%;
    aspect-ratio: 9 / 16;
    display: block;
    border-radius: 24px;
    background: #000;
}

@media (max-width: 767px) {
    .ek-video-grid {
        gap: 8px;
    }

    .ek-video-play {
        width: 30px;
        height: 30px;
    }

    .ek-video-play svg {
        width: 9px;
        height: 11px;
    }
}
</style>


<section class="ek-video-testimonials">
  <div class="ek-video-grid">
    <div class="ek-video-card" data-video="video-1.mp4">
      <img src="thumb-1.jpg" alt="Video 1">

      <button class="ek-video-play" type="button">
        <svg width="12" height="14" viewBox="0 0 12 14" fill="none">
          <path d="M12 7L0 14V0L12 7Z" fill="black"/>
        </svg>
      </button>
    </div>

    <div class="ek-video-card" data-video="video-2.mp4">
      <img src="thumb-2.jpg" alt="Video 2">

      <button class="ek-video-play" type="button">
        <svg width="12" height="14" viewBox="0 0 12 14" fill="none">
          <path d="M12 7L0 14V0L12 7Z" fill="black"/>
        </svg>
      </button>
    </div>

    <div class="ek-video-card" data-video="video-3.mp4">
      <img src="thumb-3.jpg" alt="Video 3">

      <button class="ek-video-play" type="button">
        <svg width="12" height="14" viewBox="0 0 12 14" fill="none">
          <path d="M12 7L0 14V0L12 7Z" fill="black"/>
        </svg>
      </button>
    </div>
  </div>
</section>


<script>
    const videoCards = document.querySelectorAll(".ek-video-card");
const popup = document.querySelector(".ek-video-popup");
const popupClose = document.querySelector(".ek-video-popup__close");
const video = popup.querySelector("video");
const source = video.querySelector("source");

videoCards.forEach(card => {
    card.addEventListener("click", () => {
        source.src = card.dataset.video;
        video.load();

        popup.classList.add("active");

        video.play().catch(() => {});
    });
});

function closeVideoPopup() {
    video.pause();
    video.currentTime = 0;

    source.src = "";
    video.load();

    popup.classList.remove("active");
}

popupClose.addEventListener("click", closeVideoPopup);

popup.addEventListener("click", e => {
    if (e.target === popup) {
        closeVideoPopup();
    }
});

document.addEventListener("keydown", e => {
    if (e.key === "Escape" && popup.classList.contains("active")) {
        closeVideoPopup();
    }
});
</script>