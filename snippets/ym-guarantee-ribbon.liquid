<div
  class="ym-guarantee-ribbon"
  style="
    {% if block.settings.background_image != blank %}
      background-image: url('{{ block.settings.background_image | image_url: width: 2000 }}');
      background-size: 100% 100%;
      background-position: center;
      background-repeat: no-repeat;
    {% else %}
      --ribbon-color: {{ block.settings.ribbon_color }};
      background-color: {{ block.settings.background_color }};
    {% endif %}
  "
>
  <div
    class="ym-guarantee-ribbon__content"
    style="max-width:{{ block.settings.content_width }}px;"
  >
    {% if block.settings.heading != blank %}
      <h3
        class="ym-guarantee-ribbon__title"
        style="color:{{ block.settings.heading_color }};"
      >
        {{ block.settings.heading }}
      </h3>
    {% endif %}

    {% if block.settings.text != blank %}
      <p
        class="ym-guarantee-ribbon__text"
        style="color:{{ block.settings.text_color }};"
      >
        {{ block.settings.text }}
      </p>
    {% endif %}
  </div>
</div>

{% if template.suffix == 'ancestral-blend-v2' %}
<script>
  (() => {
    const ribbons = document.querySelectorAll('.ym-guarantee-ribbon');

    ribbons.forEach(ribbon => {
      const title = ribbon.querySelector('.ym-guarantee-ribbon__title');
      const text = ribbon.querySelector('.ym-guarantee-ribbon__text');

      if (!title || !text) return;

      ribbon.classList.remove('is-text-slide');

      setInterval(() => {
        ribbon.classList.toggle('is-text-slide');
      }, 3000);
    });
  })();
</script>
{% endif %}

<style>
    .ym-guarantee-ribbon {
        position: relative;
        display: flex;
        justify-content: center;
        align-items: center;
        width: 100%;
        max-width: 900px;
        margin: 1.6rem auto 0;
        padding: 12px 50px;
        overflow: hidden;
        box-sizing: border-box;
        border-radius: 2px;

        background-size: 100% 100%;
        background-position: center;
        background-repeat: no-repeat;
    }

    {% if block.settings.background_image == blank %}
    .ym-guarantee-ribbon::before,
    .ym-guarantee-ribbon::after {
        content: "";
        position: absolute;
        top: 0;
        width: 24px;
        height: 100%;
        background: var(--ribbon-color);
    }

    .ym-guarantee-ribbon::before {
        left: 0;
        clip-path: polygon(0 0, 100% 50%, 0 100%);
        border-radius: 2px 0 0 2px;
    }

    .ym-guarantee-ribbon::after {
        right: 0;
        clip-path: polygon(100% 0, 0 50%, 100% 100%);
        border-radius: 0 2px 2px 0;
    }
    {% endif %}

    .ym-guarantee-ribbon__content {
        position: relative;
        z-index: 2;
        text-align: center;
    }

    .ym-guarantee-ribbon__title {
        margin: 0;
        font-size: 16px;
        line-height: 20px;
        color: #000000;
        letter-spacing: 0;
        font-family: 'Matter';
        font-weight: 500;
        transform: translateY(2px);
    }

    .ym-guarantee-ribbon__text {
        margin: 4px 0 0;
        font-size: 14px;
        font-weight: 500;
        line-height: 20px;
        color: rgba(0, 0, 0, 0.5);
        letter-spacing: 0;
        font-family: 'Matter';
    }

            {% comment %} v2-changes {% endcomment %}
        .product__info-wrapper_v2 .ym-guarantee-ribbon {
            padding: 5px 16px 7px;
            margin:1.2rem 0 0;
         }
        .product__info-wrapper_v2 .ym-guarantee-ribbon__text {
            margin-top: 0;
            font-size: 14px;
            line-height: 20px;
            color: #000;
        }

.product__info-wrapper_v2 .ym-guarantee-ribbon__content {
    position: relative;
    min-height: 20px;
    width: 100%;
    display: flex;
    justify-content: center;
    align-items: center;
    overflow: hidden;
}


.product__info-wrapper_v2 .ym-guarantee-ribbon__title,
.product__info-wrapper_v2 .ym-guarantee-ribbon__text {
    margin: 0;
    width: 100%;
    text-align: center;
    transition: transform 0.7s cubic-bezier(0.4, 0, 0.2, 1);
    will-change: transform;
    animation: ribbonTextLight 2.5s ease-in-out infinite;
    font-size: 16px;
    line-height: 24px;
    letter-spacing: 0;
    font-family: 'Matter';
}

@keyframes ribbonTextLight {
    0%,
    100% {
        opacity: 1;
    }

    50% {
        opacity: 0.6;
    }
}

.product__info-wrapper_v2 .ym-guarantee-ribbon__title {
    transform: translateY(0);
}

.product__info-wrapper_v2 .ym-guarantee-ribbon__text {
    position: absolute;
    left: 0;
    top: 50%;
    transform: translateY(100%);
}

.product__info-wrapper_v2 .ym-guarantee-ribbon.is-text-slide .ym-guarantee-ribbon__title {
    transform: translateY(-100%);
}

.product__info-wrapper_v2 .ym-guarantee-ribbon.is-text-slide .ym-guarantee-ribbon__text {
    transform: translateY(-50%);
}

    @media (max-width: 990px) {
        .ym-guarantee-ribbon {
            padding: 12px 16px 16px;

            {% if block.settings.background_image_mobile != blank %}
                background-image: url('{{ block.settings.background_image_mobile | image_url: width: 1200 }}') !important;
            {% elsif block.settings.background_image != blank %}
                background-image: url('{{ block.settings.background_image | image_url: width: 2000 }}');
            {% endif %}
        }

        .ym-guarantee-ribbon::before,
        .ym-guarantee-ribbon::after {
            width: 28px;
        }

        .ym-guarantee-ribbon__title {
            font-size: 14px;
        }

        .ym-guarantee-ribbon__text {
            margin-top: 4px;
            font-size: 12px;
            line-height: 16px;
        }

        {% comment %} v2-changes {% endcomment %}
        .product__info-wrapper_v2 .ym-guarantee-ribbon {
            padding: 5px 16px 7px;
            margin:1.2rem 0 0;
         }
        .product__info-wrapper_v2 .ym-guarantee-ribbon__text {
            margin-top: 0;
            font-size: 14px;
            line-height: 20px;
            color: #000;
        }
    }
</style>