<div
  class="ym-guarantee-ribbon"
  style="
    --ribbon-color: {{ block.settings.ribbon_color }};

    {% if block.settings.background_image != blank %}
      background-image: url('{{ block.settings.background_image | image_url: width: 2000 }}');
      background-size: cover;
      background-position: center;
      background-repeat: no-repeat;
    {% else %}
      background-color: {{ block.settings.background_color }};
    {% endif %}
  "
>
  <div
    class="ym-guarantee-ribbon__content"
    style="max-width:{{ block.settings.content_width }}px;"
  >
    {% if block.settings.heading != blank %}
      <h3
        class="ym-guarantee-ribbon__title"
        style="color:{{ block.settings.heading_color }};"
      >
        {{ block.settings.heading }}
      </h3>
    {% endif %}

    {% if block.settings.text != blank %}
      <p
        class="ym-guarantee-ribbon__text"
        style="color:{{ block.settings.text_color }};"
      >
        {{ block.settings.text }}
      </p>
    {% endif %}
  </div>
</div>

<style>
  .ym-guarantee-ribbon {
      position: relative;
      display: flex;
      justify-content: center;
      align-items: center;
      width: 100%;
      max-width: 900px;
      margin: 1.6rem auto 0;
      padding: 12px 50px;
      overflow: hidden;
      box-sizing: border-box;
      border-radius: 2px;
      background-size: cover;
      background-position: center;
  }

  .ym-guarantee-ribbon::before, .ym-guarantee-ribbon::after {
      content: "";
      position: absolute;
      top: 0;
      width: 24px;
      height: 100%;
      background: var(--ribbon-color);
  }

  .ym-guarantee-ribbon::before {
      left: 0;
      clip-path: polygon(0 0, 100% 50%, 0 100%);
      border-radius: 2px 0 0 2px;
  }

  .ym-guarantee-ribbon::after {
      right: 0;
      clip-path: polygon(100% 0, 0 50%, 100% 100%);
      border-radius: 0 2px 2px 0;
  }

  .ym-guarantee-ribbon__content {
    position: relative;
    z-index: 2;
    text-align: center;
  }

  .ym-guarantee-ribbon__title {
      margin: 0;
      font-size: 16px;
      font-weight: 700;
      line-height: 20px;
      color: #000000;
      letter-spacing: 0;
  }

  .ym-guarantee-ribbon__text {
      margin: 4px 0 0;
      font-size: 13px;
      font-weight: 500;
      line-height: 20px;
      color: rgba(0, 0, 0, 0.5);
      letter-spacing: 0;
  }

  @media (max-width: 767px) {
    .ym-guarantee-ribbon {
      padding: 18px 30px;
    }

    .ym-guarantee-ribbon::before,
    .ym-guarantee-ribbon::after {
      width: 28px;
    }

    .ym-guarantee-ribbon__title {
      font-size: 24px;
    }

    .ym-guarantee-ribbon__text {
      margin-top: 6px;
      font-size: 15px;
    }
  }
</style>
