{% comment %}
  Renders a metafield value that follows the selected variant.

  Accepts:
  - product: {Object}
  - key:     {String} metafield key under the `custom` namespace
  - heading: {String} optional heading text
  - class:   {String} optional extra class on the wrapper

  Usage:
  {% render 'variant-metafield-text',
     product: product, key: 'complete_balanced', heading: 'COMPLETE & BALANCED' %}
{% endcomment %}

{%- liquid
  assign fallback = product.metafields.custom[key].value
  assign current_variant = product.selected_or_first_available_variant
  assign current = current_variant.metafields.custom[key].value | default: fallback
-%}

{%- if fallback != blank or current != blank -%}
  <variant-metafield-text
    class="variant-metafield-text {{ class }}"
    {% if current == blank %}hidden{% endif %}
  >
    <script type="application/json" data-variant-values>
      {
        "fallback": {{ fallback | default: '' | json }},
        "variants": [
          {%- for v in product.variants -%}
            {
              "options": {{ v.options | json }},
              "value": {{ v.metafields.custom[key].value | default: fallback | default: '' | json }}
            }{% unless forloop.last %},{% endunless %}
          {%- endfor -%}
        ]
      }
    </script>

    {%- if heading != blank -%}
      <h4 class="variant-metafield-text__heading">{{ heading }}</h4>
    {%- endif -%}
    <p class="variant-metafield-text__value" data-value>{{ current }}</p>
  </variant-metafield-text>
{%- endif -%}

<script>
  if (!customElements.get('variant-metafield-text')) {
    customElements.define(
      'variant-metafield-text',
      class extends HTMLElement {
        connectedCallback() {
          const dataEl = this.querySelector('[data-variant-values]');
          if (!dataEl) return;

          try {
            this.data = JSON.parse(dataEl.textContent);
          } catch (e) {
            return;
          }

          this.target = this.querySelector('[data-value]');
          this.picker = this.closest('product-info, .product__info-container')?.querySelector('variant-selects');
          if (!this.picker || !this.target) return;

          this.onChange = this.onChange.bind(this);
          this.picker.addEventListener('change', this.onChange);
        }

        disconnectedCallback() {
          this.picker?.removeEventListener('change', this.onChange);
        }

        selectedOptions() {
          return Array.from(
            this.picker.querySelectorAll('fieldset, .product-form__input--dropdown')
          )
            .map((group) => {
              const select = group.querySelector('select');
              if (select) return select.value;
              return group.querySelector('input:checked')?.value ?? null;
            })
            .filter((value) => value !== null);
        }

        onChange() {
          const selected = this.selectedOptions();
          const match = this.data.variants.find(
            (variant) =>
              variant.options.length === selected.length &&
              variant.options.every((option, i) => option === selected[i])
          );

          const value = (match ? match.value : this.data.fallback) || '';
          this.target.textContent = value;
          this.toggleAttribute('hidden', value.trim() === '');
        }
      }
    );
  }
</script>