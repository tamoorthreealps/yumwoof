{% comment %}
  Renders a metafield value that follows the selected variant.

  Reads the variant-level metafield and falls back to the product-level one.
  Updates on variant selection without a page reload.

  Accepts:
  - product: {Object} product object.
  - key:     {String} metafield key under the `custom` namespace.
  - heading: {String} optional heading text.

  Usage:
  {% render 'variant-metafield-text',
     product: product,
     key: 'complete_balanced',
     heading: 'COMPLETE & BALANCED'
  %}
{% endcomment %}

{%- liquid
  assign fallback = product.metafields.custom[key].value
  assign current_variant = product.selected_or_first_available_variant
  assign current = current_variant.metafields.custom[key].value | default: fallback
-%}

{%- if fallback != blank or current != blank -%}
  <div class="nutritional--info" data-variant-metafield {% if current == blank %}hidden{% endif %}>
    <script type="application/json" data-variant-metafield-values>
      {
        "fallback": {{ fallback | default: '' | json }},
        "variants": [
          {%- for v in product.variants -%}
            {
              "options": {{ v.options | json }},
              "value": {{ v.metafields.custom[key].value | default: fallback | default: '' | json }}
            }{% unless forloop.last %},{% endunless %}
          {%- endfor -%}
        ]
      }
    </script>

    {%- if heading != blank -%}
      <h4 class="nutritional--info--heading">{{ heading }}</h4>
    {%- endif -%}
    <p class="nutritional--info--content" data-variant-metafield-value>{{ current }}</p>
  </div>

  <script>
    (function () {
      if (window.variantMetafieldTextInit) return;
      window.variantMetafieldTextInit = true;

      function selectedOptions(picker) {
        return Array.from(picker.querySelectorAll('fieldset, .product-form__input--dropdown'))
          .map(function (group) {
            var select = group.querySelector('select');
            if (select) return select.value;
            var checked = group.querySelector('input:checked');
            return checked ? checked.value : null;
          })
          .filter(function (value) {
            return value !== null;
          });
      }

      function update(el) {
        var dataEl = el.querySelector('[data-variant-metafield-values]');
        var target = el.querySelector('[data-variant-metafield-value]');
        var scope = el.closest('product-info') || el.closest('.product__info-container');
        var picker = scope ? scope.querySelector('variant-selects') : null;
        if (!dataEl || !target || !picker) return;

        var data;
        try {
          data = JSON.parse(dataEl.textContent);
        } catch (e) {
          return;
        }

        var selected = selectedOptions(picker);
        var match = data.variants.find(function (variant) {
          return (
            variant.options.length === selected.length &&
            variant.options.every(function (option, i) {
              return option === selected[i];
            })
          );
        });

        var value = (match ? match.value : data.fallback) || '';
        target.textContent = value;
        el.toggleAttribute('hidden', value.trim() === '');
      }

      // Delegated so it survives the section re-render performed by product-info.js.
      document.addEventListener('change', function (event) {
        if (!event.target.closest || !event.target.closest('variant-selects')) return;
        document.querySelectorAll('[data-variant-metafield]').forEach(update);
      });
    })();
  </script>
{%- endif -%}