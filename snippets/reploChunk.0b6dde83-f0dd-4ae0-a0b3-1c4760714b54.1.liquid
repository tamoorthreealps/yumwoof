" class="r-cfndg1"><div data-rid="dbea43ce-9d73-493b-a4c4-cf8fb3a06d46" class="r-pemes0 alchemy-rte"><span style="width:100%"><h5>marcus p.</h5></span></div><div data-rid="90382652-0e0e-432d-87ed-a5b1d42c1e41" class="r-1nsbdrp"><div data-rid="0592bdcf-0f52-4bf5-af73-1b0d05bd6818" class="r-16w3sc8"><svg stroke="currentColor" fill="currentColor" stroke-width="0" viewBox="0 0 16 16" role="presentation" style="width:var(--rsw, 100%);height:auto;max-height:100%" class="r-7ehtqe" height="1em" width="1em" xmlns="http://www.w3.org/2000/svg"><path d="M10.97 4.97a.75.75 0 0 1 1.07 1.05l-3.99 4.99a.75.75 0 0 1-1.08.02L4.324 8.384a.75.75 0 1 1 1.06-1.06l2.094 2.093 3.473-4.425z"></path></svg></div><div data-rid="d36dd5dd-20c5-4e85-8654-55b17fd0b9ab" class="r-gh2g08 alchemy-rte"><span style="width:100%"><p>Verified Buyer</p></span></div></div></div></div></div></div></div></div><div class="r-115xab4" data-rid="1"><div data-rid="ae3bdc86-cc25-482e-9bae-b434b429b599" class="r-1yf778m"><picture data-rid="67aa00fb-02c7-4a0f-bbbc-52c68e1dfbd0" class="r-1iwst8t"><source srcSet="https://assets.replocdn.com/projects/2ee6ec90-baee-4f21-b088-c47798c979a2/7a8cc217-afde-4933-a5c7-cbaa34391469?width=820" media="(max-width: 640px)"/><source srcSet="https://assets.replocdn.com/projects/2ee6ec90-baee-4f21-b088-c47798c979a2/4e71b84c-58ca-4e78-aa3d-6cb2ee09e7aa?width=1024" media="(min-width: 641px) and (max-width: 1024px)"/><source srcSet="https://assets.replocdn.com/projects/2ee6ec90-baee-4f21-b088-c47798c979a2/4e71b84c-58ca-4e78-aa3d-6cb2ee09e7aa?width=1800" media="(min-width: 1025px) and (max-width: 2400px)"/><img src="https://assets.replocdn.com/projects/2ee6ec90-baee-4f21-b088-c47798c979a2/4e71b84c-58ca-4e78-aa3d-6cb2ee09e7aa" class="r-c4ynog" loading="eager"/></picture><picture data-rid="2fb42758-2354-4dff-805a-e787eaa42cfd" data-cloudshape="image" class="r-a3d6kr"><source srcSet="https://assets.replocdn.com/projects/2ee6ec90-baee-4f21-b088-c47798c979a2/9213a04b-11be-4839-ae6f-482adff85544?