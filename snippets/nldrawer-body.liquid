{% comment %}
  Renders a generic pdp_drawer panel body (multi-line text) into HTML.

  Line markup:
    = a | b | c   -> table HEADER row (uppercase, ruled)
    a | b | c     -> table row (cells split on "|"; first left, last right)
    ## Text       -> large heading (e.g. "Calorie content:")
    # Text        -> small section eyebrow (e.g. "FATTY ACIDS")
    > Text        -> footnote (muted, small)
    Text          -> paragraph
    (blank)       -> spacing

  Accepts: body {String}
{% endcomment %}
{%- assign _lines = body | strip | newline_to_br | strip_newlines | split: '<br />' -%}
{%- assign _intable = false -%}
{%- for _raw in _lines -%}
  {%- assign _line = _raw | strip -%}
  {%- if _line == blank -%}{%- continue -%}{%- endif -%}
  {%- assign _c1 = _line | slice: 0 -%}
  {%- assign _c2 = _line | slice: 0, 2 -%}
  {%- if _line contains '|' -%}
    {%- assign _head = false -%}
    {%- if _c1 == '=' -%}
      {%- assign _head = true -%}
      {%- assign _line = _line | remove_first: '=' | strip -%}
    {%- endif -%}
    {%- unless _intable -%}<div class="nldrawer__rows">{%- assign _intable = true -%}{%- endunless -%}
    {%- assign _cells = _line | split: '|' -%}
    <div class="nldrawer__row{% if _head %} nldrawer__row--head{% endif %}">
      {%- for _cell in _cells -%}
        <span class="nldrawer__cell{% if forloop.first %} nldrawer__cell--first{% endif %}{% if forloop.last and forloop.index > 1 %} nldrawer__cell--last{% endif %}">{{ _cell | strip }}</span>
      {%- endfor -%}
    </div>
  {%- else -%}
    {%- if _intable -%}</div>{%- assign _intable = false -%}{%- endif -%}
    {%- if _c2 == '##' -%}
      <p class="nldrawer__calorie-title">{{ _line | remove_first: '##' | strip }}</p>
    {%- elsif _c1 == '#' -%}
      <p class="nldrawer__section">{{ _line | remove_first: '#' | strip }}</p>
    {%- elsif _c1 == '>' -%}
      <p class="nldrawer__foot">{{ _line | remove_first: '>' | strip }}</p>
    {%- else -%}
      <p class="nldrawer__prose">{{ _line }}</p>
    {%- endif -%}
  {%- endif -%}
{%- endfor -%}
{%- if _intable -%}</div>{%- endif -%}
