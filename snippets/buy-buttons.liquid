{% comment %}
  Renders product buy-buttons.
  Accepts:
  - product: {Object} product object.
  - block: {Object} passing the block information.
  - product_form_id: {String} product form id.
  - section_id: {String} id of section to which this snippet belongs.
  - show_pickup_availability: {Boolean} for the pickup availability. If true the pickup availability is rendered, false - not rendered (optional).

  Usage:
  {% render 'buy-buttons', block: block, product: product, product_form_id: product_form_id, section_id: section.id, show_pickup_availability: true %}
{% endcomment %}
<div {{ block.shopify_attributes }}>
  {%- if product != blank -%}
    {%- liquid
      # ----- Market availability (Coming Soon) -----
      # A product can be withheld from purchase in specific markets via the
      # custom.unavailable_markets metafield (list of single line text). Each entry
      # is matched, case-insensitively, against the visitor's current market HANDLE
      # (localization.market.handle) or their country code (localization.country.iso_code).
      # Spaces become hyphens so "United Kingdom" also matches the "united-kingdom" handle.
      assign is_market_unavailable = false
      assign unavailable_markets = product.metafields.custom.unavailable_markets.value
      if unavailable_markets != blank
        assign cur_market_handle = localization.market.handle | downcase | strip
        assign cur_country_code = localization.country.iso_code | downcase | strip
        for um in unavailable_markets
          assign um_key = um | downcase | strip | replace: ' ', '-'
          if um_key == cur_market_handle or um_key == cur_country_code
            assign is_market_unavailable = true
          endif
        endfor
      endif

      assign gift_card_recipient_feature_active = false
      if block.settings.show_gift_card_recipient and product.gift_card?
        assign gift_card_recipient_feature_active = true
      endif

      assign show_dynamic_checkout = false
      if block.settings.show_dynamic_checkout and gift_card_recipient_feature_active == false
        assign show_dynamic_checkout = true
      endif
    -%}

    {%- comment -%}
      Variant-level per-market OOS. When the selected variant's custom.oos_markets
      lists the current market, force a "Sold Out" state (frontend only — backend
      stock is untouched). If custom.notify_markets also lists the market, a Klaviyo
      notify form is shown. Product-level "Coming Soon" (is_market_unavailable) still
      takes precedence, so this only applies when the product is otherwise for sale.
    {%- endcomment -%}
    {%- assign cur_variant = product.selected_or_first_available_variant -%}
    {%- capture v_oos_check %}{% render 'variant-market-availability', variant: cur_variant, list: 'oos' %}{% endcapture -%}
    {%- capture v_notify_check %}{% render 'variant-market-availability', variant: cur_variant, list: 'notify' %}{% endcapture -%}
    {%- liquid
      assign variant_oos = false
      assign variant_notify = false
      if v_oos_check contains 'true'
        assign variant_oos = true
      endif
      if variant_oos and v_notify_check contains 'true'
        assign variant_notify = true
      endif
      if is_market_unavailable
        assign variant_oos = false
        assign variant_notify = false
      endif
      assign notify_form_class = block.settings.notify_form_class | default: '' | strip
    -%}

    {%- if is_market_unavailable -%}
      <style>
        .product-form__input.product-form__quantity, .qty.freq{
          display:none;
        }
      </style>
      {%- comment -%}
        Not for sale in this market: the add-to-cart is replaced by a "Coming Soon"
        button (styled exactly like add-to-cart) that opens a popup containing the
        Klaviyo email-signup form.
      {%- endcomment -%}
      {%- assign klaviyo_form_class = block.settings.klaviyo_form_class | default: 'klaviyo-form-Ry6Yff' | strip -%}
      {%- assign coming_soon_heading = block.settings.coming_soon_heading | default: 'Coming Soon' -%}
      {%- assign cs_id = 'ComingSoon-' | append: section_id | append: '-' | append: product.id -%}
      {% style %}
        .coming-soon-modal[hidden] { display: none; }
        .coming-soon-modal {
          position: fixed;
          inset: 0;
          z-index: 1000;
          display: flex;
          align-items: center;
          justify-content: center;
          padding: 2rem;
        }
        .coming-soon-modal__overlay {
          position: absolute;
          inset: 0;
          background: rgba(0, 0, 0, 0.5);
        }
        .coming-soon-modal__dialog {
          position: relative;
          background: #fff9ef;
          color: #1a1a1a;
          width: 100%;
          max-width: 48rem;
          max-height: 90vh;
          overflow: auto;
          border-radius: 12px;
          padding: 3.6rem 2.4rem 2.4rem;
        }
        .coming-soon-modal__close {
          position: absolute;
          top: 0.8rem;
          right: 1rem;
          background: none;
          border: 0;
          font-size: 2.8rem;
          line-height: 1;
          cursor: pointer;
          color: inherit;
        }
        .coming-soon-modal__heading { margin: 0 0 0.8rem; font-size: 2rem; font-weight: 600; line-height: 1.2; }
        .coming-soon-modal__text > :first-child { margin-top: 0; }
        .coming-soon-modal__text { margin-bottom: 1.6rem; }
        /*---- waqar--css ----*/
        .product-form--coming-soon .coming-soon-modal__heading { margin: 0 0 0.8rem; font-size: 2rem; font-weight: 600; line-height: 1.2; }
        .product-form--coming-soon .klaviyo-form.klaviyo-form.klaviyo-form { background: transparent !important; padding: 0 !important; border: 0 !important; }
        .product-form--coming-soon .needsclick { padding: 0 !important; min-height: auto !important; }
        .product-form--coming-soon .needsclick.kl-private-reset-css-Xuajs1 h1 { text-align: left !important; margin: 0 0 12px !important; }
        .product-form--coming-soon .needsclick.kl-private-reset-css-Xuajs1 h1 span { color: #000; font-size: 16px !important; line-height: 24px; letter-spacing: -.64px; font-family: TAY Birdie !important; text-transform: uppercase; margin: 0 !important; text-align: left !important; }
        .product-form--coming-soon .klaviyo-emailinput input { background: #FFF !important; border: 1px solid #000 !important; border-radius: 12px !important; padding: 16px 28px !important; height: 64px !important; color: #000 !important; font-size: 18px !important; line-height: 24px !important; letter-spacing: 0 !important; font-family: 'Matter' !important; }
        .product-form--coming-soon .klaviyo-emailinput input::placeholder { color: #000 !important; font-family: 'Matter' !important; letter-spacing: 0 !important; font-size: 18px !important; opacity: 1; }
        .product-form--coming-soon .klaviyo-form-button.go3634373664 { background: #000 !important; font-weight:500 !important; color: #FFF9EF !important; font-size: 22px !important; line-height: 24px !important; letter-spacing: 1.32px !important; font-family: 'FFBlurProMedium' !important; border: 1px solid #000 !important; border-radius: 12px !important; margin: 12px 0 0; height: 63px !important; }
        .product-form--coming-soon .klaviyo-form-button.go3634373664:hover { background: transparent !important; color: #000 !important; transition: all .25s ease; }
        .product-form--coming-soon .klaviyo-form-button.go4033861592.go488503511 { height: auto !important; margin: 12px 0 0; }

        @media screen and (max-width: 990px) {
          .product-form--coming-soon .needsclick.kl-private-reset-css-Xuajs1 h1 { margin: 0 0 8px !important; }
          .product-form--coming-soon .klaviyo-emailinput input { border-radius: 8px !important; padding: 12px 16px !important; height: 48px !important; font-size: 15px !important; line-height: 24px !important; letter-spacing: 0 !important; }
          .product-form--coming-soon .klaviyo-emailinput input::placeholder { font-size: 15px !important; }
          .product-form--coming-soon .klaviyo-form-button.go3634373664 { font-size: 18px !important; letter-spacing: .96px !important; border-radius: 8px !important; height: 54px !important; }
        }

      {% endstyle %}
      <div class="product-form product-form--coming-soon">
        {%- if block.settings.coming_soon_text != blank -%}
            <div class="coming-soon-modal__text rte">{{ block.settings.coming_soon_text }}</div>
          {%- endif -%}
          {%- if klaviyo_form_class != blank -%}
            <div class="{{ klaviyo_form_class }}"></div>
          {%- endif -%}
      </div>
    {%- else -%}
    <product-form
      class="product-form"
      data-hide-errors="{{ gift_card_recipient_feature_active }}"
      data-section-id="{{ section.id }}"
    >
      <div class="product-form__error-message-wrapper" role="alert" hidden>
        <span class="svg-wrapper">
          {{- 'icon-error.svg' | inline_asset_content -}}
        </span>
        <span class="product-form__error-message"></span>
      </div>

      {%- form 'product',
        product,
        id: product_form_id,
        class: 'form',
        novalidate: 'novalidate',
        data-type: 'add-to-cart-form'
      -%}
        {%- liquid
          assign check_against_inventory = true
          if product.selected_or_first_available_variant.inventory_management != 'shopify' or product.selected_or_first_available_variant.inventory_policy == 'continue'
            assign check_against_inventory = false
          endif
          assign quantity_rule_soldout = false
          if product.selected_or_first_available_variant.quantity_rule.min > product.selected_or_first_available_variant.inventory_quantity and check_against_inventory
            assign quantity_rule_soldout = true
          endif
        -%}
        <input
          type="hidden"
          name="id"
          value="{{ product.selected_or_first_available_variant.id }}"
          {% if product.selected_or_first_available_variant.available == false
            or quantity_rule_soldout
            or product.selected_or_first_available_variant == null
            or variant_oos
          %}
            disabled
          {% endif %}
          class="product-variant-id"
        >
        <input
          type="hidden"
          name="selling_plan"
          id="selling-plan-input"
          value=""
        >
        {%- if gift_card_recipient_feature_active -%}
          {%- render 'gift-card-recipient-form', product: product, form: form, section: section -%}
        {%- endif -%}

        <div class="product-form__buttons">
          <button
            id="ProductSubmitButton-{{ section_id }}"
            type="submit"
            name="add"
            class="product-form__submit button button--full-width {% if show_dynamic_checkout %}button--secondary{% else %}button--primary{% endif %}"
            {% if product.selected_or_first_available_variant.available == false
              or quantity_rule_soldout
              or product.selected_or_first_available_variant == null
              or variant_oos
            %}
              disabled
            {% endif %}
          >
            <span>
              {%- if product.selected_or_first_available_variant == null -%}
                {{ 'products.product.unavailable' | t }}
              {%- elsif product.selected_or_first_available_variant.available == false or quantity_rule_soldout or variant_oos -%}
                {{ 'products.product.sold_out' | t }}
              {%- else -%}
                {{ 'products.product.add_to_cart' | t }}
              {%- endif -%}
            </span>
            {%- render 'loading-spinner' -%}
          </button>
          {%- if show_dynamic_checkout -%}
            {{ form | payment_button }}
          {%- endif -%}
        </div>
      {%- endform -%}
    </product-form>

    {%- comment -%}
      Variant-level per-market OOS support: a per-variant state map (for JS to react
      to variant changes without a page reload) and, when any variant has a notify
      market, the Klaviyo notify form (shown/hidden by assets/oos-notify.js).
    {%- endcomment -%}
    {%- assign any_notify = false -%}
    {%- for v in product.variants -%}
      {%- capture v_any_notify %}{% render 'variant-market-availability', variant: v, list: 'notify' %}{% endcapture -%}
      {%- if v_any_notify contains 'true' -%}{%- assign any_notify = true -%}{%- endif -%}
    {%- endfor -%}

    {% style %}
      [data-variant-notify] { margin-top: 1.6rem; }
      .pdp--variant-oos .product-form__input.product-form__quantity,
      .pdp--variant-oos .qty.freq { display: none !important; }
      /* When the notify form is the CTA, hide the Sold Out button entirely. */
      .pdp--variant-notify .product-form__buttons { display: none !important; }
      /* ...and hide the guarantee ribbon while the notify form is showing. */
      .pdp--variant-notify .ym-guarantee-ribbon { display: none !important; }

      /* Notify form styled to match the Coming Soon Klaviyo form (unchanged). */
      .variant-notify .klaviyo-form.klaviyo-form.klaviyo-form { background: transparent !important; padding: 0 !important; border: 0 !important; }
      .variant-notify .needsclick { padding: 0 !important; min-height: auto !important; }
      .variant-notify .needsclick.kl-private-reset-css-Xuajs1 h1 { text-align: left !important; margin: 0 0 12px !important; }
      .variant-notify .needsclick.kl-private-reset-css-Xuajs1 h1 span { color: #000; font-size: 16px !important; line-height: 24px; letter-spacing: -.64px; font-family: TAY Birdie !important; text-transform: uppercase; margin: 0 !important; text-align: left !important; }
      .variant-notify .klaviyo-emailinput input { background: #FFF !important; border: 1px solid #000 !important; border-radius: 12px !important; padding: 16px 28px !important; height: 64px !important; color: #000 !important; font-size: 18px !important; line-height: 24px !important; letter-spacing: 0 !important; font-family: 'Matter' !important; }
      .variant-notify .klaviyo-emailinput input::placeholder { color: #000 !important; font-family: 'Matter' !important; letter-spacing: 0 !important; font-size: 18px !important; opacity: 1; }
      .variant-notify .klaviyo-form-button { background: #7BA6DD !important; font-weight:500 !important; color: #000 !important; font-size: 22px !important; line-height: 24px !important; letter-spacing: 1.32px !important; font-family: 'FFBlurProMedium' !important; border: 1px solid #000 !important; border-radius: 12px !important; margin: 12px 0 0; height: 63px !important; }
      .variant-notify .klaviyo-form-button:hover { background: transparent !important; color: #000 !important; transition: all .25s ease; }

      /* ----- Success message (post-submit "You're on the list.") -----
         Klaviyo's success view = the <form> element once the email field + submit
         button are gone. Only the <form> is styled as the blue box (the outer
         .klaviyo-form div stays transparent, so it doesn't nest). The heading/body
         are .klaviyo-form-richtext <p><span> in two form-rows, not h1/h2 — Klaviyo
         sets their font inline, so these override with !important. Desktop sizes here. */
      .variant-notify form.klaviyo-form:not(:has(.klaviyo-emailinput)):not(:has(.klaviyo-form-button)) {
        background: #7BA6DD !important; border: 1px solid #000 !important;
        border-radius: 16px !important; padding: 40px 53px !important;
      }
      .variant-notify form.klaviyo-form:not(:has(.klaviyo-emailinput)):not(:has(.klaviyo-form-button)) > div { min-height: 0 !important; }
      .variant-notify form.klaviyo-form:not(:has(.klaviyo-emailinput)):not(:has(.klaviyo-form-button)) [data-testid="form-row"]:nth-of-type(1) .klaviyo-form-richtext span {
        color: #000 !important; font-family: 'TAY Birdie' !important; font-size: 29px !important; margin:0 0 8px !important;
        line-height: 25px !important; font-weight:400 !important; letter-spacing: -1.16px !important; text-transform: uppercase !important; display: block !important;
      }
      .variant-notify form.klaviyo-form:not(:has(.klaviyo-emailinput)):not(:has(.klaviyo-form-button)) [data-testid="form-row"]:nth-of-type(2) .klaviyo-form-richtext span {
        color: #000 !important; font-family: 'Matter' !important; font-size: 18px !important;
        line-height: 24px !important; letter-spacing: 0 !important; font-weight:500 !important;
      }

      @media screen and (max-width: 990px) {
        .variant-notify .needsclick.kl-private-reset-css-Xuajs1 h1 { margin: 0 0 8px !important; }
        .variant-notify .klaviyo-emailinput input { border-radius: 8px !important; padding: 12px 16px !important; height: 48px !important; font-size: 15px !important; line-height: 24px !important; letter-spacing: 0 !important; }
        .variant-notify .klaviyo-emailinput input::placeholder { font-size: 15px !important; }
        .variant-notify .klaviyo-form-button { font-size: 18px !important; letter-spacing: .96px !important; border-radius: 8px !important; height: 54px !important; }
        /* Success message: mobile sizes (heading 24, body 16). */
        .variant-notify form.klaviyo-form:not(:has(.klaviyo-emailinput)):not(:has(.klaviyo-form-button)) [data-testid="form-row"]:nth-of-type(1) .klaviyo-form-richtext span { font-size: 24px !important; letter-spacing: -.96px !important; line-height: 20px !important; }
        .variant-notify form.klaviyo-form:not(:has(.klaviyo-emailinput)):not(:has(.klaviyo-form-button)) [data-testid="form-row"]:nth-of-type(2) .klaviyo-form-richtext span { font-size: 16px !important; max-width:201px !important; margin:0 auto !important; display: block !important; }
      }
    {% endstyle %}

    <script type="application/json" data-variant-oos-map data-section-id="{{ section_id }}" data-product-title="{{ product.title | escape }}" data-market="{{ localization.country.iso_code | default: localization.market.handle | escape }}">
      { {%- for v in product.variants -%}
          {%- capture v_o %}{% render 'variant-market-availability', variant: v, list: 'oos' %}{% endcapture -%}
          {%- capture v_n %}{% render 'variant-market-availability', variant: v, list: 'notify' %}{% endcapture -%}
          "{{ v.id }}": { "oos": {% if v_o contains 'true' %}true{% else %}false{% endif %}, "notify": {% if v_n contains 'true' %}true{% else %}false{% endif %}, "title": {{ v.title | json }} }{% unless forloop.last %},{% endunless %}
        {%- endfor -%} }
    </script>

    {%- if any_notify -%}
      {%- comment -%} Same markup shape as the Coming Soon form: just the Klaviyo embed. {%- endcomment -%}
      <div class="variant-notify product-form--coming-soon" data-variant-notify data-section-id="{{ section_id }}" hidden>
        {%- if notify_form_class != blank -%}
          <div class="{{ notify_form_class }}"></div>
        {%- endif -%}
      </div>
    {%- endif -%}

    <script src="{{ 'oos-notify.js' | asset_url }}" defer="defer"></script>
    {%- endif -%}
  {%- else -%}
    <div class="product-form">
      <div class="product-form__buttons form">
        <button
          type="submit"
          name="add"
          class="product-form__submit button button--full-width button--primary"
          disabled
        >
          {{ 'products.product.sold_out' | t }}
        </button>
      </div>
    </div>
  {%- endif -%}

  {%- if show_pickup_availability -%}
    {{ 'component-pickup-availability.css' | asset_url | stylesheet_tag }}

    {%- assign pick_up_availabilities = product.selected_or_first_available_variant.store_availabilities
      | where: 'pick_up_enabled', true
    -%}

    <pickup-availability
      class="product__pickup-availabilities quick-add-hidden"
      {% if product.selected_or_first_available_variant.available and pick_up_availabilities.size > 0 %}
        available
      {% endif %}
      data-root-url="{{ routes.root_url }}"
      data-variant-id="{{ product.selected_or_first_available_variant.id }}"
      data-has-only-default-variant="{{ product.has_only_default_variant }}"
      data-product-page-color-scheme="gradient color-{{ section.settings.color_scheme }}"
    >
      <template>
        <pickup-availability-preview class="pickup-availability-preview">
          <span class="svg-wrapper">
            {{- 'icon-unavailable.svg' | inline_asset_content -}}
          </span>
          <div class="pickup-availability-info">
            <p class="caption-large">{{ 'products.product.pickup_availability.unavailable' | t }}</p>
            <button class="pickup-availability-button link link--text underlined-link">
              {{ 'products.product.pickup_availability.refresh' | t }}
            </button>
          </div>
        </pickup-availability-preview>
      </template>
    </pickup-availability>

    <script src="{{ 'pickup-availability.js' | asset_url }}" defer="defer"></script>
  {%- endif -%}
</div>
