{% comment %}
  Renders product buy-buttons.
  Accepts:
  - product: {Object} product object.
  - block: {Object} passing the block information.
  - product_form_id: {String} product form id.
  - section_id: {String} id of section to which this snippet belongs.
  - show_pickup_availability: {Boolean} for the pickup availability. If true the pickup availability is rendered, false - not rendered (optional).

  Usage:
  {% render 'buy-buttons', block: block, product: product, product_form_id: product_form_id, section_id: section.id, show_pickup_availability: true %}
{% endcomment %}
<div {{ block.shopify_attributes }}>
  {%- if product != blank -%}
    {%- liquid
      # ----- Market availability (Coming Soon) -----
      # A product can be withheld from purchase in specific markets via the
      # custom.unavailable_markets metafield (list of single line text). Each entry
      # is matched, case-insensitively, against the visitor's current market HANDLE
      # (localization.market.handle) or their country code (localization.country.iso_code).
      # Spaces become hyphens so "United Kingdom" also matches the "united-kingdom" handle.
      assign is_market_unavailable = false
      assign unavailable_markets = product.metafields.custom.unavailable_markets.value
      if unavailable_markets != blank
        assign cur_market_handle = localization.market.handle | downcase | strip
        assign cur_country_code = localization.country.iso_code | downcase | strip
        for um in unavailable_markets
          assign um_key = um | downcase | strip | replace: ' ', '-'
          if um_key == cur_market_handle or um_key == cur_country_code
            assign is_market_unavailable = true
          endif
        endfor
      endif

      assign gift_card_recipient_feature_active = false
      if block.settings.show_gift_card_recipient and product.gift_card?
        assign gift_card_recipient_feature_active = true
      endif

      assign show_dynamic_checkout = false
      if block.settings.show_dynamic_checkout and gift_card_recipient_feature_active == false
        assign show_dynamic_checkout = true
      endif
    -%}

    {%- if is_market_unavailable -%}
      {%- comment -%}
        Not for sale in this market: the add-to-cart is replaced by a "Coming Soon"
        button (styled exactly like add-to-cart) that opens a popup containing the
        Klaviyo email-signup form.
      {%- endcomment -%}
      {%- assign klaviyo_form_class = block.settings.klaviyo_form_class | default: 'klaviyo-form-Ry6Yff' | strip -%}
      {%- assign coming_soon_heading = block.settings.coming_soon_heading | default: 'Coming Soon' -%}
      {%- assign cs_id = 'ComingSoon-' | append: section_id | append: '-' | append: product.id -%}
      {% style %}
        .coming-soon-modal[hidden] { display: none; }
        .coming-soon-modal {
          position: fixed;
          inset: 0;
          z-index: 1000;
          display: flex;
          align-items: center;
          justify-content: center;
          padding: 2rem;
        }
        .coming-soon-modal__overlay {
          position: absolute;
          inset: 0;
          background: rgba(0, 0, 0, 0.5);
        }
        .coming-soon-modal__dialog {
          position: relative;
          background: #fff9ef;
          color: #1a1a1a;
          width: 100%;
          max-width: 48rem;
          max-height: 90vh;
          overflow: auto;
          border-radius: 12px;
          padding: 3.6rem 2.4rem 2.4rem;
        }
        .coming-soon-modal__close {
          position: absolute;
          top: 0.8rem;
          right: 1rem;
          background: none;
          border: 0;
          font-size: 2.8rem;
          line-height: 1;
          cursor: pointer;
          color: inherit;
        }
        .coming-soon-modal__heading { margin: 0 0 0.8rem; font-size: 2rem; font-weight: 600; line-height: 1.2; }
        .coming-soon-modal__text > :first-child { margin-top: 0; }
        .coming-soon-modal__text { margin-bottom: 1.6rem; }
        /*---- waqar--css ----*/
        .klaviyo-form.klaviyo-form.klaviyo-form {
            background: transparent !important;
            padding: 0 !important;
            border: 0 !important;
        }
        .needsclick {
            padding: 0 !important;
        }
        .needsclick.kl-private-reset-css-Xuajs1 h1 {
    text-align: left !important;
    margin: 0 0 12px !important;
}
.needsclick.kl-private-reset-css-Xuajs1 h1 span {
    color: #000;
    font-size: 16px !important;
    line-height: 24px;
    letter-spacing: -.64px;
    font-family: TAY Birdie !important;
    text-transform: uppercase;
    margin: 0 !important;
    text-align: left !important;
}
.klaviyo-emailinput input {
    background: #FFFFFF !important;
    border: 1px solid #000 !important;
    border-radius: 12px !important;
    padding: 16px 28px !important;
    height: 64px !important;
    color: #000000 !important;
    font-size: 18px !important;
    line-height: 24px !important;
    letter-spacing: 0 !important;
    font-family: 'Matter' !important;
}
.klaviyo-emailinput input::placeholder {
  color: #000 !important;
  font-family: 'Matter' !important;
  letter-spacing: 0 !important;
  font-size: 18px !important;
}
.klaviyo-emailinput input::-webkit-input-placeholder {
  color: #000 !important;
  font-family: 'Matter' !important;
  letter-spacing: 0 !important;
  font-size: 18px !important;
}
.klaviyo-emailinput input::-moz-placeholder {
  color: #000 !important;
  font-family: 'Matter' !important;
  letter-spacing: 0 !important;
  font-size: 18px !important;
}

.klaviyo-form-button.go3634373664 {
    background: #000 !important;
    color: #FFF9EF !important;
    font-size: 22px !important;
    line-height: 24px !important;
    letter-spacing: 1.32px !important;
    font-family: 'FFBlurProMedium' !important;
    border: 1px solid #000;
    border-radius: 12px !important;
    margin: 12px 0 0;
        height: 63px !important;
    border: 1px solid #000 !important;
}
.klaviyo-form-button.go3634373664:hover {
  background:transparent !important;
  color:#000 !important;
  transition: all .25s ease;
}
.klaviyo-form-button.go4033861592.go488503511 {
    height: auto !important;
    margin: 12px 0 0;
}
@media screen and (max-width: 990px) {
.needsclick.kl-private-reset-css-Xuajs1 h1 {
    margin: 0 0 8px !important;
}
.klaviyo-emailinput input {
    border-radius: 8px !important;
    padding: 12px 16px !important;
    height: 48px !important;
    font-size: 15px !important;
    line-height: 24px !important;
    letter-spacing: 0 !important;
}
.klaviyo-emailinput input::placeholder {
  font-size: 15px !important;
}
.klaviyo-emailinput input::-webkit-input-placeholder {
  font-size: 15px !important;
}
.klaviyo-emailinput input::-moz-placeholder {
  font-size: 15px !important;
}
.klaviyo-form-button.go3634373664 {
    font-size: 18px !important;
    letter-spacing: 0.96px !important;
    border-radius: 8px !important;
    height: 54px !important;
}
}

      {% endstyle %}
      <div class="product-form product-form--coming-soon">
        {%- if block.settings.coming_soon_text != blank -%}
            <div class="coming-soon-modal__text rte">{{ block.settings.coming_soon_text }}</div>
          {%- endif -%}
          {%- if klaviyo_form_class != blank -%}
            <div class="{{ klaviyo_form_class }}"></div>
          {%- endif -%}
      </div>
    {%- else -%}
    <product-form
      class="product-form"
      data-hide-errors="{{ gift_card_recipient_feature_active }}"
      data-section-id="{{ section.id }}"
    >
      <div class="product-form__error-message-wrapper" role="alert" hidden>
        <span class="svg-wrapper">
          {{- 'icon-error.svg' | inline_asset_content -}}
        </span>
        <span class="product-form__error-message"></span>
      </div>

      {%- form 'product',
        product,
        id: product_form_id,
        class: 'form',
        novalidate: 'novalidate',
        data-type: 'add-to-cart-form'
      -%}
        <input
          type="hidden"
          name="id"
          value="{{ product.selected_or_first_available_variant.id }}"
          {% if product.selected_or_first_available_variant.available == false
            or quantity_rule_soldout
            or product.selected_or_first_available_variant == null
          %}
            disabled
          {% endif %}
          class="product-variant-id"
        >
          <input
          type="hidden"
          name="selling_plan"
          id="selling-plan-input"
          value=""
        >
        {%- if gift_card_recipient_feature_active -%}
          {%- render 'gift-card-recipient-form', product: product, form: form, section: section -%}
        {%- endif -%}

        <div class="product-form__buttons">
          {%- liquid
            assign check_against_inventory = true
            if product.selected_or_first_available_variant.inventory_management != 'shopify' or product.selected_or_first_available_variant.inventory_policy == 'continue'
              assign check_against_inventory = false
            endif
            if product.selected_or_first_available_variant.quantity_rule.min > product.selected_or_first_available_variant.inventory_quantity and check_against_inventory
              assign quantity_rule_soldout = true
            endif
          -%}
          <button
            id="ProductSubmitButton-{{ section_id }}"
            type="submit"
            name="add"
            class="product-form__submit button button--full-width {% if show_dynamic_checkout %}button--secondary{% else %}button--primary{% endif %}"
            {% if product.selected_or_first_available_variant.available == false
              or quantity_rule_soldout
              or product.selected_or_first_available_variant == null
            %}
              disabled
            {% endif %}
          >
            <span>
              {%- if product.selected_or_first_available_variant == null -%}
                {{ 'products.product.unavailable' | t }}
              {%- elsif product.selected_or_first_available_variant.available == false or quantity_rule_soldout -%}
                {{ 'products.product.sold_out' | t }}
              {%- else -%}
                {{ 'products.product.add_to_cart' | t }}
              {%- endif -%}
            </span>
            {%- render 'loading-spinner' -%}
          </button>
          {%- if show_dynamic_checkout -%}
            {{ form | payment_button }}
          {%- endif -%}
        </div>
      {%- endform -%}
    </product-form>
    {%- endif -%}
  {%- else -%}
    <div class="product-form">
      <div class="product-form__buttons form">
        <button
          type="submit"
          name="add"
          class="product-form__submit button button--full-width button--primary"
          disabled
        >
          {{ 'products.product.sold_out' | t }}
        </button>
      </div>
    </div>
  {%- endif -%}

  {%- if show_pickup_availability -%}
    {{ 'component-pickup-availability.css' | asset_url | stylesheet_tag }}

    {%- assign pick_up_availabilities = product.selected_or_first_available_variant.store_availabilities
      | where: 'pick_up_enabled', true
    -%}

    <pickup-availability
      class="product__pickup-availabilities quick-add-hidden"
      {% if product.selected_or_first_available_variant.available and pick_up_availabilities.size > 0 %}
        available
      {% endif %}
      data-root-url="{{ routes.root_url }}"
      data-variant-id="{{ product.selected_or_first_available_variant.id }}"
      data-has-only-default-variant="{{ product.has_only_default_variant }}"
      data-product-page-color-scheme="gradient color-{{ section.settings.color_scheme }}"
    >
      <template>
        <pickup-availability-preview class="pickup-availability-preview">
          <span class="svg-wrapper">
            {{- 'icon-unavailable.svg' | inline_asset_content -}}
          </span>
          <div class="pickup-availability-info">
            <p class="caption-large">{{ 'products.product.pickup_availability.unavailable' | t }}</p>
            <button class="pickup-availability-button link link--text underlined-link">
              {{ 'products.product.pickup_availability.refresh' | t }}
            </button>
          </div>
        </pickup-availability-preview>
      </template>
    </pickup-availability>

    <script src="{{ 'pickup-availability.js' | asset_url }}" defer="defer"></script>
  {%- endif -%}
</div>
