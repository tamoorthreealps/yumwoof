<div class="yw-butcher-quality {{ custom_class }}">
  {% if block.settings.seal_image != blank %}
    <div class="yw-butcher-quality__image">
      {{
        block.settings.seal_image
        | image_url: width: 220
        | image_tag: loading: 'lazy', widths: '110,220', alt: 'Butcher quality seal'
      }}
    </div>
  {% endif %}

  <div class="yw-butcher-quality__content">
    {% if block.settings.bq_heading != blank %}
      <h3 class="yw-butcher-quality__heading">
        {{ block.settings.bq_heading }}
      </h3>
    {% endif %}

    {% if block.settings.bq_description != blank %}
      <div class="yw-butcher-quality__description">
        {{ block.settings.bq_description | replace: '™', '<span class="wy-bq-trademark">™</span>' }}
      </div>
    {% endif %}
  </div>
</div>


<style>
.yw-butcher-quality {
    display: flex;
    align-items: center;
    gap: 22px;
    margin: 20px 0 0;
}

.yw-butcher-quality__image {
    flex: 0 0 128px;
}

.yw-butcher-quality__image img {
    display: block;
    width: 100%;
    height: auto;
}

.yw-butcher-quality__content {
    flex: 1;
}

.yw-butcher-quality__heading {
    margin: 0 0 8px;
    font-family: "TAY Birdie";
    font-size: 14px;
    line-height: 20px;
    letter-spacing: 2px;
    text-transform: uppercase;
    color: #661D1D;
    font-weight: 400;
}

.yw-butcher-quality__description,
.yw-butcher-quality__description p {
    margin: 0;
    font-family: 'TAY Birdie';
    font-size: 12px;
    line-height: 16px;
    letter-spacing: 0;
    color: #661D1D;
}

.butcher-quality-mobile {
    display:none;
}

@media (max-width:990px){
    .yw-butcher-quality {
        display:none;
        gap:16px;
        align-items:flex-start;
    }

    .yw-butcher-quality.butcher-quality-mobile {
        display: flex;
        flex-direction: column;
        justify-content: center;
        align-items: center;
        gap: 16px;
        margin: 48px 0;
    }

    .yw-butcher-quality__image {
        width: 128px;
        flex: auto;
    }

    .yw-butcher-quality__heading{
        font-size:13px;
        letter-spacing:1.5px;
    }

    .yw-butcher-quality__description,
    .yw-butcher-quality__description p{
        font-size:12px;
        line-height:16px;
        text-align: justify;
    }

}
</style>