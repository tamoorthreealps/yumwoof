<div
  class="yw-butcher-quality {% if block.settings.bq_bg_image_desktop != blank or block.settings.bq_bg_image_mobile != blank %} has-background-image{% endif %} {{ custom_class }}"
  style="
    --bq-bg-desktop: {{ block.settings.bq_bg_color_desktop }};
    --bq-text-desktop: {{ block.settings.bq_text_color_desktop }};
    --bq-bg-mobile: {{ block.settings.bq_bg_color_mobile }};
    --bq-text-mobile: {{ block.settings.bq_text_color_mobile }};
    {% if block.settings.bq_bg_image_desktop != blank %}
      --bq-bg-image-desktop: url('{{ block.settings.bq_bg_image_desktop | image_url: width: 2000 }}');
    {% endif %}
    {% if block.settings.bq_bg_image_mobile != blank %}
      --bq-bg-image-mobile: url('{{ block.settings.bq_bg_image_mobile | image_url: width: 1200 }}');
    {% endif %}
  "
>
  {% assign seal_image = block.settings.seal_image %}

  {% if block.settings.seal_image_mobile != blank %}
    {% if request.design_mode %}
      {% assign seal_image_mobile = block.settings.seal_image_mobile %}
    {% endif %}
  {% endif %}

  <div class="yw-butcher-quality__image">
    {% if block.settings.seal_image_mobile != blank %}
      <picture>
        <source
          media="(max-width: 990px)"
          srcset="{{ block.settings.seal_image_mobile | image_url: width: 220 }}"
        >
        {% if seal_image != blank %}
          {{
            seal_image
            | image_url: width: 220
            | image_tag: loading: 'lazy', widths: '110,220', alt: 'Butcher quality seal'
          }}
        {% endif %}
      </picture>
    {% elsif seal_image != blank %}
      {{
        seal_image
        | image_url: width: 220
        | image_tag: loading: 'lazy', widths: '110,220', alt: 'Butcher quality seal'
      }}
    {% endif %}
  </div>

  <div class="yw-butcher-quality__content">
    {% if block.settings.bq_heading != blank %}
      <h3 class="yw-butcher-quality__heading">
        {{ block.settings.bq_heading }}
      </h3>
    {% endif %}

    {% if block.settings.bq_description != blank %}
      <div class="yw-butcher-quality__description">
        {{ block.settings.bq_description | replace: '™', '<span class="wy-bq-trademark">™</span>' }}
      </div>
    {% endif %}
  </div>
</div>


<style>
.yw-butcher-quality {
    display: flex;
    align-items: center;
    gap: 22px;
    margin: 20px 0 0;

    background-color: var(--bq-bg-desktop);
    background-image: var(--bq-bg-image-desktop);
    background-size: cover;
    background-position: center;
    background-repeat: no-repeat;

    color: var(--bq-text-desktop);
}

.yw-butcher-quality__image {
    flex: 0 0 128px;
}

.yw-butcher-quality__image img {
    display: block;
    width: 100%;
    height: auto;
}

.yw-butcher-quality__content {
    flex: 1;
}

.yw-butcher-quality__heading {
    margin: 0 0 8px;
    font-family: "TAY Birdie";
    font-size: 14px;
    line-height: 20px;
    letter-spacing: 2px;
    text-transform: uppercase;
    color: var(--bq-text-desktop);
    font-weight: 400;
}

.yw-butcher-quality__description,
.yw-butcher-quality__description p {
    margin: 0;
    font-family: "TAY Birdie";
    font-size: 12px;
    line-height: 16px;
    letter-spacing: 0;
    color: var(--bq-text-desktop);
}

.wy-bq-trademark {
    font-family: Arial, sans-serif;
    font-size: 0.8em;
    position: relative;
    top: -1px;
}

.butcher-quality-mobile {
    display: none;
}

.yw-butcher-quality.has-background-image .yw-butcher-quality {
  margin:2.4rem 0 0;
}

.yw-butcher-quality.has-background-image .yw-butcher-quality__description,
.yw-butcher-quality.has-background-image .yw-butcher-quality__description p {
      font-size: 14px;
      text-align: justify;
  }

@media (max-width: 990px) {
  .yw-butcher-quality {
    display: none;
    gap: 16px;
    align-items: flex-start;
    background-color: var(--bq-bg-mobile);
    background-image: var(--bq-bg-image-mobile);
    background-size: 100% 100%;
    background-position: center;
    background-repeat: no-repeat;
    color: var(--bq-text-mobile);
  }

  .yw-butcher-quality.butcher-quality-mobile {
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    gap: 16px;
    margin: 48px 0;
  }

  .yw-butcher-quality__image {
    width: 128px;
    flex: auto;
  }

  .yw-butcher-quality__heading {
    font-size: 13px;
    letter-spacing: 1.5px;
    color: var(--bq-text-mobile);
  }

  .yw-butcher-quality__description,
  .yw-butcher-quality__description p {
    font-size: 12px;
    line-height: 16px;
    text-align: justify;
    color: var(--bq-text-mobile);
  }

  .yw-butcher-quality.has-background-image.butcher-quality-mobile {
    width: calc(100% + 48px);
    margin: 40px -24px 0;
    padding: 35px 26px;
    gap: 15px;
    transition: none;
  }

  .yw-butcher-quality.has-background-image.butcher-quality-mobile.bq-animate {
    width: 100%;
    margin-left: 0;
    margin-right: 0;
  }

  .yw-butcher-quality.has-background-image.butcher-quality-mobile
    .yw-butcher-quality__image {
    width: 166px;
    animation: bqLogoFloat 2.8s ease-in-out infinite;
    will-change: transform;
  }

  .yw-butcher-quality.has-background-image.butcher-quality-mobile
    .yw-butcher-quality__description,
  .yw-butcher-quality.has-background-image.butcher-quality-mobile
    .yw-butcher-quality__description p {
    font-size: 13px;
  }

  .yw-butcher-quality.has-background-image.butcher-quality-mobile
    .yw-butcher-quality__description {
    overflow: hidden;
  }

  .yw-butcher-quality.has-background-image.butcher-quality-mobile
    .yw-butcher-quality__description:not(.bq-typing)
    > * {
    visibility: hidden;
  }

  .yw-butcher-quality.has-background-image.butcher-quality-mobile
    .bq-char {
    visibility: hidden;
  }

  .yw-butcher-quality.has-background-image.butcher-quality-mobile
    .bq-char.bq-char-visible {
    visibility: visible;
  }

  .yw-butcher-quality.has-background-image.butcher-quality-mobile
    .wy-bq-trademark {
    display: none;
  }

  @keyframes bqLogoFloat {
    0%,
    100% {
      transform: translateY(0);
    }

    50% {
      transform: translateY(-6px);
    }
  }
}
</style>


<script>
  document.addEventListener('DOMContentLoaded', function () {
    var sections = document.querySelectorAll(
      '.yw-butcher-quality.has-background-image.butcher-quality-mobile'
    );

    if (!sections.length) return;

    sections.forEach(function (section) {
      var description = section.querySelector('.yw-butcher-quality__description');

      if (!description) return;

      var walker = document.createTreeWalker(
        description,
        NodeFilter.SHOW_TEXT,
        {
          acceptNode: function (node) {
            return node.textContent.trim()
              ? NodeFilter.FILTER_ACCEPT
              : NodeFilter.FILTER_REJECT;
          }
        }
      );

      var textNodes = [];
      var node;

      while ((node = walker.nextNode())) {
        textNodes.push(node);
      }

      var chars = [];

      textNodes.forEach(function (textNode) {
        var fragment = document.createDocumentFragment();

        Array.from(textNode.textContent).forEach(function (char) {
          var span = document.createElement('span');

          span.className = 'bq-char';
          span.textContent = char;

          fragment.appendChild(span);
          chars.push(span);
        });

        textNode.parentNode.replaceChild(fragment, textNode);
      });

      var typingTimers = [];

      var resetAnimation = function () {
        typingTimers.forEach(function (timer) {
          clearTimeout(timer);
        });

        typingTimers = [];

        section.classList.remove('bq-animate');
        description.classList.remove('bq-typing');

        chars.forEach(function (char) {
          char.classList.remove('bq-char-visible');
        });
      };

      var playAnimation = function () {
        resetAnimation();

        requestAnimationFrame(function () {
          section.classList.add('bq-animate');
          description.classList.add('bq-typing');

          chars.forEach(function (char, index) {
            var timer = setTimeout(function () {
              char.classList.add('bq-char-visible');
            }, index * 28);

            typingTimers.push(timer);
          });
        });
      };

      var sectionObserver = new IntersectionObserver(
        function (entries) {
          entries.forEach(function (entry) {
            if (entry.isIntersecting) {
              playAnimation();
            } else {
              resetAnimation();
            }
          });
        },
        {
          threshold: 0.15
        }
      );

      sectionObserver.observe(section);

      var updateWidth = function () {
        var rect = section.getBoundingClientRect();
        var viewportHeight = window.innerHeight;

        var start = viewportHeight;
        var end = viewportHeight * 0.45;

        var progress = (start - rect.top) / (start - end);

        progress = Math.max(0, Math.min(1, progress));

        var sideSpace = 24 * progress;

        section.style.width = 'calc(100% + ' + (48 - sideSpace * 2) + 'px)';
        section.style.marginLeft = '-' + (24 - sideSpace) + 'px';
        section.style.marginRight = '-' + (24 - sideSpace) + 'px';
      };

      var ticking = false;

      var onScroll = function () {
        if (ticking) return;

        ticking = true;

        requestAnimationFrame(function () {
          updateWidth();
          ticking = false;
        });
      };

      window.addEventListener('scroll', onScroll, { passive: true });
      window.addEventListener('resize', updateWidth);

      updateWidth();
    });
  });
</script>