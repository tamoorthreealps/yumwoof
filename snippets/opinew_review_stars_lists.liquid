<style>
  .yw-pcard-opinew-stars .opinew-no-reviews-stars-plugin {display:none;}
  .yw-pcard-opinew-stars .rating-wrap {
    display: flex;
    align-items: center;
    gap: 8px;
}
.yw-pcard-opinew-stars .opinew-star-plugin-inside {
    display: flex;
    align-items: center;
    gap: 4px;
}
.yw-pcard-opinew-stars .rating-summary {
    font-size: 14px;
    line-height: 16px;
    letter-spacing: 0;
    color: #000;
    font-family: 'Matter';
    margin: 1px 0 0;
}


@media screen and (max-width: 990px) {
.yw-pcard-opinew-stars .opinew-star-plugin-inside {
    gap: 2px;
}
.yw-pcard-opinew-stars .rating-wrap {
    gap: 6px;
}

.yw-pcard-opinew-stars .opw-noci:before {
    width: 12px;
    height: 12px;
}
}
</style>

{%- liquid
  assign rating = product.metafields.opinew_metafields.reviews_average
  assign rating_count = product.metafields.opinew_metafields.reviews_count | plus: 0
-%}

{% if product.metafields.opinew_metafields.stars_lists != blank %}
  <span class="rating-wrap">
    {{ product.metafields.opinew_metafields.stars_lists }}

    {% if rating_count > 0 %}
      <span class="rating-summary">
        {{ rating | times: 1.0 | round: 1 }} ({{ rating_count }})
      </span>
    {% endif %}
  </span>
{% endif %}