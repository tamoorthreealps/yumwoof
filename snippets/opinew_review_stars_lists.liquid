<style>
  .yw-pcard-opinew-stars .opinew-no-reviews-stars-plugin {display:none;}
  span.rating-wrap {
    display: flex;
    align-items: center;
    gap: 8px;
}
span.opinew-star-plugin-inside {
    display: flex;
    align-items: center;
    gap: 4px;
}
</style>

{%- liquid
  assign rating = product.metafields.opinew_metafields.reviews_average
  assign rating_count = product.metafields.opinew_metafields.reviews_count | plus: 0
-%}

{% if product.metafields.opinew_metafields.stars_lists != blank %}
  <span class="rating-wrap">
    {{ product.metafields.opinew_metafields.stars_lists }}

    {% if rating_count > 0 %}
      <span class="rating-summary">
        {{ rating | times: 1.0 | round: 1 }} ({{ rating_count }})
      </span>
    {% endif %}
  </span>
{% endif %}