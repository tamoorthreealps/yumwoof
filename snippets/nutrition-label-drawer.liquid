{% comment %}
  Nutrition label — drawer/popup (PDP)  [redesign]
  ---------------------------------------------------------------------------
  Each launcher button opens this popup showing ONE table (no in-popup tabs):
    analysis / full  -> per variant (custom.nutrition_label)
    feeding          -> product custom.feeding_table   (cups/kg/grams computed in JS)
    transition       -> product custom.transition_plan

  The header band takes the SELECTED recipe's colour (custom.nutrition_label →
  header_color; falls back to a coral/blue/gold palette by variant order).

  Metaobject field API keys used:
    nutrition_label : guaranteed_analysis, guaranteed_analysis_footnote,
                      kcal_per_kg, kcal_per_cup, full_data, header_color (NEW, color)
    transition_plan : intro, steps, note_title, note

  Accepts: product, section_id, brand_label
{% endcomment %}

{%- liquid
  assign brand = brand_label | default: 'Ancestral Blend'
  assign tp = product.metafields.custom.transition_plan.value
  assign ft = product.metafields.custom.feeding_table.value
  assign gpc = product.metafields.custom.feeding_grams_per_cup | default: 160
  assign all_recipes_eyebrow = brand | append: ' · All Recipes'
  assign palette = '#E1523D,#83A6D6,#C6912F' | split: ','
  assign dial25 = 'https://cdn.shopify.com/s/files/1/0317/2827/1419/files/Ratio_Dial_25.png?v=1785701384'
  assign dial50 = 'https://cdn.shopify.com/s/files/1/0317/2827/1419/files/Ratio_Dial_50.png?v=1785701384'
  assign dial75 = 'https://cdn.shopify.com/s/files/1/0317/2827/1419/files/Ratio_Dial_75.png?v=1785701384'
  assign dial100 = 'https://cdn.shopify.com/s/files/1/0317/2827/1419/files/Ratio_Dial_100.png?v=1785701384'
-%}

<div class="nldrawer" data-nldrawer hidden>
  <div class="nldrawer__scrim" data-nldrawer-close></div>

  <div
    class="nldrawer__card"
    role="dialog"
    aria-modal="true"
    aria-labelledby="nldrawer-title-{{ section_id }}"
    tabindex="-1"
  >
    <div class="nldrawer__head" data-nldrawer-head>
      <div class="nldrawer__head-text">
        <p class="nldrawer__title" id="nldrawer-title-{{ section_id }}" data-nldrawer-heading></p>
        <p class="nldrawer__eyebrow" data-nldrawer-eyebrow></p>
      </div>
      <button type="button" class="nldrawer__close" data-nldrawer-close aria-label="Close">{ X }</button>
    </div>

    <div class="nldrawer__body" data-nldrawer-body>
      {%- comment -%} ---------- per-variant panels ---------- {%- endcomment -%}
      {%- assign vi = 0 -%}
      {%- for variant in product.variants -%}
        {%- assign nl = variant.metafields.custom.nutrition_label.value -%}
        {%- if nl -%}
          {%- assign recipe = variant.title -%}
          {%- if recipe == 'Default Title' -%}{%- assign recipe = product.title -%}{%- endif -%}
          {%- assign palette_idx = vi | modulo: 3 -%}
          {%- assign vcolor = nl.header_color | default: palette[palette_idx] -%}
          {%- assign vi = vi | plus: 1 -%}
          <div class="nldrawer__variant"
            data-nldrawer-variant="{{ variant.id }}"
            data-color="{{ vcolor }}"
            data-eyebrow="{{ recipe | append: ' Recipe' | escape }}"
            hidden>

            {%- comment -%} Guaranteed Analysis (+ calorie content) {%- endcomment -%}
            <section class="nldrawer__panel" data-nldrawer-panel="analysis" data-title="Guaranteed Analysis" hidden>
              {%- assign ga_rows = nl.guaranteed_analysis | strip | newline_to_br | strip_newlines | split: '<br />' -%}
              <div class="nldrawer__ga">
                {%- for line in ga_rows -%}
                  {%- assign row = line | strip -%}
                  {%- if row == blank -%}{%- continue -%}{%- endif -%}
                  {%- assign c = row | split: '|' -%}
                  <div class="nldrawer__ga-row">
                    <span class="nldrawer__ga-label">
                      <span class="nldrawer__ga-name">{{ c[0] | strip }}</span>
                      <span class="nldrawer__ga-qual">{{ c[1] | strip }}</span>
                    </span>
                    <span class="nldrawer__ga-val">{{ c[3] | strip }}</span>
                  </div>
                {%- endfor -%}
              </div>

              <div class="nldrawer__calorie">
                <p class="nldrawer__calorie-title">Calorie content:</p>
                {%- assign kk = nl.kcal_per_kg | append: '' -%}
                {%- if kk.size == 4 -%}
                  {%- assign kk_first = kk | slice: 0 -%}
                  {%- assign kk_rest = kk | slice: 1, 3 -%}
                  {%- assign kk = kk_first | append: ',' | append: kk_rest -%}
                {%- endif -%}
                <p class="nldrawer__calorie-line">ME= {{ kk }} kcal/kg, {{ nl.kcal_per_cup }} kcal/cup</p>
              </div>

              {%- if nl.guaranteed_analysis_footnote != blank -%}
                <p class="nldrawer__foot">{{ nl.guaranteed_analysis_footnote }}</p>
              {%- endif -%}
            </section>

            {%- comment -%} Full Nutritional Data {%- endcomment -%}
            <section class="nldrawer__panel" data-nldrawer-panel="full" data-title="Full Nutritional Data" hidden>
              {%- assign fd_rows = nl.full_data | strip | newline_to_br | strip_newlines | split: '<br />' -%}
              {%- assign open = false -%}
              {%- for line in fd_rows -%}
                {%- assign row = line | strip -%}
                {%- if row == blank -%}{%- continue -%}{%- endif -%}
                {%- assign first = row | slice: 0 -%}
                {%- if first == '#' -%}
                  {%- if open -%}</div>{%- endif -%}
                  <p class="nldrawer__section">{{ row | remove_first: '#' | strip }}</p>
                  <div class="nldrawer__full">
                  {%- assign open = true -%}
                {%- else -%}
                  {%- assign c = row | split: '|' -%}
                  <div class="nldrawer__full-row">
                    <span class="nldrawer__full-name">{{ c[0] | strip }}</span>
                    <span class="nldrawer__full-val">{{ c[1] | strip }}</span>
                  </div>
                {%- endif -%}
              {%- endfor -%}
              {%- if open -%}</div>{%- endif -%}
            </section>

          </div>
        {%- endif -%}
      {%- endfor -%}

      {%- comment -%} ---------- shared: Feeding (JS-computed) ---------- {%- endcomment -%}
      {%- if ft -%}
        <section class="nldrawer__panel nldrawer__panel--shared" data-nldrawer-panel="feeding"
          data-title="Feeding Guidelines" data-eyebrow="{{ all_recipes_eyebrow | escape }}" hidden>
          <div class="nldrawer__feed">
            <div class="nldrawer__feed-head">
              <span>Dog Weight</span>
              <span class="nldrawer__ta-r">Daily Serving</span>
            </div>
            <div class="nldrawer__feed-rows" data-nldrawer-feeding-rows></div>
          </div>

          <div class="nldrawer__2x">
            <svg class="nldrawer__2x-cup" xmlns="http://www.w3.org/2000/svg" width="46" height="36" viewBox="53 -1 46 36" fill="none" aria-hidden="true">
              <path d="M89.596 13.842C88.6397 13.842 87.8109 14.5182 87.6197 15.4691L84.8995 29.606C84.7507 30.3245 84.262 31.212 83.5394 31.9305C82.8169 32.649 81.9881 33.0716 81.223 33.0716L62.3944 33.1984C60.4605 32.7335 58.8029 31.3599 58.3779 29.5004L58.3354 29.3102L55.0627 10.7146C54.9352 9.93269 55.509 9.23535 56.3165 9.23535H91.2749C94.5901 9.23535 97.289 11.919 97.289 15.2155V21.9987C97.289 23.3511 96.1839 24.45 94.8239 24.45C93.4638 24.45 92.3587 23.3511 92.3587 21.9987V16.6102C92.3587 15.0888 91.1261 13.8631 89.596 13.8631V13.842Z" stroke="#2D2926" stroke-width="0.75" stroke-miterlimit="10"/>
              <path d="M54.9348 7.54454C54.8711 7.31209 54.8711 7.01625 54.8711 6.78381C54.8711 4.67067 56.2949 3.00128 58.1013 3.00128C58.6963 3.00128 59.2701 3.23373 59.7801 3.61409C60.0989 3.84654 60.5027 3.90993 60.8215 3.76201C61.1402 3.61409 61.459 3.38165 61.5865 2.93789C62.0965 1.58548 63.2654 0.740223 64.4979 0.740223C65.3905 0.740223 66.2405 1.18398 66.8993 1.94471C67.1543 2.32508 67.5369 2.473 67.9406 2.38847C68.3444 2.30395 68.7057 2.09263 68.9182 1.71227C69.5132 0.592303 70.5333 -0.0205078 71.6384 -0.0205078C72.7434 -0.0205078 73.7848 0.655697 74.3585 1.71227C74.5498 2.09263 74.9536 2.32508 75.3361 2.38847C75.7186 2.38847 76.1011 2.24055 76.3774 1.94471C77.0149 1.18398 77.865 0.740223 78.7788 0.740223C80.0114 0.740223 81.1802 1.56435 81.6902 2.93789C81.8177 3.31825 82.1365 3.61409 82.4553 3.76201C82.774 3.90993 83.1778 3.84654 83.4966 3.61409C84.0066 3.23373 84.6017 3.00128 85.1754 3.00128C86.9818 3.00128 88.4056 4.67067 88.4056 6.78381C88.4056 7.01625 88.4056 7.31209 88.3419 7.54454H54.9136H54.9348Z" fill="#2D2926"/>
            </svg>
            <p class="nldrawer__2x-line1">Up to <b>2x</b> calories per cup</p>
            <p class="nldrawer__2x-line2">vs. dry kibble †</p>
          </div>

          <p class="nldrawer__feed-note">Our food is calorie-dense, so you may feed less compared to other food. These suggested daily servings are only guidelines. Individual requirements may vary depending on age, breed, weight, activity level and metabolism. Puppies require more calories, so serve 2x more than the amounts shown. Senior dogs may require fewer calories. Pregnant or nursing dogs may require free feeding. Please consult your veterinarian.</p>

          <script type="application/json" data-nldrawer-feeding-config>
            {
              "gramsPerCup": {{ gpc | times: 1.0 }},
              "weights": [10, 20, 30, 40, 60, 80, 100],
              "bands": [
                {%- for band in ft.title_bands.value -%}
                  {
                    "minW": {{ band.min_weight_lb | times: 1.0 }},
                    "maxW": {{ band.max_weight_lb | times: 1.0 }},
                    "minC": {{ band.min_cups | times: 1.0 }},
                    "maxC": {{ band.max_cups | times: 1.0 }}
                  }{%- unless forloop.last -%},{%- endunless -%}
                {%- endfor -%}
              ]
            }
          </script>
        </section>
      {%- endif -%}

      {%- comment -%} ---------- shared: Transition ---------- {%- endcomment -%}
      {%- if tp -%}
        <section class="nldrawer__panel nldrawer__panel--shared" data-nldrawer-panel="transition"
          data-title="How to Transition" data-eyebrow="{{ all_recipes_eyebrow | escape }}" hidden>
          {%- if tp.intro != blank -%}
            <p class="nldrawer__prose">{{ tp.intro }}</p>
          {%- endif -%}

          {%- assign step_rows = tp.steps | strip | newline_to_br | strip_newlines | split: '<br />' -%}
          <div class="nldrawer__steps">
            {%- for line in step_rows -%}
              {%- assign row = line | strip -%}
              {%- if row == blank -%}{%- continue -%}{%- endif -%}
              {%- assign c = row | split: '|' -%}
              {%- assign step_label = c[0] | strip -%}
              {%- assign step_val = c[1] | strip -%}
              {%- assign pct = step_val | split: '%' | first | strip -%}
              {%- if pct == '25' -%}{%- assign dial = dial25 -%}
              {%- elsif pct == '50' -%}{%- assign dial = dial50 -%}
              {%- elsif pct == '75' -%}{%- assign dial = dial75 -%}
              {%- else -%}{%- assign dial = dial100 -%}{%- endif -%}
              {%- assign parts = step_val | split: ' · ' -%}
              <div class="nldrawer__step">
                <img class="nldrawer__dial" src="{{ dial }}" width="56" height="56" loading="lazy" alt="">
                <div class="nldrawer__step-text">
                  <span class="nldrawer__step-label">{{ step_label }}</span>
                  <span class="nldrawer__step-val">
                    <b>{{ parts[0] | strip }}</b>
                    {%- if parts.size > 1 -%}
                      <span class="nldrawer__step-muted"> · {{ parts[1] | strip }}</span>
                    {%- endif -%}
                  </span>
                </div>
              </div>
            {%- endfor -%}
          </div>

          {%- if tp.note != blank -%}
            <div class="nldrawer__callout">
              {%- if tp.note_title != blank -%}
                <p class="nldrawer__callout-label">{{ tp.note_title }}</p>
              {%- endif -%}
              <p class="nldrawer__callout-body">{{ tp.note }}</p>
            </div>
          {%- endif -%}
        </section>
      {%- endif -%}
    </div>
  </div>
</div>
