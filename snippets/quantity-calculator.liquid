{% comment %}
  Quantity calculator (PDP)
  ---------------------------------------------------------------------------
  Renders the "Not sure how much to order?" CTA + a guided quiz that sizes the
  order to the shopper's dog(s), using the product's feeding table metaobject
  (product.metafields.custom.feeding_table).

  - Only renders when the product has a feeding table (metafield gating).
  - Dogs are saved in localStorage and persist until removed; a shopper can add
    multiple dogs and the suggested quantity covers all of them.
  - The suggestion is recalculated from the SELECTED variant's bag size.

  Accepts:
  - product    : {Object} product
  - section_id : {String} the main-product section id (to sync the qty input)
{% endcomment %}

{%- assign ft = product.metafields.custom.feeding_table.value -%}

{%- if ft -%}
  {{ 'css--quantity-calculator.css' | asset_url | stylesheet_tag }}

  <quantity-calculator
    class="qcalc"
    data-section="{{ section_id }}"
    data-product="{{ product.id }}"
  >
    <script type="application/json" data-qcalc-config>
      {
        "cadenceDays": 28,
        {%- comment -%} number_decimal metaobject fields are strings; times:1.0 emits real JSON numbers {%- endcomment -%}
        "table": {
          "cupsPerBag": {{ ft.cups_per_bag | times: 1.0 }},
          "fullBagOz": {{ ft.full_bag_weight_oz | times: 1.0 }},
          "trialBagOz": {{ ft.trial_bag_weight_oz | times: 1.0 }},
          "bands": [
            {%- for band in ft.title_bands.value -%}
              {
                "minW": {{ band.min_weight_lb | times: 1.0 }},
                "maxW": {{ band.max_weight_lb | times: 1.0 }},
                "minC": {{ band.min_cups | times: 1.0 }},
                "maxC": {{ band.max_cups | times: 1.0 }}
              }{%- unless forloop.last -%},{%- endunless -%}
            {%- endfor -%}
          ]
        },
        "variants": [
          {%- for v in product.variants -%}
            {
              "id": {{ v.id | json }},
              "title": {{ v.title | json }},
              "available": {{ v.available | json }}
            }{%- unless forloop.last -%},{%- endunless -%}
          {%- endfor -%}
        ],
        "selectedVariantId": {{ product.selected_or_first_available_variant.id | json }}
      }
    </script>

    {%- comment -%} JS fills this with the CTA button or the saved-dogs summary. {%- endcomment -%}
    <div class="qcalc__slot" data-qcalc-slot></div>

    {%- comment -%} Quiz modal {%- endcomment -%}
    <div class="qz-scrim" data-qz-scrim hidden>
      <div class="qz-modal" role="dialog" aria-modal="true" aria-label="Order size quiz">
        <div class="qz-head">
          <button class="qz-back" type="button" data-qz-back hidden>&larr; Back</button>
          <div class="qz-dots" data-qz-dots aria-hidden="true"></div>
          <button class="qz-close" type="button" data-qz-close aria-label="Close">&times;</button>
        </div>
        <div class="qz-body" data-qz-body></div>
      </div>
    </div>
  </quantity-calculator>

  <script src="{{ 'quantity-calculator.js' | asset_url }}" defer="defer"></script>
{%- endif -%}
