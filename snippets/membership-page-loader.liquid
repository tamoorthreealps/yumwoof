<script>
(function(){
  var loader=document.getElementById('yw-membership-loader');
  var percent=document.getElementById('yw-membership-loader__percent');
  var fill=document.getElementById('yw-membership-loader__progress-fill');
  if(!loader||!percent||!fill)return;

  var reduced=window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  var ready=document.readyState==='complete';
  var finished=false;

  document.documentElement.classList.add('yw-membership-loading');
  document.body.classList.add('yw-membership-loading');

  window.addEventListener('load',function(){ ready=true; },{once:true});

  // The meter is the last element to rise in; when it lands, settle the entrance.
  function settleEntrance(){ loader.classList.add('is-entered'); }
  percent.addEventListener('animationend',settleEntrance,{once:true});
  setTimeout(settleEntrance,2200); // fallback if animationend never fires

  /* Count pacing from the client reference: a 1s beat for the logo to land, then an
     unhurried count with natural pauses up to 93%, a wait for the page to finish loading
     (capped so a slow page never traps anyone), then a short glide to 100%. */
  var START_DELAY=reduced?0:1000;
  var COUNT_MS=reduced?300:4100; // full scripted count
  var MAX_WAIT=8000;             // cap on waiting for window load
  var HOLD_AT=93;
  var KEYS=[[0,0],[.19,22],[.30,38],[.46,41],[.62,68],[.73,74],[.89,89],[1,HOLD_AT]];

  // Exit timings after 100% (keep in sync with the CSS vars above)
  var HOLD_MS=1100; // "Please, come in." crossfades in and reads before the exit
  var SEAM_MS=800;  // content fades + seam draws (700ms) + a beat
  var DOOR_MS=1400; // --ywl-door-ms

  function ease(t){ return t<.5 ? 2*t*t : 1-Math.pow(-2*t+2,2)/2; }

  function curve(f){
    for(var i=1;i<KEYS.length;i++){
      if(f<=KEYS[i][0]){
        var a=KEYS[i-1],b=KEYS[i];
        return a[1]+(b[1]-a[1])*ease((f-a[0])/(b[0]-a[0]));
      }
    }
    return HOLD_AT;
  }

  function setProgress(value){
    value=Math.min(100,Math.max(0,Math.round(value)));
    percent.textContent=value+'%';
    fill.style.width=value+'%';
  }

  function unlockPage(){
    document.documentElement.classList.remove('yw-membership-loading');
    document.body.classList.remove('yw-membership-loading');
  }

  function finish(){
    if(finished)return;
    finished=true;
    setProgress(100);
    loader.classList.add('is-done'); // subline crossfade

    // Reduced motion: the original simple fade, no doors.
    if(reduced){
      setTimeout(function(){
        loader.classList.add('is-complete');
        unlockPage();
        setTimeout(function(){ loader.remove(); },900);
      },300);
      return;
    }

    setTimeout(function(){ loader.classList.add('is-seam'); },HOLD_MS);
    setTimeout(function(){
      loader.classList.add('is-open');
      unlockPage(); // page scrolls/clicks as soon as the doors start to part
    },HOLD_MS+SEAM_MS);
    setTimeout(function(){ loader.remove(); },HOLD_MS+SEAM_MS+DOOR_MS+100);
  }

  var PHASE1=COUNT_MS*.9, PHASE3=COUNT_MS*.1;
  var t0=null, phase=1, t3=null;

  function tick(now){
    if(finished)return;
    if(t0===null)t0=now;
    var ms=now-t0;

    if(phase===1){
      var f=ms/PHASE1;
      if(f>=1){ setProgress(HOLD_AT); phase=2; }
      else setProgress(curve(f));
    }
    if(phase===2&&(ready||ms>MAX_WAIT)){ phase=3; t3=now; }
    if(phase===3){
      var f3=Math.min((now-t3)/PHASE3,1);
      setProgress(HOLD_AT+(100-HOLD_AT)*ease(f3));
      if(f3>=1){ finish(); return; }
    }
    requestAnimationFrame(tick);
  }

  setTimeout(function(){ requestAnimationFrame(tick); },START_DELAY);
})();
</script>
