{%- comment -%}
  Yum Club membership loader — refined to Figma:
    desktop 8732:1560 (1512 × 816), mobile 8732:1196 (loading) + 8732:1549 (100%).
  Motion follows the client's reference loader: staggered entrance, paced count with
  pauses (holds at 93% until the page has loaded, capped at 8s), subline crossfade at
  100%, then seam + door reveal. Design (colours, type, sizes, spacing) is our Figma
  build. Page lock and reduced-motion fade are kept.
{%- endcomment -%}

<style>
html.yw-membership-loading,body.yw-membership-loading{overflow:hidden!important}

#yw-membership-loader{position:fixed;inset:0;z-index:999999;display:flex;align-items:center;justify-content:center;width:100%;height:100dvh;background:#661d1d;color:#fff9ef;overflow:hidden;opacity:1;visibility:visible;pointer-events:all;transition:opacity .8s cubic-bezier(.22,1,.36,1),visibility 0s linear 0s}
#yw-membership-loader.is-complete{opacity:0;visibility:hidden;pointer-events:none;transition:opacity .8s cubic-bezier(.22,1,.36,1),visibility 0s linear .8s}

/* Desktop — Figma group 294: 340 × 328, centred in the frame */
#yw-membership-loader__inner{display:flex;flex-direction:column;align-items:center;justify-content:center;width:min(340px,calc(100% - 48px));text-align:center;transform:translateY(0);transition:transform .8s cubic-bezier(.22,1,.36,1)}
#yw-membership-loader.is-complete #yw-membership-loader__inner{transform:translateY(-30px)}

/* ---------- Door-reveal exit (timing/easing from the client reference) ----------
   At rest the two doors sit edge to edge over the same #661d1d, so the loader looks
   exactly as before. Sequence, driven by JS: .is-seam (content fades, centre seam draws)
   -> .is-open (doors slide apart, page revealed). Transform/opacity only. */
#yw-membership-loader{--ywl-door-ms:1400ms;--ywl-seam-ms:700ms;--ywl-ease-door:cubic-bezier(.77,0,.18,1);--ywl-ease-seam:cubic-bezier(.65,0,.35,1);--ywl-seam-color:rgba(255,249,239,.45)}
.yw-membership-loader__door{position:absolute;top:0;bottom:0;width:50%;background:#661d1d;transition:transform var(--ywl-door-ms) var(--ywl-ease-door);z-index:0;pointer-events:none}
/* Promote the doors to their own layer only once the exit begins (a step before they move),
   so the resting loader renders exactly as before. */
#yw-membership-loader.is-seam .yw-membership-loader__door{will-change:transform}
.yw-membership-loader__door--left{left:0}
.yw-membership-loader__door--right{left:50%}
.yw-membership-loader__door::after{content:"";position:absolute;top:0;bottom:0;width:1px;background:var(--ywl-seam-color);transform:scaleY(0);transform-origin:top;transition:transform var(--ywl-seam-ms) var(--ywl-ease-seam)}
.yw-membership-loader__door--left::after{right:0}
.yw-membership-loader__door--right::after{left:0}
#yw-membership-loader__inner{position:relative;z-index:1}
#yw-membership-loader.is-seam #yw-membership-loader__inner{opacity:0;transition:opacity .5s ease,transform .8s cubic-bezier(.22,1,.36,1)}
#yw-membership-loader.is-seam .yw-membership-loader__door::after{transform:scaleY(1)}
/* The root keeps its own background until the doors move, so no hairline can ever
   show between the halves at rest; from here on the doors alone carry the colour. */
#yw-membership-loader.is-open{background:transparent;pointer-events:none}
#yw-membership-loader.is-open .yw-membership-loader__door--left{transform:translate3d(-100%,0,0)}
#yw-membership-loader.is-open .yw-membership-loader__door--right{transform:translate3d(100%,0,0)}

/* ---------- Entrance + text swap (motion from the client reference, our design) ----------
   Logo, heading, subline and meter rise in on staggered delays; at 100% the subline
   crossfades (old line lifts out, new line rises in). */
@keyframes ywl-rise{to{opacity:1;transform:none}}
#yw-membership-loader__logo{opacity:0;transform:translateY(6px);animation:ywl-rise 1s ease .15s forwards}
#yw-membership-loader__text{opacity:0;animation:ywl-rise .9s ease .5s forwards}
#yw-membership-loader__subtext{opacity:0;animation:ywl-rise .9s ease .7s forwards}
#yw-membership-loader__progress,#yw-membership-loader__percent{opacity:0;animation:ywl-rise .9s ease .9s forwards}
.yw-membership-loader__sub-b{opacity:0;transform:translateY(6px)}
#yw-membership-loader.is-done .yw-membership-loader__sub-a{opacity:0;transform:translateY(-6px)}
#yw-membership-loader.is-done .yw-membership-loader__sub-b{opacity:1;transform:none}
/* Once the entrance has played, drop the finished animations so the text renders on the
   normal layer again (filled animations keep elements GPU-promoted, which softens text). */
#yw-membership-loader.is-entered #yw-membership-loader__logo,#yw-membership-loader.is-entered #yw-membership-loader__text,#yw-membership-loader.is-entered #yw-membership-loader__subtext,#yw-membership-loader.is-entered #yw-membership-loader__progress,#yw-membership-loader.is-entered #yw-membership-loader__percent{animation:none;opacity:1;transform:none}

#yw-membership-loader__logo{display:block;width:198px;max-width:60vw;height:auto;color:currentColor;margin:0 0 32px}

#yw-membership-loader__copy{display:flex;flex-direction:column;align-items:center;gap:12px;width:100%;margin:0 0 32px}
#yw-membership-loader__text{margin:0;font-family:'TAY Birdie','TAYBirdie','TAY-Birdie',sans-serif;font-size:32px;line-height:32px;font-weight:400;letter-spacing:0;text-transform:uppercase;white-space:nowrap}
#yw-membership-loader__subtext{position:relative;width:100%;height:28px;margin:0;font-family:'Matter','Matter Medium','Matter-Medium',sans-serif;font-size:20px;line-height:28px;font-weight:500;letter-spacing:0}
.yw-membership-loader__sub-a,.yw-membership-loader__sub-b{position:absolute;inset:0;white-space:nowrap;transition:opacity .5s ease,transform .5s ease}

/* Line + percentage (Figma frame 440: gap 12). The -1px margins make the 2px line take
   zero layout height, centred on the Figma stroke, so the gaps match Figma exactly. */
#yw-membership-loader__progress{position:relative;width:100%;height:2px;margin:-1px 0;overflow:hidden;border-radius:0;background:rgba(255,249,239,.45)}
#yw-membership-loader__progress-fill{display:block;width:0;height:100%;border-radius:0;background:#fff9ef;transform-origin:left center;transition:width .08s linear}
#yw-membership-loader__percent{display:block;margin-top:12px;font-family:'TAY Birdie','TAYBirdie','TAY-Birdie',sans-serif;font-size:16px;line-height:20px;font-weight:400;letter-spacing:0;font-variant-numeric:tabular-nums}

/* Mobile — Figma 392 × 816 frames: separate sizes and gaps, group sits 24px above centre */
@media(max-width:749px){
#yw-membership-loader{padding-bottom:48px;box-sizing:border-box}
#yw-membership-loader__inner{width:min(240px,calc(100% - 48px))}
#yw-membership-loader__logo{width:168px;margin-bottom:32px}
#yw-membership-loader__copy{gap:12px;margin-bottom:24px}
#yw-membership-loader__text{font-size:20px;line-height:20px}
#yw-membership-loader__subtext{height:20px;font-size:14px;line-height:20px}
#yw-membership-loader__percent{margin-top:8px;font-size:16px;line-height:20px}
}

@media(prefers-reduced-motion:reduce){
#yw-membership-loader,#yw-membership-loader__inner,#yw-membership-loader__progress-fill{transition:none}
.yw-membership-loader__door,.yw-membership-loader__door::after{transition:none}
#yw-membership-loader__logo,#yw-membership-loader__text,#yw-membership-loader__subtext,#yw-membership-loader__progress,#yw-membership-loader__percent{animation-duration:.01s;animation-delay:0s}
.yw-membership-loader__sub-a,.yw-membership-loader__sub-b{transition:none;transform:none}
}
</style>

