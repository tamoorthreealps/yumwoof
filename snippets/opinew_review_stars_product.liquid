<style>
    .rating-wrap .opinew-no-reviews-stars-plugin { display: none; }
    .rating-summary {transition: opacity 0.3s ease;}
    .rating-wrap:hover .rating-summary {opacity: .5;}
    .opw-noci-star-full::before,
    .opw-noci-star-half::before,
    .opw-nocin-star-empty::before {
        content: "";
        display: inline-block;
        width: 17px;
        height: 17px;
        background-size: contain;
        background-repeat: no-repeat;
        background-position: center;
    }
    .opw-noci-star-full::after,
    .opw-noci-star-half::after,
    .opw-nocin-star-empty::after {
      display:none;
    }

    .opw-noci-star-full::before {
        background-image: url("https://cdn.shopify.com/s/files/1/0317/2827/1419/files/full-star.svg?v=1786034114");
    }

    .opw-noci-star-half::before {
        background-image: url("https://cdn.shopify.com/s/files/1/0317/2827/1419/files/half-star.svg?v=1786034115");
    }

    .opw-nocin-star-empty::before {
        background-image: url("https://cdn.shopify.com/s/files/1/0317/2827/1419/files/emptry-star.svg?v=1786034405");
    }
</style>
{%- liquid
  assign rating = product.metafields.opinew_metafields.reviews_average
  assign rating_count = product.metafields.opinew_metafields.reviews_count | plus: 0
-%}

{% if product.metafields.opinew_metafields['stars_product'] != blank %}
  <span class="rating-wrap">
    {{ product.metafields.opinew_metafields['stars_product'] }}
    {% if rating_count > 0 %}
      <span class="rating-summary">
        {{ rating | times: 1.0 | round: 1 }} ({{ rating_count }})
      </span>
    {% endif %}
  </span>
{% else %}
  <a role="button" class="opinew-stars-plugin-link opinew-product-page-stars-disable" aria-label="Product reviews" href="#opinew-plugin" style="text-decoration:none;color:inherit;">
    <span class="opinew-star-plugin-inside" aria-label="product star rating">
      <i class="stars-color opw-nocin opw-nocin-star-empty" aria-hidden="true"></i>
      <i class="stars-color opw-nocin opw-nocin-star-empty" aria-hidden="true"></i>
      <i class="stars-color opw-nocin opw-nocin-star-empty" aria-hidden="true"></i>
      <i class="stars-color opw-nocin opw-nocin-star-empty" aria-hidden="true"></i>
      <i class="stars-color opw-nocin opw-nocin-star-empty" aria-hidden="true"></i>
    </span>
    <span class="opinew-no-reviews-stars-plugin" aria-label="review count"><b>  </b></span>
  </a>
{% endif %}