{% comment %}
  Yumwoof "GoCart" product card — matches Figma collection design (node 3845:168).

  Accepts:
  - product: {Object} product
  - short_desc_mf: {String} "namespace.key" for the short description above the price
      (default 'custom.collection_short_description')

  Behaviour:
  - Dark "BESTSELLER" flag (top-left of the image) when the product has the
    `best-seller` tag.
  - Outline category badge(s) straddling the bottom of the image, from the
    `custom.product_card_badges` list metafield (list of single line text),
    e.g. "ALL BREEDS & STAGES".
  - Recipe variants: when the product has an option named "Recipe", one card is
    rendered per distinct recipe value. Each card shows that recipe as its
    subtitle, the lowest price of that recipe's variants ("From $X"), the
    compare-at price struck through when higher, an "as low as $Y / day" line
    (lowest price / 30) and a "Shop now" button linking to that variant's PDP.
    The "Healthy Grains (Original)" recipe is skipped.
  - Card image: desktop from `custom.variant_image_collection_card`, mobile from
    `custom.variant_image_collection_card_mobile`. Each falls back to the other,
    then to the product featured image.
  - Short description from `custom.collection_short_description`.
{% endcomment %}

{%- liquid
  assign sd_key = short_desc_mf | default: 'custom.collection_short_description'
  assign sd_parts = sd_key | split: '.'
  assign short_desc = product.metafields[sd_parts[0]][sd_parts[1]]

  assign rating = product.metafields.reviews.rating
  assign rating_count = product.metafields.reviews.rating_count

  assign extra_badges = product.metafields.custom.product_card_badges.value

  comment
    Locate an option named "Recipe" (case-insensitive) so we can split the card per recipe.
  endcomment
  assign recipe_idx0 = -1
  for opt in product.options
    assign optname = opt | downcase | strip
    if optname == 'recipe'
      assign recipe_idx0 = forloop.index0
    endif
  endfor

  if recipe_idx0 >= 0
    assign recipe_values = ''
    for v in product.variants
      assign v_recipe = v.options[recipe_idx0]
      assign token = v_recipe | append: '||'
      unless recipe_values contains token
        assign recipe_values = recipe_values | append: token
      endunless
    endfor
    assign recipe_list = recipe_values | split: '||'
  else
    assign recipe_list = '__ALL__' | split: '#'
  endif
-%}

{%- for rv in recipe_list -%}
  {%- comment -%} Skip the "Healthy Grains (Original)" recipe entirely. {%- endcomment -%}
  {%- assign rv_check = rv | strip | downcase -%}
  {%- if rv_check == 'healthy grains (original)' -%}{%- continue -%}{%- endif -%}

  {%- liquid
    assign group_min = 0
    assign group_count = 0
    assign recipe_label = ''
    assign rep_variant = product.selected_or_first_available_variant
    assign group_image = ''
    assign group_image_mobile = ''

    if recipe_idx0 >= 0
      assign recipe_label = rv
      for v in product.variants
        if v.options[recipe_idx0] == rv
          assign group_count = group_count | plus: 1
          if group_min == 0 or v.price < group_min
            assign group_min = v.price
            assign rep_variant = v
          endif
          # First variant with a custom.variant_image_collection_card in this recipe sets the card image.
          assign v_img = v.metafields.custom.variant_image_collection_card.value
          if group_image == blank and v_img != blank
            assign group_image = v_img
          endif
          # First variant with a mobile card image in this recipe sets the mobile card image.
          assign v_img_m = v.metafields.custom.variant_image_collection_card_mobile.value
          if group_image_mobile == blank and v_img_m != blank
            assign group_image_mobile = v_img_m
          endif
        endif
      endfor
    else
      assign group_min = product.price_min
      assign group_count = product.variants.size
      assign group_image = rep_variant.metafields.custom.variant_image_collection_card.value
      assign group_image_mobile = rep_variant.metafields.custom.variant_image_collection_card_mobile.value
    endif

    assign rep_compare = rep_variant.compare_at_price
    assign per_day_cents = group_min | divided_by: 30
    assign card_url = rep_variant.url | default: product.url
    assign bestseller_label = rep_variant.metafields.custom.best_seller.value
    # Desktop image (custom.variant_image_collection_card); fall back to the product featured image.
    assign card_image = group_image | default: product.featured_image
    # Mobile image (custom.variant_image_collection_card_mobile); fall back to the desktop image.
    assign card_image_mobile = group_image_mobile | default: card_image
  -%}

  <div class="yw-pcard yw-pcard--{{ product.title | handleize }}">
    <a class="yw-pcard__media" href="{{ card_url }}" aria-label="{{ product.title | escape }}">
      <span class="yw-pcard__imgwrap">
        {%- if card_image != blank -%}
          {%- assign card_alt = card_image.alt | default: product.title | escape -%}
          {{
            card_image
            | image_url: width: 600
            | image_tag: class: 'yw-pcard__img recipe-swatch__img--desktop', widths: '200, 300, 460, 600', alt: card_alt, loading: 'lazy'
          }}
          {%- assign card_alt_mobile = card_image_mobile.alt | default: product.title | escape -%}
          {{
            card_image_mobile
            | image_url: width: 600
            | image_tag: class: 'yw-pcard__img recipe-swatch__img--mobile', widths: '200, 300, 460, 600', alt: card_alt_mobile, loading: 'lazy'
          }}
        {%- endif -%}
      </span>

      {%- if bestseller_label != blank -%}
        <span class="yw-pcard__flag">{{ bestseller_label }}</span>
      {%- endif -%}
    </a>

    <div class="yw-pcard__body">
      {%- if extra_badges != blank -%}
        <span class="yw-pcard__tags">
          {%- for b in extra_badges -%}
            <span class="yw-pcard__tag">{{ b }}</span>
          {%- endfor -%}
        </span>
      {%- endif -%}
      <a class="yw-pcard__title" href="{{ card_url }}">{{ product.title }}</a>

      {%- if recipe_label != blank -%}
        <p class="yw-pcard__recipe">{{ recipe_label }}</p>
      {%- endif -%}
      <div class="yw-pcard-opinew-stars">
        <div class='opinew-stars-plugin-product-list'>{% render 'opinew_review_stars_lists' product:product %}</div>
      </div>
      {%- if rating != blank -%}
        {%- assign rating_val = rating.value | default: rating | times: 1.0 -%}
        <div class="yw-pcard__rating">
          <span class="yw-pcard__stars" style="--yw-stars: {{ rating_val }};" aria-hidden="true">
            <span class="yw-pcard__stars-on">★★★★★</span>
            <span class="yw-pcard__stars-off">★★★★★</span>
          </span>
          <span class="yw-pcard__rating-count">
            {{- rating_val -}}
            {%- if rating_count != blank %} ({{ rating_count }}){% endif -%}
          </span>
        </div>
      {%- endif -%}

      {%- assign variant_short_desc = rep_variant.metafields.custom.product_card_short_description.value -%}

      {%- if variant_short_desc != blank -%}
        <p class="yw-pcard__desc">{{ variant_short_desc }}</p>
      {%- elsif short_desc != blank -%}
        <p class="yw-pcard__desc">{{ short_desc }}</p>
      {%- endif -%}

      <div class="yw-pcard__price">
        {%- if group_count > 1 -%}
          <span class="yw-pcard__price-from">From</span>
        {%- endif -%}
        <span class="yw-pcard__price-now">{{ group_min | money }}</span>
        {%- if rep_compare != blank and rep_compare > group_min -%}
          <s class="yw-pcard__price-was">{{ rep_compare | money }}</s>
        {%- endif -%}
      </div>

      {%- if group_min > 0 -%}
        <p class="yw-pcard__perday">as low as {{ per_day_cents | money }} / day</p>
      {%- endif -%}

      <a class="yw-pcard__btn" href="{{ card_url }}"><span>Shop now</span></a>
    </div>
  </div>
{%- endfor -%}