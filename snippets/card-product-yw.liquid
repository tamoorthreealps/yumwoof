          </svg>
        </span>
        <span class="card_new_badge desktop_badge">
          <svg xmlns="http://www.w3.org/2000/svg" width="64" height="40" viewBox="0 0 64 40" fill="none">
          <ellipse cx="32" cy="20" rx="32" ry="20" fill="#D9D9D9"/>
          <ellipse cx="32" cy="20" rx="32" ry="20" fill="#6DB8D8"/>
