048 49.313 23.064H49.217C48.817 23.16 48.705 22.904 48.689 22.568L48.529 19.224Z" fill="black"/>
          </svg>
        </span>
      {% endif %}
    </a>

    <div class="yw-pcard__body">
      {%- if extra_badges != blank -%}
        <span class="yw-pcard__tags">
          {%- for b in extra_badges -%}
            <span class="yw-pcard__tag">{{ b }}</span>
          {%- endfor -%}
        </span>
      {%- endif -%}
      <a class="yw-pcard__title" href="{{ card_url }}">{{ product.title }}</a>

      {%- assign collection_label = rep_variant.metafields.custom.collection_label.value
        | default: product.metafields.custom.collection_label.value
      -%}

      {%- if recipe_label != blank -%}
        <p class="yw-pcard__recipe">{{ recipe_label }}</p>
      {%- elsif collection_label != blank -%}
        <p class="yw-pcard__recipe">{{ collection_label }}</p>
      {%- endif -%}
      <div class="yw-pcard-opinew-stars">
        <div class="opinew-stars-plugin-product-list">{% render 'opinew_review_stars_lists', product: product %}</div>
      </div>
      {%- if rating != blank -%}
        {%- assign rating_val = rating.value | default: rating | times: 1.0 -%}
        <div class="yw-pcard__rating">
          <span class="yw-pcard__stars" style="--yw-stars: {{ rating_val }};" aria-hidden="true">
            <span class="yw-pcard__stars-on">★★★★★</span>
            <span class="yw-pcard__stars-off">★★★★★</span>
          </span>
          <span class="yw-pcard__rating-count">
            {{- rating_val -}}
            {%- if rating_count != blank %} ({{ rating_count }}){% endif -%}
          </span>
        </div>
      {%- endif -%}

      {%- assign variant_short_desc = rep_variant.metafields.custom.product_card_short_description.value -%}

      {%- if variant_short_desc != blank -%}
        <p class="yw-pcard__desc">{{ variant_short_desc }}</p>
      {%- elsif short_desc != blank -%}
        <p class="yw-pcard__desc">{{ short_desc }}</p>
      {%- endif -%}

      <div class="yw-pcard__price">
        {%- if group_count > 1 -%}
          <span class="yw-pcard__price-from">From</span>
        {%- endif -%}
        <span class="yw-pcard__price-now">{{ group_min | money }}</span>
        {%- if rep_compare != blank and rep_compare > group_min -%}
          <s class="yw-pcard__price-was">{{ rep_compare | money }}</s>
        {%- endif -%}
      </div>

      {%- if group_min > 0 -%}
        <p class="yw-pcard__perday">as low as {{ per_day_cents | money }} / day</p>
      {%- endif -%}

      <a class="yw-pcard__btn" href="{{ card_url }}"><span>Shop now</span></a>
    </div>
  </div>
{%- endfor -%}
