      padding: 14vw 0;
    }
    .yum-club-membership .inide {
      max-width: none;
      padding: 0 6vw;
    }
    .yum-club-membership .svg-text {
      width: 45vw;
    }
    .yum-club-membership .title-regular {
      font-size: 10vw;
      line-height: 0.85;
      margin-bottom: 4vw;
    }
    .yum-club-membership .site-para {
      font-size: 4.6vw;
      margin-bottom: 6vw;
    }
  }
</style>

<div class="page-main-wrapper">
